#!/usr/bin/env python3
"""cs-mcp -- the `cs` CLI exposed over MCP, as an ADDITIONAL surface.

Why this exists alongside the CLI rather than instead of it
-----------------------------------------------------------
The README's original argument against MCP was cost: tool schemas sit in
context for the whole session whether or not you search, so an MCP surface for
`cs` would have made the ~8.2k skill body permanent rather than on demand. That
argument is still exactly right for a client that inlines every schema at
session start, and this server does not repeal it.

It is no longer the whole story for clients that DEFER tool schemas -- tools
arrive as names only, and a schema is fetched when a tool is actually called.
There the standing cost is a list of ~21 identifiers, which is smaller than the
always-on skill description this partly duplicates.

So: both surfaces, and neither is the default for everyone. The CLI stays the
primary one and needs nothing installed. This server is opt-in (see docs/mcp.md), so
a client that inlines schemas is not made to pay for a surface that is only
cheap somewhere else.

What it buys, given the CLI already works
-----------------------------------------
Reachability. A tool an agent must be TOLD about is reached only when something
remembers to tell it; a tool in the tool list is reached because it is there.
That difference decides adoption independently of whether the tool is any good.
The `instructions` field below is the whole point of the exercise -- it is the
one place a search facade can say "start here" from inside the tool list.

Measurability comes with it: usage rollups key on the `mcp__<server>__` prefix,
so calls are countable by name rather than by matching the shape of a shell
command, which undercounts precisely when someone invokes it a new way.

THE TRAP: a server has no working directory worth reading
---------------------------------------------------------
`cs` resolves the ticket workspace from `$PWD`. That is right for a CLI -- you
are standing in the workspace -- and meaningless for a server, which is a
long-lived process whose cwd is wherever the client launched it and which does
not move when the user does.

Inherit that cwd and every MCP query silently becomes a fleet-only search: the
ticket layer disappears, the answer comes from main while the user is editing a
branch, and none of the `searching:` provenance that makes the scope visible is
attached. A confident answer from the wrong scope is the exact failure the
layering was built to prevent, and it would arrive through a brand new door.

Two things stop that here, and they are deliberately belt-and-braces:

  1. `scope` is a REQUIRED argument on every tool that reads the fleet. There
     is no default and no detection. "fleet" is spelled out as a value, so
     searching the fleet alone is a choice a caller makes rather than what it
     gets by falling through.
  2. `cs` is spawned with cwd="/", so even if (1) were bypassed there is no
     ticket workspace under the working directory to be found. The failure
     mode becomes a loud refusal instead of a quiet wrong scope.

And every result carries the `view` provenance line the CLI prints on stderr,
because a caller that names a scope must be able to see which scope answered.

Transport: JSON-RPC 2.0 over newline-delimited stdio, stdlib only -- `cs` runs
where python3 runs and nothing here should add an install step to that.
"""

import json
import os
import re
import signal
import subprocess
import sys
import time
import traceback

HERE = os.path.dirname(os.path.abspath(__file__))
CS = os.path.join(HERE, "cs")

# The working directory every cs subprocess is given -- see the module
# docstring. Deliberately not the server's own, and deliberately a NAMED
# constant reported by --self-check: while scope stays required this backstop
# is unreachable, so nothing observes it, so nothing would notice it being
# removed until the day something else regressed and it was needed. A defence
# that cannot be inspected is one you find out about by not having it.
CS_CWD = "/"

# Newest first. An unknown version from the client is answered with our newest
# rather than an error: the parts of the protocol this server uses (initialize,
# tools/list, tools/call) have not changed across any of these.
PROTOCOL_VERSIONS = ("2025-06-18", "2025-03-26", "2024-11-05")

# Long enough for a cold language server on a large repo, short enough that a
# wedged engine returns an error instead of hanging the client forever. `cs`
# has its own per-engine CS_TIMEOUT; this is the backstop for the whole call.
CALL_TIMEOUT = int(os.environ.get("CS_MCP_TIMEOUT", "600"))

# Why the server stopped. A client that loses this server sees only that its
# tools vanished (#88), and every way out of the loop below used to be silent:
# stdin closing, a signal, a broken pipe. Each now names itself on stderr, which
# the client's MCP log keeps. CS_MCP_LOG also appends start, every call and the
# exit to a file the client cannot lose -- the same values as CS_LOG: unset or 0
# for off, 1 for the default path, anything else is the path. A run in that file
# with no exit line was killed outright (SIGKILL, or the process crashed) --
# the one ending nothing inside the process can report.
_log = os.environ.get("CS_MCP_LOG", "")
if _log.lower() in ("", "0", "false", "no", "off"):
    LOG_PATH = ""
elif _log.lower() in ("1", "true", "yes", "on"):
    LOG_PATH = os.path.join(os.environ.get("XDG_CACHE_HOME")
                            or os.path.expanduser("~/.cache"), "cs-mcp.log")
else:
    LOG_PATH = _log
STARTED = time.time()
LIFE = {"calls": 0, "running": None, "last": None}

# A scope is "fleet", a workspace id (a folder name, looked up under every
# workspace root), or an ABSOLUTE path to a workspace or anywhere inside one --
# so an agent can pass its own working directory. A path is one argv element
# (run_cs builds a list, never a shell string), so this is not about injection;
# `cs` validates it as a subtree of a configured root and refuses otherwise.
# What is rejected here is what cs would misread: a leading dash (a flag), a
# relative path (resolved against this server's cwd, which is not the
# caller's), and control characters.
SCOPE_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]*\Z")
SCOPE_PATH_RE = re.compile(r"\A/[^\x00-\x1f]*\Z")

# `cs` has no `--` end-of-options marker, so a positional argument spelled like
# one of its flags would be eaten by the flag loop and silently change the
# query. Caught here rather than producing an answer to a different question.
CS_FLAGS = {
    "--fleet", "--why", "--quiet", "-q", "--all", "--touched",
    "--refresh", "--porcelain", "--json", "--word", "-w",
    "--source-only", "--count", "--suggest-clone", "--full-lines",
}


# ---- the tool surface ------------------------------------------------------
# Named `cs_<subcommand>`, one per CLI subcommand, so the two surfaces cannot
# drift into answering differently. Descriptions are one line: in a client that
# defers schemas the name and this line are the entire standing cost, and the
# schema below is fetched only when the tool is actually used.
#
# Flags that change the MEANING of an answer are exposed (`word`, `touched`).
# Flags that only change presentation or the result cap are not -- `cs` reports
# a cap in the result rather than making the caller pre-guess one.

def arg(name, desc, required=True, type_="string", enum=None):
    prop = {"type": type_, "description": desc}
    if enum:
        prop["enum"] = enum
    return (name, prop, required)


SCOPE_ARG = arg(
    "scope",
    "Which workspace to search: the ABSOLUTE PATH of a workspace or of any "
    "directory inside one (your own working directory works, at any depth), "
    'a workspace folder name when it is unique, or "fleet" for the fleet '
    "alone. REQUIRED — this server is not running in your working directory "
    "and cannot infer it. cs_scopes lists the workspaces by path. Naming a "
    "workspace layers its branch state over the fleet; \"fleet\" answers "
    "from main only.",
)

# `word` is declared on every verb that takes an identifier, not just cs_text.
# The flag was always passed through (see the flags block in call_tool) and
# always accepted by the CLI, so the capability was present and only the
# DECLARATION was missing -- which over MCP is the same as not having it, since
# a caller can only send what the schema names.
#
# The cost of the omission is asymmetric, which is why it is worth a comment.
# cs_uses substring-matches, so a compound identifier matches every longer
# identifier containing it: the reported case returned 1,305 hits across 6
# repos where the whole-word answer was 2 call sites. A malformed query of this
# shape does not error and does not return a suspicious zero -- it returns
# false ABUNDANCE, and a large hit count reads as thorough coverage.
# Opt-in, and named on the verbs that return text hits. A measured `cs uses`
# answer was 1,295 hits of which 1,271 were data files and 1,192 came from a
# single fixture CSV -- the 24 source hits were the answer, and under the cap
# almost none of them were shown. cs now reports the composition of every text
# answer; this flag is for a caller who wants the data half gone.
#
# NOT a test-vs-production filter, deliberately: a test constructing a request
# object WITHOUT a field is often the most informative hit for an impact
# question, so test code stays in scope. The line is data vs source.
SOURCE_ONLY_ARG = arg(
    "source_only",
    "Exclude data, doc and generated files (.csv .json .txt .tsv .lock .log "
    ".rst .md .svg .map .min.js .min.css) from the hits. Off by default, because a route in an appsettings.json is a real "
    "seam. Composition is reported either way. Observability definitions "
    "(dashboard panels, alert and recording rules) are kept even when their "
    "extension is on that list — they are consumers of an identifier, and this "
    "flag is what an impact question is asked with.",
    required=False,
    type_="boolean",
)

WORD_ARG = arg(
    "word",
    "Match whole identifiers only, not substrings of longer ones. Use this "
    "whenever the query is a compound identifier (a type or method name) "
    "rather than a string-shaped seam such as a route, topic or config key.",
    required=False,
    type_="boolean",
)

# The counts-first mode, declared on the three verbs that return TEXT HITS.
#
# `--count` was `cs fields` only, and for a human at a terminal that was the
# right call: scrolling past 200 lines is free. Over MCP it is not. Hits land in
# a context window and are charged by the token, and the caller usually does not
# know the distribution before asking -- which is the case where the cost is
# incurred to learn something a tally would have said. One measured exploratory
# cs_text over a 43-repo fleet returned 642 hits in 12 repos, showed 200, and
# cost roughly 15,000 tokens for a query whose only purpose was to find out
# which repo to read. The tally is a few hundred and names the repo.
#
# The property that makes it safe is the one cs fields --count already has: the
# counts are the whole answer rather than a header over a listing, so there is
# no truncation for them to be lost to. And they come from the same pipeline as
# the listing, so `word` and `source_only` still narrow them.
COUNT_TEXT_ARG = arg(
    "count",
    "Return the per-repo HIT TALLY with no hit bodies, instead of the hits. "
    "Ask this FIRST for an exploratory query over the whole fleet: hits are "
    "charged by the token and a truncated listing costs the full cap to learn "
    "a distribution this answers in one line per repo. The counts come from the "
    "same search as the listing, so word and source_only narrow them the same "
    "way and the totals agree. Then rerun without it, having read where to look.",
    required=False,
    type_="boolean",
)

TOOLS = [
    # --- the questions ------------------------------------------------------
    ("cs_uses", "uses",
     "Who uses this string in CODE across every repo — comments excluded. The "
     "cross-repo caller question: start here for an endpoint, topic or config "
     "key. For a compound IDENTIFIER rather than a string-shaped seam, pass "
     "word: this substring-matches by default, and a compound name then "
     "matches every longer name containing it.",
     [arg("query", "The string to find: an endpoint path, topic name, config key."),
      SCOPE_ARG,
      WORD_ARG,
      SOURCE_ONLY_ARG,
      COUNT_TEXT_ARG]),

    ("cs_seam", "seam",
     "Which repos share this string, comments included — and warns when only "
     "one does, which is how a dead seam looks.",
     [arg("query", "The string that would form the seam."),
      SCOPE_ARG,
      WORD_ARG,
      SOURCE_ONLY_ARG,
      COUNT_TEXT_ARG]),

    ("cs_text", "text",
     "Plain text or regex across every repo, comments included. The fallback "
     "when no sharper question fits.",
     [arg("pattern", "A literal string or regex."),
      SCOPE_ARG,
      WORD_ARG,
      SOURCE_ONLY_ARG,
      COUNT_TEXT_ARG]),

    ("cs_def", "def",
     "Where a symbol is defined, across the fleet or within one repo.",
     [arg("symbol", "The symbol name."),
      SCOPE_ARG,
      arg("repo", "Limit to this repo directory name.", required=False)]),

    ("cs_calls", "calls",
     "Structural search: call sites shaped like a pattern, or taking a literal "
     "argument — finds what text search cannot express.",
     [arg("pattern", "An ast-grep/semgrep pattern, e.g. 'foo($$$ARGS)'."),
      SCOPE_ARG,
      arg("language", "Restrict to one language, e.g. csharp, kotlin, python.",
          required=False)]),

    ("cs_impls", "impls",
     "What implements this interface — resolved by a language server, the "
     "strongest evidence available.",
     [arg("symbol", "The interface or base type name."),
      arg("repo", "The repo directory name holding it."),
      SCOPE_ARG]),

    # --- symbol mode: the same three questions the CLI fronts, and no more ---
    # The graph behind these exposes ~90 operations. Fronting them all would put
    # a worse interface in the tool list than the one the client could call
    # directly, and would cost the property that makes this surface legible:
    # tools shaped like questions, few enough to skim. Each description states
    # the per-repo scope, because that is what a caller cannot see from here.
    ("cs_callers", "callers",
     "What calls this symbol, from one repo's symbol graph. Direct callers "
     "only, and scoped to that repo — a caller in another repo is a string, "
     "which is cs_uses.",
     [arg("symbol", "The function, method or constructor name."),
      arg("repo", "The repo directory name holding it."),
      SCOPE_ARG]),

    ("cs_callees", "callees",
     "What this symbol calls, from one repo's symbol graph. Direct callees "
     "only, so nothing transitive is mixed in unlabelled.",
     [arg("symbol", "The function, method or constructor name."),
      arg("repo", "The repo directory name holding it."),
      SCOPE_ARG]),

    ("cs_impact", "impact",
     "What depends on this symbol, transitively — the 'what breaks if I change "
     "it' question, within one repo's graph.",
     [arg("symbol", "The symbol whose dependents you want."),
      arg("repo", "The repo directory name holding it."),
      SCOPE_ARG]),

    # Fleet-wide, unlike the three above it: the field-level impact question
    # stops making sense at a repo boundary, so `repo` here NARROWS rather than
    # being required. The read/write split is named in the description because
    # it is the reason to reach for this instead of cs_uses, and a caller
    # reading only the tool list would otherwise see "another search verb".
    ("cs_fields", "fields",
     "Every READ and WRITE site of a field, across every repo with a graph, "
     "split by access kind — the API-impact question. Writes observe an added "
     "field or a changed default; reads break on a removal, rename or retype. "
     "Prefer this over cs_uses for a field: text search cannot tell the two "
     "apart.",
     [arg("field", "The field name. Type::field is accepted but tokensave 7.9.0 "
                   "parses the qualifier without applying it, and cs refuses "
                   "rather than return the unnarrowed answer under it."),
      SCOPE_ARG,
      arg("repo", "Limit to this repo directory name.", required=False),
      arg("count", "Return per-repo write/read SITE tallies instead of the site "
                   "list — the same quantity the listing reports, so the two "
                   "agree. Use this fleet-wide: a common field name overflows "
                   "the graph's own output and the listing then refuses, while "
                   "the counts survive that truncation. Where the output was "
                   "truncated, sites cannot be derived and the row says it is "
                   "counting references instead.",
          required=False, type_="boolean")]),

    # The enumeration is the point. cs_calls answers one shape and reads as
    # complete; this one unions the construction idioms and names both what it
    # searched and what it could not.
    ("cs_constructs", "constructs",
     "Every construction site of a type, across the shapes it can be built by "
     "— direct constructor, new, builder, factory. Use for a DEFAULT change: a "
     "default is only observable where the object is built without the field. "
     "Names the shapes it could not search, so the answer never reads as "
     "complete.",
     [arg("type", "The type name."),
      SCOPE_ARG,
      arg("repo", "Limit to this repo directory name.", required=False),
      arg("field_name", "Mark each site present or ABSENT for this field. "
                        "ABSENT sites inherit its default. Textual test on the "
                        "matched construction, not a resolved argument list.",
          required=False)]),

    # The other half of an API-impact review, and the half a search verb cannot
    # answer: WHO CRASHES if the field is added. Declared tier, like cs_owns.
    ("cs_strictness", "strictness",
     "Which repos REJECT unknown fields when deserializing — the 'who crashes "
     "if I add a field' half of an API-impact review. STRICT / LENIENT / MIXED "
     "/ UNKNOWN per repo; name a repo for the per-model evidence. UNKNOWN is "
     "not lenient, it means undetermined.",
     [SCOPE_ARG,
      arg("repo", "Limit to this repo, and list its per-model evidence "
                  "instead of the roll-up.", required=False)]),

    # The other half of the same review, and the one a search verb cannot
    # answer: not "who rejects an added field" but "who can even OBSERVE one".
    ("cs_resilience", "resilience",
     "What each repo does on a non-2xx: READS ERROR BODY / DISCARDS / RETRIES, "
     "BODY DISCARDED / MIXED / UNKNOWN per repo. Use when changing an ERROR "
     "shape or adding a partial-failure field: a caller that raises on the "
     "status and retries never sees the body, so the contract is a no-op for "
     "it and nothing errors. UNKNOWN means undetermined, not attentive.",
     [SCOPE_ARG,
      arg("repo", "Limit to this repo, and list its per-site evidence instead "
                  "of the roll-up.", required=False)]),

    # The same read/write split cs_fields makes, applied to a config key and
    # therefore ACROSS a repo boundary -- which is where the mismatch hides,
    # because the two sides live in different file kinds and no single sweep
    # can tell you whether their literals agree.
    ("cs_values", "values",
     "Which repos SET a config key or env var, with what literal values, and "
     "which repos READ it — split into set-sites and read-sites the way "
     "cs_fields splits a field. Use for a config key instead of cs_uses: the "
     "failure is a VALUE MISMATCH across the seam, not a missing reference, "
     "and an undifferentiated list hides it. Reports which set values no read "
     "site accepts, but only when the read side is genuinely enumerable.",
     [arg("key", "The config key or environment variable name."),
      SCOPE_ARG,
      arg("repo", "Limit to this repo directory name.", required=False)]),

    # The CORPUS bound, not a search result. The only tool here that needs
    # network, and the only one whose absence leaves a question unanswerable
    # rather than answered worse.
    ("cs_gaps", "gaps",
     "What matches ORG-WIDE that the fleet does not hold — the bound on a "
     "fleet-scoped negative. Use before reporting that nothing calls something: "
     "a repo that was never cloned cannot be searched by any query. Needs a "
     "forge CLI and network, and refuses rather than degrading to a fleet-only "
     "answer.",
     [arg("query", "The string to search for org-wide."),
      SCOPE_ARG,
      # #24 again, and the third time this shape has been filed: the flag was
      # implemented, worked on the CLI, and was already in the passthrough
      # allowlist -- only this declaration was missing, and over MCP an
      # undeclared flag is the same as an absent one, because a caller can only
      # send what the schema names.
      arg("suggest_clone",
          "Also print the clone command for each repo the fleet is missing — "
          "the application-code matches only, which is the half the answer's "
          "own warning says is worth cloning. Config-only matches are still "
          "listed, under a separate heading, without a clone command.",
          required=False, type_="boolean")]),

    ("cs_refs", "refs",
     "What references this symbol, resolved by a language server — bridges "
     "dependency injection that text search cannot follow.",
     [arg("symbol", "The symbol name: a bare name, or a member as "
                    "Type/Member (Type.Member is accepted and asked as Type/Member)."),
      arg("repo", "The repo directory name holding it."),
      arg("file", "Path to the file declaring it, relative to the repo."),
      SCOPE_ARG]),

    ("cs_provides", "provides",
     "Which repo publishes this package coordinate — read from build "
     "manifests, not guessed from names.",
     [arg("coordinate", "A package coordinate, e.g. com.acme:pricing-lib."),
      SCOPE_ARG]),

    ("cs_deps", "deps",
     "Dependency edges between fleet repos, read from build manifests.",
     [SCOPE_ARG,
      arg("repo", "Limit to this repo's edges.", required=False)]),

    ("cs_versions", "versions",
     "Which version each repo pins for a shared package, and where they "
     "disagree — the version-drift question.",
     [SCOPE_ARG,
      arg("coordinate", "A package coordinate; omit for every shared one.",
          required=False)]),

    ("cs_owns", "owns",
     "Who CODEOWNERS names for this repo or path, across the fleet.",
     [SCOPE_ARG,
      arg("target", "A repo name, or repo/path; omit for every repo.",
          required=False)]),

    ("cs_publishes", "publishes",
     "What each repo in the fleet publishes.",
     [SCOPE_ARG]),

    ("cs_history", "history",
     "When a cross-repo seam entered or left history, across every repo, "
     "ordered by date — answers 'what changed near this incident'.",
     [arg("query", "The string whose history you want."),
      SCOPE_ARG,
      arg("repo", "Limit to one repo.", required=False),
      arg("touched", "Include commits that modified a line containing it in "
                     "place, not only those that added or removed it.",
          required=False, type_="boolean")]),

    # --- what am I searching, and how much is it worth ----------------------
    ("cs_scopes", "scopes",
     "Which workspaces exist to be searched — the fleet, and every workspace "
     "under every workspace root (nested ones included), by path. The path "
     "is the scope value. Call this first: every other tool needs a scope.",
     []),

    ("cs_repos", "repos",
     "Which repos a scope actually contains, and whether each came from the "
     "ticket or the fleet.",
     [SCOPE_ARG]),

    ("cs_which", "which",
     "Decision table: which cs tool answers which kind of question.",
     []),

    ("cs_why", "why",
     "What a given kind of answer cannot see, and how much a NEGATIVE result "
     "of that kind is worth.",
     [arg("kind", "resolved, declared, structural, historical, heuristic, or "
                  "textual; omit for the table.", required=False,
          enum=["resolved", "declared", "structural", "historical",
                "heuristic", "textual"])]),

    ("cs_engines", "engines",
     "Which engines and answer kinds are available on this machine — what the "
     "negatives here are worth.",
     []),

    ("cs_changes", "changes",
     "What changed in cs: the three latest releases, or everything after a "
     "version you name -- behaviour changes, new refusals, and small fixes "
     "that had no ticket. Call it when cs behaves differently from what you "
     "remember or from your notes.",
     [arg("since", "a version such as 1.17.2: list everything released after "
                   "it. Omit for the three latest releases.", required=False)]),

    ("cs_doctor", "doctor",
     "Check this machine against this fleet: for every engine, and for every "
     "language the fleet contains, whether cs can answer here, what it costs "
     "when it cannot, and the fix. Use it when a tool refused, or when an "
     "empty cs_impls / cs_refs needs explaining.",
     []),
]

# The one place a search facade can tell an agent it exists, from inside the
# tool list rather than from prose someone has to remember to load. Kept short:
# it is standing context in every session this server is enabled for.
def _version():
    try:
        with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "VERSION")) as f:
            return f.read().strip() or "?"
    except OSError:
        return "?"


INSTRUCTIONS = """\
cs searches a fleet of repositories. Start with a cs_* tool for any question \
that spans more than one repo — who calls an endpoint, where a symbol is \
defined, what implements an interface, which repo publishes a package, who \
owns it, which version each repo pins. Reach for grep only after cs.

Every tool needs a `scope`: the absolute path of the workspace you are working \
in (your own working directory, at any depth, works), or "fleet". This server \
has no working directory to infer it from, and guessing would answer from main \
while the user edits a branch. cs_scopes lists the workspaces by path.

Every answer is labelled with the KIND of evidence behind it, which is what \
decides how much a NEGATIVE is worth: a `resolved` no is strong, a `textual` \
no is weak. Pass on the provenance line and any PARTIAL / degraded / truncated \
warning rather than reporting the hits alone.

When a tool refuses for a missing engine or toolchain, or cs_impls / cs_refs \
come back empty, call cs_doctor before concluding anything: it checks this \
machine against the languages the fleet holds and names the fix to give the \
user.

This is cs {version}. If cs behaves differently from what you remember or \
from your notes, call cs_changes: it lists what changed in recent versions, \
small fixes included.\
"""
# The version is read, not written in: a number typed into this string would be
# the one place it could drift from VERSION, and the version is what lets an
# agent notice the cs it is talking to is not the one it remembers.
INSTRUCTIONS = INSTRUCTIONS.replace("{version}", _version())


def tool_schema(spec):
    name, sub, desc, args = spec
    props, required = {}, []
    for arg_name, prop, is_required in args:
        props[arg_name] = prop
        if is_required:
            required.append(arg_name)
    return {
        "name": name,
        "description": desc,
        "inputSchema": {
            "type": "object",
            "properties": props,
            "required": required,
            "additionalProperties": False,
        },
    }


BY_NAME = {spec[0]: spec for spec in TOOLS}


# ---- running cs ------------------------------------------------------------

def scope_flag(scope):
    """The cs flag for a scope, or raise with a message the agent can act on."""
    if not isinstance(scope, str) or not scope.strip():
        raise ToolError(
            "scope is required and was not given.\n"
            "  This server has no working directory to infer a workspace from, so "
            "answering anyway would search the fleet (main) while you may be asking "
            "about a ticket branch — with nothing in the answer to reveal the "
            "substitution.\n"
            "  Pass the absolute path of the workspace you are working in (your "
            "own working directory, at any depth, works), or scope=\"fleet\" to "
            "search the fleet on purpose. cs_scopes lists the workspaces by path."
        )
    scope = scope.strip()
    if scope == "fleet":
        return "--fleet"
    if not (SCOPE_RE.match(scope) or SCOPE_PATH_RE.match(scope)):
        raise ToolError(
            f"not a usable scope: {scope!r}\n"
            "  A scope is the absolute path of a workspace (or of any directory "
            'inside one), a workspace folder name, or the literal "fleet". A '
            "relative path cannot be used: this server's working directory is "
            "not yours.\n"
            "  Call cs_scopes for the valid values."
        )
    return "--ticket=" + scope


class ToolError(Exception):
    """A failure to report as an isError tool result, not a protocol error."""


def run_cs(sub, argv, scope=None, flags=()):
    """Run one cs subcommand and return its porcelain envelope as a dict.

    --quiet as well as --porcelain: the human `answer:` line goes to stderr and
    every fact on it is in the envelope, so printing it too would only mean
    parsing back out what we already have structured.
    """
    for a in argv:
        if a in CS_FLAGS or a.startswith("--ticket=") or a.startswith("--field="):
            raise ToolError(
                f"argument {a!r} is spelled like a cs flag and would change the "
                "query rather than be searched for.\n"
                "  cs has no end-of-options marker. Search for it with cs_text "
                "using a pattern that does not begin with a dash."
            )
    cmd = [CS, sub] + list(argv) + ["--porcelain", "--quiet"]
    if scope is not None:
        cmd.append(scope_flag(scope))
    cmd.extend(flags)

    env = dict(os.environ)
    # The flag on the command line is the single source of truth for output
    # mode; an inherited CS_JSON could otherwise turn porcelain on for a
    # subprocess we then parse differently. (It is already on -- this is about
    # not depending on the environment for it.)
    env.pop("CS_JSON", None)

    try:
        proc = subprocess.run(
            cmd,
            cwd=CS_CWD,
            env=env,
            # Not the protocol stream: anything cs runs that reads stdin would
            # take the client's next request out of it.
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=CALL_TIMEOUT,
        )
    except FileNotFoundError:
        raise ToolError(f"cs not found at {CS} — this server ships beside it")
    except subprocess.TimeoutExpired:
        raise ToolError(
            f"cs did not finish within {CALL_TIMEOUT}s and was killed.\n"
            "  Nothing was searched to completion, so nothing is ruled out. "
            "Narrow the query, or raise CS_MCP_TIMEOUT."
        )

    out = proc.stdout.decode("utf-8", "replace").strip()
    err = proc.stderr.decode("utf-8", "replace").strip()
    try:
        return json.loads(out)
    except ValueError:
        # Neither branch below is a zero-hit answer, and neither may be allowed
        # to read like one. They are told apart because they are different
        # faults with opposite advice.
        tail = "\n".join(err.splitlines()[-15:]) or "(no output)"
        # Corrupt stdout. A zero exit with bytes on stdout means cs searched,
        # found, and then mangled its own envelope. Calling that "did not run"
        # contradicts the stderr printed directly beneath it -- the hits-per-repo
        # breakdown of the very search being reported as not having happened --
        # and hands the agent a successful search as a negative result.
        if proc.returncode == 0 and out:
            raise ToolError(
                "cs exited 0 and produced output, but its result envelope is "
                "not valid JSON, so the hits could not be read. The search "
                "itself ran -- this is a formatting bug in cs, not a negative "
                f"result, and nothing here rules anything out:\n{tail}"
            )
        # No envelope at all. cs emits it from an EXIT trap, so its absence
        # means cs died in a way that skipped the trap: nothing was searched to
        # completion, so nothing is ruled out.
        raise ToolError(
            f"cs exited {proc.returncode} without a result envelope, so this "
            f"search did not run:\n{tail}"
        )


# The subcommands whose output is a TABLE, not a list of hits. They write it
# straight to stdout rather than through cs's result buffer, so `--porcelain`
# would put the table and the envelope on the same stream and neither would
# parse. Their stdout is passed through as written instead.
PLAIN_SUBS = {"which", "why", "engines", "doctor", "changes", "scopes", "repos"}


def run_cs_plain(sub, argv=(), scope=None):
    """For the explain-yourself subcommands: prose about the tool, not answers
    about the code.

    `cs repos` is scoped like a real query even though it is one of these --
    which repos it lists IS the scope, so asking it without one would describe
    a view nobody searched.
    """
    cmd = [CS, sub] + list(argv)
    if scope is not None:
        cmd.append(scope_flag(scope))
    try:
        proc = subprocess.run(
            cmd, cwd=CS_CWD, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, timeout=CALL_TIMEOUT,
        )
    except FileNotFoundError:
        raise ToolError(f"cs not found at {CS} — this server ships beside it")
    except subprocess.TimeoutExpired:
        raise ToolError(f"cs {sub} did not finish within {CALL_TIMEOUT}s")
    out = proc.stdout.decode("utf-8", "replace").rstrip()
    err = proc.stderr.decode("utf-8", "replace").rstrip()
    # These four write their diagnostics to stderr and their table to stdout,
    # and for cs scopes and cs engines the stderr half carries the part a
    # caller most needs -- "TICKETS_ROOT is unset", "this engine is missing".
    if err:
        out = (out + "\n\n" + err) if out else err
    if proc.returncode != 0 and not out:
        raise ToolError(f"cs {sub} exited {proc.returncode} with no output")
    return out or "(no output)"


# ---- rendering an answer ---------------------------------------------------

def render(env):
    """The envelope as text: provenance, kind, every warning, then the hits.

    Deliberately not the raw JSON. The four warnings and the answer kind are
    the parts a caller is most likely to drop, and burying them as sibling keys
    of a results array is how they get dropped -- so they are put above the
    results, in the order a reader would want them, and the results follow.
    """
    lines = []
    if env.get("view"):
        lines.append("searching: " + env["view"])

    if env.get("refused"):
        lines.append("")
        lines.append("REFUSED — this search did not run, so nothing is ruled out.")
        if env.get("reason"):
            lines.append(env["reason"])
        return "\n".join(lines), True

    kind, engine = env.get("kind"), env.get("engine")
    if kind:
        line = f"answer: {kind} via {engine}"
        if env.get("note"):
            line += f" ({env['note']})"
        for label, key in (("hit(s)", "hits"), ("repo(s)", "repos")):
            if env.get(key) is not None:
                line += f" · {env[key]} {label}"
        lines.append(line)

    # Everything that makes the result a subset of the truth, or worth less
    # than it looks. Above the hits, because below them is where they get
    # skimmed past.
    warnings = []
    if env.get("degraded"):
        warnings.append("degraded: " + env["degraded"])
    if env.get("partial"):
        warnings.append(
            "PARTIAL: an engine timed out or files could not be read — these "
            "results are a subset of the truth, not a complete answer."
        )
    if env.get("truncated"):
        warnings.append(
            f"TRUNCATED: {env.get('returned')} of {env.get('hits')} hits shown. "
            "Narrow the query to see the rest."
        )
    for e in env.get("engine_errors") or []:
        warnings.append("engine error: " + e)
    skipped = env.get("skipped") or []
    if skipped:
        shown = ", ".join(skipped[:5])
        more = f" (+{len(skipped) - 5} more)" if len(skipped) > 5 else ""
        warnings.append(f"could not read: {shown}{more}")
    if env.get("exclusions"):
        warnings.append("non-default exclusion list in force: " + env["exclusions"])
    # A hit whose text was cut is still the right hit -- the address is whole --
    # but the line shown is not the line in the file, and a caller quoting it
    # should know.
    elided = env.get("elided")
    if elided:
        warnings.append(
            f"{elided.get('lines')} hit line(s) longer than {elided.get('max_line')} "
            f"bytes were cut around the match ({elided.get('bytes')} bytes elided). "
            "Open the file at the line shown for the rest."
        )
    for n in env.get("notes") or []:
        warnings.append(n)
    lines.extend(warnings)

    results = env.get("results") or []
    if results:
        lines.append("")
        for r in results:
            if r.get("path"):
                lines.append(f"{r['repo']}/{r['path']}:{r['line']}: {r['text']}")
            else:
                lines.append(r["text"])
    else:
        lines.append("")
        # Exit 2, not exit 1: the search ran. Said in those words because the
        # whole point of the exit-code split is that a caller must not read
        # this as "the tool failed" OR as "definitely nothing exists".
        lines.append(
            "No hits. The search RAN and found nothing — this is an answer, not "
            "a failure."
        )
        if kind:
            lines.append(
                f"How much that is worth depends on the kind: this was {kind}. "
                f"Call cs_why with kind={kind!r} before concluding nothing exists."
            )
        for h in env.get("hints") or []:
            lines.append("  try: " + h)

    return "\n".join(lines), False


# ---- dispatch --------------------------------------------------------------

# Value-carrying arguments that cs takes as a flag rather than by position.
NOT_POSITIONAL = {"field_name"}


def positional(spec, arguments):
    """The subcommand's positional arguments, in the order cs expects them.

    cs's arguments are positional and order-dependent, and the schema above is
    written in that same order -- so the order is read off the spec rather than
    restated per tool, which is one fewer place for the two to disagree.
    """
    _, _, _, args = spec
    argv, seen_gap = [], None
    for arg_name, prop, is_required in args:
        # Skipped because they reach cs as FLAGS, not positionally. Booleans are
        # all flags by construction; NOT_POSITIONAL is for the ones that carry a
        # value -- `--field=<name>` is a string, so without naming it here it
        # would be appended as a positional argument and cs would read it as the
        # repo. Kept as a named set rather than a type test for that reason.
        if arg_name == "scope" or arg_name in NOT_POSITIONAL:
            continue
        if prop.get("type") == "boolean":
            continue
        val = arguments.get(arg_name)
        if val is None or val == "":
            if is_required:
                raise ToolError(f"{arg_name} is required")
            # An optional positional cannot be skipped over: cs reads
            # `cs def <symbol> [repo]` by position, so omitting an earlier one
            # while giving a later one would silently shift every argument.
            seen_gap = arg_name
            continue
        if seen_gap:
            raise ToolError(
                f"{arg_name} was given but {seen_gap} was not, and cs reads "
                f"these by position — give {seen_gap} as well, or drop {arg_name}."
            )
        if not isinstance(val, str):
            raise ToolError(f"{arg_name} must be a string")
        argv.append(val)
    return argv


def call_tool(name, arguments):
    spec = BY_NAME.get(name)
    if spec is None:
        raise ToolError(f"unknown tool: {name}")
    _, sub, _, args = spec
    arg_names = {a[0] for a in args}

    # The schema says additionalProperties: false, but not every client
    # enforces it -- and an unknown argument was otherwise just ignored, so
    # `cs_text {"query": …}` came back as "pattern is required": right about
    # what was missing, silent about what was wrong. The argument name differs
    # between sibling tools (pattern / query / symbol / field …), so copying it
    # from the wrong one is the common mistake, and naming it saves the round
    # trip. Checked first, because it is usually the cause of a missing one.
    unknown = [k for k in arguments if k not in arg_names]
    if unknown:
        takes = ", ".join(a[0] for a in args) or "no arguments"
        raise ToolError(
            f"unknown argument{'s' if len(unknown) > 1 else ''} "
            f"{', '.join(repr(k) for k in unknown)} — {name} takes: {takes}"
        )

    # Reached through the same path as a bad scope, so the explanation is
    # written once. A client that does not enforce `required` gets the same
    # refusal as one that passes an empty string.
    scope = arguments.get("scope") if "scope" in arg_names else None
    if "scope" in arg_names:
        scope_flag(scope)

    if sub in PLAIN_SUBS:
        return run_cs_plain(sub, positional(spec, arguments), scope=scope), False

    flags = []
    if arguments.get("word"):
        flags.append("--word")
    if arguments.get("touched"):
        flags.append("--touched")
    if arguments.get("source_only"):
        flags.append("--source-only")
    if arguments.get("count"):
        flags.append("--count")
    if arguments.get("suggest_clone"):
        flags.append("--suggest-clone")
    # A value flag, not a boolean: cs constructs takes --field=<name>.
    if arguments.get("field_name"):
        flags.append("--field=" + str(arguments["field_name"]))

    env = run_cs(sub, positional(spec, arguments), scope=scope, flags=flags)
    return render(env)


def handle(msg):
    """One request in, one response out — or None for a notification."""
    # A message that is not an object used to raise right here, outside every
    # handler, and take the server down with a traceback.
    if not isinstance(msg, dict) or not isinstance(msg.get("params") or {}, dict):
        return error(msg.get("id") if isinstance(msg, dict) else None, -32600,
                     "invalid request: a message is a JSON object, and its "
                     "params, when present, an object")
    mid = msg.get("id")
    method = msg.get("method")
    params = msg.get("params") or {}

    if mid is None:
        return None  # a notification; notifications/initialized is the only one

    if method == "initialize":
        asked = params.get("protocolVersion")
        version = asked if asked in PROTOCOL_VERSIONS else PROTOCOL_VERSIONS[0]
        return ok(mid, {
            "protocolVersion": version,
            "capabilities": {"tools": {"listChanged": False}},
            "serverInfo": {"name": "cs", "version": server_version()},
            "instructions": INSTRUCTIONS,
        })

    if method == "ping":
        return ok(mid, {})

    if method == "tools/list":
        return ok(mid, {"tools": [tool_schema(s) for s in TOOLS]})

    if method == "tools/call":
        name = params.get("name")
        arguments = params.get("arguments") or {}
        if name not in BY_NAME:
            return error(mid, -32602, f"unknown tool: {name}")
        LIFE["running"], t0 = name, time.time()
        try:
            text, is_error = call_tool(name, arguments)
        except ToolError as e:
            text, is_error = str(e), True
        except Exception as e:  # never take the transport down over one call
            text, is_error = f"cs-mcp failed to run this query: {e}", True
        LIFE["calls"] += 1
        LIFE["running"] = None
        LIFE["last"] = "%s, %.1fs, %s" % (name, time.time() - t0,
                                          "isError" if is_error else "ok")
        note("call " + LIFE["last"], stderr=False)
        return ok(mid, {"content": [{"type": "text", "text": text}],
                        "isError": is_error})

    return error(mid, -32601, f"method not found: {method}")


def lifetime():
    """How long the server ran and what it was doing, for an exit line."""
    up = int(time.time() - STARTED)
    s = "up %dh%02dm%02ds, %d call(s) answered" % (up // 3600, up // 60 % 60,
                                                  up % 60, LIFE["calls"])
    if LIFE["last"]:
        s += ", last %s" % LIFE["last"]
    if LIFE["running"]:
        s += "; %s was running and gets no reply" % LIFE["running"]
    return s


def note(msg, stderr=True):
    """One line to stderr (never stdout: that is the protocol) and to the log.
    Neither may fail the server -- it is called on the way out, often because
    a pipe has just closed."""
    line = "cs-mcp[%d] %s" % (os.getpid(), msg)
    if stderr:
        try:
            sys.stderr.write(line + "\n")
            sys.stderr.flush()
        except Exception:
            pass
    if LOG_PATH:
        try:
            os.makedirs(os.path.dirname(LOG_PATH) or ".", exist_ok=True)
            with open(LOG_PATH, "a") as f:
                f.write(time.strftime("%Y-%m-%dT%H:%M:%SZ ", time.gmtime()) + line + "\n")
        except Exception:
            pass


def on_signal(signum, frame):
    note("received %s: exiting; %s" % (signal.Signals(signum).name, lifetime()))
    # SystemExit unwinds through subprocess.run, which kills a running cs on
    # the way out rather than leaving it searching for nobody.
    raise SystemExit(128 + signum)


def server_version():
    """The plugin version, so a rollup can tell two deployments apart."""
    try:
        with open(os.path.join(HERE, "..", ".claude-plugin", "plugin.json")) as f:
            return json.load(f).get("version", "0")
    except Exception:
        return "0"


def ok(mid, result):
    return {"jsonrpc": "2.0", "id": mid, "result": result}


def error(mid, code, message):
    return {"jsonrpc": "2.0", "id": mid, "error": {"code": code, "message": message}}


def main():
    if "--tools" in sys.argv[1:]:
        # For eyeballing the surface, and for verify-search: what a client
        # would see, without having to speak the protocol to find out.
        # Optional arguments are listed too: the argument NAMES differ between
        # sibling tools, and this is the one place to read them all at once.
        for spec in TOOLS:
            req = [a[0] for a in spec[3] if a[2]]
            opt = [a[0] for a in spec[3] if not a[2]]
            line = ", ".join(req) if req else "no required arguments"
            if opt:
                line += "; optional: " + ", ".join(opt)
            print(f"{spec[0]:<14} cs {spec[1]:<10} ({line})")
        return 0
    if "--self-check" in sys.argv[1:]:
        # Does the thing this server wraps actually work from HERE, with this
        # server's environment and cwd? That is a different question from
        # whether cs works in your shell, and it is the one that decides
        # whether every tool call is about to refuse.
        print("cs: %s" % CS)
        print("cs cwd: %s   (this process is in %s)" % (CS_CWD, os.getcwd()))
        print("log: %s" % (LOG_PATH or "off -- set CS_MCP_LOG=1 to record "
                           "start, calls and exit reason"))
        try:
            print(run_cs_plain("scopes"))
        except ToolError as e:
            print(str(e), file=sys.stderr)
            return 1
        return 0
    if "--install" in sys.argv[1:]:
        # The absolute path is the whole difficulty. CLAUDE_PLUGIN_ROOT is set
        # only inside a session, so the `$CLAUDE_PLUGIN_ROOT/scripts/…` form
        # used everywhere else expands to `/scripts/…` in the shell where you
        # actually run `claude mcp add` -- and an installed plugin lives under a
        # versioned cache directory nobody types from memory. So the path is
        # resolved by the thing that already knows it: this file.
        print("claude mcp add cs -- " + os.path.abspath(__file__))
        print()
        print("Add --scope user to enable it everywhere, or --scope project to")
        print("commit it for one repo. Remove it with: claude mcp remove cs")
        return 0
    if {"-h", "--help"} & set(sys.argv[1:]):
        print(__doc__)
        return 0

    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, on_signal)
    note("started: cs %s, python %s" % (server_version(), sys.version.split()[0]),
         stderr=False)

    # stdout belongs to the protocol and nothing else: a stray print here
    # corrupts the stream and the client sees the server as broken rather than
    # as noisy. Everything diagnostic goes to stderr.
    for raw in sys.stdin.buffer:
        line = raw.decode("utf-8", "replace").strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            sys.stderr.write("cs-mcp: ignoring unparseable line\n")
            continue
        # 2025-03-26 allowed a batch; 2025-06-18 removed it. Accepted either
        # way, since tolerating one costs three lines.
        batch = msg if isinstance(msg, list) else [msg]
        replies = [r for r in (handle(m) for m in batch) if r is not None]
        for reply in replies:
            sys.stdout.write(json.dumps(reply) + "\n")
        sys.stdout.flush()
    # The only way out of the loop: the client closed our stdin. That is how
    # a client ends a session, so this line is ordinary -- and when the client
    # says the server vanished, it is the line that says who closed what.
    note("stdin closed by the client: exiting; " + lifetime())
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        # The client stopped reading while a reply was being written.
        note("stdout closed by the client mid-reply: exiting; " + lifetime())
        # Point stdout at /dev/null so the interpreter's own flush at exit
        # does not print a second, louder complaint about the same pipe.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
    except Exception:
        note("exiting on an unhandled error; %s\n%s"
             % (lifetime(), traceback.format_exc().rstrip()))
        sys.exit(1)
