#!/usr/bin/env bash
# Materialize fixtures/repos/* as real git repos so the fleet and ticket
# workflows can be exercised end to end. See fixtures/README.md.
#
# Each fixture becomes a bare "origin" plus a working clone, so fetch, reset,
# worktree, and branch operations all behave like the real thing.
#
# History is replayed rather than squashed into one commit: for every incident
# in fixtures/incidents/ the buggy state is committed first (with the ticket ID
# in the message), then unrelated commits, then the fix. This gives skills like
# postmortem real archaeology to do -- `git log -L` lands on a genuine
# introducing commit rather than on an import.
#
# Usage: build-fixtures [target-dir] [--incidents-dir DIR] [--no-toolchain]
#        (target defaults to ./fixture-fleet; incidents are optional)
#
# --no-toolchain  replace the JDK 21 toolchain requests (checkout-service-kotlin's
#                 jvmToolchain(21), pricing-lib-java's languageVersion) with a
#                 plain JVM-target setting, committed on main, so a Kotlin or Java
#                 language-server question reaches Serena on a machine without
#                 JDK 21 (#103). Committed because cs reads a fleet repo at its
#                 committed main, not its working tree.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
src="$repo_root/fixtures/repos"
# Incidents are optional and live outside this repo: the fixture repos here are
# for testing search, while seeded incidents belong to whoever is testing a
# workflow on top of them (postmortem, review, triage). Pass --incidents-dir to
# layer a set in.
incidents_dir="${INCIDENTS_DIR:-$repo_root/fixtures/incidents}"
target=""
no_toolchain=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-toolchain) no_toolchain=1; shift ;;
    --incidents-dir) incidents_dir="${2:-}"; shift 2 ;;
    --incidents-dir=*) incidents_dir="${1#*=}"; shift ;;
    -h|--help) sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *) target="$1"; shift ;;
  esac
done
target="${target:-$PWD/fixture-fleet}"

BASE_DATE="2026-01-12T09:03:00"
BASE_AUTHOR="Priya Raman <priya.raman@acme.example>"

[[ -d "$src" ]] || die "fixture sources not found: $src"
[[ -e "$target" ]] && die "target already exists: $target (remove it first)"

# git commit with a fixed identity and timestamp, so history is reproducible.
commit_as() {
  local dir="$1" author="$2" date="$3" msg_file="$4"
  local name="${author%% <*}" email="${author#*<}"; email="${email%>}"
  GIT_AUTHOR_NAME="$name" GIT_AUTHOR_EMAIL="$email" GIT_AUTHOR_DATE="$date" \
  GIT_COMMITTER_NAME="$name" GIT_COMMITTER_EMAIL="$email" GIT_COMMITTER_DATE="$date" \
    git -C "$dir" commit --quiet --allow-empty -F "$msg_file"
}

# Append a line to a changelog and commit it, so the introducing commit is not
# adjacent to the fix in `git log`.
#
# A noise commit can also carry a real code change, when the incident sets
# NOISE_n_PRE to a directory of pre-change files. Those files are laid down at
# the import commit; here the canonical version comes back, so the commit is an
# actual diff. That exists for the cross-repo trigger in PROJ-388: a commit
# whose subject claims a serializer change but whose diff is one changelog line
# cannot be investigated, and the investigation is the whole exercise.
noise_commit() {
  local work="$1" author="$2" date="$3" text="$4" pre_dir="${5:-}" canonical="${6:-}"
  if [[ -n "$pre_dir" ]]; then
    while IFS= read -r rel; do
      rel="${rel#./}"
      mkdir -p "$(dirname "$work/$rel")"
      cp "$canonical/$rel" "$work/$rel"
    done < <(cd "$pre_dir" && find . -type f)
  fi
  mkdir -p "$work/docs"
  printf -- '- %s\n' "$text" >> "$work/docs/CHANGELOG.md"
  git -C "$work" add -A
  local tmp; tmp=$(mktemp)
  printf '%s\n' "$text" > "$tmp"
  commit_as "$work" "$author" "$date" "$tmp"
  rm -f "$tmp"
}

# Directories of pre-change files a repo's incidents want present at the import
# commit. Collected before the import because the incident env is not sourced
# until after it. Two kinds:
#
#   NOISE_n_PRE      the state before a noise commit that carries a real change
#   PRE_INTRODUCED   the state before the introducing commit -- i.e. before the
#                    feature the defect rode in on existed at all
#
# PRE_INTRODUCED is what makes `git log -L` honest. Without it the import
# carries the canonical (fixed) tree, so the introducing commit reads as a
# revert of code nobody had written yet, and archaeology lands on a commit that
# appears to delete a working implementation for no reason.
import_state_dirs_for() {
  local repo="$1" inc n pre
  while IFS= read -r inc; do
    [[ -n "$inc" ]] || continue
    (
      # shellcheck disable=SC1091
      source "${inc}incident.env"
      [[ -n "${PRE_INTRODUCED:-}" ]] && printf '%s\n' "${inc}${PRE_INTRODUCED}"
      for n in 1 2; do
        pre="NOISE_${n}_PRE"
        [[ -n "${!pre:-}" ]] && printf '%s\n' "${inc}${!pre}"
      done
      true
    )
  done < <(incidents_for "$repo")
}

incidents_for() {
  local repo="$1" d
  [[ -d "$incidents_dir" ]] || return 0
  for d in "$incidents_dir"/*/; do
    [[ -f "${d}incident.env" ]] || continue
    if grep -q "^REPO=${repo}$" "${d}incident.env"; then printf '%s\n' "$d"; fi
  done | sort
}

# A toolchain request asks Gradle for a JDK of exactly that version, and cs
# refuses a Kotlin repo whose request no installed JDK satisfies. A build pinned
# by its JVM target alone needs no JDK: the same edit verify-engines makes for
# its Kotlin probe.
strip_toolchain() {  # <work-clone>
  local work="$1" f changed=0
  for f in "$work/build.gradle.kts" "$work"/*/build.gradle.kts; do
    [[ -f "$f" ]] || continue
    if grep -q 'jvmToolchain(21)' "$f"; then
      sed -i.bak 's/jvmToolchain(21)/compilerOptions { jvmTarget.set(org.jetbrains.kotlin.gradle.dsl.JvmTarget.JVM_21) }/' "$f"
      changed=1
    fi
    if grep -q 'JavaLanguageVersion.of(21)' "$f"; then
      perl -0pi.bak -e 's/toolchain \{\s*languageVersion = JavaLanguageVersion\.of\(21\)\s*\}/sourceCompatibility = JavaVersion.VERSION_21\n    targetCompatibility = JavaVersion.VERSION_21/' "$f"
      changed=1
    fi
    rm -f "$f.bak"
  done
  [[ $changed -eq 1 ]] || return 0
  git -C "$work" add -A
  local msg; msg=$(mktemp)
  printf 'Pin the JVM target instead of requesting a JDK 21 toolchain\n\n(build-fixtures --no-toolchain)\n' > "$msg"
  commit_as "$work" "$BASE_AUTHOR" "$BASE_DATE" "$msg"
  rm -f "$msg"
  git -C "$work" push --quiet origin main
}

mkdir -p "$target/.origins"
info "${C_BOLD}building fixture fleet${C_OFF} → $target"

for dir in "$src"/*/; do
  name=$(basename "$dir")
  origin="$target/.origins/$name.git"
  work="$target/$name"

  git init --quiet --bare --initial-branch=main "$origin"

  tmp=$(mktemp -d)
  git -C "$tmp" init --quiet --initial-branch=main

  # 1. The project as it was imported: the canonical tree, with any files an
  #    incident declares a pre-change state for rolled back to it.
  cp -R "$dir." "$tmp/"
  while IFS= read -r pre; do
    [[ -n "$pre" ]] || continue
    cp -R "$pre/." "$tmp/"
  done < <(import_state_dirs_for "$name")
  git -C "$tmp" add -A
  msg=$(mktemp); printf 'Import %s\n' "$name" > "$msg"
  commit_as "$tmp" "$BASE_AUTHOR" "$BASE_DATE" "$msg"

  n_inc=0
  while IFS= read -r inc; do
    [[ -n "$inc" ]] || continue
    n_inc=$((n_inc + 1))
    # shellcheck disable=SC1091
    source "${inc}incident.env"

    # 2. Regress the touched files to their buggy state.
    cp -R "${inc}before/." "$tmp/"
    git -C "$tmp" add -A
    commit_as "$tmp" "$INTRODUCED_AUTHOR" "$INTRODUCED_DATE" "${inc}introduced.msg"

    # 3. Unrelated work lands on top, so archaeology is not a one-step walk.
    noise_commit "$tmp" "$BASE_AUTHOR" "$NOISE_DATE_1" "$NOISE_1" \
                 "${NOISE_1_PRE:+${inc}${NOISE_1_PRE}}" "$dir"
    noise_commit "$tmp" "$BASE_AUTHOR" "$NOISE_DATE_2" "$NOISE_2" \
                 "${NOISE_2_PRE:+${inc}${NOISE_2_PRE}}" "$dir"

    # 4. The fix restores exactly the files this incident touched.
    (cd "${inc}before" && find . -type f) | while IFS= read -r rel; do
      rel="${rel#./}"
      if [[ -f "$dir/$rel" ]]; then
        mkdir -p "$(dirname "$tmp/$rel")"
        cp "$dir/$rel" "$tmp/$rel"
      else
        rm -f "$tmp/$rel"   # file did not exist before the fix introduced it
      fi
    done
    git -C "$tmp" add -A
    commit_as "$tmp" "$FIX_AUTHOR" "$FIX_DATE" "${inc}fix.msg"

    unset REPO TICKET INTRODUCED_DATE INTRODUCED_AUTHOR FIX_DATE FIX_AUTHOR \
          NOISE_1 NOISE_2 NOISE_DATE_1 NOISE_DATE_2 NOISE_1_PRE NOISE_2_PRE \
          PRE_INTRODUCED
  done < <(incidents_for "$name")

  # Guard: the tip must match the canonical tree, or the fixture lies.
  if ! diff -r -q --exclude=.git --exclude=docs "$dir" "$tmp" >/dev/null 2>&1; then
    err "$name: replayed history does not end at the canonical tree"
    diff -r -q --exclude=.git --exclude=docs "$dir" "$tmp" | head -5 >&2
    exit 1
  fi

  git -C "$tmp" remote add origin "$origin"
  git -C "$tmp" push --quiet origin main
  rm -rf "$tmp" "$msg"

  git clone --quiet "$origin" "$work"
  git -C "$work" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main
  [[ $no_toolchain -eq 1 ]] && strip_toolchain "$work"
  if [[ $n_inc -gt 0 ]]; then
    ok "$name ($n_inc incident(s), $(git -C "$work" rev-list --count HEAD) commits)"
  else
    ok "$name ($(git -C "$work" rev-list --count HEAD) commits)"
  fi
done

info ""
info "Fixture fleet ready. To exercise the workflow against it:"
info ""
info "  export FLEET_ROOT=$target"
info "  export TICKETS_ROOT=$target/../fixture-tickets"
info ""
info "then ask the ticket-workspace skill (fleet-workspace plugin, repo-fleet) to"
info "refresh the fleet and open a ticket on inventory-api-dotnet and"
info "checkout-service-kotlin. refresh-fleet and new-ticket moved out of this repo;"
info "they live in the plugin cache under a versioned path, so let the skill resolve"
info "them via \$CLAUDE_PLUGIN_ROOT rather than guessing one."
info ""
info "Seams to search for are in fixtures/GROUND-TRUTH.md."
info "Seeded incidents for postmortem practice are in fixtures/INCIDENTS.md."
