#!/usr/bin/env bash
# cs -- one code-search interface over several engines.
#
# Why a facade: measured across nine fixture queries (fixtures/BASELINE.md), no
# single engine won more than two, and each failed where another succeeded.
# ripgrep cannot see a route assembled from two C# attributes; a symbol graph
# cannot see a string literal in argument position; only an LSP resolves an
# interface to its implementation. Picking one engine means accepting its blind
# spot permanently.
#
# Subcommands are shaped like QUESTIONS, not like tools, so the caller does not
# need to know which engine answers what -- and so the routing can change
# without every caller changing. Output is normalized to
#
#     repo/path:line: text
#
# which keeps results compact (raw tokensave JSON measured ~7x the equivalent
# ripgrep output) and lets any answer be scored by scripts/score-seams.
#
# Every answer is labelled with HOW it was obtained -- resolved, structural,
# textual, declared, or heuristic -- because on a real codebase the difference
# decides whether you can act on it. A resolved reference is a fact; a textual
# match is an occurrence; and no static answer here can see reflection, string
# concatenation, or generated code. `cs why <kind>` spells out the blind spots.
#
# Usage:
#   cs text   <pattern>            literal or regex, every repo
#   cs seam   <string>             cross-repo seam: which repos share this string
#   cs uses   <string>             like seam, but code only -- comments excluded
#   cs def    <symbol> [repo]      where a symbol is defined (optionally one repo)
#   cs provides <coordinate>       which repo publishes a package coordinate
#   cs deps   [repo]               fleet dependency edges, from build manifests
#   cs versions [coordinate]       which version each repo pins, and where they disagree
#   cs owns   [repo|repo/path]     who CODEOWNERS names for this, across the fleet
#   cs publishes                   what each repo publishes
#   cs calls  <pattern> [lang]     structural: call shapes, literal arguments
#   cs impls  <symbol> <repo>      implementations of an interface (LSP)
#   cs callers <symbol> <repo>     what calls this symbol (graph)
#   cs callees <symbol> <repo>     what this symbol calls (graph)
#   cs impact <symbol> <repo>      what depends on it, transitively (graph)
#   cs refs   <symbol> <repo> <file>   references to a symbol (LSP)
#   cs constructs <Type> [repo]    every construction site, across the shapes a
#                                  type can be built by (graph-free, ast-grep)
#   cs fields <field|Type::field> [repo]  every read and write site of a field,
#                                  split by kind -- the API-impact question
#                                  (graph)
#   cs gaps   <query>              what matches ORG-WIDE that the fleet does not
#                                  hold -- the bound on a fleet-scoped negative
#                                  (needs a forge CLI and network)
#   cs strictness [repo]           which repos REJECT unknown fields on
#                                  deserialization -- the other half of an
#                                  API-impact review (declared)
#   cs values <KEY> [repo]         which repos SET a config key and with what
#                                  literals, and which repos READ it -- the
#                                  same split cs fields makes, across a repo
#                                  boundary, where a value MISMATCH hides
#   cs resilience [repo]           what each repo does on a non-2xx: reads the
#                                  error body, discards it, or discards it and
#                                  retries -- who can even OBSERVE an error
#                                  contract (declared)
#   cs history <string> [repo]     when a seam entered or left history (git -S)
#   cs repos                       what is in the current view, and from where
#   cs scopes                      which workspaces exist to be searched, by path
#   cs which                       decision table: which subcommand answers what
#   cs why    [kind]               what each kind of answer cannot see
#   cs engines                     which engines are available here
#   cs doctor                      check this machine against this fleet: what
#                                  will not work, what it costs, and the fix
#   cs changes [version]           what changed in cs: the latest releases, or
#                                  everything since <version> -- small fixes too
#
#   --fleet          ignore the ticket workspace, search the fleet only
#   --ticket=<path>  search a workspace layered over the fleet: the absolute
#                    path of the workspace or of any directory inside one, under
#                    TICKETS_ROOT or WORKSPACE_ROOTS. A bare folder name works
#                    when it is unique (--ticket=<id>).
#   --why            print the blind spots of this answer's kind
#   --quiet          suppress the provenance line (stdout is unaffected either way)
#   --all            no result cap for this query
#   --engine=<name>  force one engine and fail rather than fall back
#                    (--engine=tokensave makes cs def read a per-repo graph
#                    instead of the fleet-wide ctags index)
#   --refresh        rebuild the cached symbol index instead of reusing it
#   --porcelain      one JSON object on stdout instead of result lines
#                    (CS_JSON=1 does the same; stderr is unaffected)
#   --field=<name>   cs constructs only: mark each construction site present or
#                    ABSENT for this field. ABSENT sites inherit its default,
#                    which is where a default change is observable.
#   --count          per-repo tallies instead of the results, on the four verbs
#                    where a distribution is the question.
#                    cs fields: write/read SITE tallies -- the same quantity the
#                    listing reports, so the two modes agree. Survives the output
#                    truncation that makes a fleet-wide listing impossible, which
#                    is why the blast-radius question has an answer in this mode.
#                    Where the output WAS truncated, distinct sites cannot be
#                    derived and the row says it is counting references instead.
#                    cs text / seam / uses: per-repo HIT tallies and no hit
#                    bodies, for a caller that pays per hit and does not yet know
#                    where to look. Same pipeline as the listing, so --word,
#                    --source-only and the prose filter all still apply and the
#                    numbers are the ones the listing would have shown.
#   --source-only    exclude data, doc and generated files (.csv .json .txt .tsv
#                    .lock .log .rst .md .svg .map .min.js .min.css) from a text
#                    answer. OFF by default: a route in an
#                    appsettings.json is a real seam. The composition of every
#                    answer is reported either way. Draws the line at data vs
#                    source, never test vs production -- a test file is often
#                    the most informative hit for an impact question.
#   --full-lines     print each hit line whole. By default a line's text is cut
#                    to CS_MAX_LINE bytes (400) around the match, and the cut is
#                    named: one generated SVG line can be 62 KB.
#   --word, -w       match whole identifiers only, not substrings of longer
#                    ones. Off by default: it would drop `reserve` inside
#                    `reserveItem`, a real use. cs reports the distinction
#                    either way, and cs seam's orphan warning always uses it.
#
# Environment:
#   CS_MAX_RESULTS   result cap, default 200 (0 = unlimited)
#   CS_MAX_LINE      bytes of text kept per hit line, default 400 (0 = whole)
#   WORKSPACE_ROOTS  more workspace roots, colon-separated, beside TICKETS_ROOT
#   CS_TIMEOUT       per-engine timeout in seconds, default 120 (0 = none)
#   CS_TAGS_TTL      how long `cs def` reuses its symbol index, default 60s
#   CS_EXCLUDE_EXTRA directories to skip, in addition to the built-in list
#   CS_EXCLUDE_REMOVE directories to STOP skipping, e.g. "bin vendor" when a
#                    repo keeps hand-written source there (`cs engines` prints
#                    the effective list)
#   CS_NO_GRAPH      repos kept without a tokensave graph on purpose, space-
#                    separated (usually in fleet.env): cs doctor names them
#                    rather than flagging them, and a graph refusal says why
#   CS_CTAGS_BIN     use exactly this universal-ctags, and treat ctags as absent
#                    if it does not validate (cs def then falls back to a
#                    tokensave graph, or refuses)
#   CS_LOG           OFF by default. 1 logs query OUTCOMES as JSONL to
#                    ~/.cache/cs-queries.jsonl; any other value is the path to
#                    write. One appended line per query, for refusal rate and
#                    answer-kind mix over a longer window than a transcript.
#   CS_LOG_QUERY     what to record of the query STRING, independently of the
#                    rest: hash (default, repeat queries stay countable),
#                    omit (no query column), plain (the literal text)
#
# Exit codes:
#   0  the query ran and found at least one hit
#   1  REFUSAL -- the query did not run (no fleet root, a missing required
#      dependency, an unknown workspace, unparseable arguments). Nothing was
#      searched, so nothing was ruled out.
#   2  the query ran honestly and found nothing.
#   3  cs doctor only: the check ran and flagged something to fix.
#
# 1 and 2 are opposite facts and used to be the same number, which left the
# distinction available only as prose on stderr -- so `if cs uses "$x"; then …`
# reported "unused" for a typo'd FLEET_ROOT, the exact false negative the whole
# design is organised against. Branch on the code, not on the message.
#
# A BROKEN engine refuses too, and that is the point of the distinction: an
# engine that is installed and failing (ripgrep exiting 2, an uncompilable
# regex, a crashing deps.py) produces no output, which is indistinguishable
# from an honest zero until its exit status is read. Every engine's status is
# checked, so 2 means the search actually ran.
#
# --porcelain / CS_JSON=1 puts the same facts on stdout as one JSON object:
#   {"cs":1,"subcommand":…,"query":…,"scope":…,"view":…,"exit":…,"refused":…,
#    "reason":…,"kind":…,"engine":…,"note":…,"hits":…,"repos":…,"degraded":…,
#    "partial":…,"truncated":…,"returned":…,"engine_errors":[…],"hints":[…],
#    "results":[…]}
# `hits` is how many exist and `returned` how many are in `results`; comparing
# them is how a caller sees a cap without reading a stderr warning. `view` is
# the `searching:` provenance line, and `scope` the workspace id (or "fleet")
# it resolved to -- so a caller can assert it got the scope it asked for.
#
# Requires: python3 (uses, provides, deps, publishes, versions, owns, impls,
# refs, callers, callees, impact). Everything else is optional -- `cs engines`
# reports what is present, and cs routes around what is not.
#
# The three symbol-mode subcommands are the exception to "routes around what is
# not": they read a tokensave graph and nothing else here answers a call graph,
# so without it they refuse rather than degrade.
set -uo pipefail
# Before anything else runs, so the measured duration is the whole invocation
# rather than whatever is left after setup. EPOCHREALTIME is bash 5; the
# fallbacks are in cs_log_ms below, and the resolution actually achieved is
# recorded next to the number rather than assumed.
CS_T0="${EPOCHREALTIME:-}"
# The GNU-date route needs its baseline taken the same way it will be read.
# BSD date prints a literal "N" for %N, which is not digits and is discarded
# here rather than turned into a nonsense duration later.
CS_T0_NS=$(date +%s%N 2>/dev/null)
case "$CS_T0_NS" in *[!0-9]*|'') CS_T0_NS="" ;; esac
source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"

lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/lib" && pwd)"
root="${FLEET_ROOT:-$PWD}"

# ---- exit codes ------------------------------------------------------------
# Three outcomes, three codes. A refusal ("this search did not happen") and a
# zero-hit answer ("this search happened and the answer is no") are opposite
# facts, and both used to exit 1 -- so the tool's central promise existed only
# as prose on stderr, which a script discards and an agent skips under context
# pressure. `die()` in common.sh already exits REFUSED; the zero-hit sites
# return NO_HITS.
#
# 1 stays the refusal so that anything already checking "did this fail" keeps
# working; 2 is the newly distinguishable case.
# Set when an ENGINE returned a knowingly incomplete answer -- distinct from a
# timeout or an unreadable file, and folded into the same PARTIAL flag.
CS_SOURCE_PARTIAL=0
CS_EXIT_REFUSED=1
CS_EXIT_NO_HITS=2

# ---- machine-readable output -----------------------------------------------
# The exit code above split "did not run" from "ran and found nothing", but
# everything else a caller needs to weigh an answer was still prose on stderr:
# the answer KIND, and the four warnings the skill instructs an agent to pass on
# rather than swallow (PARTIAL, `showing N of M`, `degraded:`, `prose filtered
# except:`). All are load-bearing and all are easy to discard.
#
# --porcelain (or CS_JSON=1) puts one JSON object on stdout instead of the
# result lines, carrying the metadata alongside the hits -- including on a
# refusal, which is the case a caller most needs to detect and the one with no
# result stream to attach anything to.
#
# stderr is untouched: the human diagnostics stay exactly where they were, so
# --porcelain composes with --quiet rather than replacing it.
porcelain=0
CS_RESULTS=""      # what would have gone to stdout
CS_HINTS=""        # the "nothing found — try:" suggestions
CS_REFUSAL=""      # the message from die(), if we refused
CS_HITS=""; CS_REPOS=""; CS_SUB=""; CS_QUERY=""

# JSON string escaping, in bash rather than through python3, so that porcelain
# works everywhere cs does -- `cs text` and `cs seam` run without python3, and a
# refusal for a MISSING python3 obviously cannot format itself with it.
# Raw UTF-8 is legal inside a JSON string, so only the structural characters and
# the control characters that can actually occur here are escaped.
json_str() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\n'/\\n}"
  printf '"%s"' "$s"
}
# A number, or `null` when the value is unknown -- never an empty string, which
# would make `hits` unreadable without a type check on the far side.
#
# Leading zeros are stripped, not passed through. JSON forbids them, so `00`
# was all-digits by this function's own test and still not a number: it emitted
# `"line":00` and took the entire envelope down with it. A helper whose whole
# job is "emit something that parses as a number" has to hold for every
# all-digit string, not for the ones that happen to be canonical.
json_num() {
  case "${1:-}" in
    ''|*[!0-9]*) printf 'null'; return ;;
  esac
  local n="$1"
  while [[ ${#n} -gt 1 && "$n" == 0* ]]; do n="${n#0}"; done
  printf '%s' "$n"
}

# Result lines are `repo/path:line: text` for every search subcommand, so they
# are split into fields rather than handed over as strings a caller would have
# to re-parse with the regex this tool already applied. A line that does not
# match that shape (cs deps, cs versions, cs owns, cs history) is carried whole
# under "text", which keeps one array type across every subcommand.
json_results() {
  local first=1 line repo path lineno text
  printf '['
  # `|| [[ -n "$line" ]]`: read returns non-zero on a final line with no
  # trailing newline, and dropping it silently cost exactly one hit per query.
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    [[ $first -eq 1 ]] || printf ','
    first=0
    # `[^:]+` for the path, not `.+`: a greedy `.+` binds `:([0-9]+):` to the
    # LAST `:digits:` on the line, so any hit whose TEXT carries one (an ISO
    # timestamp, `host:8080:`) was split at the wrong colon -- path swallowing
    # the real line number, and `line` taking digits out of the text. Anchoring
    # to the first `:digits:` after the repo is right for every path without a
    # colon, and a path containing one is already ambiguous in `path:line:text`.
    if [[ "$line" =~ ^([^/]+)/([^:]+):([0-9]+):\ ?(.*)$ ]]; then
      repo="${BASH_REMATCH[1]}"; path="${BASH_REMATCH[2]}"
      lineno="${BASH_REMATCH[3]}"; text="${BASH_REMATCH[4]}"
      # json_num, not the bare capture: a leading zero (`:00:`) is a valid bash
      # match but not valid JSON, and one of those made the WHOLE envelope
      # unparseable. Degrade a bad line number to null, never to a syntax error.
      printf '{"repo":%s,"path":%s,"line":%s,"text":%s}' \
        "$(json_str "$repo")" "$(json_str "$path")" "$(json_num "$lineno")" "$(json_str "$text")"
    else
      printf '{"repo":null,"path":null,"line":null,"text":%s}' "$(json_str "$line")"
    fi
  done
  printf ']'
}

json_lines() {  # a plain array of strings, for hints and engine errors
  local first=1 line
  printf '['
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    [[ $first -eq 1 ]] || printf ','
    first=0
    printf '%s' "$(json_str "$line")"
  done
  printf ']'
}

# Refuse to answer rather than answer "nothing found" from an empty or missing
# fleet. A negative result is the answer that makes a breaking change look safe,
# so it is the one that must never be manufactured by a configuration mistake.
# Before this guard, a fleet root that did not exist produced a `cd` error on
# stderr and then a perfectly formatted "no code uses X · 0 hit(s) · 0 repo(s)".
#
# Applied per-subcommand rather than at load, because the guard used to fire for
# `cs which`, `cs why` and `cs engines` too -- so the three commands that exist
# to explain the tool and diagnose the setup were unavailable to exactly the
# person whose setup was not finished. `cs engines` refusing to run until the
# fleet is configured is backwards: reporting the root is half its job.
require_fleet() {
  if [[ ! -d "$root" ]]; then
    die "fleet root does not exist: $root
  set FLEET_ROOT, or run: fleet-init --config --fleet-root <dir> --tickets-root <dir>
  (cs which, cs why and cs engines work without one)"
  fi
  if ! compgen -G "$root/*/.git" >/dev/null; then
    die "no repositories in the fleet root: $root
  clone some first: fleet-init --clone <owner/repo> ...
  (searching an empty fleet would report 'nothing found' for every query)"
  fi
}

# python3 is NOT an optional engine. The engines below degrade to each other and
# `cs engines` reports which are missing; python3 is different, because half the
# subcommands pipe THROUGH it -- `uses` through filter_code.py, the manifest
# readers through deps.py, `owns` through owners.py, the LSP pair through
# serena_call.py. Without it the pipe fails and the
# stage produces nothing, which every one of those subcommands then reports as
# a perfectly formatted zero-hit answer, still labelled "prose filtered". That
# is the same manufactured negative the fleet-root guards above exist to
# prevent, arriving by a different route, so it is checked the same way: at the
# top, once, by dying rather than answering.
have_python3() { python3 -c 'import sys' >/dev/null 2>&1; }
require_python3() {  # require_python3 <subcommand> <what it is needed for>
  have_python3 && return 0
  local why
  if command -v python3 >/dev/null 2>&1; then
    why="python3 is on PATH but failed to run"
  else
    why="python3 is not on PATH"
  fi
  die "cs $1 needs python3, and $why
  it is needed for: $2
  without it this command would report zero hits rather than fail, and a
  manufactured negative is the one answer that must never be produced
  alternative: cs seam '<string>' answers without python3, but counts comments too"
}

# ---- layered view ----------------------------------------------------------
# Work happens in a ticket workspace holding only the repos being changed, but
# the questions that matter are fleet-wide: "who calls this endpoint" must see
# the eight repos NOT in the ticket, or renaming a route looks safe when it is
# not. Searching only the ticket misses callers; searching only the fleet shows
# stale copies of what you are editing. Both answers are wrong.
#
# So a view is assembled: a directory of symlinks where ticket repos point at
# the workspace (your branch state) and every other repo points at the fleet
# (main). One root, correct contents. Engines need explicit flags to follow
# symlinks, which is why each is passed one below.
view="$root"
view_tmp=""
ticket_root="${TICKET_ROOT:-}"
# The raw --ticket=<id>, kept unresolved until build_view so that a bad one can
# be reported as "no such workspace" rather than quietly becoming a fleet search.
ticket_id=""
layer_note=""
# The provenance line, as DATA. layer_note drives the `searching:` line on
# stderr and is deliberately empty when nothing is layered, because a human
# standing in a directory does not need to be told which directory. A caller
# reading the envelope has no such context -- it did not choose the working
# directory and cannot see it -- so these two are always populated, even for an
# unlayered fleet search. CS_SCOPE is the machine-checkable half: a caller that
# asked for a named workspace can assert it got that workspace rather than main.
CS_VIEW=""
CS_SCOPE=""

# How many repos the fleet root holds. build_view counts these as a side effect
# on the layered path; the other two paths need the same number and had nothing
# to say about the size of what they searched.
count_fleet_repos() {
  local d n=0
  for d in "$root"/*/; do
    [[ -d "$d" ]] && is_repo "${d%/}" && n=$((n + 1))
  done
  printf '%s' "$n"
}

# common.sh's die() is the single refusal path, and porcelain needs the reason
# it carried -- a refusal is the outcome a caller most needs to detect, and the
# one with no result stream to attach anything to. Redefined rather than edited
# in common.sh, because the other fleet scripts have no envelope to fill in.
# stderr keeps the human message either way.
die() { CS_REFUSAL="$*"; err "$*"; exit "$CS_EXIT_REFUSED"; }

# One JSON object on stdout, emitted from the EXIT trap so that it is produced
# on every path -- including die(), which does not come back. Verified that a
# command-substitution subshell does not run this trap, so the envelope cannot
# leak into a captured value.
cs_emit_porcelain() {
  local rc="$1"
  [[ $porcelain -eq 1 ]] || return 0
  local refused=false
  [[ "$rc" -eq "$CS_EXIT_REFUSED" ]] && refused=true
  # PARTIAL covers every way a result can be a subset of the truth: an engine
  # that ran out of time, files it could not read, and an engine that truncated
  # its own output (cs fields -- tokensave cuts stdout at 15000 characters).
  # reads_failed, not files_skipped: a dangling symlink committed to the repo is
  # a corpus property and is reported in "corpus_skipped" below, where it does
  # not devalue every negative the fleet produces.
  local partial=false
  { timed_out || reads_failed || [[ "${CS_SOURCE_PARTIAL:-0}" -eq 1 ]]; } && partial=true
  printf '{'
  printf '"cs":1,'
  printf '"subcommand":%s,' "$(json_str "$CS_SUB")"
  printf '"query":%s,'      "$(json_str "$CS_QUERY")"
  # WHAT was searched, next to what was asked. A result whose scope is invisible
  # is the failure this layering exists to prevent, and stdout is the only
  # channel a non-human caller reads -- the `searching:` line it would otherwise
  # have to reconstruct is on stderr.
  printf '"scope":%s,'      "$(json_str "$CS_SCOPE")"
  printf '"view":%s,'       "$(json_str "$CS_VIEW")"
  printf '"exit":%s,'       "$rc"
  printf '"refused":%s,'    "$refused"
  if [[ -n "$CS_REFUSAL" ]]; then
    printf '"reason":%s,' "$(json_str "$CS_REFUSAL")"
  else
    printf '"reason":null,'
  fi
  if [[ -n "$CS_KIND" ]]; then
    printf '"kind":%s,'   "$(json_str "$CS_KIND")"
    printf '"engine":%s,' "$(json_str "$CS_ENGINE")"
  else
    printf '"kind":null,"engine":null,'
  fi
  if [[ -n "$CS_NOTE" ]]; then printf '"note":%s,' "$(json_str "$CS_NOTE")"
  else printf '"note":null,'; fi
  printf '"hits":%s,'  "$(json_num "$CS_HITS")"
  printf '"repos":%s,' "$(json_num "$CS_REPOS")"
  if [[ -n "$CS_DEGRADED" ]]; then printf '"degraded":%s,' "$(json_str "$CS_DEGRADED")"
  else printf '"degraded":null,'; fi
  printf '"partial":%s,' "$partial"
  # "hits" is how many exist; "returned" is how many are in the array below.
  # A caller comparing the two learns whether it is holding the whole answer --
  # which is the question the `showing N of M` warning answers for a human.
  if [[ -n "$CS_TRUNCATED" ]]; then printf '"truncated":true,'
  else printf '"truncated":false,'; fi
  printf '"returned":%s,' "$(printf '%s' "$CS_RESULTS" | grep -c '[^[:space:]]')"
  # What the line cap removed, so a machine caller knows a hit's text is not
  # the whole line -- the same reason "truncated" exists for the hit count.
  printf '"bytes":%s,' "$(json_num "$CS_OUT_BYTES")"
  if [[ "$CS_ELIDED_LINES" -gt 0 ]]; then
    printf '"elided":{"lines":%s,"bytes":%s,"max_line":%s},' \
      "$(json_num "$CS_ELIDED_LINES")" "$(json_num "$CS_ELIDED_BYTES")" "$(json_num "$CS_MAX_LINE")"
  else
    printf '"elided":null,'
  fi
  # Answer-level notices that change what the answer is worth and would
  # otherwise live only on stderr, which a machine caller never sees -- a
  # manifest that was present and not read, for one.
  printf '"notes":%s,' "$(printf '%s' "$CS_NOTES" | json_lines)"
  printf '"engine_errors":%s,' "$(engine_error_lines | json_lines)"
  # Two fields, because they carry different advice. "skipped" is retryable and
  # is what sets "partial"; "corpus_skipped" is deterministic and does not.
  printf '"skipped":%s,'        "$(skipped_unreadable | json_lines)"
  printf '"corpus_skipped":%s,' "$(skipped_dangling  | json_lines)"
  if [[ -n "$CS_EXCLUSION_NOTE" ]]; then
    printf '"exclusions":%s,' "$(json_str "$CS_EXCLUSION_NOTE")"
  else
    printf '"exclusions":null,'
  fi
  printf '"hints":%s,'         "$(printf '%s' "$CS_HINTS"   | json_lines)"
  printf '"results":%s'        "$(printf '%s' "$CS_RESULTS" | json_results)"
  printf '}\n'
}

# ---- query log -------------------------------------------------------------
# One appended JSONL line per invocation, recording the OUTCOME of a query
# rather than the fact of one. Usage is the weaker half: a client that calls cs
# over MCP already records what it called and when. What nothing else can see
# is what the engines did -- and two of this tool's load-bearing claims are
# only claims until someone measures them:
#
#   1. every answer is labelled with HOW it was obtained
#   2. it fails closed, refusing rather than reporting a broken engine's empty
#      output as a clean negative
#
# (2) has a failure mode in the other direction that is invisible from inside:
# a tool that refuses too often teaches its callers to route around it. Two
# committed broken symlinks in one repo once made EVERY zero-hit query refuse,
# so no negative result was obtainable at all, and that was caught only because
# somebody happened to be evaluating at the time. As a refusal rate it would
# have been a step change on a graph.
#
# OPT-IN, and off by default. In a private fleet the query string IS the
# proprietary part -- internal route names, queue names, config keys, symbol
# names -- and a file quietly accumulating every internal identifier a company
# searched for is a thing some users cannot have on disk at any price.
#
#   CS_LOG           unset/0/false/no -> off. 1/true/yes -> the default path
#                    below. Anything else is taken as the path to write.
#   CS_LOG_QUERY     hash (default) | omit | plain
#
# The query text is controlled SEPARATELY from the rest, because outcome,
# kind, engine, hit count and latency are the analytically valuable fields and
# none of them are sensitive. Defaulting to a hash keeps repeat queries
# countable -- "the same search ran 40 times this week" is a real signal --
# without ever writing the identifier down. `plain` is there for a fleet that
# wants it; `omit` for one that wants no query column at all.
#
# JSONL rather than SQLite, deliberately. The callers here are agent sessions
# and several run at once; the one logging component in this family that used
# SQLite failed exactly that way, with an 18-case suite passing clean because
# every case was a single session against a seeded file. An O_APPEND write of
# one short line has no locking, no schema migration and nothing to be locked
# out of, and it stays greppable for a userbase that already lives in rg.
CS_LOG_PATH=""
CS_LOG_QUERY="${CS_LOG_QUERY:-hash}"
case "${CS_LOG:-}" in
  ''|0|false|no|off) CS_LOG_PATH="" ;;
  1|true|yes|on)     CS_LOG_PATH="${XDG_CACHE_HOME:-$HOME/.cache}/cs-queries.jsonl" ;;
  *)                 CS_LOG_PATH="$CS_LOG" ;;
esac

# Only the subcommands that ASK THE CODE something. cs which/why/engines/scopes
# explain the tool and cs repos describes the view; none of them can hit, miss
# or refuse, so counting them would dilute every rate this log exists to
# measure -- most of all the refusal rate, which is the headline number.
cs_log_applies() {
  case "$1" in
    text|seam|uses|def|provides|deps|publishes|versions|owns|calls|impls|refs|history) return 0 ;;
    callers|callees|impact) return 0 ;;
    *) return 1 ;;
  esac
}

# Elapsed milliseconds, and the resolution actually achieved. Four routes,
# because none of them is everywhere: EPOCHREALTIME is bash 5 (macOS ships
# 3.2), date +%s%N is GNU (BSD date prints a literal N), and perl is common but
# not a dependency this tool is willing to acquire. SECONDS is the floor and is
# always right, just coarse -- so the resolution is REPORTED rather than left
# for an analyst to infer from suspiciously round numbers. A latency graph
# built on second-granularity data without knowing it is worse than no graph.
cs_log_ms() {  # -> "<ms> <resolution>"
  local now
  if [[ -n "$CS_T0" && -n "${EPOCHREALTIME:-}" ]]; then
    now="$EPOCHREALTIME"
    # "1755440000.123456" in both, subtracted as integer microseconds so no
    # floating point (and no bc) is involved.
    local a="${CS_T0/./}" b="${now/./}"
    printf '%s ms' "$(( (10#${b:0:16} - 10#${a:0:16}) / 1000 ))"
    return 0
  fi
  if [[ -n "${CS_T0_NS:-}" ]]; then
    now=$(date +%s%N 2>/dev/null)
    case "$now" in
      *[!0-9]*|'') ;;
      *) printf '%s ms' "$(( (now - CS_T0_NS) / 1000000 ))"; return 0 ;;
    esac
  fi
  printf '%s s' "$(( SECONDS * 1000 ))"
}

# Hoisted out of cs_log_write: a function that redefines a function on every
# call is a surprise waiting for whoever reads the trap next.
cs_log_add_warn() {
  if [[ -n "$CS_LOG_WARNS" ]]; then CS_LOG_WARNS="$CS_LOG_WARNS,\"$1\""
  else CS_LOG_WARNS="\"$1\""; fi
}
CS_LOG_WARNS=""

# A refusal is only actionable if you know WHICH refusal. The messages are free
# text carrying paths and query strings, so they are not logged; they are
# classified into a small closed set instead, which is both safe to write down
# and what a rate is actually computed over.
cs_log_refusal_class() {
  case "$CS_REFUSAL" in
    *"fleet root does not exist"*)        printf 'no-fleet-root' ;;
    *"no repositories in the fleet root"*) printf 'empty-fleet' ;;
    *"needs python3"*)                    printf 'no-python3' ;;
    *"no such workspace"*|*"TICKETS_ROOT is not set"*) printf 'no-workspace' ;;
    # The two symbol-mode refusals, classified before the generic engine rule
    # below -- both messages mention an engine and would otherwise be counted as
    # one failing, which is a different thing from a graph that was never built
    # and from a name the graph does not hold. Those two are the numbers worth
    # watching here: one is a setup gap, the other is callers asking about
    # symbols that are not in the index.
    *"no tokensave graph"*|*"needs tokensave"*|*"has no graph"*) printf 'no-graph' ;;
    *"is not a node this graph"*|*"is not a type in"*) printf 'symbol-unresolved' ;;
    *"an engine failed"*|*"engine"*)      printf 'engine-failed' ;;
    *"unknown"*|*"usage"*|*"needs a"*)    printf 'bad-args' ;;
    '')                                   printf 'none' ;;
    *)                                    printf 'other' ;;
  esac
}

# The same fallback chain as view_fingerprint, and for the same reason: a weak
# hash is a perfectly good IDENTITY for "was this the same query as last time",
# which is the only thing it is asked to be. It is not a security boundary --
# a short internal identifier does not survive a dictionary attack by anyone
# who already has the fleet -- and the README says so rather than implying that
# hashing makes the query unrecoverable.
cs_log_hash() {
  local h out
  for h in "md5 -q" "md5sum" "shasum -a 1" "cksum"; do
    out=$(printf '%s' "$1" | $h 2>/dev/null | head -1 | awk '{print $1}')
    [[ -n "$out" ]] && { printf '%s' "${out:0:12}"; return 0; }
  done
  printf 'nohash'
}

cs_log_version() {
  local f="$(dirname "${BASH_SOURCE[0]}")/../.claude-plugin/plugin.json"
  [[ -f "$f" ]] || { printf 'unknown'; return 0; }
  # sed rather than python3: half the subcommands run without python3, and a
  # log line that only appears when python3 is installed would skew every rate
  # in it towards the machines that have it.
  sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -1
}

# Resolved once rather than per line -- it is a file read and a sed, and the
# answer cannot change within one invocation. Skipped entirely when logging is
# off, so a disabled log costs nothing at all.
CS_LOG_VERSION=""
[[ -n "$CS_LOG_PATH" ]] && CS_LOG_VERSION=$(cs_log_version)

cs_log_write() {  # cs_log_write <exit-code>
  local rc="$1"
  [[ -n "$CS_LOG_PATH" ]] || return 0
  cs_log_applies "$CS_SUB" || return 0

  local outcome
  case "$rc" in
    "$CS_EXIT_REFUSED") outcome=refused ;;
    "$CS_EXIT_NO_HITS") outcome=zero ;;
    0)                  outcome=hits ;;
    *)                  outcome=other ;;
  esac

  # Codes, not sentences. The sentences carry paths and identifiers and would
  # put back exactly what CS_LOG_QUERY exists to keep out.
  CS_LOG_WARNS=""
  timed_out       && cs_log_add_warn timeout
  reads_failed    && cs_log_add_warn skipped-files
  corpus_skipped  && cs_log_add_warn corpus-skips
  engine_failed && cs_log_add_warn engine-error
  [[ -n "$CS_DEGRADED" ]]       && cs_log_add_warn degraded
  [[ -n "$CS_TRUNCATED" ]]      && cs_log_add_warn truncated
  [[ -n "$CS_EXCLUSION_NOTE" ]] && cs_log_add_warn exclusions

  local q
  case "$CS_LOG_QUERY" in
    omit)  q='null' ;;
    plain) q="$(json_str "${CS_QUERY:0:200}")" ;;      # bounded: see the write below
    *)     q="$(json_str "h:$(cs_log_hash "$CS_QUERY")")" ;;
  esac

  # The ticket workspace id is an internal identifier like any other, and the
  # questions this log answers are all about outcome, kind and engine -- none of
  # which need to know WHICH ticket. So the SHAPE of the view is recorded and
  # the name is not.
  local layer=fleet
  [[ -n "$CS_SCOPE" && "$CS_SCOPE" != "fleet" ]] && layer=ticket+fleet

  local ms_pair ms res
  ms_pair=$(cs_log_ms); ms="${ms_pair%% *}"; res="${ms_pair##* }"

  local partial=false
  { timed_out || reads_failed; } && partial=true

  local line
  line=$(printf '{"ts":%s,"v":%s,"sub":%s,"query":%s,"layer":%s,"kind":%s,"engine":%s,"outcome":%s,"refusal":%s,"hits":%s,"repos":%s,"ms":%s,"ms_res":%s,"partial":%s,"warnings":[%s]}' \
    "$(json_str "$(date -u +%Y-%m-%dT%H:%M:%SZ)")" \
    "$(json_str "$CS_LOG_VERSION")" \
    "$(json_str "$CS_SUB")" \
    "$q" \
    "$(json_str "$layer")" \
    "$([[ -n "$CS_KIND" ]] && json_str "$CS_KIND" || printf 'null')" \
    "$([[ -n "$CS_ENGINE" ]] && json_str "$CS_ENGINE" || printf 'null')" \
    "$(json_str "$outcome")" \
    "$(json_str "$(cs_log_refusal_class)")" \
    "$(json_num "$CS_HITS")" \
    "$(json_num "$CS_REPOS")" \
    "$ms" "$(json_str "$res")" "$partial" "$CS_LOG_WARNS")

  # One printf, one O_APPEND write, one line -- which is what makes concurrent
  # sessions safe without a lock. Every field above is bounded (the query is
  # capped at 200 chars, warnings are a closed set of codes), so the line
  # cannot grow past the size at which a single write may be split.
  local dir="${CS_LOG_PATH%/*}"
  [[ "$dir" != "$CS_LOG_PATH" && ! -d "$dir" ]] && mkdir -p "$dir" 2>/dev/null
  if ! printf '%s\n' "$line" >> "$CS_LOG_PATH" 2>/dev/null; then
    # Said out loud, once. Believing you are collecting data and silently not
    # is the same shape of mistake as a manufactured negative: you find out
    # when you go to answer a question and the window is empty.
    warn "CS_LOG is set but the log could not be written: $CS_LOG_PATH"
  fi
  return 0
}

cleanup_view() {
  [[ -n "$view_tmp" && -d "$view_tmp" ]] && rm -rf "$view_tmp"
  [[ -n "${CS_TIMEOUT_FLAG:-}" ]] && rm -f "$CS_TIMEOUT_FLAG"
  # A half-built symbol index, if ctags was interrupted. Named per-process, so
  # this only ever removes our own.
  rm -f "${TMPDIR:-/tmp}"/cs-tags-*."$$".building 2>/dev/null
  # Same reasoning for the language server's raw response and its diagnostics:
  # the paths that refuse on a malformed answer exit through die(), which does
  # not come back to a rm.
  rm -f "${TMPDIR:-/tmp}"/cs-serena."$$".* "${TMPDIR:-/tmp}"/cs-serena-err."$$".* 2>/dev/null
  [[ -n "${CS_ENGINE_ERR_FLAG:-}" ]] && rm -f "$CS_ENGINE_ERR_FLAG"
  [[ -n "${CS_SKIPPED_FLAG:-}" ]] && rm -f "$CS_SKIPPED_FLAG"
  rm -f "${TMPDIR:-/tmp}"/cs-engerr."$$".* "${TMPDIR:-/tmp}"/cs-uses."$$".* 2>/dev/null
  rm -f "${TMPDIR:-/tmp}"/cs-tags-nokey."$$".tags 2>/dev/null
  return 0
}
# $? is captured first: the porcelain envelope reports the real exit status, and
# anything run before reading it would overwrite it.
cs_on_exit() {
  local rc=$?
  cs_emit_porcelain "$rc"
  # After the envelope, so a bug in logging can never cost a caller its answer,
  # and before cleanup, so it still sees the timeout/skipped flag files. The
  # trap is also the only place that runs on EVERY path -- including die(),
  # which does not come back, and which is precisely the refusal this log
  # exists to count.
  cs_log_write "$rc"
  cleanup_view
  return 0
}
# INT and TERM as well as EXIT: bash does not run an EXIT trap for an
# uncaught signal, and being ^C'd mid-index is the likeliest way to leak one.
trap cs_on_exit EXIT INT TERM

# ---- workspace roots, and a scope as a path -------------------------------
# A workspace used to be reachable only as TICKETS_ROOT/<id>/: one root, one
# level deep, looked up by folder name. Real layouts do not fit that shape --
# workspaces grouped by kind (_tickets/on-call/<id>/, _tickets/_done/<id>/), or
# kept under a second root (_reviews/<id>/) -- and three failures came with the
# name lookup, measured on one query where the branch had 21 hits and main 23:
#
#   - run from inside a real workspace while TICKETS_ROOT pointed elsewhere:
#     main's 23, no `searching:` line, identical to a deliberate --fleet run;
#   - run from inside _tickets/on-call/<id>/<repo>/: `on-call` taken as the
#     workspace, "holds no repos", answered from main;
#   - a workspace folder `lims-v2` cloned from the fleet's `lims`: both searched,
#     44 hits from one repo, counted as two.
#
# So a scope is a PATH, validated as a subtree of a configured root:
#
#   WORKSPACE_ROOTS  colon-separated allowed roots; TICKETS_ROOT is one more.
#
# The workspace is resolved from the path the same way whether it was passed
# (--ticket=/abs/path, MCP scope) or detected from $PWD: inside a git repo it is
# that repo's PARENT (worktrees included, so an agent can pass its own cwd from
# any depth); otherwise the nearest directory at or above the path, still inside
# the root, that holds a repo. A bare id still works, looked up under each root.

real_path_of() {  # <path> -> the physical path of an existing directory
  local d="$1"
  [[ -d "$d" ]] || d=$(dirname -- "$d")
  (cd -P -- "$d" 2>/dev/null && pwd -P)
}

# The configured roots, physical paths, one per line, existing ones only.
workspace_roots() {
  local r seen=":" rp
  local IFS=:
  for r in ${WORKSPACE_ROOTS:-} ${TICKETS_ROOT:-}; do
    [[ -n "$r" && -d "$r" ]] || continue
    rp=$(real_path_of "$r") || continue
    case "$seen" in *":$rp:"*) continue ;; esac
    seen="$seen$rp:"
    printf '%s\n' "$rp"
  done
}

# For messages: every configured root, as configured, whether or not it exists.
workspace_roots_named() {
  local out="" r
  local IFS=:
  for r in ${WORKSPACE_ROOTS:-} ${TICKETS_ROOT:-}; do
    [[ -n "$r" ]] || continue
    case ":$out:" in *":$r:"*) continue ;; esac
    out="${out:+$out:}$r"
  done
  printf '%s' "${out:-(none configured)}"
}

under() {  # <path> <dir> -> true when path is dir or inside it
  [[ "$1" == "$2" || "$1" == "$2"/* ]]
}

holds_repo() {  # <dir>
  local w
  for w in "$1"/*/; do
    [[ -d "$w" ]] && is_repo "${w%/}" && return 0
  done
  return 1
}

# The root (from workspace_roots) a physical path lies under, or nothing.
root_of() {  # <physical path>
  local r
  while IFS= read -r r; do
    under "$1" "$r" && { printf '%s' "$r"; return 0; }
  done < <(workspace_roots)
  return 1
}

# The git work tree holding <dir>, superproject first so a submodule resolves to
# the repo a person cloned.
git_toplevel_of() {  # <physical dir>
  have git || return 1
  local top sup
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || return 1
  [[ -n "$top" ]] || return 1
  sup=$(git -C "$1" rev-parse --show-superproject-working-tree 2>/dev/null || true)
  [[ -n "$sup" ]] && top="$sup"
  real_path_of "$top"
}

# <physical path> <root> -> the workspace it belongs to, or 1.
workspace_of() {
  local p="$1" r="$2" top d
  if top=$(git_toplevel_of "$p") && under "$top" "$r" && [[ "$top" != "$r" ]]; then
    d=$(dirname -- "$top")
  else
    d="$p"
  fi
  while under "$d" "$r" && [[ "$d" != "$r" ]]; do
    holds_repo "$d" && { printf '%s' "$d"; return 0; }
    d=$(dirname -- "$d")
  done
  return 1
}

# Every workspace under the roots: a directory whose immediate children include
# a repo, at any depth. Grouping folders hold workspaces, not repos, so they are
# never listed -- and a repo is never descended into.
#
# A workspace's NON-repo children are still descended into. Stopping at the
# first directory holding a repo took a grouping folder with one stray clone in
# it (_old/ beside 26 archived workspaces) to BE a workspace, and every
# workspace inside it vanished from cs scopes and from bare-id lookup -- while
# its path still resolved, because workspace_of walks up from the repo. Both
# levels are listed; cs scopes flags the outer one as mixed.
discover_workspaces() {  # -> "<root>\t<workspace>" per line
  local r c
  while IFS= read -r r; do
    for c in "$r"/*/; do
      [[ -d "$c" ]] || continue
      c="${c%/}"
      is_repo "$c" && continue
      _walk_workspaces "$r" "$c" 1
    done
  done < <(workspace_roots)
}
_walk_workspaces() {  # <root> <dir> <depth>
  local c ws=0 x skip
  holds_repo "$2" && { printf '%s\t%s\n' "$1" "$2"; ws=1; }
  [[ "$3" -lt 5 ]] || return 0
  for c in "$2"/*/; do
    [[ -d "$c" ]] || continue
    c="${c%/}"
    is_repo "$c" && continue
    # Inside a workspace, not into a venv/ or node_modules/ beside its repos:
    # four levels of site-packages is thousands of directories per lookup.
    if [[ $ws -eq 1 ]]; then
      skip=0
      for x in ${CS_EXCLUDE_DIRS[@]+"${CS_EXCLUDE_DIRS[@]}"}; do
        [[ "${c##*/}" == "$x" ]] && { skip=1; break; }
      done
      [[ $skip -eq 1 ]] && continue
    fi
    _walk_workspaces "$1" "$c" $(( $3 + 1 ))
  done
}

detect_ticket() {
  [[ -n "$ticket_root" ]] && return 0
  local here_p r ws top
  here_p=$(pwd -P 2>/dev/null) || return 1
  if r=$(root_of "$here_p"); then
    ws=$(workspace_of "$here_p" "$r") && { ticket_root="$ws"; return 0; }
    [[ "$here_p" == "$r" ]] || warn "you are in $here_p, under the workspace root $r, but neither it nor a directory above it holds a repo — answering from the fleet (main) only"
    return 1
  fi
  # Outside every root. Silent when that is the fleet itself; otherwise, if the
  # caller is standing in a repo, they are almost certainly working in it, and
  # answering from main without a word is the failure this exists to stop.
  # Not for the subcommands that explain the tool: they search nothing.
  case "${sub:-}" in which|why|engines|doctor|changes|scopes|-h|--help|help) return 1 ;; esac
  if top=$(git_toplevel_of "$here_p"); then
    local froot; froot=$(real_path_of "$root" 2>/dev/null || true)
    if [[ -z "$froot" ]] || ! under "$top" "$froot"; then
      warn "you are in $(basename "$top") at $top, which is not in a workspace root, so it is not searched — answering from the fleet (main)
  workspace roots: $(workspace_roots_named)   (set WORKSPACE_ROOTS to add one)"
    fi
  fi
  return 1
}

# Resolve an explicit --ticket=<id|path>. Asking for a workspace and being given
# the fleet instead is the inverse of the mistake this whole layering exists to
# prevent: the caller wanted THEIR branch state and silently got main, with no
# `searching:` line to reveal it. So an explicit request that cannot be honoured
# is fatal, while auto-detection from $PWD stays best-effort.
resolve_explicit_ticket() {
  [[ -n "$ticket_id" ]] || return 0
  local roots_named; roots_named=$(workspace_roots_named)
  [[ -n "$(workspace_roots)" ]] || die \
"--ticket=$ticket_id was requested but no workspace root exists
  TICKETS_ROOT is ${TICKETS_ROOT:-unset}; WORKSPACE_ROOTS is ${WORKSPACE_ROOTS:-unset}
  there is nowhere to look for the workspace, and searching the fleet instead
  would answer from main while you asked for your branch
  set WORKSPACE_ROOTS (colon-separated) or TICKETS_ROOT"

  if [[ "$ticket_id" == /* ]]; then
    local p r froot ws
    p=$(real_path_of "$ticket_id") && [[ -e "$ticket_id" ]] || die \
"--ticket=$ticket_id: no such directory
  searching the fleet instead would answer from main while you asked for your branch"
    froot=$(real_path_of "$root" 2>/dev/null || true)
    if [[ -n "$froot" ]] && under "$p" "$froot"; then
      die "--ticket=$ticket_id is inside the fleet root ($froot), not a workspace
  the fleet is searched on every query already; a workspace is your branch state
  layered over it. Pass --fleet to search the fleet alone.
  workspace roots: $roots_named"
    fi
    r=$(root_of "$p") || die \
"--ticket=$ticket_id is not inside a workspace root, so it is refused
  a scope must be a workspace under one of: $roots_named
  (set WORKSPACE_ROOTS, colon-separated, to allow another)"
    ws=$(workspace_of "$p" "$r") || die \
"--ticket=$ticket_id holds no repos, and neither does any directory above it in $r
  a workspace is a directory whose immediate children are git repos (clones or
  worktrees); a grouping folder holds workspaces, not repos
  cs scopes   lists the workspaces under every root, by path"
    ticket_root="$ws"
    return 0
  fi

  # A bare id: a direct child of a root, or a discovered workspace by that name.
  local r matches="" n=0 w
  while IFS= read -r r; do
    if [[ -d "$r/$ticket_id" ]]; then
      matches="$matches$(real_path_of "$r/$ticket_id")"$'\n'; n=$((n + 1))
    fi
  done < <(workspace_roots)
  if [[ $n -eq 0 ]]; then
    while IFS=$'\t' read -r r w; do
      [[ "$(basename "$w")" == "$ticket_id" ]] || continue
      matches="$matches$w"$'\n'; n=$((n + 1))
    done < <(discover_workspaces)
  fi
  [[ $n -gt 0 ]] || die \
"--ticket=$ticket_id was requested but no such workspace under any root
  searching the fleet instead would answer from main while you asked for your branch
  TICKETS_ROOT is ${TICKETS_ROOT:-unset}; workspace roots: $roots_named
  cs scopes   lists the workspaces there, by path
  use --fleet if you meant to search the fleet only"
  [[ $n -eq 1 ]] || die \
"--ticket=$ticket_id names $n workspaces, so it is ambiguous:
$(printf '%s' "$matches" | sed 's/^/  /')
  pass the path instead: --ticket=<one of the above>"
  ticket_root="${matches%$'\n'}"
  holds_repo "$ticket_root" || die \
"--ticket=$ticket_id ($ticket_root) holds no repos
  a workspace is a directory whose immediate children are git repos; this one
  layers nothing, so the answer would come from the fleet (main) alone
  cs scopes   lists the workspaces under every root, by path
  use --fleet if you meant to search the fleet only"
}

# A workspace repo whose folder name is no fleet repo's, cloned from one that
# is: the fleet's `lims` checked out as `lims-v2`. Layering by name searched
# both, and an answer counted one repo twice with the branch and main mixed. It
# is the same repo, so the workspace copy SHADOWS the fleet copy, as any other
# workspace repo does -- and that is said, because the names differ.
origin_key() {  # <repo dir> -> host/owner/repo, lowercased, or nothing
  local u
  u=$(git -C "$1" config --get remote.origin.url 2>/dev/null) || return 1
  [[ -n "$u" ]] || return 1
  u="${u%/}"; u="${u%.git}"
  u=$(printf '%s' "$u" | sed -E 's#^[a-zA-Z+]+://##; s#^[^@/]*@##; s#:([^0-9/])#/\1#; s#:[0-9]+/#/#')
  printf '%s' "$u" | tr 'A-Z' 'a-z'
}

build_view() {
  if [[ $fleet_only -eq 1 ]]; then
    layer_note="fleet only ($(count_fleet_repos) repo(s), main)"
    CS_VIEW="$layer_note"; CS_SCOPE="fleet"
    return
  fi
  resolve_explicit_ticket
  # No workspace to layer. Nothing is printed for this case -- see layer_note
  # above -- but the envelope still has to say what was searched.
  if ! detect_ticket || [[ ! -d "$ticket_root" ]]; then
    CS_VIEW="fleet ($(count_fleet_repos) repo(s), main) — no ticket workspace layered"
    CS_SCOPE="fleet"
    return 0
  fi

  view_tmp=$(mktemp -d)
  view="$view_tmp"
  local n_ticket=0 n_fleet=0 d name unmatched=()
  for d in "$ticket_root"/*/; do
    [[ -d "$d" ]] || continue
    is_repo "${d%/}" || continue
    name=$(basename "$d")
    ln -s "${d%/}" "$view/$name" && n_ticket=$((n_ticket + 1))
    [[ -d "$root/$name" ]] && is_repo "$root/$name" || unmatched+=("${d%/}")
  done
  # Reached only on auto-detection now: an explicit scope that holds no repos is
  # refused above. Still said out loud, because it is not what was asked for.
  if [[ $n_ticket -eq 0 ]]; then
    warn "ticket workspace $ticket_root holds no repos — answering from the fleet (main) only"
  fi
  # Fleet repos a renamed workspace repo stands in for, matched by origin.
  local shadowed=":" u key fd
  if [[ ${#unmatched[@]} -gt 0 ]]; then
    local fleet_keys=""
    for fd in "$root"/*/; do
      [[ -d "$fd" ]] && is_repo "${fd%/}" || continue
      key=$(origin_key "${fd%/}") || continue
      fleet_keys="$fleet_keys$key"$'\t'"$(basename "$fd")"$'\n'
    done
    for u in "${unmatched[@]}"; do
      key=$(origin_key "$u") || continue
      name=$(printf '%s' "$fleet_keys" | awk -F'\t' -v k="$key" '$1 == k { print $2; exit }')
      [[ -n "$name" ]] || continue
      shadowed="$shadowed$name:"
      warn "$(basename "$u") is the fleet's $name under another name (same origin), so it stands in for $name — $name from the fleet is not searched"
    done
  fi
  for d in "$root"/*/; do
    [[ -d "$d" ]] || continue
    is_repo "${d%/}" || continue
    name=$(basename "$d")
    [[ -e "$view/$name" ]] && continue
    case "$shadowed" in *":$name:"*) continue ;; esac
    ln -s "${d%/}" "$view/$name" && n_fleet=$((n_fleet + 1))
  done
  # The PATH, not the folder name: two roots can hold the same id, a grouping
  # folder can hold a workspace, and only the path says which one this was.
  layer_note="$ticket_root ($n_ticket repo(s), your branch) + fleet ($n_fleet repo(s), main)"
  CS_VIEW="$layer_note"; CS_SCOPE="$ticket_root"
}

announce_view() {
  [[ -n "$layer_note" ]] && info "${C_BOLD}searching:${C_OFF} $layer_note"
}

# Real repo directories, for engines that cannot follow symlinks.
real_dirs() {
  local d name
  if [[ -n "$view_tmp" ]]; then
    for d in "$view"/*; do [[ -e "$d" ]] && readlink "$d"; done
  else
    for d in "$root"/*/; do [[ -d "$d" ]] && is_repo "${d%/}" && echo "${d%/}"; done
  fi
}

# The repositories in the current view, by NAME -- the is_repo-filtered set the
# rest of the tool already calls "the fleet" (real_dirs, non_repo_entries, the
# `searching:` count). The text and structural engines that walk the view search
# THESE by name rather than the view wholesale, and that closes two doors at
# once, because they are the same door:
#
#   - A loose file or a non-repo folder at the fleet root -- a README, the
#     refresh job's log, a scratch-notes/ directory -- is not searched. That is
#     what `cs repos` already tells the caller ("not repositories, so not
#     searched: ..."); before this, ripgrep and ast-grep searched them anyway
#     and grep searched the folders, so tool output such as update.log leaked
#     into fleet-wide text answers.
#   - Every hit line is therefore repo-prefixed. A file sitting DIRECTLY at the
#     fleet root produces `file:line:content` with no leading `repo/`, and the
#     repo attribution downstream is `cut -d/ -f1` -- so each such hit line
#     became its own "repo" and three hits in one root file reported as three
#     repos (the count that rides every textual answer as blast radius, and the
#     denominator cs seam's orphan warning keys on). No rootless line, no
#     miscount.
#
# Names, not absolute paths: the engines run with cwd=$view, so a bare name
# resolves through the view -- a symlink in a ticket workspace, a real directory
# in the fleet -- and the hit path stays the clean `repo/...` the pipeline (and
# normalize) expects, whichever layout produced it. semgrep already scopes to
# real_dirs for the same reason and needs nothing here.
view_repo_names() {
  local d
  for d in "$view"/*/; do
    [[ -d "$d" ]] || continue
    is_repo "${d%/}" || continue
    basename "${d%/}"
  done
}

have() { command -v "$1" >/dev/null 2>&1; }

# Evidence that an entry IS a repository, rather than merely that it exists.
#
# A fleet root grows housekeeping -- a README, an update-all.sh, an update.log,
# a folder of scratch notes -- and every enumeration site here used a different
# filter. `cs repos` used a bare glob and listed all of it, reporting 40 repos
# on a fleet of 37. That count is load-bearing: it is the denominator for
# `cs seam`'s orphan warning, and it is what the `searching:` line reports --
# the one instrument the skill explicitly tells an agent to read before trusting
# a layered answer.
#
# -e rather than -d: a git worktree's .git is a FILE holding a gitdir pointer,
# so a -d test would silently exclude every worktree, which is precisely the
# ticket-workspace layout this whole tool is built around. A plain directory of
# scratch files passes a -d test too; only the .git check rejects it.
is_repo() { [[ -e "$1/.git" ]]; }

# Entries in the fleet root that are not repositories, named rather than
# silently dropped -- the same reasoning as the `skipping:` line in cs engines.
# Every one is a place results cannot come from.
non_repo_entries() {
  local d
  for d in "$root"/*; do
    [[ -e "$d" ]] || continue
    is_repo "$d" && continue
    basename "$d"
  done
}

# Modification time in epoch seconds, or 0 if it cannot be determined.
#
# GNU and BSD `stat` share a name and almost nothing else. `-f` is "use this
# format" on BSD and "report on the FILESYSTEM" on GNU -- so `stat -f %m file`
# on Linux treats `%m` as a filename, fails with status 1, and *still writes a
# multi-line filesystem dump to STDOUT*. The obvious `stat -f %m || stat -c %Y`
# chain therefore captured both the dump and the epoch, and substituting that
# into $(( )) killed the command with "File: unbound variable".
#
# The consequence was not a crash anyone would notice, which is why it survived:
# only the CACHE-HIT path reads the mtime, so on Linux `cs def` worked the first
# time and then failed for the next 60 seconds. Hence: try each dialect, and
# accept the answer only if it is actually a number.
file_mtime() {
  local t
  for t in "$(stat -c %Y "$1" 2>/dev/null)" "$(stat -f %m "$1" 2>/dev/null)"; do
    case "$t" in
      ''|*[!0-9]*) ;;
      *) printf '%s\n' "$t"; return 0 ;;
    esac
  done
  printf '0\n'
}

# ---- what gets searched ----------------------------------------------------
# One exclusion list, shared by every text backend. This exists so that the
# answer does not depend on which engine happens to be installed: ripgrep and
# POSIX grep must see the SAME set of files, or a machine without ripgrep gets
# quietly different results from one with it. `verify-search` asserts that
# parity by running the scored queries through both backends and diffing.
#
# Two consequences worth stating, because both were parity bugs:
#   - ripgrep is run with --no-ignore. Respecting .gitignore would make results
#     depend on each repo's ignore file, which grep cannot read. Deterministic
#     beats clever; the list below covers the build output .gitignore would have
#     hidden anyway, and CS_EXCLUDE_EXTRA adds to it per site.
#   - ripgrep is run with --hidden. Without it, rg skips dotted paths, so
#     .github/, .circleci/ and .env are invisible to it and visible to grep.
#     Config keys and CI wiring live in exactly those files, and a config key
#     that a service reads but a chart no longer writes is a seam worth finding.
#
# The list is a guess about other people's repos, and some entries are wrong for
# some of them: `bin` and `build` are generated in most layouts and hand-written
# source in others, and a Go fleet keeps real dependencies in `vendor`. An
# excluded directory produces a silent false negative -- the hit simply is not
# there -- so removing an entry has to be as easy as adding one. It was not:
# CS_EXCLUDE_EXTRA only ever appended. CS_EXCLUDE_REMOVE subtracts.
CS_EXCLUDE_DIRS=(
  .git .origins .hg .svn
  node_modules bower_components vendor Pods DerivedData
  target build dist out bin obj .gradle .m2
  .venv venv __pycache__ .mypy_cache .pytest_cache .tox .ruff_cache
  .next .nuxt .parcel-cache .turbo coverage .nyc_output
  .terraform .serena .tokensave .idea .vscode-test
)
# shellcheck disable=SC2206
[[ -n "${CS_EXCLUDE_EXTRA:-}" ]] && CS_EXCLUDE_DIRS+=(${CS_EXCLUDE_EXTRA})
if [[ -n "${CS_EXCLUDE_REMOVE:-}" ]]; then
  # Separate statements, not `_keep=() _d _r _drop`: outside a function that is
  # an assignment followed by three COMMANDS, and bash 3.2 duly reported
  # "_d: command not found" before carrying on with an empty exclusion list.
  _keep=(); _d=""; _r=""; _drop=0
  for _d in "${CS_EXCLUDE_DIRS[@]}"; do
    _drop=0
    for _r in ${CS_EXCLUDE_REMOVE}; do [[ "$_d" == "$_r" ]] && { _drop=1; break; }; done
    [[ $_drop -eq 0 ]] && _keep+=("$_d")
  done
  # `${a[@]+"${a[@]}"}` rather than `"${a[@]}"`: stock macOS ships bash 3.2,
  # where expanding an EMPTY array under `set -u` is a fatal "unbound variable".
  # Removing every entry is a legitimate thing to ask for, and it must not turn
  # cs into a script that refuses to start.
  CS_EXCLUDE_DIRS=(${_keep[@]+"${_keep[@]}"})
  unset _keep _d _r _drop
fi
# The same list for ctags, which had none: `cs uses` skipped JDTLS's bin/ copy
# of a Kotlin file and `cs def` listed it as a second definition (#95), so two
# engines disagreed about one file. The list, not .gitignore, for the reason
# above: a copy in a bin/ that .gitignore does not cover is still a copy, and
# CS_EXCLUDE_REMOVE=bin brings a bin/ of real sources back for both.
CS_CTAGS_EXCLUDES=()
for _d in ${CS_EXCLUDE_DIRS[@]+"${CS_EXCLUDE_DIRS[@]}"}; do CS_CTAGS_EXCLUDES+=("--exclude=$_d"); done
unset _d

# A non-default exclusion list changes which files are searched, and nothing
# said so. The answer line was identical in shape either way -- only the hit
# count moved, and a reader has nothing to compare it against.
#
# `cs engines` already names the hazard ("a directory excluded by mistake looks
# exactly like a directory with no hits"), but only if you run `cs engines`, not
# when it matters. And the delivery mechanism makes it durable: set
# CS_EXCLUDE_EXTRA once in a shell profile for one investigation and every query
# in every later session is narrowed, with no per-query signal and no expiry.
# `app`, `src`, `lib`, `test` are all plausible one-off exclusions and
# disastrous left set -- excluding `app` hid an endpoint's own @router
# declaration while leaving its config mentions and tests, so the result was not
# merely smaller but inverted in character.
#
# The two directions carry opposite risk and are reported separately: EXTRA
# narrows and manufactures false negatives; REMOVE widens and merely adds noise.
CS_EXCLUSION_NOTE=""
if [[ -n "${CS_EXCLUDE_EXTRA:-}" ]]; then
  # sed, not tr: tr maps character-to-character and cannot expand one space
  # into " +", so `-bin vendor` came out unprefixed on the second entry.
  CS_EXCLUSION_NOTE="+$(printf '%s' "${CS_EXCLUDE_EXTRA}" | sed -e 's/^  *//' -e 's/  *$//' -e 's/  */ +/g') (CS_EXCLUDE_EXTRA)"
fi
if [[ -n "${CS_EXCLUDE_REMOVE:-}" ]]; then
  _rm="-$(printf '%s' "${CS_EXCLUDE_REMOVE}" | sed -e 's/^  *//' -e 's/  *$//' -e 's/  */ -/g') (CS_EXCLUDE_REMOVE)"
  if [[ -n "$CS_EXCLUSION_NOTE" ]]; then CS_EXCLUSION_NOTE="$CS_EXCLUSION_NOTE, $_rm"
  else CS_EXCLUSION_NOTE="$_rm"; fi
  unset _rm
fi

# `rg` may exist only as a shell function (Claude Code proxies its bundled
# ripgrep that way), which a script cannot call. Require a real binary, and
# fall back to POSIX grep so the facade works on a machine without ripgrep.
have_rg_binary() { [[ -x "$(command -v rg 2>/dev/null || true)" ]]; }

# Which text backend will actually run. CS_TEXT_ENGINE forces one, so the two
# can be compared against each other rather than trusted.
text_engine() {
  case "${CS_TEXT_ENGINE:-auto}" in
    rg|ripgrep) echo ripgrep ;;
    grep|posix)  echo grep ;;
    *) if have_rg_binary; then echo ripgrep; else echo grep; fi ;;
  esac
}

# Run an engine under a wall-clock limit. A language server or a fleet-wide
# structural scan can hang on a real repo, and a search tool that never returns
# is worse than one that says it gave up. macOS has no `timeout` unless GNU
# coreutils is installed, so its absence degrades to running unbounded.
timeout_bin() {
  local t
  for t in timeout gtimeout; do have "$t" && { echo "$t"; return 0; }; done
  return 1
}
# Engines run inside subshells and command substitutions, so a shell variable
# set here would be discarded before anything could report it -- a timeout would
# silently look like "no results", which is the single worst failure mode this
# tool can have. The flag is a file for that reason: it crosses process
# boundaries where a variable cannot.
# mktemp, portably. BSD's `-t PREFIX` treats the argument as a prefix and
# appends its own suffix, so it needs no X's; GNU's `-t TEMPLATE` requires at
# least three and FAILS without them. `mktemp -t "cs-engerr.$$"` therefore
# worked on macOS and returned an empty string on Linux -- which made
# `2>"$err_f"` an ambiguous redirect, so the search command never ran and
# grep_fleet produced no output at all. Every text query on Linux returned
# nothing, which is this tool's worst failure mode arriving through its own
# plumbing.
#
# The explicit-directory form is the one both accept. Named per-process so
# cleanup_view can sweep only our own.
cs_tmp() { mktemp "${TMPDIR:-/tmp}/$1.$$.XXXXXX"; }

CS_TIMEOUT_FLAG="$(cs_tmp cs-timeout)"
run_timed() {
  local tb secs="${CS_TIMEOUT:-120}"
  if [[ "$secs" != 0 ]] && tb=$(timeout_bin); then
    "$tb" "$secs" "$@"
    local rc=$?
    [[ $rc -eq 124 ]] && printf '%s\n' "${secs}s" >> "$CS_TIMEOUT_FLAG"
    return $rc
  fi
  "$@"
}
timed_out() { [[ -s "$CS_TIMEOUT_FLAG" ]]; }

# ---- engine failure --------------------------------------------------------
# A broken engine and an absent one are different problems with the same
# symptom, and only the absent one was handled. `cs engines` reports what is on
# PATH; it cannot report that ripgrep is on PATH and exiting 2 on every query,
# that ast-grep no longer understands its own pattern dialect, or that the regex
# the caller typed does not compile. Every one of those produced no output, and
# every one was then reported as `0 hit(s)` -- and since the exit code now
# separates a refusal from an honest zero, reporting it as an honest zero is a
# stronger lie than it used to be: a caller that correctly branches on 2 gets
# "this search happened and the answer is no" from a search that crashed.
#
# The three text/structural engines share one convention, which is what makes
# this detectable at all:
#
#   ripgrep, POSIX grep, ast-grep:  0 = matched, 1 = no match, >=2 = error
#   semgrep, git:                   0 = ran (match or not), non-zero = error
#
# A file rather than a variable, for the same reason as CS_TIMEOUT_FLAG: engines
# run inside command substitutions, and a variable set there is discarded before
# anything can report it.
CS_ENGINE_ERR_FLAG="$(cs_tmp cs-engine-err)"
engine_error()       { printf '%s\n' "$*" >> "$CS_ENGINE_ERR_FLAG"; }
engine_failed()      { [[ -s "$CS_ENGINE_ERR_FLAG" ]]; }
engine_error_lines() { sort -u "$CS_ENGINE_ERR_FLAG" 2>/dev/null; }

# ---- unreadable files are PARTIAL, not broken ------------------------------
# ripgrep overloads exit 2: from its own docs 0 = match, 1 = no match, 2 =
# error -- and that one code covers "bad regex", "binary missing", and "could
# not open one file out of 84,000". Only the first two are systemic. The third
# is per-file and routine on any real multi-repo checkout: committed symlinks
# whose targets do not exist on this machine, permission bits, files deleted
# mid-scan, dangling worktree links.
#
# Treating them alike meant one unreadable file anywhere in the fleet made
# every ZERO-HIT query refuse, while queries with hits answered normally. On a
# 37-repo fleet with two broken symlinks in someone else's repo, no negative
# result was obtainable at all -- and "is this dead?" is the question this tool
# is best at. 84,783 of 84,785 files had been searched to completion.
#
# So the two are separated by parsing the stderr cs was already capturing, and
# a per-file failure becomes PARTIAL -- the vocabulary timeouts already use and
# that the skill already tells agents to pass on rather than swallow.
CS_SKIPPED_FLAG="$(cs_tmp cs-skipped)"
note_skipped()  { printf '%s\n' "$1" >> "$CS_SKIPPED_FLAG"; }
files_skipped() { [[ -s "$CS_SKIPPED_FLAG" ]]; }
skipped_paths() { sed -e "s|^\./||" -e "s|^${view}/||" "$CS_SKIPPED_FLAG" 2>/dev/null | sort -u; }
skipped_count() { skipped_paths | grep -c ''; }

# ---- a corpus property is not a read failure -------------------------------
# PARTIAL is the line that tells a reader "your negative is weak, do not
# over-read it". It only works if it is rare. Measured 2026-08-27/28 on a
# 43-repo fleet, it appeared on 100% of answers, on every verb, naming the same
# two paths whether or not the query touched their repo -- two symlinks
# COMMITTED to one repo whose targets are not on any machine but their author's
# (one pointing at a sibling that was never committed, one into a home
# directory on another laptop). A warning that fires always is a warning that
# stops being read, and then the day it means an engine TIMED OUT is the day it
# is skipped.
#
# The two are not the same kind of thing, and the difference is testable:
#
#   engine timeout                     not deterministic, might differ on retry
#   unreadable: permission denied      not deterministic, might differ per user
#   dangling symlink in the repo       DETERMINISTIC -- rerunning changes nothing
#
# The third is a property of the CORPUS, like a directory that is excluded or a
# repo that was never cloned. It is disclosed -- silently narrowing the corpus
# is the failure #13 records -- but as a counted fact, not as PARTIAL, and the
# paths are listed once by `cs engines`, which is what owns fleet health, rather
# than reprinted on every answer.
#
# `-e` follows the link, so `-L && ! -e` is exactly "points at nothing". An
# intermediate component that is itself a symlink (the view's own repo links)
# resolves before the test, so this reads the FINAL component only.
is_dangling_link() { [[ -L "$view/$1" && ! -e "$view/$1" ]]; }

skipped_dangling() {
  local p
  while IFS= read -r p; do
    [[ -n "$p" ]] && is_dangling_link "$p" && printf '%s\n' "$p"
  done < <(skipped_paths)
}
# The retryable half: permission bits, a file deleted mid-scan, an I/O error.
# These are what PARTIAL now means.
skipped_unreadable() {
  local p
  while IFS= read -r p; do
    [[ -n "$p" ]] && ! is_dangling_link "$p" && printf '%s\n' "$p"
  done < <(skipped_paths)
}
reads_failed()    { [[ -n "$(skipped_unreadable)" ]]; }
corpus_skipped()  { [[ -n "$(skipped_dangling)" ]]; }
dangling_count()  { skipped_dangling | grep -c ''; }
unreadable_count(){ skipped_unreadable | grep -c ''; }

# A per-file read error, across the three spellings that occur in practice:
#   rg:    rg: ./path: No such file or directory (os error 2)
#   grep:  grep: path: Permission denied
#   ugrep: ugrep: warning: ./path: No such file or directory
# The trailing errno phrase is what makes this safe to match on. `rg: regex
# parse error:` and `ugrep: error: error at position 7` both fail it, so a
# systemic failure cannot be mistaken for a skipped file.
CS_PERFILE_RE='^[A-Za-z0-9_.+-]+: (warning: )?(.+): (No such file or directory|Permission denied|Is a directory|Not a directory|Too many levels of symbolic links|Operation not permitted|Input/output error|Device not configured|Bad file descriptor)( \(os error [0-9]+\))?$'

# classify_engine_stderr <stderr-file> -> 0 if every line was per-file, 1 if any
# line was systemic. Systemic lines are passed through to stderr, because an
# uncompilable regex is exactly the message the caller needs to see; per-file
# lines are collected and summarised once instead of printed by the hundred.
classify_engine_stderr() {
  local ef="$1" line systemic=0
  [[ -s "$ef" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    if [[ "$line" =~ $CS_PERFILE_RE ]]; then
      note_skipped "${BASH_REMATCH[2]}"
    else
      systemic=1
      printf '%s\n' "$line" >&2
    fi
  done < "$ef"
  return $systemic
}

# note_search_result <rc> <stderr-file> <engine> <what it was doing>
# For the 0/1/>=2 family (ripgrep, grep, ast-grep). An exit >=2 explained
# entirely by per-file errors is PARTIAL; anything else is a failure.
note_search_result() {
  local rc="${1:-0}" ef="$2" eng="$3" what="$4"
  # A timeout is its own category and run_timed has already flagged it. Filing
  # it as a generic engine failure too would bury the one word the caller is
  # told to look for -- PARTIAL -- under "an engine failed".
  if [[ "$rc" -eq 124 ]] && timed_out; then
    classify_engine_stderr "$ef" >/dev/null 2>&1 || true
    return 0
  fi
  if classify_engine_stderr "$ef"; then
    # Every message accounted for as a skipped file. An exit >=2 with NO
    # explanation at all is still a failure -- silence is not evidence of
    # health, and that is the case where the engine simply did not run.
    if [[ "$rc" -ge 2 ]] && ! files_skipped; then
      engine_error "$eng exited $rc while $what (no diagnostic)"
    fi
  else
    engine_error "$eng exited $rc while $what"
  fi
  return 0
}

# note_grep_status <rc> <engine> <what it was doing>
# For the 0/1/>=2 family. 1 is a real "no match" and must stay silent.
note_grep_status() {
  [[ "${1:-0}" -ge 2 ]] && engine_error "$2 exited $1 while $3"
  return 0
}
# note_run_status <rc> <engine> <what it was doing>
# For engines that report 0 whether or not they matched.
note_run_status() {
  [[ "${1:-0}" -ne 0 ]] && engine_error "$2 exited $1 while $3"
  return 0
}

# Called at every zero-hit branch, before the emptiness is reported as an
# answer. This is the structural-tier twin of serena_answered_or_die.
engines_ok_or_die() {  # <subcommand>
  # Only SYSTEMIC failures refuse. A per-file read error has already been
  # recorded as a skipped path, and a zero-hit result that skipped two dangling
  # symlinks is still an answer -- refusing there blocked every negative on the
  # whole fleet over two files that had nothing to do with the query.
  scan_unreadable_for_grep
  # A run that did not finish has not established a negative, so it refuses --
  # but it refuses in the PARTIAL vocabulary, which is the word the skill tells
  # an agent to look for and pass on.
  if timed_out; then
    die "cs $1: an engine hit the ${CS_TIMEOUT:-120}s timeout and found nothing — PARTIAL, not an answer
  the search did not finish, so nothing was ruled out; raise CS_TIMEOUT and rerun"
  fi
  engine_failed || return 0
  die "cs $1: an engine failed, so this empty result is not an answer
$(engine_error_lines | sed 's/^/  /')
  nothing here was searched to completion, and a zero-hit result from a broken
  engine is precisely the manufactured negative this tool exists to prevent
  check: cs doctor   (what is missing or broken here, and the fix)
  if you passed a regex, check it compiles: cs text needs a valid pattern"
}

# grep_fleet <regex|literal> <pattern>
#
# The mode is named rather than passed as a flag, because the two backends do
# NOT share a flag vocabulary and assuming they did was a real bug: `-E` means
# --extended-regexp to grep and --encoding to ripgrep, so every `cs text` query
# died with "unknown encoding" and reported "nothing found". It went unnoticed
# because the machine it was written on had no ripgrep binary, which is the
# whole argument for the parity check in verify-search.
grep_fleet() {
  local mode="$1" pattern="$2" engine
  engine=$(text_engine)
  # An empty array expanded under `set -u` is an error on bash 3.2, which is
  # what macOS ships, so the mode flag is always a single value rather than a
  # possibly-empty list.
  local extra="--regexp"
  # --word is opt-in rather than the default. Both backends spell it -w and both
  # agree on it (checked against the scored queries), but making it the DEFAULT
  # would drop `reserve` inside `reserveItem` -- a real use, silently lost. That
  # trades one false-negative class for another in a tool organised against
  # them, so the boundary information is computed and REPORTED instead, and the
  # flag is there for callers who want identifier-strict matching.
  local wordflag=()
  [[ $word_match -eq 1 ]] && wordflag=(-w)
  if [[ "$engine" == ripgrep ]]; then
    # ripgrep is a regex engine by default; -F restricts it to a literal.
    [[ "$mode" == literal ]] && extra="--fixed-strings"
  else
    case "$mode" in
      literal) extra="-F" ;;
      regex)   extra="-E" ;;
    esac
  fi
  # Captured rather than discarded (grep) or let through to the terminal (rg):
  # it is the only thing that separates "could not open one file" from "the
  # regex does not compile", and both arrive as exit 2.
  local rc=0 err_f
  err_f=$(cs_tmp cs-engerr)
  # Search the repositories in the view, by name, rather than the view itself:
  # loose files and non-repo folders at the fleet root are not repositories and
  # not searched, and every hit line stays repo-prefixed. See view_repo_names.
  local repo_targets=() name
  while IFS= read -r name; do repo_targets+=("$name"); done < <(view_repo_names)
  if [[ ${#repo_targets[@]} -eq 0 ]]; then
    # No repositories in view. An empty fleet is refused upstream before any
    # query runs, so this is a backstop: a degenerate view searches nothing
    # rather than letting a pathless `rg`/`grep .` fall back to the process cwd.
    rm -f "$err_f"
    return 1
  fi
  if [[ "$engine" == ripgrep ]]; then
    # --regexp is ripgrep's default, so pass a harmless flag instead of none.
    [[ "$extra" == "--regexp" ]] && extra="--no-config"
    local globs=() d
    for d in ${CS_EXCLUDE_DIRS[@]+"${CS_EXCLUDE_DIRS[@]}"}; do globs+=(--glob "!**/$d/**" --glob "!$d/**"); done
    # With cwd=$view the bare names resolve through the view; --follow makes rg
    # descend into a ticket workspace's repo symlinks, and --hidden still reaches
    # .github/ and .env INSIDE each named repo. Only the fleet root's own loose
    # files stop being reachable, which is the point.
    (cd "$view" && run_timed rg --follow --hidden --no-ignore \
        --no-heading --line-number --color=never \
        ${globs[@]+"${globs[@]}"} ${wordflag[@]+"${wordflag[@]}"} "$extra" -- "$pattern" \
        "${repo_targets[@]}") 2>"$err_f"
    rc=$?
    # 1 is "no match" and must stay silent; 2 is either an uncompilable regex
    # (systemic, refuse) or an unreadable file (per-file, PARTIAL).
    note_search_result "$rc" "$err_f" ripgrep "searching for '$pattern'"
  else
    # BSD grep's -R follows a symlink named on the command line but NOT one it
    # meets while recursing, so `grep -R pattern .` silently finds nothing in a
    # view made of symlinks. Passing the repo directories explicitly with a
    # trailing slash works on both BSD and GNU grep and does not depend on
    # symlink-following semantics at all.
    local ex=() d grep_targets=()
    for d in ${CS_EXCLUDE_DIRS[@]+"${CS_EXCLUDE_DIRS[@]}"}; do ex+=("--exclude-dir=$d"); done
    for name in "${repo_targets[@]}"; do grep_targets+=("$view/$name/"); done
    run_timed grep -Rn --binary-files=without-match \
        ${ex[@]+"${ex[@]}"} ${wordflag[@]+"${wordflag[@]}"} "$extra" -- "$pattern" \
        "${grep_targets[@]}" 2>"$err_f"
    rc=$?
    note_search_result "$rc" "$err_f" grep "searching for '$pattern'"
  fi
  rm -f "$err_f"
  return $rc
}

# Recursive grep skips a dangling symlink SILENTLY -- it never reports the file
# ripgrep exits 2 over -- so the same fleet yields a clean negative on one
# backend and a PARTIAL one on the other. A negative has to mean the same thing
# whichever engine happens to be installed, which is the property verify-search
# already asserts for results and did not assert for what was skipped.
#
# Only run when it can change what an answer MEANS: on the grep backend, when
# the query found nothing and grep reported nothing. That is the one case where
# a silent skip turns into a false "this is dead", and it keeps a whole extra
# filesystem walk off every query that already has an answer.
# The walk itself, shared with `cs engines`, which lists these once for the
# fleet rather than leaving each answer to reprint them.
#
# -L makes find follow symlinks, so one that still reports as -type l is a
# symlink whose target does not resolve: exactly the file grep passed over.
find_dangling_links() {
  local prune=() d first=1
  for d in ${CS_EXCLUDE_DIRS[@]+"${CS_EXCLUDE_DIRS[@]}"}; do
    if [[ $first -eq 1 ]]; then prune+=(-name "$d"); first=0
    else prune+=(-o -name "$d"); fi
  done
  find -L "$view"/*/ \( "${prune[@]}" \) -prune -o -type l -print 2>/dev/null
}

scan_unreadable_for_grep() {
  [[ "$(text_engine)" == grep ]] || return 0
  files_skipped && return 0
  local d
  while IFS= read -r d; do
    [[ -n "$d" ]] && note_skipped "$d"
  done < <(find_dangling_links)
}
ctags_bin() {
  # CS_CTAGS_BIN names the binary explicitly, and is authoritative: if it does
  # not validate, ctags is ABSENT rather than falling back to the scan below.
  # Same reasoning as CS_TEXT_ENGINE -- an engine you can force is an engine you
  # can compare rather than trust -- and it is the only way to exercise the
  # no-ctags path at all, because the scan resolves ABSOLUTE paths specifically
  # to dodge macOS's BSD ctags, so PATH cannot hide the real one.
  if [[ -n "${CS_CTAGS_BIN:-}" ]]; then
    [[ -x "$CS_CTAGS_BIN" ]] || return 1
    "$CS_CTAGS_BIN" --version 2>&1 | grep -qi universal || return 1
    printf '%s\n' "$CS_CTAGS_BIN"
    return 0
  fi
  # On macOS, Homebrew's universal-ctags is shadowed by the BSD ctags in
  # /usr/bin, which is a different program with a different output format --
  # so check for the Universal banner rather than trusting the name.
  local c
  for c in /opt/homebrew/bin/ctags /usr/local/bin/ctags /usr/bin/ctags-universal \
           "$(command -v ctags 2>/dev/null || true)"; do
    [[ -n "$c" && -x "$c" ]] || continue
    if "$c" --version 2>&1 | grep -qi universal; then echo "$c"; return 0; fi
  done
  return 1
}

# ---- language toolchains ---------------------------------------------------
# Serena is a DRIVER for a language server, and a language server needs its
# language's toolchain: a .NET SDK to load a C# project, a JDK for Kotlin, node
# for TypeScript. The preflight in `cs refs` / `cs impls` used to
# check uvx, python3 and the repo directory -- the driver and its plumbing, none
# of which say anything about whether the language can be analysed. All three
# passed on a machine with no SDK, the server loaded nothing, and the empty
# result was printed as
#
#     answer: resolved via serena (LSP) · 0 hit(s)
#
# which is the STRONGEST negative this tool can emit ("no reference, within that
# one repo"), asserted about a repo where nothing had been read. That is the
# failure mode the project exists to prevent, reproduced inside the tool.
#
# `bootstrap` already probed dotnet and java and said "Serena cannot analyse
# that language" -- but bootstrap is optional and its knowledge never reached
# the query path. This is that knowledge, moved to where the query is.
#
# Probed by RUNNING the binary, not by `command -v` alone, for the same reason
# require_python3 does: "on PATH but fails to run" is a real state, and it is
# indistinguishable from a working toolchain until a query comes back empty.
have_toolchain() {
  command -v "$1" >/dev/null 2>&1 || return 1
  case "$1" in
    java) java -version >/dev/null 2>&1 ;;   # JDK 8 has no --version
    *)    "$1" --version </dev/null >/dev/null 2>&1 ;;  # stdin: dotnet writes a keypad escape to the terminal
  esac
}

# The mapping is deliberately short. A toolchain named here and absent produces
# a REFUSAL, so a wrong entry blocks a query that would have worked -- which is
# its own kind of damage. These two are the runtimes the server itself cannot
# start without; a language not listed is not preflighted, and `cs why resolved`
# says so rather than implying the check was made.
#
# Kotlin is not listed. Its entry said `java`, which stopped being true in
# 1.18.0: the Kotlin server runs on its own runtime, and a JDK is needed only
# for a jvmToolchain(N) request, then exactly N (kotlin_jdk_unmet). The callers
# that preflight handled Kotlin before reaching it, but a graph answer's warning
# read the entry and told the reader cs refs "needs java" (#97).
language_toolchain() {  # <language> -> the binary its language server needs
  case "$1" in
    csharp)                echo dotnet ;;
    typescript|javascript) echo node ;;
    *) return 1 ;;
  esac
}
# Java is preflighted and needs NOTHING, which is different from not being
# preflighted. Serena's Eclipse JDTLS ships its own JRE and imports Gradle with
# it ("Using bundled JRE for Gradle"), so `cs impls DiscountRule` resolves on a
# machine whose only java is the macOS stub. Java used to share Kotlin's `java`
# entry, and on that machine cs refused a query that would have been answered
# correctly. Kotlin is gated by what its BUILD asks for, not by `java` (#72):
# see kotlin_jdk_unmet.
runtime_bundled() { [[ "$1" == java ]]; }
toolchain_languages() {  # <toolchain> -> the languages it unblocks, for messages
  case "$1" in
    dotnet) echo "C#" ;;
    java)   echo "Kotlin builds that request a Gradle toolchain" ;;
    node)   echo "TypeScript/JavaScript" ;;
  esac
}
toolchain_install() {
  case "$1" in
    dotnet) echo "brew install --cask dotnet-sdk   (or https://dot.net)" ;;
    java)   echo "$(have brew && echo 'brew install openjdk' || echo 'install a JDK'), then set JAVA_HOME to it (Homebrew's JDKs are keg-only)" ;;
    node)   echo "brew install node" ;;
  esac
}
CS_TOOLCHAINS="dotnet java node"

# ---- JDKs, for Kotlin --------------------------------------------------------
# Kotlin's requirement is a VERSION, not a binary: its server's Gradle import
# needs a JDK at the toolchain version the build declares (#65). These are shared
# by the refusal and by cs doctor, so the two cannot give different advice -- the
# refusal used to say `brew install openjdk@21` whatever the build asked for, and
# even when that JDK was installed already, merely keg-only (#70).

# Toolchain versions a repo's Gradle build declares, one per line, ascending --
# including those of builds it pulls in with includeBuild(...). A composite
# build imports as one, so an included build's jvmToolchain(21) is this repo's
# requirement too: the fixture's Kotlin service includes the sibling
# pricing-lib-java whenever it is checked out beside it, as in a fleet, and the
# import failed on THAT build's toolchain while the service itself asked for
# none (#72).
gradle_build_dirs() {  # <repo-dir> -> it, and every includeBuild(...) target that exists
  local s inc
  printf '%s\n' "$1"
  while IFS= read -r s; do
    [[ -n "$s" ]] || continue
    grep -ohE 'includeBuild\([[:space:]]*["'"'"'][^"'"'"']+' "$s" 2>/dev/null \
      | sed -E 's/.*["'"'"']//' | while IFS= read -r inc; do
          [[ -d "${s%/*}/$inc" ]] && printf '%s\n' "${s%/*}/$inc"
        done
  done <<< "$(find "$1" -maxdepth 2 \( -name settings.gradle.kts -o -name settings.gradle \) -print 2>/dev/null)"
}
kotlin_toolchain_versions() {  # <repo-dir>
  local d
  gradle_build_dirs "$1" | while IFS= read -r d; do
    find "$d" -maxdepth 3 \( -name build.gradle.kts -o -name build.gradle \) \
         -not -path '*/build/*' -print 2>/dev/null
  done | xargs grep -ohE '(jvmToolchain|JavaLanguageVersion\.of)\(\s*[0-9]+' 2>/dev/null \
    | grep -oE '[0-9]+$' | sort -un
}

# The Java major in a JDK home's `release` file ("1.8" counts as 8), or nothing.
jdk_major_at() {  # <jdk-home>
  local r
  for r in "$1/release" "$1/Contents/Home/release"; do
    [[ -f "$r" ]] || continue
    sed -n 's/^JAVA_VERSION="\([0-9]*\)\.\{0,1\}\([0-9]*\).*/\1 \2/p' "$r" \
      | awk '{print ($1 == "1" ? $2 : $1); exit}'
    return 0
  done
  return 1
}

# Java majors a Gradle toolchain request can be met from: JAVA_HOME, what
# macOS's java_home has registered, JDKs Gradle provisioned itself, SDKMAN's,
# and org.gradle.java.installations.paths. "<major> <where>" lines.
jdks_findable() {
  local v h p
  if [[ -n "${JAVA_HOME:-}" ]] && v=$(jdk_major_at "$JAVA_HOME") && [[ -n "$v" ]]; then
    printf '%s JAVA_HOME\n' "$v"
  fi
  if [[ -x /usr/libexec/java_home ]]; then
    /usr/libexec/java_home -V 2>&1 \
      | awk '/^[[:space:]]+[0-9]/ { split($1, p, "."); print (p[1] == "1" ? p[2] : p[1]), "java_home" }'
  fi
  for h in "$HOME"/.gradle/jdks/*/ "$HOME"/.sdkman/candidates/java/*/; do
    [[ -d "$h" ]] && v=$(jdk_major_at "${h%/}") && [[ -n "$v" ]] && printf '%s %s\n' "$v" "${h%/}"
  done
  p=$(sed -n 's/^[[:space:]]*org\.gradle\.java\.installations\.paths[[:space:]]*=[[:space:]]*//p' \
      "$HOME/.gradle/gradle.properties" 2>/dev/null | tr ',' '\n')
  while IFS= read -r h; do
    [[ -n "$h" ]] && v=$(jdk_major_at "$h") && [[ -n "$v" ]] && printf '%s gradle.properties\n' "$v"
  done <<< "$p"
  return 0
}

# Whether the build lets Gradle DOWNLOAD a missing toolchain (the foojay
# resolver). Then no local JDK is needed, and refusing would block a query that
# works.
#
# A loop, not `find | xargs grep -q`: given no input, BSD xargs runs nothing and
# exits 0, so a repo with NO settings file read as "provisions toolchains" and
# every jvmToolchain request in it was waved through on macOS.
gradle_provisions_toolchains() {  # <repo-dir>
  local f
  while IFS= read -r f; do
    [[ -n "$f" ]] && grep -q 'foojay-resolver' "$f" 2>/dev/null && return 0
  done <<< "$(find "$1" -maxdepth 2 \( -name settings.gradle.kts -o -name settings.gradle \) -print 2>/dev/null)"
  return 1
}

# The lowest Java a Gradle build compiles for WITHOUT requesting a toolchain:
# sourceCompatibility / targetCompatibility / jvmTarget. A FLOOR, not an exact
# version, and the Kotlin server's Gradle import meets it from its own bundled
# runtime: a build pinned this way to 21 imported under JDK 17, 21, 26 and with
# no JDK at all (#72). Prints the highest such floor, or nothing.
kotlin_jvm_floor() {  # <repo-dir>
  find "$1" -maxdepth 3 \( -name build.gradle.kts -o -name build.gradle \) \
       -not -path '*/build/*' -print 2>/dev/null \
    | xargs grep -ohE '(VERSION|JVM)_[0-9_]+|(jvmTarget|sourceCompatibility|targetCompatibility)[^"=]*=[[:space:]]*["'"'"']?[0-9.]+' 2>/dev/null \
    | grep -oE '[0-9][0-9._]*$' | sed -e 's/^1[._]//' -e 's/[._].*//' | sort -n | tail -1
}

# The Java major the Kotlin server's bundled runtime provides, once Serena has
# downloaded it; nothing before that.
kotlin_server_runtime() {
  local r best=""
  for r in "$HOME"/.serena/language_servers/static/KotlinLanguageServer/*/kotlin-server-*/jbr; do
    [[ -d "$r" ]] && best=$(jdk_major_at "$r")
  done
  [[ -n "$best" ]] && printf '%s\n' "$best"
}

# What a Kotlin repo needs from this machine, decided from its build. The
# Kotlin server runs Gradle on its own runtime, so a build that requests no
# toolchain needs no JDK at all; one that requests jvmToolchain(N) needs a JDK
# of EXACTLY N that Gradle can find -- with none, or another version, the
# import fails and the server answers [] with exit 0 (#65, #72). `java` running
# says nothing about either, which is why the gate used to refuse the first
# kind of repo and wave through the silent empty of the second.
# Prints the major that is needed and not findable, or fails if nothing is.
kotlin_jdk_unmet() {  # <repo-dir>
  local want have
  gradle_provisions_toolchains "$1" && return 1
  have=$(jdks_findable | awk '{print $1}')
  for want in $(kotlin_toolchain_versions "$1"); do
    printf '%s\n' "$have" | grep -qx "$want" || { printf '%s\n' "$want"; return 0; }
  done
  return 1
}

# ---- C# project styles ------------------------------------------------------
# "<sdk> <framework>": how many of a repo's projects are SDK-style and how many
# are legacy .NET Framework. Both load in Serena with the .NET SDK installed --
# on macOS too, contrary to what cs used to say (#72). A Framework project loads
# WITHOUT its reference assemblies, so types from the framework and from its
# packages do not resolve, while the repo's own types, implementations and
# references (across its projects) do.
csharp_project_styles() {  # <repo-dir>
  local f sdk=0 fw=0
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    if grep -qE '<Project[^>]*Sdk=' "$f" 2>/dev/null; then sdk=$((sdk + 1)); else fw=$((fw + 1)); fi
  done <<< "$(find "$1" -name '*.csproj' -not -path '*/bin/*' -not -path '*/obj/*' 2>/dev/null)"
  printf '%s %s\n' "$sdk" "$fw"
}
csharp_framework_note="it loads .NET Framework projects too, without their reference assemblies: framework and package types do not resolve, the repo's own types and references do"

# ---- repos kept without a graph on purpose ------------------------------------
# CS_NO_GRAPH in fleet.env: repos deliberately left unindexed. Without it a
# fleet with one such repo could never pass cs doctor, and a gate that always
# fails teaches people to skip it (#72).
graph_excluded() { [[ " ${CS_NO_GRAPH:-} " == *" $1 "* ]]; }
graph_hint() {  # <repo> <dir> -> how to get a graph there, or why there is none
  if graph_excluded "$1"; then
    printf '%s is kept without a graph on purpose (CS_NO_GRAPH in fleet.env), so no graph can answer there' "$1"
  else
    printf 'build one with: cd %s && tokensave init' "$(real_dir_of "$2" 2>/dev/null || printf '%s' "$2")"
  fi
}

# A JDK of that major that is installed but that nothing can see -- Homebrew's
# openjdk formulae are keg-only. Prints its home, or fails.
keg_jdk_home() {  # <major>
  local h r
  for h in /opt/homebrew/opt/openjdk@"$1" /opt/homebrew/opt/openjdk /usr/local/opt/openjdk@"$1" \
           /usr/local/opt/openjdk /home/linuxbrew/.linuxbrew/opt/openjdk@"$1" /home/linuxbrew/.linuxbrew/opt/openjdk; do
    for r in "$h/libexec/openjdk.jdk/Contents/Home" "$h/libexec"; do
      [[ -f "$r/release" ]] || continue
      grep -q "^JAVA_VERSION=\"$1[.\"]" "$r/release" && { printf '%s\n' "$r"; return 0; }
    done
  done
  return 1
}

# A fix the user can paste: append <line> to the profile their shell reads for
# it. Prose such as "put X before Y on PATH" left the last step to whoever read
# it, and an agent that cannot edit a profile has to hand the user a command.
#   path -- read by login shells (each new macOS terminal): PATH belongs here
#   env  -- read by every interactive shell
profile_line() {  # <path|env> <line, without single quotes>
  local f
  case "${SHELL##*/}" in
    zsh)  [[ "$1" == path ]] && f="~/.zprofile" || f="~/.zshrc" ;;
    bash) [[ "$(uname -s)" == Darwin ]] && f="~/.bash_profile" || f="~/.bashrc" ;;
    *)    printf 'add to your shell profile: %s' "$2"; return ;;
  esac
  printf "echo '%s' >> %s" "$2" "$f"
}

toolchain_fix() {  # <toolchain> <repo-dir> [jdk major] -> the fix for this repo
  local want="${3:-}" keg styles
  if [[ "$1" == dotnet ]]; then
    styles=$(csharp_project_styles "$2")
    if [[ "${styles#* }" -gt 0 ]]; then
      printf '%s — %s' "$(toolchain_install dotnet)" "$csharp_framework_note"
      return
    fi
  fi
  if [[ "$1" == java ]]; then
    [[ -n "$want" ]] || want=$(kotlin_toolchain_versions "$2" | tail -1)
    if [[ -n "$want" ]] && keg=$(keg_jdk_home "$want"); then
      printf 'JDK %s is installed but keg-only, so nothing finds it: %s' "$want" \
        "$(profile_line env "export JAVA_HOME=\"$keg\"")"
      return
    elif [[ -n "$want" ]]; then
      printf '%s (the build asks for %s), then set JAVA_HOME to it' \
        "$(have brew && echo "brew install openjdk@$want" || echo "install a JDK $want")" "$want"
      return
    fi
  fi
  toolchain_install "$1"
}

# The dominant source language of a repo, or nothing if it cannot be told.
#
# Extension counts, walked in rank order rather than taking the single commonest
# extension: a repo's most numerous file type is often .json or .yml, which
# names no language at all. The first ranked extension that IS a language wins.
# One extension -> language map, shared by the repo census and the symbol route.
ext_language() {
  case "$1" in
    cs)             echo csharp ;;
    java)           echo java ;;
    kt|kts)         echo kotlin ;;
    ts|tsx)         echo typescript ;;
    js|jsx|mjs|cjs) echo javascript ;;
    py)             echo python ;;
    go)             echo go ;;
    rs)             echo rust ;;
    *) return 1 ;;
  esac
}

# The language of the SYMBOL, which is the language of the QUESTION.
#
# repo_language answers a different question -- what is this repo mostly written
# in -- and routing on it means a repo that is 554 .js and 419 .cs files reports
# `javascript`, finds node installed, and never reaches the graph fallback even
# when the symbol asked about is C# and dotnet is missing. The only difference
# between an answer and a refusal was the ratio of file extensions in the repo,
# which has nothing to do with the question.
#
# ctags locates the defining file cheaply and without any toolchain, and its
# extension is a far better signal than a file census. Falls back to the census
# when there is no ctags or the symbol is not indexed.
symbol_language() {  # <symbol> <repo-dir>
  local sym="$1" dir="$2" ct tags ext
  ct=$(ctags_bin) || return 1
  tags=$(cs_tmp cs-symlang)
  run_timed "$ct" -R --fields=+n ${CS_CTAGS_EXCLUDES[@]+"${CS_CTAGS_EXCLUDES[@]}"} -f "$tags" "$dir" >/dev/null 2>&1
  ext=$(awk -F'\t' -v w="$sym" '$1 == w { print $2 }' "$tags" \
        | sed -n 's/.*\.\([A-Za-z0-9_]\{1,\}\)$/\1/p' | tr 'A-Z' 'a-z' | head -1)
  rm -f "$tags"
  [[ -n "$ext" ]] || return 1
  ext_language "$ext"
}

# The file to hand `cs refs` for a symbol, so the advice after a zero is a
# command that runs rather than one with `<file>` in it (#81): the one file that
# declares it, repo-relative. Two files declaring the name is a choice cs cannot
# make for the reader, so that prints the placeholder and says how to choose.
refs_file() {  # <symbol> <repo-name> <repo-dir>
  local sym="$1" repo="$2" dir="$3" ct tags files n
  if ct=$(ctags_bin); then
    tags=$(cs_tmp cs-symfile)
    (cd "$dir" && run_timed "$ct" -R --fields=+n ${CS_CTAGS_EXCLUDES[@]+"${CS_CTAGS_EXCLUDES[@]}"} -f "$tags" . >/dev/null 2>&1)
    files=$(awk -F'\t' -v w="$sym" '$1 == w { sub(/^\.\//, "", $2); print $2 }' "$tags" | sort -u)
    rm -f "$tags"
  fi
  n=$(printf '%s' "${files:-}" | grep -c .)
  if [[ $n -eq 1 ]]; then printf '%s\n' "$files"
  elif [[ $n -gt 1 ]]; then printf '<file>   (declared in %s files: cs def %s %s lists them)\n' "$n" "$sym" "$repo"
  else printf '<file>\n'
  fi
}

repo_language() {
  local dir="$1" ranked n ext
  ranked=$(find -L "$dir" -type d \( -name .git -o -name node_modules -o -name vendor \
             -o -name target -o -name build -o -name dist -o -name obj -o -name bin \
             -o -name .venv -o -name __pycache__ \) -prune -o -type f -print 2>/dev/null \
           | sed -n 's/.*\.\([A-Za-z0-9_]\{1,\}\)$/\1/p' \
           | tr 'A-Z' 'a-z' | sort | uniq -c | sort -rn)
  [[ -n "$ranked" ]] || return 1
  local lang
  while read -r n ext; do
    [[ -n "$ext" ]] || continue
    if lang=$(ext_language "$ext"); then printf '%s\n' "$lang"; return 0; fi
  done <<EOF
$ranked
EOF
  return 1
}

# require_serena_toolchain <subcommand> <symbol> <repo-name> <repo-dir>
#
# Refuses rather than answering, and refuses BEFORE `answer resolved` is set, so
# there is no path on which the label reaches stdout for a query that could not
# have run.
# The missing toolchain for a repo's language, or empty if it can be analysed.
# Split out of require_serena_toolchain so a caller can offer a fallback instead
# of only refusing -- installing the SDK is not a fix for every repo, and where
# it is not, refusing was cs's ONLY answer.
serena_missing_toolchain() {  # <repo-dir> [symbol]
  local lang tc
  # The symbol's language first; the repo census only as a fallback.
  if [[ -n "${2:-}" ]]; then lang=$(symbol_language "$2" "$1") || lang=""; fi
  [[ -n "${lang:-}" ]] || lang=$(repo_language "$1") || return 1
  if [[ "$lang" == kotlin ]]; then
    kotlin_jdk_unmet "$1" >/dev/null || return 1
    printf 'java\n'; return 0
  fi
  tc=$(language_toolchain "$lang") || return 1
  have_toolchain "$tc" && return 1
  printf '%s\n' "$tc"
}

# ---- the repo's Serena project file (#95) -----------------------------------
# Serena writes <repo>/.serena/project.yml on its first run there and, when it is
# not interactive, enables ONE language server: the language with the most
# files. In a Gradle repo with more .java than .kt the Kotlin server never
# started, and every Kotlin symbol came back "could not locate" with advice on
# spelling it. Which servers run is a property of that file, so cs reads it to
# name the cause, and writes it when it would otherwise be Serena's guess.
serena_ls_key() {  # <cs language> -> the language server Serena calls it
  case "$1" in
    csharp) echo csharp ;; java) echo java ;; kotlin) echo kotlin ;;
    typescript|javascript) echo typescript ;;
    python) echo python ;; go) echo go ;; rust) echo rust ;;
    *) return 1 ;;
  esac
}
lang_label() {
  case "$1" in
    csharp) echo "C#" ;; java) echo Java ;; kotlin) echo Kotlin ;; python) echo Python ;;
    typescript) echo TypeScript ;; javascript) echo JavaScript ;; go) echo Go ;; rust) echo Rust ;;
    *) echo "$1" ;;
  esac
}

# The servers the repo's project file enables ("java, python"), when it has one
# and it leaves out <language>. Fails when there is no file or the language is on.
serena_project_lacks() {  # <repo-dir> <cs language>
  local key on
  key=$(serena_ls_key "$2") || return 1
  on=$(python3 "$lib_dir/serena_project.py" languages "$1") || return 1
  # A variant server is still the language: csharp_omnisharp, python_jedi.
  printf '%s\n' "$on" | grep -qE "^${key}(_|\$)" && return 1
  printf '%s' "$(printf '%s\n' "$on" | grep -v '^$' | paste -sd, - | sed 's/,/, /g')"
}

# The refusal when the symbol's language has no server in the repo. Not the
# spelling advice: the name was never looked up, by a server that could see it.
serena_lang_off() {  # <subcommand> <symbol> <repo> <repo-dir> <cs language> <enabled>
  local lab on="only: $6"
  lab=$(lang_label "$5")
  [[ -n "$6" ]] || on="no language server at all"
  printf "cs %s: '%s' is %s, and %s's Serena project enables %s
  no %s language server ran there, so '%s' was not looked up — this is NOT an answer, nothing was ruled out
  Serena enables only a repo's majority language when it writes that file itself
  fix: add %s to language_servers: in %s/.serena/project.yml, then rerun" \
    "$1" "$2" "$lab" "$3" "$on" "$lab" "$2" \
    "$(serena_ls_key "$5")" "$(real_dir_of "$4")"
}

# The language a question is in: the file's, when one is named, which is
# certain; otherwise the symbol's declaration (ctags, so a run over the repo).
question_language() {  # <symbol> <repo-dir> [file]
  if [[ -n "${3:-}" ]]; then ext_language "$(printf '%s' "${3##*.}" | tr 'A-Z' 'a-z')"
  else symbol_language "$1" "$2"; fi
}

# Writes the project file before Serena's first run in a repo, when the question
# is in a language that is not the repo's majority: Serena's own file would
# enable the majority alone and this question could not be answered. Both
# servers are enabled, the one Serena would have chosen included, so a question
# in the majority language is answered as before. Anything else is left to
# Serena, and an existing file is never edited: it may be someone's choice.
#
# With Java on, `**/bin/**` is ignored where git tracks nothing under a bin/:
# JDTLS imports a Gradle build into Eclipse output there, with a copy of every
# non-Java source, and a lookup that lands on a copy of a .kt file gets an empty
# answer from a server that does not own it.
serena_project_prepare() {  # <repo-dir> <repo-name> <symbol> [file]
  local dir="$1" lang major k1 k2 yml
  yml="$(real_dir_of "$dir")/.serena/project.yml"
  [[ -e "$yml" ]] && return 0
  lang=$(question_language "$3" "$dir" "${4:-}") || return 0
  major=$(repo_language "$dir") || return 0
  k1=$(serena_ls_key "$major") || return 0
  k2=$(serena_ls_key "$lang") || return 0
  [[ "$k1" != "$k2" ]] || return 0
  local ignored=""
  if [[ "$k1" == java || "$k2" == java ]] \
     && [[ -z "$(git -C "$dir" ls-files -- ':(glob)**/bin/**' 2>/dev/null | head -1)" ]]; then
    ignored='**/bin/**'
  fi
  if [[ -n "$ignored" ]]; then
    python3 "$lib_dir/serena_project.py" create "$dir" "$k1" "$k2" --ignore "$ignored" || return 0
  else
    python3 "$lib_dir/serena_project.py" create "$dir" "$k1" "$k2" || return 0
  fi
  info "wrote $yml with language servers $k1 and $k2 — the question is $(lang_label "$lang") and the repo is mostly $(lang_label "$major"), and Serena's own file would enable only $k1${ignored:+; ignoring $ignored, where JDTLS writes copies of the sources}"
}

# ---- the graph fallback ----------------------------------------------------
# `resolved` needs a language server, and a language server needs its language's
# toolchain. Where that toolchain is missing, or cannot be installed, cs had no
# answer at all for those repos, not a degraded one. (This once said .NET
# Framework C# was such a case BY CONSTRUCTION on macOS and Linux. It is not:
# the .NET SDK loads Framework projects there too, minus their reference
# assemblies -- #72.)
#
# A prebuilt graph is the profile the facade is otherwise missing: offline,
# cross-repo, no per-language toolchain. It is NEVER labelled `resolved`: a
# symbol graph cannot see reflection, DI registration, or generated code, and
# `cs refs` remains the only thing that bridges a DI registration. Calling a
# graph answer `resolved` would overstate it in precisely the way this project's
# answer-kind vocabulary exists to prevent, so it is `structural`.
tokensave_graph_at() { [[ -f "$1/.tokensave/tokensave.db" ]]; }

# Epoch seconds of the graph's last sync, or empty. A graph is the one engine
# here that can be confidently WRONG rather than merely blind -- it answers
# about the code as of its last sync -- so its age is surfaced, not assumed.
# `status` takes its path POSITIONALLY and rejects --project, unlike the `tool`
# subcommands; and --json avoids ~36KB of ANSI art for a handful of numbers.
#
# `last_sync_at`, NOT `last_updated`. They are different questions and only one
# of them is the one every message here asks:
#
#   last_sync_at   when the graph was last VERIFIED against the tree
#   last_updated   when the graph's CONTENT last changed
#
# A sync that finds nothing to change advances the first and not the second, so
# `last_updated` goes stale on a repo that is perfectly current -- and stays
# stale indefinitely for a repo whose commits only touch file types with no
# extractor. Measured on a fleet synced two minutes earlier: last_sync_at 0h2m,
# last_updated 87h46m, and `cs engines` reporting "oldest 3 day(s) old". Every
# sentence downstream of this says "last synced", which is exactly the claim
# last_sync_at answers and last_updated does not.
#
# No fallback to last_updated when the field is absent. Substituting the field
# that answers a different question is the bug being fixed, and the callers all
# already have an honest "sync age unknown" branch to take instead.
tokensave_graph_epoch() {
  have_tokensave || return 1
  tokensave status "$1" --json 2>/dev/null \
    | sed -n 's/.*"last_sync_at"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -1
}
tokensave_graph_age_secs() {
  local e now
  e=$(tokensave_graph_epoch "$1") || return 1
  [[ -n "$e" ]] || return 1
  now=$(date +%s)
  # A clock that has gone backwards since the sync would otherwise print a
  # negative age, which reads as a corrupt graph rather than a skewed clock.
  [[ "$e" -gt "$now" ]] && { printf '0\n'; return 0; }
  printf '%s\n' $(( now - e ))
}

# Seconds as something a reader can act on. Days alone were the unit before,
# and once the fleet refreshes every 15 minutes every graph is "0 day(s)" --
# accurate and useless, since the whole point of the number is to let a reader
# decide whether to discount the answer.
#
# The seconds tier is not cosmetic. A scheduled sync every 15 minutes puts the
# real answer under a minute most of the time, and "0m" is the same string a
# rounding bug would print -- so the one number that tells a stale graph from a
# current one would have had no resolution in the range it is normally read in.
format_age() {  # <seconds> -> 8s | 2m | 3h | 4d
  local s="$1"
  if   [[ "$s" -lt 60    ]]; then printf '%ds' "$s"
  elif [[ "$s" -lt 3600  ]]; then printf '%dm' $(( s / 60 ))
  elif [[ "$s" -lt 172800 ]]; then printf '%dh' $(( s / 3600 ))
  else printf '%dd' $(( s / 86400 )); fi
}

# ---- which graph answered, and what it therefore cannot see ------------------
# The layered view is cs's best property: ticket repos at branch state, every
# other repo at main, one root. A graph index cannot do that. Indexes are
# per-project -- the workspace copy of a repo has its own, the fleet copy has
# its own, and THERE IS NO UNION. So every graph-backed answer is scoped to one
# repo at one layer, and which layer decides whether the answer describes the
# code you are editing or the code you branched from.
#
# That gap is invisible in the output unless it is put there. Renaming a symbol
# on your branch and then asking who calls it, only to be answered from the
# fleet index, is the failure the layering exists to prevent -- a confident
# answer from the wrong scope -- arriving through a new door, the same way the
# MCP server's inherited working directory would have. So: the layer and the
# sync age go in the provenance NOTE (which reaches the porcelain envelope and
# the MCP surface, not only stderr), and a substituted layer is recorded as
# `degraded`.

# Which layer a directory belongs to. Same test as cs repos: the view is a
# directory of symlinks, and a ticket repo is one pointing into the workspace.
#
# Keyed on the directory the graph was actually READ FROM, not on the repo name.
# Those differ in exactly the case that matters -- $view/<repo> points at the
# workspace while the graph came from the fleet copy -- and reporting the view's
# layer there would put a false claim in the provenance line, which is the one
# place this tool cannot afford one.
graph_layer_of() {  # <dir> -> ticket|fleet
  local target="$1"
  [[ -L "$target" ]] && target=$(readlink "$target")
  if [[ -n "$ticket_root" && "$target" == "$ticket_root"/* ]]; then printf 'ticket'
  else printf 'fleet'; fi
}

# The path a reader can actually `cd` to. When a ticket is layered the view is a
# mktemp directory of symlinks that cs deletes on exit, so a message telling
# someone to run `tokensave init` there names a path that will not exist by the
# time they read it.
real_dir_of() {  # <dir> -> the path it resolves to
  local d="$1"
  [[ -L "$d" ]] && d=$(readlink "$d")
  printf '%s' "$d"
}

# The provenance note for a graph answer: which index answered, and how old it
# is. Always both -- the age half is what separates a graph from every other
# engine here, and the layer half is what separates this repo's branch state
# from main.
graph_note() {  # <repo> <graph-dir> [extra] -> the note for answer()
  local repo="$1" dir="$2" extra="${3:-}" age note
  note="scoped to $repo; $(graph_layer_of "$dir") layer"
  if age=$(tokensave_graph_age_secs "$dir") && [[ -n "$age" ]]; then
    note="$note, synced $(format_age "$age") ago"
  else
    note="$note, sync age unknown"
  fi
  [[ -n "$extra" ]] && note="$note; $extra"
  printf '%s' "$note"
}

# Said out loud on every graph answer: the age, and the scope the graph cannot
# cover. `substituted` is the trap-2 case -- a ticket workspace was asked about
# and the answer came from the fleet index, so it describes the world before
# your edits. That one goes in CS_DEGRADED as well as on stderr, because a
# caller reading the envelope has no stderr to read.
graph_caveats() {  # <repo> <graph-dir> <substituted:0|1>
  local repo="$1" dir="$2" substituted="$3" age
  if age=$(tokensave_graph_age_secs "$dir") && [[ -n "$age" ]]; then
    warn "answered from a tokensave graph last synced $(format_age "$age") ago — it cannot see changes made since (cd $(real_dir_of "$dir") && tokensave sync)"
  else
    warn "could not read this graph's sync age — a graph answers about the code as of its last sync, and this one will not say when that was"
  fi
  if [[ "$substituted" -eq 1 ]]; then
    CS_DEGRADED="answered from $repo's FLEET index (main) although the scope is $CS_SCOPE — graph indexes are per-project and there is no union of the two, so your branch's edits to $repo are invisible in this answer"
    warn "the $CS_SCOPE workspace copy of $repo has no graph, so its FLEET copy answered — this describes main, not your branch (build one with: cd ${ticket_root:-<workspace>}/$repo && tokensave init)"
  fi
  warn "a graph index is per-repo: this answers about $repo alone. A caller in another repo of the fleet is a string, not an edge — cs uses '<symbol>' is the cross-repo half of the question."
}

# tokensave's C# and Kotlin extractors emit no edges out of property accessors
# (get/set/init, a Kotlin `get() =`) and none into properties: a method called
# only from a getter has no callers in the graph, and `cs callers` answered a
# clean structural zero for it (#79). Measured on tokensave 7.9.0, 7.13.0 and
# 7.14.1; TypeScript getters ARE edges. cs cannot add the edges, so it says
# where they are missing -- verify-engines probes it, and reports IMPROVED the
# day a release emits them.
graph_accessor_gap() {  # <language> -> the language's name, if its graph has the gap
  case "$1" in
    csharp) printf 'C#' ;;
    kotlin) printf 'Kotlin' ;;
    *) return 1 ;;
  esac
}

# The graph question nearest to the one a refusal could not answer, as a command
# that will run. This was one line shared by cs impls and cs refs -- "rerun with
# --engine=tokensave" -- and cs refs refuses that flag, so the advice sent a
# refs caller straight into a second refusal (#75). A graph has no reference
# search; what it has is narrower: the call sites of a method (cs callers) and
# the implementations of a type (cs impls), and which one applies depends on the
# symbol, so the graph is asked which it is.
graph_alternative() {  # <subcommand> <symbol> <repo> <repo-dir>
  local rc=0
  case "$1" in
    refs)
      have_tokensave && { python3 "$lib_dir/tokensave_call.py" impls "$4" "$3" "$2" >/dev/null 2>&1; rc=$?; }
      if [[ $rc -eq 3 ]]; then
        local gl gap=""
        gl=$(symbol_language "$2" "$4" || repo_language "$4" || true)
        gl=$(graph_accessor_gap "$gl") && gap=", nor any call made inside a $gl property accessor"
        printf 'cs callers %s %s   (its call sites, from the tokensave graph: structural, and narrower than references — no DI registrations, no non-call uses%s)\n         and:  cs uses '"'"'%s'"'"' --word   (the text half: every mention of the name, calls the graph does not hold included; only the two together approximate references)' "$2" "$3" "$gap" "$2"
      else
        printf 'cs impls %s %s --engine=tokensave   (its implementations, from the tokensave graph: structural, and narrower than references — no DI registrations, no other uses)' "$2" "$3"
      fi ;;
    *) printf 'cs impls %s %s --engine=tokensave   (from the tokensave graph %s already has: structural)' "$2" "$3" "$3" ;;
  esac
}

require_serena_toolchain() {
  local sub="$1" sym="$2" repo="$3" dir="$4" lang tc
  lang=$(symbol_language "$sym" "$dir") || lang=""
  if [[ -z "$lang" ]] && ! lang=$(repo_language "$dir"); then
    warn "could not tell what language $repo is written in — if Serena cannot load it, an empty result here would look like a clean negative (cs why resolved)"
    return 0
  fi
  runtime_bundled "$lang" && return 0
  local graph_now="" graph_later
  if have_tokensave && tokensave_graph_at "$dir"; then
    graph_now="
  answer now:  $(graph_alternative "$sub" "$sym" "$repo" "$dir")"
    graph_later="the answer-now line above"
  else
    graph_later=$(graph_hint "$repo" "$dir")
  fi
  if [[ "$lang" == kotlin ]]; then
    local want
    want=$(kotlin_jdk_unmet "$dir") || return 0
    die "cs $sub cannot analyse $repo: its Gradle build (or a build it includes) requests a JDK $want toolchain (jvmToolchain), and none is findable here$graph_now
  the Kotlin server's Gradle import needs exactly that version: with none, or
  another, it fails and the server answers [] — which cs would have labelled
  'resolved · 0 hit(s)', the strongest negative in the taxonomy, about a repo
  where nothing was read. Refusing instead.
  fix:        $(toolchain_fix java "$dir" "$want")
  check:      cs doctor   (which JDKs are findable, and the fix)
  without it, a tokensave graph answers a narrower question: $graph_later
  weaker but available now:
    cs def $sym $repo      (structural: ctags, matches spelling not identity)
    cs uses '$sym'         (heuristic: text, comments filtered — cs why heuristic)"
  fi
  if ! tc=$(language_toolchain "$lang"); then
    # Not preflighted rather than known-good. Said out loud, because silence
    # here would read as "checked and fine".
    warn "$repo looks like $lang, which cs does not preflight — if Serena cannot analyse it, this returns empty rather than refusing (cs why resolved)"
    return 0
  fi
  have_toolchain "$tc" && return 0
  die "cs $sub cannot analyse $repo: it is $lang, and Serena needs $tc to load it$graph_now
  $tc is missing or not runnable, so the language server would start, fail to
  load the project, and return nothing — which cs would have labelled
  'resolved · 0 hit(s)', the strongest negative in the taxonomy, about a repo
  where nothing was read. Refusing instead.
  fix:        $(toolchain_fix "$tc" "$dir")
  check:      cs doctor   (what this machine lacks for the fleet's languages, and the fix)
  without the toolchain, a tokensave graph answers a narrower question: $graph_later
  weaker but available now:
    cs def $sym $repo      (structural: ctags, matches spelling not identity)
    cs uses '$sym'         (heuristic: text, comments filtered — cs why heuristic)"
}

# Normalize "path:line:text" to "path:line: text" with the fleet prefix removed.
normalize() { sed -e "s|^${view}/||" -e "s|^${root}/||" -e 's|^\./||'; }

# ---- source vs data, in the hits that came back ----------------------------
# A text answer's SIZE is the first thing a reader takes from it, and a large
# hit count reads as thorough coverage. Measured on a real fleet: `cs uses` on a
# CamelCase type returned 1,295 hits of which 24 were source and 1,271 were data
# -- 1,192 of them in a single test-resources CSV. The 24 were the answer; they
# were 1.9% of what came back, and under the default 200-line cap almost none of
# them were shown.
#
# Nothing here was broken. filter_code.py lists these extensions in
# NO_COMMENT_SYNTAX deliberately -- a CSV has no comment syntax, so there is
# nothing to strip and every line legitimately passes. And `cs why heuristic`
# already says a string in a test fixture counts as a use. The defect is that
# the COMPOSITION was invisible in the answer: nothing distinguished
# 24-code-plus-1271-fixture from 1295-code, and the caveat lived in a separate
# command a caller had to already suspect they needed.
#
# The line drawn is DATA vs SOURCE, never test vs production. A test file is
# often the single most informative hit for an impact question -- a test
# constructing a request object WITHOUT a field is exactly where a changed
# default becomes observable -- so test code stays in scope.
#
# .sql, .yaml, .xml and friends are SOURCE here. They have comment syntax, they
# are executable or declarative logic, and a column named in a query is a real
# use. Only files with no comment syntax at all, plus prose docs, are data. The
# per-extension breakdown is printed either way, so a reader who disagrees with
# where the line falls can see the extensions and judge for themselves.
#
# Generated assets are data too. A committed SVG diagram (rendered from a .d2
# source) put six hit lines totalling 106 KB into a 110 KB --source-only answer
# whose useful part was two lines: a match inside an SVG is a diagram label, not
# a seam. Minified bundles and source maps are the same shape -- one enormous
# generated line -- and `.min.js` / `.min.css` are matched as compound
# extensions, so a hand-written .js or .css stays source.
CS_DATA_EXTS=".json .txt .csv .tsv .lock .log .rst .md .markdown .svg .map .min.js .min.css"

# The extension of each hit's path, counted. Splits on the FIRST colon after the
# repo prefix, not the last -- the same rule json_results learned the hard way,
# since a hit's TEXT can contain `:NN:` and a path almost never does.
hit_extensions() {  # hits on stdin -> "<count> <ext>" per line, most first
  awk '
    {
      p = $0
      sub(/:[0-9]+:.*$/, "", p)          # drop `:line: text`
      n = split(p, seg, "/")
      base = seg[n]
      ext = (match(tolower(base), /\.min\.(js|css)$/) || match(base, /\.[^.\/]+$/)) ? tolower(substr(base, RSTART)) : "(none)"
      c[ext]++
    }
    END { for (e in c) printf "%d %s\n", c[e], e }
  ' | sort -rn
}

is_data_ext() {  # <ext>
  local e
  for e in $CS_DATA_EXTS; do [[ "$1" == "$e" ]] && return 0; done
  return 1
}

# ---- observability definitions are consumers too ---------------------------
# When a workload is renamed or split, the emitted `service.name` (or job name,
# or metric label) is a contract with every SAVED QUERY: dashboard panels, alert
# and recording rules, log filters. Nothing in a code diff, a chart diff or a
# symbol graph can see that seam -- on one side it is a deployment identifier
# and on the other it is a string inside a query expression.
#
# The reported instance: a workload split changed the emitted job name, the
# dashboards and alerts kept querying the old one, and the tell that it was
# catchable is that the new name had been REPORTED a week earlier and simply
# never connected to the queries hard-coding the old one.
#
# These fail in the quietest way this tool knows about. A renamed field crashes
# a consumer; a renamed job name makes a panel go flat and an alert never fire
# again. No error, no page, nothing to notice.
#
# The corpus is thin -- a dozen to fifteen files on a 43-repo fleet, and much of
# the estate lives in the observability platform rather than in git at all --
# which is why this is a LABEL on the answers that already return these files,
# and not a verb of its own. Two things follow from the label, and both are the
# point:
#
#   1. a reader scanning a rename's blast radius sees that a saved query is
#      implicated, instead of inferring it from a file path;
#   2. --source-only stops dropping them. An impact question is exactly the
#      question you ask WITH --source-only, and a Grafana dashboard is a .json,
#      which the data/doc list drops. That is the trap this closes.
#
# Classified by CONTENT, not by path: a dashboard lives wherever someone put it,
# and `dashboards/` is a convention rather than a rule. One grep per candidate
# FILE, memoised, and only for the handful of extensions a saved query can live
# in -- so the cost is bounded by the number of distinct .json/.yaml paths in an
# answer, not by its hit count.
CS_OBS_MAP=""

observability_kind_of() {  # <repo-relative path> -> kind on stdout, or 1
  local p="$1" f="$view/$1" kind=""
  case "$p" in
    *.json|*.jsonnet|*.libsonnet)
      # "panels" is the dashboard marker; schemaVersion pins it to Grafana's
      # own export shape rather than any JSON that happens to have panels.
      grep -qE '"(panels|schemaVersion)"[[:space:]]*:' "$f" 2>/dev/null && kind="dashboard" ;;
    *.yaml|*.yml)
      if grep -qE '^[[:space:]]*(kind:[[:space:]]*PrometheusRule|alerting:)' "$f" 2>/dev/null; then kind="alert rule"
      elif grep -qE '^[[:space:]]*-?[[:space:]]*alert:[[:space:]]*[^[:space:]]' "$f" 2>/dev/null; then kind="alert rule"
      elif grep -qE '^[[:space:]]*-?[[:space:]]*record:[[:space:]]*[^[:space:]]' "$f" 2>/dev/null; then kind="recording rule"
      elif grep -qE '"(panels|schemaVersion)"[[:space:]]*:|grafana_dashboard' "$f" 2>/dev/null; then kind="dashboard"
      # Last, and deliberately weakest: `expr:` alone is a saved query of some
      # kind without saying which. Named as such rather than guessed at.
      elif grep -qE '^[[:space:]]*expr:[[:space:]]*[^[:space:]]' "$f" 2>/dev/null; then kind="saved query"
      fi ;;
    *.tf|*.tfvars|*.hcl)
      grep -q 'grafana_dashboard\|grafana_rule' "$f" 2>/dev/null && kind="dashboard" ;;
    *) return 1 ;;
  esac
  [[ -n "$kind" ]] || return 1
  printf '%s' "$kind"
}

# `<path>\t<kind>` for the observability files among a set of hits, written to a
# file so awk can read it and so the classification is paid once per answer.
# Empty file when there are none, which every reader treats as "no labels".
build_obs_map() {  # <hits>
  [[ -n "$CS_OBS_MAP" ]] || CS_OBS_MAP=$(cs_tmp cs-obs)
  : > "$CS_OBS_MAP"
  local p kind
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    kind=$(observability_kind_of "$p") || continue
    printf '%s\t%s\n' "$p" "$kind" >> "$CS_OBS_MAP"
  done < <(printf '%s\n' "$1" | awk '{ p = $0; sub(/:[0-9]+:.*$/, "", p); print p }' \
           | grep -E '\.(json|jsonnet|libsonnet|ya?ml|tf|tfvars|hcl)$' | sort -u)
}

# The tag itself, in the shape cs constructs already uses: `path:line: [kind] …`.
# Applied to what is EMITTED and not to `$hits`, so the whole-identifier and
# composition analyses keep reading the text the engine actually matched.
annotate_observability() {  # <hits> -> hits, tagged
  [[ -n "$CS_OBS_MAP" && -s "$CS_OBS_MAP" ]] || { printf '%s' "$1"; return 0; }
  printf '%s\n' "$1" | awk -F'\t' -v map="$CS_OBS_MAP" '
    BEGIN {
      while ((getline line < map) > 0) {
        i = index(line, "\t")
        if (i) kind[substr(line, 1, i - 1)] = substr(line, i + 1)
      }
      close(map)
    }
    {
      p = $0; sub(/:[0-9]+:.*$/, "", p)
      # `path:line: [kind] text`, the shape cs constructs already prints, with
      # the leading indentation collapsed the same way it collapses it.
      if ((p in kind) && match($0, /:[0-9]+:/)) {
        head = substr($0, 1, RSTART + RLENGTH - 1)
        rest = substr($0, RSTART + RLENGTH)
        sub(/^[ \t]+/, "", rest)
        $0 = head " [" kind[p] "] " rest
      }
      print
    }' | grep -v '^$'
}

# Said once, under the hits, because the CONSEQUENCE is what a reader needs and
# it does not fit in a tag.
disclose_observability() {
  [[ -n "$CS_OBS_MAP" && -s "$CS_OBS_MAP" ]] || return 0
  local n; n=$(grep -c '' "$CS_OBS_MAP")
  warn "$n of these file(s) are SAVED QUERIES, not code — a dashboard panel, alert or recording rule naming this string will not error when it stops matching: the panel goes flat and the alert never fires again"
  cut -f1,2 "$CS_OBS_MAP" | sed 's/\t/   /' | head -10 | sed 's/^/  /' >&2
  [[ "$n" -gt 10 ]] && info "  … and $((n - 10)) more"
  info "  much of an observability estate lives in the platform rather than in git, where no query here can reach it — this is the part that is committed"
}

# Drop the data hits, for --source-only. Kept separate from the disclosure so
# that the DEFAULT answer never silently loses a hit: this runs only when asked.
#
# Observability definitions are the one EXCEPTION, and it is not a special case
# so much as the rule applied properly: a Grafana dashboard is a .json, so the
# data/doc list drops it -- and an impact question ("who breaks if I rename
# this") is precisely the question a caller reaches for --source-only to ask.
# Silently discarding a whole class of consumer from the answer to that question
# is the trap; the flag is meant to remove fixtures and logs, not consumers.
source_only_hits() {  # hits on stdin
  awk -v exts="$CS_DATA_EXTS" -v map="${CS_OBS_MAP:-/dev/null}" '
    BEGIN {
      n = split(exts, a, " "); for (i = 1; i <= n; i++) drop[a[i]] = 1
      while ((getline line < map) > 0) {
        i2 = index(line, "\t")
        if (i2) keep[substr(line, 1, i2 - 1)] = 1
      }
      close(map)
    }
    {
      p = $0
      sub(/:[0-9]+:.*$/, "", p)
      if (p in keep) { print; next }
      m = split(p, seg, "/")
      base = seg[m]
      ext = (match(tolower(base), /\.min\.(js|css)$/) || match(base, /\.[^.\/]+$/)) ? tolower(substr(base, RSTART)) : "(none)"
      if (!(ext in drop)) print
    }
  '
}

# The narrowing itself, applied only when asked and DISCLOSED when applied --
# an exclusion nobody can see is the same hazard as CS_EXCLUDE_EXTRA, which is
# why that one is announced too.
apply_source_only() {  # <hits> -> hits, filtered when --source-only is on
  [[ $source_only -eq 1 ]] || { printf '%s' "$1"; return 0; }
  local kept n_before n_after
  n_before=$(printf '%s\n' "$1" | grep -c '[^[:space:]]')
  kept=$(printf '%s\n' "$1" | source_only_hits)
  n_after=$(printf '%s\n' "$kept" | grep -c '[^[:space:]]')
  warn "--source-only dropped $((n_before - n_after)) of $n_before hit(s) in data/doc files ($CS_DATA_EXTS) — a route in a .json config is a real seam and is gone from this answer too"
  # Only the ones the extension list WOULD have dropped: an alert rule in a
  # .yaml was never at risk, and counting it here would overstate the rescue.
  local n_rescued=0
  if [[ -n "$CS_OBS_MAP" && -s "$CS_OBS_MAP" ]]; then
    n_rescued=$(cut -f1 "$CS_OBS_MAP" | awk -v exts="$CS_DATA_EXTS" '
      BEGIN { n = split(exts, a, " "); for (i = 1; i <= n; i++) drop[a[i]] = 1 }
      { m = split($0, seg, "/"); base = seg[m]
        ext = (match(tolower(base), /\.min\.(js|css)$/) || match(base, /\.[^.\/]+$/)) ? tolower(substr(base, RSTART)) : "(none)"
        if (ext in drop) c++ }
      END { print c + 0 }')
  fi
  [[ "$n_rescued" -gt 0 ]] && \
    warn "  KEPT $n_rescued observability definition(s) the extension list would have dropped — a dashboard is a .json, and an impact question is exactly the question this flag is used to ask"
  printf '%s' "$kept"
}

# Said on stdout's behalf, on stderr: how much of this answer is data. Printed
# only when there IS data in it -- a line that fires on every query is noise and
# stops being read, which is the rule report_answer already follows.
disclose_composition() {  # <hits>
  local exts n_data=0 n_src=0 c e data_list="" 
  exts=$(printf '%s\n' "$1" | hit_extensions)
  [[ -n "$exts" ]] || return 0
  while read -r c e; do
    [[ -n "$c" ]] || continue
    if is_data_ext "$e"; then
      n_data=$((n_data + c)); data_list="$data_list $e $c,"
    else
      n_src=$((n_src + c))
    fi
  done <<EOF
$exts
EOF
  [[ "$n_data" -gt 0 ]] || return 0
  data_list="${data_list%,}"
  local total=$((n_src + n_data)) msg
  local excl="--source-only excludes the data half"
  [[ -n "$CS_OBS_MAP" && -s "$CS_OBS_MAP" ]] && excl="$excl, except the observability definitions listed below"
  msg="composition: $n_src in source, $n_data in data/doc files ($(printf '%s' "${data_list# }" | sed 's/ \([0-9]\)/ \1/g')) — $excl"
  # A warning when the data half DOMINATES, because that is the case where the
  # hit count misrepresents the answer; otherwise a plain note.
  if [[ $((n_data * 2)) -ge "$total" ]]; then
    warn "most of this answer is NOT source: $msg"
  else
    info "$msg"
  fi
}

# ---- answer provenance -----------------------------------------------------
# Scoring 9/9 on a fixture means the test set is exhausted, not that search is
# solved: on a real repo some questions are undecidable statically at any
# budget -- an implementation chosen from a config string, an identifier built
# by concatenation, a route assembled at runtime. A tool that cannot reach
# those should not be silent about it.
#
# So every answer carries its KIND, which is what decides whether you can act
# on it and, more importantly, what a NEGATIVE result is worth. "cs uses found
# nothing" is weak evidence of no callers; "cs refs found nothing" is strong.
# The kinds, in descending order of weight:
#
#   resolved    a language server resolved the symbol. Same symbol, not merely
#               the same spelling. The only kind that survives a rename.
#   declared    read from a build manifest. Authoritative for what a repo
#               publishes and depends on, because that is where it is stated.
#   structural  a parser matched a syntax shape. The shape is real; whether two
#               matches mean the same entity is not checked.
#   historical  git history. Authoritative about the past of tracked files.
#   heuristic   a text match with prose filtered out. Best effort at "is this a
#               use", and the filter can be wrong in both directions.
#   textual     a byte or regex match. An occurrence, which is not a use.
CS_KIND=""; CS_ENGINE=""; CS_NOTE=""; CS_TRUNCATED=""; CS_DEGRADED=""; CS_NOTES=""

answer() { CS_KIND="$1"; CS_ENGINE="$2"; CS_NOTE="${3:-}"; }

blind_spots() {
  case "$1" in
    resolved) cat <<'X'
Cannot see: a type chosen at runtime from configuration or reflection; code the
language server failed to load (an unresolved build is the usual reason, and it
degrades quietly); anything outside the one repo the server was pointed at.
A negative here is strong evidence -- but only within that repo, and only if
the project actually built.
X
;;
    declared) cat <<'X'
Cannot see: dependencies injected by a parent build file, a BOM, or a plugin
rather than declared in the manifest; vendored code with no coordinate at all;
version ranges resolved at build time. States what the manifest says, which is
not always what is on the classpath.

For `cs versions`: a lockfile, not the manifest, decides what is actually
installed, and two repos agreeing in the manifest can still resolve differently.
Ranges are compared by their written form, not by what they resolve to.

For `cs owns`: CODEOWNERS names who is REQUIRED TO REVIEW, which is not who
wrote the code, who understands it, or who is still at the company. A repo with
no CODEOWNERS produces no answer rather than "nobody owns it", and the rule that
matched is printed so you can judge whether it was meant to cover your file.
X
;;
    structural) cat <<'X'
Cannot see: two matches that resolve to different entities -- it matches shape,
not identity, so a same-named method on an unrelated class matches too. Cannot
see calls made through an alias, a wrapper, or reflection. Coverage is
per-language and uneven; a language the parser does not support returns nothing
rather than an error.

The graph-backed half (cs callers, cs callees, cs impact, and cs impls where no
language server can run) is blind in two more ways, and both are stated on the
answer rather than left here. It answers as of its LAST SYNC, so it is the only
kind that can be confidently wrong rather than merely blind. And a graph index
is per-project: it covers ONE repo at ONE layer, with no union of your ticket
workspace and the fleet -- so a caller in another repo is invisible to it, and
`cs uses` is the other half of that question.

In C# and Kotlin the graph also has a hole: no edges out of property accessors
(get/set/init, a Kotlin `get() =`) and none into properties. A method called
only from a getter has no callers there, so cs says so on every C# or Kotlin
graph answer, and `cs uses '<name>' --word` finds those calls as text.
X
;;
    historical) cat <<'X'
Cannot see: anything untracked, anything in a repo not in the view, or a change
that never took this exact string form (a rename that also reformatted). Finds
where a string entered or left history, which is not always where the behaviour
changed.
X
;;
    heuristic) cat <<'X'
Cannot see: a use assembled from parts ("/api/v1/" + resource), a value read
from configuration, or a generated call site. Also over-reports: a string in a
test fixture or a dead branch counts as a use. The prose filter is per-file
comment-state tracking, so an unusual comment syntax can misclassify a line in
either direction. A negative is weak evidence of absence.
X
;;
    textual) cat <<'X'
Cannot see: anything not spelled exactly this way -- concatenation, interpolation,
a constant holding the value, generated code. Counts comments, docs, changelogs
and test fixtures as hits. This is an occurrence, not a use; a negative is weak
evidence of absence.
X
;;
    *) return 1 ;;
  esac
}

# ---- which answer kinds are reachable on this machine -----------------------
# `cs engines` reported which BINARIES were present. The contract is expressed
# in answer KINDS, and nothing connected the two, so translating
#
#     ast-grep     MISSING
#     semgrep      MISSING
#
# into the fact that actually matters -- the whole `structural` tier is gone and
# `cs calls` will refuse -- required already knowing the routing table. Five
# rows saying `ok` next to two saying MISSING reads as a healthy install.
#
# It matters because the skill tells the agent to weigh every negative by its
# kind, and marks heuristic weak and textual weakest. "Which kinds can I get
# right now" therefore decides whether a negative from this machine is worth
# anything at all -- and there is a realistic configuration (no ast-grep, no
# semgrep, no language toolchain) where BOTH strong code-derived kinds are gone
# and nothing says so.
#
# So the routing table is written down once, here, and `cs engines` and `cs why`
# both read it instead of keeping their own hand-maintained lists.
kind_subcommands() {
  case "$1" in
    resolved)   echo "cs impls, cs refs" ;;
    declared)   echo "cs provides, cs deps, cs publishes, cs versions, cs owns" ;;
    structural) echo "cs calls, cs def, cs impls (graph fallback), cs callers, cs callees, cs impact" ;;
    historical) echo "cs history" ;;
    heuristic)  echo "cs uses" ;;
    textual)    echo "cs text, cs seam" ;;
  esac
}

# Roll-call of the language toolchains Serena needs, e.g.
# "dotnet ok, java MISSING (Kotlin), node ok".
toolchain_roll_call() {
  local tc out=""
  for tc in $CS_TOOLCHAINS; do
    if have_toolchain "$tc"; then out="$out, $tc ok"
    else out="$out, $tc MISSING ($(toolchain_languages "$tc"))"; fi
  done
  printf '%s\n' "${out#, }"
}

# kind_status <kind> -> "<state>|<detail>", state in ok|degraded|unavailable.
#
# `degraded` is a third state on purpose, and keeping it separate from
# `unavailable` is the point: ripgrep absent still yields `textual` through the
# POSIX grep fallback, which is a slower route to the same kind, not a missing
# kind. Collapsing the two would either hide a real gap or invent one.
kind_status() {
  local n_missing=0 n_present=0 tc
  case "$1" in
    resolved)
      if ! have uvx; then
        echo "unavailable|needs uv — Serena runs via uvx and it is not installed → cs impls / cs refs refuse"
        return
      fi
      for tc in $CS_TOOLCHAINS; do
        if have_toolchain "$tc"; then n_present=$((n_present + 1)); else n_missing=$((n_missing + 1)); fi
      done
      if [[ $n_missing -eq 0 ]]; then
        echo "ok|serena (LSP) via uvx; toolchains: $(toolchain_roll_call)"
      elif [[ $n_present -eq 0 ]]; then
        echo "unavailable|serena needs a toolchain per language and none are runnable: $(toolchain_roll_call) → cs impls / cs refs refuse for every preflighted language"
      else
        local _fb=""
        have_tokensave && _fb="; a tokensave graph answers cs impls (as structural) where a toolchain is missing"
        echo "degraded|$(toolchain_roll_call) → cs impls / cs refs refuse for the missing languages$_fb"
      fi
      ;;
    declared)
      if have_python3; then echo "ok|python3 reads the build manifests and CODEOWNERS"
      else echo "unavailable|needs python3, which is not runnable → cs provides / deps / publishes / versions / owns refuse"; fi
      ;;
    structural)
      # Three independent backers behind one kind: ast-grep-or-semgrep answers
      # `cs calls`, ctags answers `cs def`, a tokensave graph answers symbol mode
      # (and cs impls where no toolchain can run). Losing one is not losing the
      # tier, so the consequence is named per subcommand rather than per kind --
      # and symbol mode is named explicitly, because it is the one part of
      # `structural` with NO second engine: without tokensave it refuses outright
      # rather than degrading to something weaker.
      local have_calls=0 have_def=0 _sym
      { have ast-grep || have semgrep; } && have_calls=1
      ctags_bin >/dev/null 2>&1 && have_def=1
      if have_tokensave; then
        _sym="tokensave graph for cs callers/callees/impact and for cs impls without a toolchain"
      else
        _sym="no tokensave → cs callers / cs callees / cs impact refuse (no second engine answers a call graph)"
      fi
      if [[ $have_calls -eq 1 && $have_def -eq 1 ]]; then
        echo "ok|ast-grep/semgrep for cs calls, ctags for cs def, $_sym"
      elif [[ $have_calls -eq 0 && $have_def -eq 0 ]]; then
        echo "unavailable|needs ast-grep or semgrep, and universal-ctags — none installed → cs calls and cs def both refuse; $_sym"
      elif [[ $have_calls -eq 0 ]]; then
        echo "degraded|neither ast-grep nor semgrep installed → cs calls refuses; cs def still answers via ctags; $_sym"
      else
        echo "degraded|universal-ctags not installed → cs def refuses; cs calls still answers; $_sym"
      fi
      ;;
    historical)
      if have git; then echo "ok|git log -S / -G"
      else echo "unavailable|needs git, which is not installed → cs history refuses"; fi
      ;;
    heuristic)
      if have_python3; then echo "ok|$(text_engine) plus the python3 prose filter"
      else echo "unavailable|the prose filter needs python3, which is not runnable → cs uses refuses"; fi
      ;;
    textual)
      if have_rg_binary; then echo "ok|ripgrep"
      else echo "degraded|no ripgrep binary — POSIX grep fallback, same results, slower"; fi
      ;;
  esac
}

# The kinds view, shared by `cs engines` and `cs why`. Two lines per kind: what
# you can get, then what you lose if you cannot get it.
print_kinds_table() {
  local kind row state detail
  printf '%-12s %s\n' "ANSWER KIND" "STATUS"
  for kind in resolved declared structural historical heuristic textual; do
    row=$(kind_status "$kind")
    state="${row%%|*}"; detail="${row#*|}"
    [[ "$state" == ok ]] || state=$(printf '%s' "$state" | tr 'a-z' 'A-Z')
    printf '%-12s %s — %s\n' "$kind" "$state" "$detail"
    printf '%-12s   backs: %s\n' "" "$(kind_subcommands "$kind")"
  done
}

# Print the provenance line. Goes to stderr, so stdout stays exactly the
# scoreable "repo/path:line: text" stream every caller and score-seams expect.
report_answer() {
  local hits="${1:-}" repos="${2:-}"
  # Recorded before the early return, because --quiet suppresses the human line
  # and must not also empty the porcelain envelope.
  CS_HITS="$hits"; CS_REPOS="$repos"
  # An engine that failed but still produced output means the results are a
  # subset of the truth, exactly like a timeout. Said out loud rather than left
  # to look complete; the empty case refuses instead, via engines_ok_or_die.
  # Only when it differs from the default: a warning that fires on every run is
  # noise and gets ignored, so this one has to mean "something unusual is in
  # force". EXTRA is the dangerous direction and is called out as such.
  if [[ -n "$CS_EXCLUSION_NOTE" ]]; then
    if [[ -n "${CS_EXCLUDE_EXTRA:-}" ]]; then
      warn "searching with a NON-DEFAULT exclusion list: $CS_EXCLUSION_NOTE — files under those directories were not searched, so this result may be narrower than the fleet"
    else
      warn "searching with a non-default exclusion list: $CS_EXCLUSION_NOTE"
    fi
  fi
  if engine_failed; then
    warn "an engine failed during this query; these results are INCOMPLETE:"
    engine_error_lines | sed 's/^/  /' >&2
  fi
  # Named, not merely counted. Two broken symlinks cannot hide a symbol; a
  # skipped directory of 400 files might, and only the paths let a reader tell
  # those apart. Capped so a fleet with thousands of them stays readable.
  if reads_failed; then
    local n; n=$(unreadable_count)
    warn "$n file(s) could not be read and were skipped; this result is PARTIAL:"
    skipped_unreadable | head -10 | sed 's/^/  /' >&2
    [[ "$n" -gt 10 ]] && info "  … and $((n - 10)) more"
  fi
  # A COUNT, not the paths: these are the same paths on every answer for as long
  # as they are committed, and reprinting them was most of the noise that taught
  # readers to skip this whole block. `cs engines` names them, once.
  if corpus_skipped; then
    info "skipped: $(dangling_count) dangling symlink(s) — a corpus property, not a read failure, so NOT partial (cs engines names them)"
  fi
  [[ $quiet -eq 1 || -z "$CS_KIND" ]] && return 0
  local line="${C_BOLD}answer:${C_OFF} $CS_KIND via $CS_ENGINE"
  [[ -n "$CS_NOTE" ]] && line="$line ($CS_NOTE)"
  [[ -n "$hits" ]] && line="$line · $hits hit(s)"
  [[ -n "$repos" ]] && line="$line · $repos repo(s)"
  # The SIZE, once it is large: a caller charged by the token can see the cost
  # here before re-running, which a hit count alone does not tell it.
  [[ "$CS_OUT_BYTES" -ge 20000 ]] && line="$line · $(( (CS_OUT_BYTES + 512) / 1024 )) KB"
  info "$line"
  if [[ "$CS_ELIDED_LINES" -gt 0 ]]; then
    warn "$CS_ELIDED_LINES line(s) longer than $CS_MAX_LINE bytes were cut around the match ($CS_ELIDED_BYTES bytes elided) — --full-lines prints them whole"
  fi
  [[ -n "$CS_DEGRADED" ]] && warn "degraded: $CS_DEGRADED"
  if timed_out; then
    warn "an engine hit the ${CS_TIMEOUT:-120}s timeout $(grep -c '' "$CS_TIMEOUT_FLAG") time(s); these results are PARTIAL, not complete (raise CS_TIMEOUT)"
  fi
  if [[ -n "$CS_TRUNCATED" ]]; then
    warn "showing $CS_MAX_RESULTS of $CS_TRUNCATED — rerun with --all, or narrow the query"
  fi
  # The CORPUS bound on a zero. Everything else here is about whether the SEARCH
  # was sound; this is the one dishonest negative none of that can catch. cs
  # already knows the denominator -- it prints it in the view line -- and stating
  # it converts a silent over-read ("nothing at this company calls it") into a
  # disclosed limit. Costs one line and needs no network.
  #
  # Only on a ZERO, and only for a fleet-reading subcommand: on a positive
  # answer the bound is not what the reader is about to act on, and a note that
  # fires on every query stops being read.
  if [[ "$hits" == "0" && -n "$CS_KIND" ]]; then
    case "$CS_SUB" in
      which|why|engines|scopes|repos|gaps) ;;
      *) warn "this negative is bounded by the CORPUS, not just the search: $(count_fleet_repos) repo(s) are in view, and a repo that was never cloned cannot be searched by any query. Escalate before reporting absence: cs gaps '$CS_QUERY'" ;;
    esac
  fi
  if [[ $show_why -eq 1 ]]; then
    info ""
    blind_spots "$CS_KIND" >&2
  else
    info "  ${C_BOLD}--why${C_OFF} for what a $CS_KIND answer cannot see"
  fi
}

# Two labelled halves of one answer, capped SEPARATELY. cs fields established
# why: its reads outnumbered its writes ~7:1, and a single budget over the
# combined stream spent itself on reads and truncated the writes away -- the
# half that answers "who observes a changed default". Each kind gets an equal
# share, and a kind that does not use its share donates the remainder, so a
# query with only one side still shows the full budget.
#
# cs fields keeps its own copy of this inline because its two halves come from
# the graph already separated and it reports per-kind totals the graph gave it.
# This is the same rule for a text-derived split.
emit_two_kinds() {  # <regex-a> <regex-b> <hits>
  local ra="$1" rb="$2" all="$3"
  local a b n_a n_b cap half bud_a bud_b capped=""
  a=$(printf '%s\n' "$all" | grep -E "$ra" || true)
  b=$(printf '%s\n' "$all" | grep -E "$rb" || true)
  n_a=$(printf '%s' "$a" | grep -c '[^[:space:]]' || true)
  n_b=$(printf '%s' "$b" | grep -c '[^[:space:]]' || true)

  cap="${CS_MAX_RESULTS:-200}"
  if [[ "$cap" -le 0 ]]; then
    bud_a=$n_a; bud_b=$n_b
  else
    half=$(( cap / 2 ))
    bud_a=$half; bud_b=$(( cap - half ))
    if [[ "$n_a" -lt "$bud_a" ]]; then bud_b=$(( cap - n_a )); bud_a=$n_a; fi
    if [[ "$n_b" -lt "$bud_b" ]]; then bud_a=$(( cap - n_b )); bud_b=$n_b; fi
  fi
  # awk rather than head, for the reason emit_capped uses it: head closes the
  # pipe at the cap and the builtin printf then reports EPIPE on stderr.
  [[ "$n_a" -gt 0 ]] && capped=$(printf '%s\n' "$a" | awk -v n="$bud_a" 'NR<=n')
  if [[ "$n_b" -gt 0 ]]; then
    local part; part=$(printf '%s\n' "$b" | awk -v n="$bud_b" 'NR<=n')
    capped="${capped:+$capped
}$part"
  fi
  # Everything the two regexes did not claim, so a hit is never silently lost
  # by falling between the labels.
  local rest; rest=$(printf '%s\n' "$all" | grep -vE "$ra" | grep -vE "$rb" || true)
  if [[ -n "$rest" ]]; then
    capped="${capped:+$capped
}$rest"
  fi
  emit_plain "$capped"
  local shown; shown=$(printf '%s' "$capped" | grep -c '[^[:space:]]' || true)
  local total; total=$(printf '%s' "$all" | grep -c '[^[:space:]]' || true)
  if [[ "$shown" -lt "$total" ]]; then
    CS_TRUNCATED="$total"
    info "showing $shown of $total — the cap is applied per half, so neither side is truncated away by the other (--all, or CS_MAX_RESULTS)"
  fi
}

# Print at most CS_MAX_RESULTS lines. A fleet-wide query for a common token can
# return tens of thousands of lines on real repos; dumping those into an agent's
# context is worse than saying how many there were and where they live.
emit_capped() {
  local out="$1" total
  total=$(printf '%s\n' "$out" | grep -c '' )
  if [[ "${CS_MAX_RESULTS:-200}" -gt 0 && "$total" -gt "${CS_MAX_RESULTS}" ]]; then
    # awk, not `head`: head closes the pipe at the cap and bash's builtin
    # printf still had the rest of $out to write, so every over-cap query --
    # i.e. every fleet-wide one -- printed "printf: write error: Broken pipe"
    # on stderr, beside a correct answer, in the one channel that carries
    # PARTIAL/INCOMPLETE. awk reads to EOF, so there is nothing to report.
    emit_plain "$(printf '%s\n' "$out" | awk -v n="$CS_MAX_RESULTS" 'NR<=n')"
    CS_TRUNCATED="$total"
    # When truncating, the distribution is the useful part of what was cut.
    info ""
    info "${C_BOLD}hits per repo (all $total, not just those shown):${C_OFF}"
    printf '%s\n' "$out" | cut -d/ -f1 | sort | uniq -c | sort -rn | sed 's/^/  /' >&2
  else
    emit_plain "$out"
  fi
}

# The single door to stdout. In porcelain mode the lines are buffered into the
# JSON envelope instead of printed, so that stdout carries exactly one object
# and no subcommand has to know which mode it is running in.
emit_plain() {
  # stdout is the result stream, one hit per line and nothing else -- so an
  # empty result writes ZERO bytes, not a bare newline. `printf '%s\n' ""`
  # emitted one byte, which made `cs deps | wc -l` report 1 for no results.
  [[ -n "$1" ]] || return 0
  local body="$1"
  # Called directly, not in $(...): the elision tallies are globals, and an
  # assignment made in a subshell never reaches the envelope.
  if [[ -n "${CS_PRECAPPED:-}" ]]; then
    tally_elisions "$body"
  elif [[ "${CS_MAX_LINE:-400}" -gt 0 ]]; then
    cap_hit_lines "$body"; body="$CS_CAPPED"
  fi
  CS_OUT_BYTES=$((CS_OUT_BYTES + $(printf '%s\n' "$body" | LC_ALL=C wc -c)))
  if [[ $porcelain -eq 1 ]]; then
    if [[ -n "$CS_RESULTS" ]]; then CS_RESULTS="$CS_RESULTS
$body"; else CS_RESULTS="$body"; fi
  else
    printf '%s\n' "$body"
  fi
}

# ---- one hit line is not allowed to be the whole answer --------------------
# The hit COUNT was small (27) and the answer was 110 KB: six lines of a
# generated SVG diagram, inline CSS on one line, were 96% of it, and the longest
# single line was 62 KB. Over MCP that is ~27k tokens charged for two useful
# lines, and unlike a large hit count it cannot be seen coming -- --count says
# 27 and the cost is in line LENGTH.
#
# So the text of each line is cut to CS_MAX_LINE bytes (default 400) AROUND THE
# MATCH, with the elided byte counts written where the bytes were. The
# `repo/path:line:` prefix is never cut: it is the address a reader opens.
# --full-lines (or CS_MAX_LINE=0) prints lines whole.
#
# Bytes, in the C locale, so the budget means the same thing on every awk -- and
# a cut is moved off a UTF-8 continuation byte so a multibyte character is never
# split into invalid output (the porcelain envelope must stay valid UTF-8).
CS_MAX_LINE="${CS_MAX_LINE:-400}"
case "$CS_MAX_LINE" in ''|*[!0-9]*) CS_MAX_LINE=400 ;; esac
CS_OUT_BYTES=0; CS_ELIDED_LINES=0; CS_ELIDED_BYTES=0
cap_hit_lines() {  # <lines> -> CS_CAPPED, each line capped; tallies the cuts
  local capped stats
  capped=$(printf '%s\n' "$1" | LC_ALL=C awk -v max="$CS_MAX_LINE" -v q="$CS_QUERY" '
    function cont(c) { return (c >= "\200" && c < "\300") }
    BEGIN { lq = tolower(q); nl = 0; nb = 0 }
    {
      line = $0
      if (length(line) <= max) { print line; next }
      # The address: `repo/path:NN:` -- the first :digits: after the repo --
      # and a verb'"'"'s side tag after it (`[write]`, `[read]`), which says
      # what the line IS.
      pre = ""; text = line
      if (match(line, /^[^\/]+\/[^:]+:[0-9]+:/)) {
        pre = substr(line, 1, RLENGTH); text = substr(line, RLENGTH + 1)
        if (match(text, /^ ?\[[a-z]+\] /)) {
          pre = pre substr(text, 1, RLENGTH); text = substr(text, RLENGTH + 1)
        }
      }
      if (length(text) <= max) { print line; next }
      at = (lq != "") ? index(tolower(text), lq) : 0
      if (at > 0) {
        start = at - int((max - length(q)) / 2)
        if (start < 1) start = 1
      } else {
        start = 1
      }
      if (start + max - 1 > length(text)) start = length(text) - max + 1
      stop = start + max - 1
      while (start > 1 && cont(substr(text, start, 1))) start++
      while (stop < length(text) && cont(substr(text, stop + 1, 1))) stop--
      head = start - 1; tail = length(text) - stop
      out = pre
      if (head > 0) out = out "…(" head " bytes elided)…"
      out = out substr(text, start, stop - start + 1)
      if (tail > 0) out = out "…(" tail " bytes elided)"
      print out
      nl++; nb += head + tail
    }
    END { printf "\001%d %d\n", nl, nb }
  ')
  stats="${capped##*$'\001'}"
  capped="${capped%$'\n'$'\001'*}"
  [[ "$capped" == $'\001'* ]] && capped=""
  CS_ELIDED_LINES=$((CS_ELIDED_LINES + ${stats%% *}))
  CS_ELIDED_BYTES=$((CS_ELIDED_BYTES + ${stats##* }))
  CS_CAPPED="$capped"
}

# For a verb that capped its own lines (cs values: its annotation sits between
# the address and the raw text, and only the verb knows where one ends and the
# other begins), the cuts are tallied from the markers it wrote, so the warning
# and the porcelain envelope still count them.
CS_PRECAPPED=""
tally_elisions() {  # <lines> -> adds to CS_ELIDED_LINES / CS_ELIDED_BYTES
  local stats
  stats=$(printf '%s\n' "$1" | LC_ALL=C awk '
    BEGIN { nl = 0; nb = 0 }
    {
      rest = $0; cut = 0
      while (match(rest, /…\([0-9]+ bytes elided\)/)) {
        m = substr(rest, RSTART, RLENGTH); gsub(/[^0-9]/, "", m)
        nb += m; cut = 1
        rest = substr(rest, RSTART + RLENGTH)
      }
      nl += cut
    }
    END { printf "%d %d\n", nl, nb }
  ')
  CS_ELIDED_LINES=$((CS_ELIDED_LINES + ${stats%% *}))
  CS_ELIDED_BYTES=$((CS_ELIDED_BYTES + ${stats##* }))
}

# Of these hit lines, the subset where the pattern matched as a WHOLE
# identifier rather than inside a longer one.
#
# `cs seam`'s orphan warning -- "only one repo mentions this, a producer with no
# consumer, or dead" -- is this tool's dead-code detector, and a SUBSTRING match
# in an unrelated repo silently removed it. A queue handler named
# AccessionUpdateIn stopped looking dead because a different repo declared a
# GraphQL type called AccessionUpdateInput. The consequence is inverted from a
# normal false positive: extra hits do not add noise, they delete a warning, and
# the reading flips from "this looks dead" to "two repos use it, leave it alone".
# Names of that shape -- FooIn/FooInput, Handler/HandlerFactory, Update/
# UpdateRequest -- are ordinary, so any identifier that is a prefix of a longer
# one anywhere in the fleet lost its warning.
#
# The prefix is stripped before testing, so a pattern occurring in a FILE NAME
# cannot pass itself off as a whole-identifier hit in the code.
#
# The line numbers are passed as a FILE, not through `awk -v`. POSIX leaves a
# literal newline in a -v operand undefined; BSD awk -- /usr/bin/awk on macOS --
# rejects it outright with "newline in string", exits 2, and writes nothing.
# That made this function return empty for every query with TWO OR MORE
# whole-word hits, and an empty result here reads as "no repo mentions this as a
# whole identifier": the orphan warning. A live cross-repo seam was reported as
# dead, which is the inverse of the bug this function was added to fix and the
# outcome the whole project exists to prevent.
#
# It survived a 79-check run because every fixture query yielded at most ONE
# whole-word hit, so `keep` was always a single line and -v behaved. Invisible
# below two matches, certain at or above -- hence the multi-hit fixture cases in
# verify-search.
#
# Returns awk's exit status, so the caller can tell "no whole-word hits" from
# "the analysis did not run". An empty result from a broken helper is not an
# answer, which is the rule cs already applies to ripgrep and filter_code.py.
whole_word_hits() {  # <pattern>, hit lines on stdin
  local pat="$1" all stripped keep tmp rc
  all=$(cat)
  [[ -n "$all" ]] || return 0
  stripped=$(printf '%s\n' "$all" | sed 's/^[^:]*:[0-9]*: \{0,1\}//')
  keep=$(printf '%s\n' "$stripped" | grep -nwF -- "$pat" 2>/dev/null | cut -d: -f1)
  [[ -n "$keep" ]] || return 0
  tmp=$(cs_tmp cs-word)
  printf '%s\n' "$keep" > "$tmp"
  printf '%s\n' "$all" | awk 'NR == FNR { want[$1] = 1; next } want[FNR]' "$tmp" -
  rc=$?
  rm -f "$tmp"
  return $rc
}

n_repos_in() { printf '%s\n' "$1" | cut -d/ -f1 | sort -u | grep -c ''; }
n_hits_in()  { printf '%s\n' "$1" | grep -c ''; }

# --count for a TEXT answer: the per-repo tally, and no hit bodies.
#
# The reason it exists is a caller that pays per hit. A human at a terminal
# scrolls past 200 lines for free; an MCP caller reads them into a context
# window and is charged by the token. One measured exploratory `cs text` over a
# 43-repo fleet returned 642 hits in 12 repos, showed 200 of them, and cost
# roughly 15,000 tokens -- for a query whose only purpose was to find out WHICH
# REPO to look in. That is the question a tally answers in a few hundred.
#
# It runs the SAME pipeline the listing does and only changes what is emitted,
# so the numbers here are the numbers that mode would have shown -- including
# every narrowing (--word, --source-only, the prose filter) that already
# applied. A count computed by a shortcut would be a different question wearing
# this one's heading, which is the failure cs fields --count was built to avoid.
#
# Uncapped, deliberately. The rows are bounded by the fleet -- one line per repo
# -- so there is no budget to spend, and truncating a tally would destroy the
# one property that makes it worth asking for: that it is a complete
# denominator. emit_plain, not emit_capped, for that reason.
emit_repo_counts() {  # <hits> <unit> <the same query, listing the hits>
  local hits="$1" unit="$2" listing="$3" rows total n_repos
  rows=$(printf '%s\n' "$hits" | cut -d/ -f1 | sort | uniq -c \
         | sort -rn | awk '{printf "%s: %s\n", $2, $1}')
  emit_plain "$rows"
  total=$(n_hits_in "$hits")
  n_repos=$(n_repos_in "$hits")
  info ""
  info "${C_BOLD}total: $total $unit across $n_repos repo(s)${C_OFF}"
  info "  counts only — no hit bodies were read into this answer"
  # Named rather than implied. None of the three text verbs takes a repo
  # argument, so a hint offering to narrow to one would name a command that
  # does not exist -- and the repo names above are still the answer: they say
  # where to point cs def, cs refs, or an editor.
  info "  the hits themselves: $listing"
  info "  the repo names are the useful half — cs text/seam/uses search the whole view, so narrow by asking a sharper question there (cs def, cs refs, cs callers)"
}

# Print the comment header verbatim, so usage cannot drift from the file.
usage() {
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
  exit "${1:-0}"
}

cmd_engines() {
  local n=0
  printf '%-12s %s\n' "ENGINE" "STATUS"
  # Listed first, and separately from the optional engines below, because it is
  # the only REQUIRED one: the others degrade to each other, python3 does not.
  # Its absence used to be invisible here, which is why `cs uses` on a machine
  # without it looked like a working search that found nothing.
  if have_python3; then printf '%-12s %s\n' "python3" "ok (REQUIRED by: uses, provides, deps, publishes)"
  else printf '%-12s %s\n' "python3" "MISSING — REQUIRED: uses/provides/deps/publishes cannot run"; fi
  if have_rg_binary; then printf '%-12s %s\n' "ripgrep" "ok"; n=$((n+1))
  else printf '%-12s %s\n' "ripgrep" "absent - using POSIX grep fallback"; fi
  for e in ast-grep semgrep; do
    if have "$e"; then printf '%-12s %s\n' "$e" "ok"; n=$((n+1))
    else printf '%-12s %s\n' "$e" "MISSING"; fi
  done
  if ctags_bin >/dev/null; then printf '%-12s %s\n' "ctags" "ok ($(ctags_bin))"; n=$((n+1))
  else printf '%-12s %s\n' "ctags" "MISSING (brew install universal-ctags)"; fi
  if have uvx; then printf '%-12s %s\n' "serena" "ok (via uvx)"; n=$((n+1))
  else printf '%-12s %s\n' "serena" "MISSING (needs uv)"; fi
  if have git; then printf '%-12s %s\n' "git" "ok (cs history)"; n=$((n+1))
  else printf '%-12s %s\n' "git" "MISSING (cs history unavailable)"; fi
  # Reported with its AGE, because a graph is the only engine here that answers
  # about the code as of its last sync -- it can be confidently wrong rather
  # than merely blind, and nothing else in this table has that failure mode.
  if have_tokensave; then
    local g_n=0 g_oldest="" g_age d
    for d in $(real_dirs); do
      tokensave_graph_at "$d" || continue
      g_n=$((g_n + 1))
      g_age=$(tokensave_graph_age_secs "$d") || continue
      [[ -n "$g_age" ]] || continue
      if [[ -z "$g_oldest" || "$g_age" -gt "$g_oldest" ]]; then g_oldest="$g_age"; fi
    done
    if [[ $g_n -eq 0 ]]; then
      printf '%-12s %s\n' "tokensave" "ok, but no repo has a graph (cd <repo> && tokensave init) — cs callers/callees/impact refuse, and cs impls has no fallback where a toolchain is missing"
    else
      printf '%-12s %s\n' "tokensave" "ok ($g_n repo graph(s), oldest last synced $( [[ -n "$g_oldest" ]] && format_age "$g_oldest" || printf '?' ) ago; answers cs callers/callees/impact, and cs impls where no language server can run)"
    fi
  else
    printf '%-12s %s\n' "tokensave" "MISSING — cs callers / cs callees / cs impact refuse (nothing else here answers a call graph); cs impls loses its fallback where a language toolchain cannot be installed"
  fi
  # The one engine that needs NETWORK, and the only one whose absence leaves a
  # CORPUS question unanswerable rather than a search question. Reported like
  # any other so its absence is visible rather than assumed.
  if have "${CS_FORGE_BIN:-gh}"; then
    if have_forge; then
      printf '%-12s %s\n' "forge" "ok (${CS_FORGE_BIN:-gh}, authenticated) — cs gaps can bound a fleet-scoped negative against the org"
    else
      printf '%-12s %s\n' "forge" "${CS_FORGE_BIN:-gh} present but NOT authenticated — cs gaps refuses (an unauthenticated query fails per call, and a per-call failure that reads as empty is a false zero); ${CS_FORGE_BIN:-gh} auth login"
    fi
  else
    printf '%-12s %s\n' "forge" "MISSING — cs gaps refuses; a fleet-scoped negative cannot be escalated org-wide and stays bounded by the fleet"
  fi
  # Serena is a driver, not an analyser: uvx present says nothing about whether
  # a C# or Kotlin project can be LOADED. Reported here so the gap is visible
  # before a query is run, rather than only after one returns empty.
  local tc
  for tc in $CS_TOOLCHAINS; do
    if have_toolchain "$tc"; then
      printf '%-12s %s\n' "$tc" "ok (Serena can analyse $(toolchain_languages "$tc"))"
    else
      printf '%-12s %s\n' "$tc" "MISSING — Serena cannot analyse $(toolchain_languages "$tc"); cs impls/refs refuse there"
    fi
  done

  # Binaries are not the fact a caller needs. This is.
  printf '\n'
  print_kinds_table

  printf '\nfleet root:  %s\n' "$root"
  printf 'text engine: %s\n' "$(text_engine)"
  printf 'result cap:  %s\n' \
    "$([[ "${CS_MAX_RESULTS:-200}" -eq 0 ]] && echo "none" || echo "${CS_MAX_RESULTS:-200} (CS_MAX_RESULTS, or --all)")"
  if timeout_bin >/dev/null; then
    printf 'timeout:     %ss (CS_TIMEOUT)\n' "${CS_TIMEOUT:-120}"
  else
    printf 'timeout:     %s\n' "NONE — no timeout(1) on this machine, so a hung engine hangs cs (brew install coreutils)"
  fi
  # Printed because every entry here is a place results cannot come from, and a
  # directory excluded by mistake looks exactly like a directory with no hits.
  printf 'skipping:    %s\n' "$(printf '%s ' ${CS_EXCLUDE_DIRS[@]+"${CS_EXCLUDE_DIRS[@]}"})"
  printf '             (CS_EXCLUDE_EXTRA adds, CS_EXCLUDE_REMOVE subtracts)\n'
  # The other place results cannot come from, and the one that is a property of
  # the corpus rather than of this machine: a symlink COMMITTED to a repo whose
  # target is not in that repo is unreadable on every checkout but its author's,
  # permanently. It is named here, once, so that per-answer output can carry a
  # count instead of the paths -- see the note on is_dangling_link. This is the
  # only place in cs that walks the fleet purely to report on it, which is why
  # it lives in the diagnostic subcommand and not on the query path.
  local dangling n_dangling
  dangling=$(find_dangling_links | sed -e "s|^${view}/||" | sort -u)
  n_dangling=$(printf '%s' "$dangling" | grep -c '[^[:space:]]')
  if [[ "$n_dangling" -gt 0 ]]; then
    printf 'corpus:      %s dangling symlink(s) — tracked in a repo, target absent on this machine, unreadable on every checkout\n' "$n_dangling"
    printf '%s\n' "$dangling" | head -20 | sed 's/^/             /'
    [[ "$n_dangling" -gt 20 ]] && printf '             … and %s more\n' "$((n_dangling - 20))"
    printf '             these are NOT reported as PARTIAL: rerunning cannot change them, so they say nothing about whether a search finished\n'
    printf '             remove them in the owning repo, or accept them — a query answer carries the count, not the paths\n'
  else
    printf 'corpus:      no dangling symlinks — every tracked file in the view is readable\n'
  fi
  # Reported in both directions. A log nobody knows is running is the privacy
  # problem the opt-in default exists to avoid, and a log somebody believes is
  # running when it is not is how a measurement window turns out empty.
  if [[ -n "$CS_LOG_PATH" ]]; then
    printf 'query log:   %s (query text: %s)\n' "$CS_LOG_PATH" "$CS_LOG_QUERY"
  else
    printf 'query log:   off (CS_LOG unset)\n'
  fi
  # Exits 0 whatever it found. Under the exit-code contract, 1 means "the query
  # did not run" -- and a diagnostic that ran, printed a full report, and then
  # claimed to have refused is exactly the confusion the codes exist to remove.
  # What is missing is in the report; the status says only that reporting worked.
  [[ $n -gt 0 ]] || warn "no optional engine is installed — see the ANSWER KIND table above for what that costs"
  return 0
}

# ---- cs doctor -------------------------------------------------------------
# `cs engines` answers "what is installed". The question someone setting up
# actually has is different -- "will cs work on MY repos, and if not, what do I
# run?" -- and three of its answers were discoverable only by a query going
# wrong (#67): a python3 too old for tomllib with a newer one later on PATH; a
# Kotlin repo whose Gradle toolchain wants a JDK that is installed but invisible
# (Homebrew's openjdk is keg-only, so /usr/bin/java stays the stub); and which
# language needs which toolchain at all. So this reads the FLEET as well as the
# machine: a toolchain is flagged only for a language the fleet contains, and
# every line that is not ok says what it costs and what fixes it.
#
# Exit 0 when nothing is flagged and 3 when something is, so a script can gate
# on it. Not 1: the diagnosis RAN, and 1 means "did not run". Not 2 either --
# that is a query's honest zero.
CS_EXIT_DOCTOR_FLAGGED=3
doc_n_ok=0; doc_n_flagged=0; doc_n_unchecked=0

doc_row() {  # <ok|warn|bad|unchecked> <item> <status> [costs] [fix, may be multi-line]
  local mark line
  case "$1" in
    ok)        mark="${D_G}✓${D_O}"; doc_n_ok=$((doc_n_ok + 1)) ;;
    warn)      mark="${D_Y}!${D_O}"; doc_n_flagged=$((doc_n_flagged + 1)) ;;
    bad)       mark="${D_R}✗${D_O}"; doc_n_flagged=$((doc_n_flagged + 1)) ;;
    unchecked) mark="?";             doc_n_unchecked=$((doc_n_unchecked + 1)) ;;
  esac
  printf '  %s %-12s %s\n' "$mark" "$2" "$3"
  [[ -n "${4:-}" ]] && printf '    %-12s costs: %s\n' "" "$4"
  if [[ -n "${5:-}" ]]; then
    local first=1
    while IFS= read -r line; do
      if [[ $first -eq 1 ]]; then printf '    %-12s fix:   %s\n' "" "$line"; first=0
      else printf '    %-12s        %s\n' "" "$line"; fi
    done <<< "$5"
  fi
  return 0
}

doc_install() {  # <brew formula> <what to install, for other platforms>
  if have brew; then printf 'brew install %s' "$1"; else printf 'install %s' "$2"; fi
}

# "a, b, c (+N more)" from one name per line.
doc_list() {
  local all n
  all=$(grep -v '^$' || true)
  n=$(printf '%s' "$all" | grep -c '' || true)
  if [[ "$n" -le 4 ]]; then printf '%s' "$all" | paste -sd, - | sed 's/,/, /g'
  else printf '%s (+%s more)' "$(printf '%s\n' "$all" | head -4 | paste -sd, - | sed 's/,/, /g')" "$((n - 4))"; fi
}

doc_python() {
  if ! have_python3; then
    doc_row bad python3 "MISSING or not runnable — REQUIRED" \
      "uses, provides, deps, publishes, versions, owns, impls, refs, fields and symbol mode all refuse" \
      "$(have brew && echo 'brew install python' || echo 'install Python 3.11+ from your OS')"
    return
  fi
  local p v c cv better=""
  p=$(command -v python3)
  v=$(python3 -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>/dev/null)
  if python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
    doc_row ok python3 "$v ($p)"
    return
  fi
  # A newer one is often installed already and merely later on PATH -- the
  # case that was found, and the cheapest fix there is.
  for c in $(type -ap python3 2>/dev/null) /opt/homebrew/bin/python3 /usr/local/bin/python3 \
           /home/linuxbrew/.linuxbrew/bin/python3; do
    [[ -x "$c" && "$c" != "$p" ]] || continue
    cv=$("$c" -c 'import sys; sys.exit(1) if sys.version_info < (3, 11) else print("%d.%d" % sys.version_info[:2])' 2>/dev/null) || continue
    better="$c ($cv)"; break
  done
  local fix bdir brew_bin
  if [[ -n "$better" ]]; then
    bdir=${better%%/python3*}
    brew_bin=$(command -v brew 2>/dev/null || true)
    [[ -z "$brew_bin" && -x "$bdir/brew" ]] && brew_bin="$bdir/brew"
    if [[ -n "$brew_bin" && "${brew_bin%/brew}" == "$bdir" ]]; then
      # Homebrew's own way of putting itself first, rather than a PATH edit
      # that drifts from what `brew` expects.
      fix="${better} is already installed, but ${p%/python3} comes first on PATH. Paste:
  $(profile_line path "eval \"\$($brew_bin shellenv)\"")"
    else
      fix="${better} is already installed, but ${p%/python3} comes first on PATH. Paste:
  $(profile_line path "export PATH=\"$bdir:\$PATH\"")"
    fi
  else
    fix="install Python 3.11+ ($(have brew && echo 'brew install python' || echo 'from your OS')), and put it first on PATH"
  fi
  fix="$fix
then open a new terminal, and restart Claude Code so the MCP server sees it"
  doc_row warn python3 "$v ($p) — older than 3.11, so no tomllib" \
    "cs versions / cs deps cannot read Gradle version catalogs (gradle/libs.versions.toml), and read pyproject.toml with a fallback scanner" \
    "$fix"
}

doc_fleet() {
  local n
  if [[ ! -d "$root" ]]; then
    doc_row bad fleet "root does not exist: $root" "every search command refuses" \
"set FLEET_ROOT in ~/.config/repo-fleet/fleet.env (or the environment)
fleet-init --config --fleet-root <dir> --tickets-root <dir>   (fleet-workspace plugin)"
    return
  fi
  local strays
  n=$(count_fleet_repos)
  strays=$(non_repo_entries | doc_list)
  if [[ "$n" -eq 0 ]]; then
    doc_row bad fleet "no repositories in $root${strays:+ (not git repos, so not searched: $strays)}" \
      "every search command refuses" \
      "clone some: fleet-init --clone <owner/repo> ...   (or git clone into $root)"
  else
    doc_row ok fleet "$n repo(s) in $root${strays:+; not git repos, so not searched: $strays}"
  fi
}

# The roots --ticket= and an MCP scope resolve against (#59). A configured root
# that does not exist, or holds no workspace, used to surface only as a refusal
# in the middle of a task (#72). The default TICKETS_ROOT is not flagged when
# absent: nobody asked for it.
doc_workspaces() {
  local r all n mixed names="" parts="" bad="" w v inner
  all=$(discover_workspaces 2>/dev/null)
  local IFS_save="$IFS" configured=""
  [[ "${TICKETS_ROOT_DEFAULTED:-0}" -eq 1 && ! -d "$TICKETS_ROOT" ]] || configured="$TICKETS_ROOT"
  IFS=:; for r in ${WORKSPACE_ROOTS:-}; do [[ -n "$r" ]] && configured="$configured
$r"; done; IFS="$IFS_save"
  if [[ -z "$(printf '%s' "$configured" | grep .)" ]]; then
    doc_row ok workspaces "none configured — every scope is the fleet (TICKETS_ROOT / WORKSPACE_ROOTS in fleet.env add ticket workspaces)"
    return
  fi
  while IFS= read -r r; do
    [[ -n "$r" ]] || continue
    if [[ ! -d "$r" ]]; then bad="$bad $r"; continue; fi
    r=$(real_path_of "$r" 2>/dev/null || printf '%s' "$r")
    n=0; mixed=0; names=""
    while IFS=$'\t' read -r _ w; do
      [[ -n "$w" ]] || continue
      n=$((n + 1)); inner=0
      while IFS=$'\t' read -r _ v; do [[ "$v" == "$w"/* ]] && inner=$((inner + 1)); done <<< "$all"
      [[ $inner -gt 0 ]] && { mixed=$((mixed + 1)); names="$names${w#"$r"/}
"; }
    done <<< "$(printf '%s\n' "$all" | awk -F'\t' -v r="$r" '$1 == r')"
    parts="${parts:+$parts; }$n under $r$([[ $mixed -gt 0 ]] && printf ' (%s mixed: %s)' "$mixed" "$(printf '%s' "$names" | doc_list)")"
  done <<< "$configured"
  if [[ -n "$bad" ]]; then
    doc_row warn workspaces "configured but missing:$bad${parts:+; $parts}" \
      "--ticket= and an MCP scope under it refuse mid-task" \
      "create it (mkdir -p$bad), or correct TICKETS_ROOT / WORKSPACE_ROOTS in ~/.config/repo-fleet/fleet.env"
  else
    doc_row ok workspaces "$parts"
  fi
}

doc_engines() {
  if have_rg_binary; then doc_row ok ripgrep "$(rg --version 2>/dev/null | head -1)"
  else doc_row warn ripgrep "absent — text search uses POSIX grep" \
    "cs text / seam / uses are much slower on a large fleet" "$(doc_install ripgrep ripgrep)"; fi
  if have ast-grep || have semgrep; then
    doc_row ok structural "$(have ast-grep && printf 'ast-grep' || printf 'semgrep')$(have ast-grep && have semgrep && printf ' (semgrep as fallback)')"
  else doc_row warn structural "neither ast-grep nor semgrep" "cs calls refuses" "$(doc_install ast-grep ast-grep)"; fi
  if ctags_bin >/dev/null; then doc_row ok ctags "universal-ctags ($(ctags_bin))"
  else doc_row warn ctags "no universal-ctags" "cs def falls back to tokensave graphs, or refuses where there are none" \
    "$(doc_install universal-ctags universal-ctags)"; fi
  if have git; then doc_row ok git "$(git --version 2>/dev/null)"
  else doc_row warn git "MISSING" "cs history is unavailable" "$(doc_install git git)"; fi

  # Coverage, not presence: a graph answers only in the repo it was built in, and
  # a repo without one is a place cs callers/callees/impact cannot see into.
  if have_tokensave; then
    local d total=0 without="" n_with=0 age oldest="" aged="" excluded=""
    for d in $(real_dirs); do
      # Kept graph-less on purpose (CS_NO_GRAPH): named, not counted, not a fix.
      if graph_excluded "${d##*/}" && ! tokensave_graph_at "$d"; then excluded="$excluded${d##*/}
"; continue; fi
      total=$((total + 1))
      if tokensave_graph_at "$d"; then
        n_with=$((n_with + 1))
        age=$(tokensave_graph_age_secs "$d") || age=""
        [[ -n "$age" && ( -z "$oldest" || "$age" -gt "$oldest" ) ]] && oldest="$age"
      else without="$without${d##*/}
"; fi
    done
    # Age, because a graph answers about the code as of its last sync -- the
    # one engine here that can be confidently wrong rather than merely blind.
    [[ -n "$oldest" ]] && aged=", oldest last synced $(format_age "$oldest") ago"
    [[ -n "$excluded" ]] && aged="$aged; without one on purpose (CS_NO_GRAPH): $(printf '%s' "$excluded" | doc_list)"
    if [[ $total -eq 0 ]]; then
      doc_row ok tokensave "installed (no repos to graph yet)"
    elif [[ $n_with -eq $total ]]; then
      doc_row ok tokensave "graphs in all $total repo(s)$aged"
    else
      doc_row warn tokensave "graphs in $n_with of $total repo(s)$aged" \
        "cs callers / callees / impact refuse in the rest, and cs impls has no fallback there where a toolchain is missing: $(printf '%s' "$without" | doc_list)" \
        "cd <repo> && tokensave init   (in each; fleet-workspace's refresh keeps them synced)
or, for a repo left unindexed on purpose: add it to CS_NO_GRAPH=\"…\" in ~/.config/repo-fleet/fleet.env"
    fi
  else
    doc_row warn tokensave "MISSING" \
      "cs callers / callees / impact refuse (nothing else answers a call graph), and cs impls loses its fallback where a toolchain is missing" \
      "$(doc_install aovestdipaperino/tap/tokensave 'tokensave (github.com/aovestdipaperino/tokensave)')"
  fi
  if have uvx; then doc_row ok serena "via uvx — language servers download on first use"
  else doc_row warn serena "uv MISSING, so Serena cannot run" "cs impls / cs refs refuse in every repo" "$(doc_install uv uv)"; fi
  if have "${CS_FORGE_BIN:-gh}"; then
    if have_forge; then doc_row ok forge "${CS_FORGE_BIN:-gh}, authenticated"
    else doc_row warn forge "${CS_FORGE_BIN:-gh} present but not authenticated" "cs gaps refuses" "${CS_FORGE_BIN:-gh} auth login"; fi
  else doc_row warn forge "no gh" "cs gaps refuses: a fleet-scoped negative cannot be checked org-wide" "$(doc_install gh 'the GitHub CLI'), then gh auth login"; fi
  if timeout_bin >/dev/null; then doc_row ok timeout "$(command -v "$(timeout_bin)")"
  else doc_row warn timeout "no timeout(1)" "a hung language server hangs cs with no upper bound" "$(doc_install coreutils coreutils)"; fi
}

# Languages a repo is written in: each with at least 3 tracked files, so one
# stray build script does not make a Kotlin repo "need node".
doc_repo_languages() {  # <repo-dir>
  local n ext lang
  { git -C "$1" ls-files 2>/dev/null || find "$1" -type f 2>/dev/null; } \
    | sed -n 's/.*\.\([A-Za-z0-9_]\{1,\}\)$/\1/p' | tr 'A-Z' 'a-z' | sort | uniq -c \
    | while read -r n ext; do
        [[ "$n" -ge 3 ]] || continue
        lang=$(ext_language "$ext") && printf '%s\n' "$lang"
      done | sort -u
}


# Each Serena project file against the languages its repo is written in (#95).
# Serena's own file enables only the majority language, and the minority's
# symbols are then refused. A repo is "written in" a language at 3 tracked
# source files AND 5% of the ones cs recognises, not counting .kts, so a Java
# repo's Gradle scripts do not make it a Kotlin one, and 10 .py files in a
# 4,600-file TypeScript monorepo do not ask for a server that might not start. And JDTLS's bin/ copies of the .kt sources, where Serena can
# see them: a lookup that lands on a copy gets an empty answer.
doc_serena_projects() {
  local d name on keys missing miss="" copies="" n_proj=0 f k tc w
  for d in $(real_dirs); do
    [[ -f "$d/.serena/project.yml" ]] || continue
    n_proj=$((n_proj + 1)); name=${d##*/}
    on=$(python3 "$lib_dir/serena_project.py" languages "$d") || continue
    keys=$({ git -C "$d" ls-files 2>/dev/null || find "$d" -type f 2>/dev/null; } \
      | sed -n 's/.*\.\([A-Za-z0-9_]\{1,\}\)$/\1/p' | tr 'A-Z' 'a-z' | grep -vx kts \
      | sort | uniq -c | while read -r n ext; do
          lang=$(ext_language "$ext") && printf '%s %s\n' "$(serena_ls_key "$lang")" "$n"
        done | awk '$1 != "" { c[$1] += $2; t += $2 }
                    END { for (k in c) if (c[k] >= 3 && c[k] * 20 >= t) print k }' | sort -u)
    # A server that cannot start stops every server in the repo (Serena's
    # manager starts all or none), so a language whose toolchain is missing is
    # named with it: adding that one first would break the repo's other answers.
    missing=$(for k in $keys; do
                printf '%s\n' "$on" | grep -qE "^${k}(_|\$)" && continue
                tc=""
                case "$k" in
                  (csharp) have_toolchain dotnet || tc=dotnet ;;
                  (typescript) have_toolchain node || tc=node ;;
                  (kotlin) w=$(kotlin_jdk_unmet "$d") && tc="a JDK $w" ;;
                esac
                printf '%s\n' "$k${tc:+: needs $tc first}"
              done | paste -sd';' - | sed 's/;/; /g')
    [[ -n "$missing" ]] && miss="$miss$name (no $missing)
"
    if printf '%s\n' "$on" | grep -qx java && printf '%s\n' "$on" | grep -qx kotlin \
       && ! python3 "$lib_dir/serena_project.py" ignored "$d" | grep -q 'bin'; then
      f=$(find "$d" -path "$d/.git" -prune -o -path '*/bin/*' -name '*.kt' -print 2>/dev/null | head -1)
      if [[ -n "$f" ]] && ! git -C "$d" check-ignore -q "${f#"$d"/}" 2>/dev/null \
         && [[ -z "$(git -C "$d" ls-files -- "${f#"$d"/}" 2>/dev/null)" ]]; then
        copies="$copies$name
"
      fi
    fi
  done
  [[ $n_proj -gt 0 ]] || return 0
  [[ -n "$miss" ]] && doc_row warn project.yml "Serena project files that leave out a language the repo is written in: $(printf '%s' "$miss" | doc_list)" \
    "no server runs for that language there, so cs impls / cs refs refuse for its symbols" \
    "add the language to language_servers: in <repo>/.serena/project.yml (Serena enables only the majority language when it writes the file); install a toolchain named first, since a server that cannot start stops the repo's others"
  [[ -n "$copies" ]] && doc_row warn project.yml "JDTLS's bin/ copies of the Kotlin sources are visible to Serena in: $(printf '%s' "$copies" | doc_list)" \
    "a lookup that lands on a copy gets an empty answer from a server that does not own it (cs impls skips copies; Serena's own tools do not)" \
    "add bin/ to the repo's .gitignore, or \"**/bin/**\" to ignored_paths: in <repo>/.serena/project.yml"
  [[ -z "$miss$copies" ]] && doc_row ok project.yml "$n_proj repo(s) with a Serena project file, each enabling every language it is written in"
  return 0
}

doc_languages() {
  local d lang census langs repos n
  census=$(for d in $(real_dirs); do
             doc_repo_languages "$d" | awk -v n="${d##*/}" -v d="$d" '{ print $0 "\t" n "\t" d }'
           done)
  langs=$(printf '%s\n' "$census" | cut -f1 | grep -v '^$' | sort -u)
  if [[ -z "$langs" ]]; then
    doc_row unchecked languages "no source languages recognised in the fleet"
    return
  fi
  have uvx || info "  (uv is missing, so no language below can be resolved until it is installed)"
  local label
  for lang in $langs; do
    case "$lang" in
      csharp) label="C#" ;; java) label="Java" ;; kotlin) label="Kotlin" ;; python) label="Python" ;;
      typescript) label="TypeScript" ;; javascript) label="JavaScript" ;; go) label="Go" ;; rust) label="Rust" ;;
      *) label="$lang" ;;
    esac
    repos=$(printf '%s\n' "$census" | awk -F'\t' -v l="$lang" '$1 == l { print $2 }')
    n=$(printf '%s\n' "$repos" | grep -c .)
    case "$lang" in
      csharp)
        local cd st fw_repos="" n_fw n_graph=0
        while IFS= read -r cd; do
          [[ -n "$cd" ]] || continue
          st=$(csharp_project_styles "$cd")
          [[ "${st#* }" -gt 0 ]] && fw_repos="$fw_repos${cd##*/}
"
          tokensave_graph_at "$cd" && n_graph=$((n_graph + 1))
        done <<< "$(printf '%s\n' "$census" | awk -F'\t' '$1 == "csharp" { print $3 }')"
        n_fw=$(printf '%s' "$fw_repos" | grep -c . || true)
        if have_toolchain dotnet; then
          doc_row ok C# "$n repo(s) — dotnet $(dotnet --version </dev/null 2>/dev/null | head -1)$([[ $n_fw -gt 0 ]] && printf '; %s with .NET Framework projects, which load without their reference assemblies (framework and package types do not resolve, the repo'"'"'s own do)' "$n_fw")"
        else doc_row warn C# "$n repo(s) — no runnable dotnet$([[ $n_fw -gt 0 ]] && printf ' (%s with .NET Framework projects)' "$n_fw")" \
          "cs impls / cs refs refuse in: $(printf '%s\n' "$repos" | doc_list); cs impls answers from a tokensave graph instead in $n_graph of them (--engine=tokensave)" \
          "$(have brew && echo 'brew install --cask dotnet-sdk' || echo 'install the .NET SDK (https://dot.net)')$([[ $n_fw -gt 0 ]] && printf ' — %s' "$csharp_framework_note")"; fi ;;
      java)
        doc_row ok Java "$n repo(s) — no JDK needed: Serena's Java server ships its own runtime" ;;
      kotlin) doc_kotlin "$repos" "$n" "$(printf '%s\n' "$census" | awk -F'\t' '$1 == "kotlin" { print $3 }')" ;;
      typescript|javascript)
        if have_toolchain node; then doc_row ok "$label" "$n repo(s) — node $(node --version 2>/dev/null)"
        else doc_row warn "$label" "$n repo(s) — no runnable node" \
          "cs impls / cs refs refuse in: $(printf '%s\n' "$repos" | doc_list)" "$(doc_install node node)"; fi ;;
      *)
        doc_row unchecked "$label" "$n repo(s) — cs does not check what Serena needs for $label; an empty cs impls / refs there is not proof of absence" ;;
    esac
  done
}

# Kotlin is the one whose requirement is a VERSION, not a binary: its server's
# Gradle import needs a JDK at the toolchain version the build declares, and
# without one it answers [] (#65). cs's own gate only sees that `java` runs, so
# a JDK of the wrong version gets past it -- that case is named separately,
# because there the cost is an empty answer rather than a refusal.
doc_kotlin() {  # <repo names> <count> <repo dirs>, one per line
  local n="$2" dirs="$3" d name want floor rt have_majors
  local tc_repos="" tc_wants="" unmet_repos="" unmet_wants="" free_repos="" high_repos="" high_floor=""
  have_majors=$(jdks_findable)
  rt=$(kotlin_server_runtime)
  while IFS= read -r d; do
    [[ -n "$d" ]] || continue
    name=${d##*/}
    want=$(kotlin_toolchain_versions "$d" | tail -1)
    if [[ -n "$want" ]]; then
      tc_repos="$tc_repos$name
"; tc_wants="$tc_wants $want"
      if want=$(kotlin_jdk_unmet "$d"); then
        unmet_repos="$unmet_repos$name
"; unmet_wants="$unmet_wants $want"
      fi
    else
      floor=$(kotlin_jvm_floor "$d")
      if [[ -n "$floor" && -n "$rt" && "$floor" -gt "$rt" ]]; then
        high_repos="$high_repos$name
"; high_floor="$floor"
      else
        free_repos="$free_repos$name
"
      fi
    fi
  done <<< "$dirs"
  tc_wants=$(printf '%s\n' $tc_wants | sort -un | tr '\n' ' ' | sed 's/ $//')
  unmet_wants=$(printf '%s\n' $unmet_wants | sort -un | tr '\n' ' ' | sed 's/ $//')

  local parts="" n_free n_tc
  n_free=$(printf '%s' "$free_repos" | grep -c . || true)
  n_tc=$(printf '%s' "$tc_repos" | grep -c . || true)
  local s_v="s" s_o="it"; [[ "$n_free" -gt 1 ]] && { s_v=""; s_o="them"; }
  [[ "$n_free" -gt 0 ]] && parts="$n_free request$s_v no Gradle toolchain: the Kotlin server builds $s_o on its own runtime${rt:+ (Java $rt)}, no JDK needed"
  if [[ -z "$unmet_wants" ]]; then
    if [[ "$n_tc" -gt 0 ]]; then
      local where
      where=$(for want in $tc_wants; do printf '%s\n' "$have_majors" | awk -v m="$want" '$1 == m { print $2; exit }'; done | grep . | sort -u | paste -sd, - | sed 's/,/, /g')
      parts="${parts:+$parts; }$n_tc request$([[ "$n_tc" -eq 1 ]] && printf s) JDK $tc_wants: $(if [[ -n "$where" ]]; then printf 'findable (%s)' "$where"; else printf 'Gradle downloads it (foojay resolver)'; fi)"
    fi
    doc_row ok Kotlin "$n repo(s) — ${parts:-nothing to check}"
  else
    local fixes="" keg home
    for want in $unmet_wants; do
      if keg=$(keg_jdk_home "$want"); then
        fixes="${fixes}JDK $want is installed but keg-only, so nothing finds it. Paste:
  $(profile_line env "export JAVA_HOME=\"$keg\"")
"
      else
        home=$(have brew && echo "\$(brew --prefix openjdk@$want)/libexec/openjdk.jdk/Contents/Home" || echo "<its home>")
        fixes="${fixes}$(doc_install "openjdk@$want" "a JDK $want"), then paste:
  $(profile_line env "export JAVA_HOME=\"$home\"")
"
      fi
    done
    fixes="${fixes}then open a new terminal, and restart Claude Code so the MCP server sees it"
    doc_row warn Kotlin "$n repo(s) — builds (or builds they include) request a JDK $unmet_wants toolchain (jvmToolchain), and none is findable${parts:+; $parts}" \
      "cs impls / cs refs refuse in: $(printf '%s' "$unmet_repos" | doc_list) — the server's Gradle import needs exactly that version, and answers [] without it" \
      "$fixes"
  fi
  [[ -n "$high_repos" ]] && doc_row unchecked Kotlin "$(printf '%s' "$high_repos" | doc_list) compile for Java $high_floor, above the Kotlin server's own runtime (Java $rt) — not verified to import"
  return 0
}

cmd_doctor() {
  if [[ -t 1 ]]; then D_G=$'\033[32m'; D_Y=$'\033[33m'; D_R=$'\033[31m'; D_B=$'\033[1m'; D_O=$'\033[0m'
  else D_G=''; D_Y=''; D_R=''; D_B=''; D_O=''; fi
  printf '%ssetup%s\n' "$D_B" "$D_O"
  # Where cs itself is, because a plugin install does not put it on PATH: this
  # row is how a terminal user, or an installing agent, finds the copy to run.
  doc_row ok cs "$(tr -d '[:space:]' < "$lib_dir/../../VERSION" 2>/dev/null || printf '?') at $(cd "$lib_dir/.." && pwd)/cs"
  doc_python
  doc_fleet
  doc_workspaces
  printf '\n%sengines%s\n' "$D_B" "$D_O"
  doc_engines
  if [[ -d "$root" && "$(count_fleet_repos)" -gt 0 ]]; then
    printf '\n%slanguages in this fleet%s — what cs impls / cs refs need for each\n' "$D_B" "$D_O"
    doc_languages
    doc_serena_projects
  fi
  printf '\n%s%s ok, %s to fix, %s not checked%s\n' "$D_B" "$doc_n_ok" "$doc_n_flagged" "$doc_n_unchecked" "$D_O"
  # The MCP server is started by Claude Code and keeps the environment it was
  # started with, so a fix made in a shell is invisible to it until a restart --
  # and this report describes only the environment it ran in.
  printf 'this describes the environment it ran in: from a terminal, that shell; as cs_doctor, the MCP server Claude Code started\n'

  if [[ $doc_n_flagged -gt 0 ]]; then
    printf 'each "!" or "✗" line above says what it costs and how to fix it; exit %s\n' "$CS_EXIT_DOCTOR_FLAGGED"
    return "$CS_EXIT_DOCTOR_FLAGGED"
  fi
  printf 'everything cs can check here works\n'
  return 0
}

# ---- cs changes --------------------------------------------------------------
# What changed in cs, from the CHANGELOG.md that ships beside it. An agent never
# opens the changelog, and its notes, CLAUDE.md or memory describe whichever cs
# it learned -- so a fixed bug, a changed refusal, or a different meaning for an
# answer reached it only if someone copied that one change into the skill. The
# changelog records every change, the small ones nobody filed a ticket for
# included; this puts it one call away, and the MCP instructions name the
# running version so a mismatch is noticeable at all.
cmd_changes() {
  local log="$lib_dir/../../CHANGELOG.md" ver
  ver=$(tr -d '[:space:]' < "$lib_dir/../../VERSION" 2>/dev/null)
  [[ -f "$log" ]] || die "cs changes: there is no CHANGELOG.md beside this cs ($log)"
  require_python3 changes "reading the changelog"
  if [[ $# -ge 1 && -n "${1:-}" ]]; then
    [[ "$1" =~ ^[0-9]+(\.[0-9]+)*$ ]] || die "cs changes: '$1' is not a version (it looks like 1.17.2)"
    info "cs ${ver:-?}: what changed after $1, newest first"
    python3 "$lib_dir/changelog.py" "$log" since "$1" \
      || die "cs changes: '$1' is not a version (it looks like 1.17.2)"
  else
    info "cs ${ver:-?}: the three latest releases (cs changes <version> lists everything after that one)"
    python3 "$lib_dir/changelog.py" "$log" last 3
  fi
  info "the whole history: $(cd "$(dirname "$log")" && pwd)/CHANGELOG.md"
  return 0
}

hint() {
  info ""; info "${C_BOLD}nothing found — try:${C_OFF}"
  while [[ $# -gt 0 ]]; do
    info "  $1"
    if [[ -n "$CS_HINTS" ]]; then CS_HINTS="$CS_HINTS
$1"; else CS_HINTS="$1"; fi
    shift
  done
}

cmd_text() {
  [[ $# -ge 1 ]] || die "cs text <pattern>"
  answer textual "$(text_engine)" "regex"
  local out; out=$(grep_fleet regex "$1" | normalize)
  # Before --source-only, deliberately: the map is what keeps a dashboard .json
  # from being dropped by it.
  build_obs_map "$out"
  out=$(apply_source_only "$out")
  if [[ -z "$out" ]]; then
    engines_ok_or_die text
    report_answer 0 0
    hint "cs def $1              (it may be a symbol, not literal text)" \
         "cs calls '<pattern>'   (it may only appear as a call shape)"
    return $CS_EXIT_NO_HITS
  fi
  # The disclosures stay in BOTH modes: they are per-answer facts on stderr,
  # they cost a handful of lines, and a tally with the composition hidden would
  # be the cheap answer that is also the misleading one.
  if [[ $count_mode -eq 1 ]]; then
    emit_repo_counts "$out" "hit(s)" "cs text '$1'"
  else
    emit_capped "$(annotate_observability "$out")"
  fi
  disclose_composition "$out"
  disclose_observability
  report_answer "$(n_hits_in "$out")" "$(n_repos_in "$out")"
}

# A seam is a string two repos share. Grouping by repo is the answer -- a flat
# hit list buries the fact that only one repo mentions it (a dead seam) or that
# three do (a fan-out nobody expected).
cmd_seam() {
  [[ $# -ge 1 ]] || die "cs seam <string>"
  answer textual "$(text_engine)" "literal, grouped by repo"
  local hits repos n
  hits=$(grep_fleet literal "$1" | normalize)
  build_obs_map "$hits"
  hits=$(apply_source_only "$hits")
  if [[ -z "$hits" ]]; then
    info "no repo mentions '$1'"
    engines_ok_or_die seam
    report_answer 0 0
    return $CS_EXIT_NO_HITS
  fi
  repos=$(printf '%s\n' "$hits" | cut -d/ -f1 | sort -u)
  n=$(printf '%s\n' "$repos" | grep -c '')
  # The orphan warning below is the point of this verb, and it is computed from
  # the hits either way -- so --count changes what is PRINTED and nothing about
  # what is concluded.
  if [[ $count_mode -eq 1 ]]; then
    emit_repo_counts "$hits" "mention(s)" "cs seam '$1'"
  else
    emit_capped "$(annotate_observability "$hits")"
  fi
  disclose_composition "$hits"
  disclose_observability
  info ""
  info "${C_BOLD}$n repo(s):${C_OFF} $(printf '%s ' $repos)"

  # The orphan warning is computed on WHOLE-IDENTIFIER matches, even though the
  # hits shown above are substring matches. Showing fewer hits would risk losing
  # a real use (a name assembled by concatenation is exactly the heuristic blind
  # spot documented in `cs why`); computing the warning on the narrower set
  # loses nothing and restores the signal.
  local word_hits word_repos n_word substring_only ww_rc
  word_hits=$(printf '%s\n' "$hits" | whole_word_hits "$1"); ww_rc=$?
  # The orphan warning ASSERTS A NEGATIVE, so it needs the same evidence bar as
  # any other negative here: if the analysis did not run, no warning is emitted
  # at all. Reading a failed helper's empty output as "nothing matched" is what
  # turned a live seam into a dead one.
  if [[ $ww_rc -ne 0 ]]; then
    engine_error "whole-identifier analysis failed (exit $ww_rc) while checking '$1'"
    warn "could not determine whole-identifier matches — the dead/orphan warning is NOT being reported for this query"
    report_answer "$(n_hits_in "$hits")" "$n"
    return 0
  fi
  word_repos=$(printf '%s\n' "$word_hits" | grep '[^[:space:]]' | cut -d/ -f1 | sort -u)
  n_word=$(printf '%s\n' "$word_repos" | grep -c '[^[:space:]]')

  if [[ $n_word -eq 0 ]]; then
    warn "no repo mentions this as a whole identifier — every hit is inside a longer name, so this is a producer with no consumer, or dead"
  elif [[ $n_word -eq 1 ]]; then
    if [[ $n -eq 1 ]]; then
      warn "only one repo mentions this -- a producer with no consumer, or dead"
    else
      warn "only one repo mentions this as a whole identifier ($(printf '%s' "$word_repos")) -- a producer with no consumer, or dead"
    fi
  fi
  # Said whichever way the warning went, in the same spirit as `prose filtered
  # except:`: name what could not be counted so the reader can discount it.
  if [[ $n_word -lt $n ]]; then
    substring_only=$(comm -23 <(printf '%s\n' "$repos" | sort -u) \
                              <(printf '%s\n' "$word_repos" | grep '[^[:space:]]' | sort -u) 2>/dev/null | tr '\n' ' ')
    warn "$((n - n_word)) repo(s) matched only INSIDE a longer identifier: ${substring_only:-?}— not whole-word (use --word to search identifiers only)"
  fi
  report_answer "$(n_hits_in "$hits")" "$n"
}

# Deliberately not a natural-language router: guessing intent from a sentence
# fails quietly and is hard to debug. This prints the decision table instead, so
# the caller picks with the reasoning visible.
cmd_which() {
  cat <<'TABLE'
What do you want to know?                        Use
------------------------------------------------ ----------------------------
Who calls / uses this endpoint, topic, key?      cs uses <string>
Which repos share this string?                   cs seam <string>
Any text or regex, including comments            cs text <pattern>
Where is this symbol defined?                    cs def <symbol> [repo]
What calls look like X, or take literal Y?       cs calls '<pattern>' [lang]
Where is this type CONSTRUCTED (all idioms)?     cs constructs <Type> [repo]
What implements this interface?                  cs impls <symbol> <repo>
What calls this symbol?                          cs callers <symbol> <repo>
What does this symbol call?                      cs callees <symbol> <repo>
What breaks if I change this symbol?             cs impact <symbol> <repo>
Who reads / writes this FIELD, fleet-wide?       cs fields <field> [repo]
How BIG is that field's blast radius?            cs fields <field> --count
What references this symbol (bridges DI)?        cs refs <symbol> <repo> <file>
Which repo publishes this package?               cs provides <coordinate>
Which repos depend on which?                     cs deps [repo]
Which version does each repo pin?                cs versions [coordinate]
Who owns this repo, or this file?                cs owns [repo|repo/path]
Who CRASHES if I add a field to a response?      cs strictness [repo]
Who SETS this config key, and who READS it?      cs values <KEY> [repo]
Who even READS an error body, and who retries?   cs resilience [repo]
What does the fleet NOT hold that the org does?  cs gaps <query>
When did this seam appear, or last change?       cs history <string> [repo]
What am I actually searching right now?           cs repos
Which workspaces are there to search at all?     cs scopes
How much should I trust this answer?             cs why [kind]

Two same-named symbols in different repos: resolve the dependency first, then
filter, because code search alone cannot tell them apart:

  cs def DiscountEngine "$(cs provides com.acme:pricing-lib)"

When a consumer breaks and nothing in its own repo changed, the trigger is in
another repo and its history is not reachable from here. cs history spans the
fleet and sorts by date, which puts the two changes side by side:

  cs history '"reservationId"'      # every repo that added or removed it, in order

Two kinds of question, one interface. cs uses / cs seam / cs history ask about
NAMES; cs callers / cs callees / cs impact / cs impls ask about SYMBOLS. A real
question crosses between them -- "I am renaming this route, what breaks" starts
as one and ends as the other -- which is why both are here rather than in two
tools with two scoping models.

Symbol mode answers from a per-repo graph, so it sees ONE repo at ONE layer and
there is no union of your ticket workspace and the fleet. Every such answer says
which index answered and how old it is; read that line. The cross-repo half of
the same question is cs uses, which searches the layered view.

cs values is the same read/write split as cs fields, applied to a config key
instead of a field -- and it crosses a REPO BOUNDARY, which is where the
mismatch hides. The two sides live in different file kinds (manifests set,
code reads), so one text sweep mixes deployment data with branching code and
the counts alone cannot tell you whether the values line up. It reports the
literals each side supplies and, only when the read side is genuinely
enumerable, which set values no read site accepts.

cs fields is the field-level half of the impact question, and it is the one
graph verb that is FLEET-wide rather than per-repo: "who is affected if I change
X" stops making sense at a repo boundary. It splits the sites by ACCESS KIND
because that is two different blast radii from one query -- an added field or a
changed default can only be observed where the field is WRITTEN, while a
removal, rename or retype breaks where it is READ. A text sweep collapses both,
which is why grepping a default-value change returns precisely the sites where
the change is not observable.

Symbol mode fronts three graph questions on purpose, not ninety. Dead code,
coupling, complexity, blame, test mapping, call chains, inheritance depth: those
are graph questions beyond what cs fronts, and the honest route is the graph
tool directly (tokensave tool <name>) rather than a facade that quietly answers
less than the thing it fronts.

Start cheap. cs uses and cs def answer most questions in well under a second;
cs impls and cs refs start language servers and are far slower.

Every answer prints the KIND of evidence behind it. Read that before acting on
a negative result: `cs uses` finding nothing is weak evidence of no callers,
because it cannot see a path assembled by concatenation. `cs why` explains.
TABLE
}

# "Who actually uses this string in code?" -- the seam question with prose
# removed. No single engine answered this: text search counts a docstring
# mentioning an endpoint as a caller, and a symbol graph cannot see the string
# literal that is the real call site.
cmd_uses() {
  [[ $# -ge 1 ]] || die "cs uses <string>"
  require_python3 uses "excluding comments and docstrings from the hits"
  local hits repos unsupported unsup_file
  # The filter cannot cover every language, and a hit in one it does not know is
  # passed through unfiltered. Saying "prose filtered" over those anyway is a
  # provenance claim the run did not honour -- the exact overstatement the kind
  # labels exist to prevent -- so the note is built from what actually happened.
  unsup_file="$(cs_tmp cs-unsup)"
  # Two steps rather than one pipeline. Under pipefail the pipeline's status is
  # whichever stage failed LAST, so ripgrep exiting 2 over an unreadable file
  # was reported as "filter_code.py exited 2" -- blaming a stage that had run
  # perfectly. grep_fleet records its own status internally; what is caught
  # here is filter_code.py actually dying, which empties the stream and leaves
  # `cs uses` reporting a confident zero while still claiming "prose filtered".
  local filter_rc raw_hits
  raw_hits=$(cs_tmp cs-uses)
  grep_fleet literal "$1" | normalize > "$raw_hits"
  hits=$(python3 "$lib_dir/filter_code.py" --root "$view" --report-unsupported \
         < "$raw_hits" 2>"$unsup_file")
  filter_rc=$?
  # After the comment filter, not before: --source-only is about the FILE kind,
  # and stacking it on the prose filter keeps each stage's claim its own.
  build_obs_map "$hits"
  hits=$(apply_source_only "$hits")
  # Named from the hits that are LEFT. The filter reports what it passed
  # through, before --source-only drops the data files, so .svg went on being
  # named as "NOT filtered" in answers that no longer held a single .svg hit.
  unsupported=$(printf '%s\n' "$hits" | python3 -c '
import pathlib, sys
exts = {l.split("\t")[0] for l in open(sys.argv[1]) if l.strip()}
seen = set()
for line in sys.stdin:
    p = pathlib.PurePosixPath(line.split(":", 1)[0])
    seen.add(p.suffix.lower() or p.name)
print(" ".join(sorted(exts & seen)))
' "$unsup_file") || unsupported=$(cut -f1 "$unsup_file" | sort -u | tr '\n' ' ' | sed 's/ $//')
  rm -f "$unsup_file"
  # filter_code.py exits 0 on every legitimate outcome, including empty input,
  # so any non-zero here is the filter itself failing.
  [[ "$filter_rc" -ne 0 ]] && engine_error "filter_code.py exited $filter_rc while removing comments from the hits"
  if [[ -n "$unsupported" ]]; then
    answer heuristic "$(text_engine)" "literal, prose filtered except: $unsupported"
  else
    answer heuristic "$(text_engine)" "literal, prose filtered"
  fi
  if [[ -z "$hits" ]]; then
    engines_ok_or_die uses
    info "no code uses '$1'"
    local prose
    # Re-uses the captured hits rather than searching a second time: a repeat
    # grep_fleet would re-report every unreadable file and double the count.
    prose=$(python3 "$lib_dir/filter_code.py" --invert --root "$view" < "$raw_hits" 2>/dev/null)
    if [[ -n "$prose" ]]; then
      warn "mentioned only in comments/docs:"
      # stderr, like every other diagnostic. On stdout these lines landed in the
      # scoreable result stream of a query that had just reported ZERO hits, so
      # a caller piping cs saw comment matches presented as results -- and a
      # decoy planted in a docstring could be scored as a hit against the very
      # answer that correctly excluded it.
      printf '%s\n' "$prose" >&2
    fi
    rm -f "$raw_hits"
    report_answer 0 0
    return $CS_EXIT_NO_HITS
  fi
  rm -f "$raw_hits"
  [[ -n "$unsupported" ]] && warn "comments were NOT filtered in: $unsupported — hits in those files may be prose (cs why heuristic)"
  # Same reasoning as the seam warning: a hit inside a longer identifier is not
  # a use of THIS name, and "who uses this" is the question being asked. Named
  # rather than removed, so a name genuinely assembled from parts is not lost.
  local uses_word n_uses_word n_uses_all uw_rc
  uses_word=$(printf '%s\n' "$hits" | whole_word_hits "$1"); uw_rc=$?
  n_uses_all=$(n_hits_in "$hits")
  n_uses_word=$(printf '%s\n' "$uses_word" | grep -c '[^[:space:]]')
  if [[ $uw_rc -ne 0 ]]; then
    # Same rule as cs seam: a claim about what did NOT match needs the analysis
    # to have actually run.
    engine_error "whole-identifier analysis failed (exit $uw_rc) while checking '$1'"
    warn "could not determine which hits matched inside a longer identifier"
  elif [[ "$n_uses_word" -lt "$n_uses_all" ]]; then
    warn "$((n_uses_all - n_uses_word)) of $n_uses_all hit(s) matched INSIDE a longer identifier — not a use of this name (use --word to exclude them)"
  fi
  if [[ $count_mode -eq 1 ]]; then
    emit_repo_counts "$hits" "use(s) in code" "cs uses '$1'"
  else
    emit_capped "$(annotate_observability "$hits")"
  fi
  # The composition, next to the count. "In CODE" in this subcommand's own
  # description reads as a guarantee about file KIND; what it actually promises
  # is "with comments stripped where we know how", which is a different thing.
  # This line is what closes that gap in the answer itself rather than in a
  # separate command the caller has to already suspect they need.
  disclose_composition "$hits"
  disclose_observability
  repos=$(printf '%s\n' "$hits" | cut -d/ -f1 | sort -u)
  info ""
  info "${C_BOLD}$(printf '%s\n' "$repos" | grep -c '') repo(s) use it:${C_OFF} $(printf '%s ' $repos)"
  report_answer "$(n_hits_in "$hits")" "$(n_repos_in "$hits")"
}

# The fleet's identity for caching: which repos are in the view and what commit
# each sits on. Reading refs is milliseconds; it is the one cheap thing that
# changes whenever the fleet is refreshed or a ticket branch moves.
# Keyed on the REAL repo paths, never on $view: in a ticket workspace the view
# is a fresh temp directory of symlinks on every invocation, so including it
# would change the key every run and the cache would never hit at all -- which
# is exactly the case where the fleet is large and the saving matters.
#
# The hashing chain is longer than it looks like it needs to be. `md5` lives in
# /sbin on macOS and `md5sum` does not exist there at all, so a trimmed PATH
# finds NEITHER -- and the old `md5 -q || md5sum` chain then produced an EMPTY
# fingerprint rather than failing. The cache path became the constant
# `cs-tags-.tags`, every fleet shared one symbol index, and `cs def` answered
# one fleet's question from another fleet's index. A confident wrong answer, in
# the one command whose entire job is "where is this defined".
#
# Returns non-zero when nothing on this machine can hash, so the caller can skip
# the cache instead of sharing one. Slower is a cost; wrong is a defect.
view_fingerprint() {
  local d data h out
  data=$({ for d in $(real_dirs); do
             printf '%s %s\n' "$d" "$(git -C "$d" rev-parse HEAD 2>/dev/null || echo nogit)"
           done
           # An index built under another exclusion list holds other files.
           printf '~exclude %s\n' "${CS_EXCLUDE_DIRS[*]-}"
         } | sort)
  # cksum is POSIX and therefore the backstop: a weak checksum is still a
  # correct cache KEY, because a collision only costs a rebuild.
  for h in "md5 -q" "md5sum" "shasum -a 1" "cksum"; do
    out=$(printf '%s\n' "$data" | $h 2>/dev/null | head -1 | awk '{print $1}')
    [[ -n "$out" ]] && { printf '%s\n' "$out"; return 0; }
  done
  return 1
}

# The cross-repo graph alternative to the ctags index. Unlike ctags -- which
# indexes the whole view in one pass -- graphs are per-repo, so coverage is
# whatever has been indexed. That gap is DISCLOSED rather than assumed away: a
# repo without a graph is a place results cannot come from, which is the same
# hazard as an excluded directory.
def_via_tokensave() {  # <symbol> [only-repo]
  local sym="$1" only="${2:-}" d name out="" rc n_graph=0 no_graph="" oldest="" age
  for d in $(real_dirs); do
    name=$(basename "$d")
    [[ -n "$only" && "$name" != "$only" ]] && continue
    if ! tokensave_graph_at "$d"; then no_graph="$no_graph $name"; continue; fi
    n_graph=$((n_graph + 1))
    age=$(tokensave_graph_age_secs "$d") || age=""
    if [[ -n "$age" && ( -z "$oldest" || "$age" -gt "$oldest" ) ]]; then oldest="$age"; fi
    local one
    one=$(python3 "$lib_dir/tokensave_call.py" def "$d" "$name" "$sym"); rc=$?
    [[ $rc -eq 4 ]] && die "cs def: the tokensave graph for $name could not be queried
  nothing was read there, so nothing was ruled out
  check: cs doctor   (graph coverage and age, and the fix)"
    [[ -n "$one" ]] && out="${out:+$out
}$one"
  done
  [[ $n_graph -gt 0 ]] || die "cs def: no repo in view has a tokensave graph
  build one with: cd <repo> && tokensave init
  or install universal-ctags, which indexes the whole view in one pass"
  answer structural "tokensave (graph)" "$n_graph repo graph(s), no ctags index"
  [[ -n "$oldest" ]] && warn "answered from graph(s) last synced up to $(format_age "$oldest") ago — changes made since are invisible (tokensave sync)"
  # The uncovered repos, named. A symbol defined in one of them looks exactly
  # like a symbol that does not exist.
  [[ -n "$no_graph" ]] && warn "no tokensave graph, so NOT searched:$no_graph — a definition in those repos cannot be found this way"
  if [[ -z "$out" ]]; then
    report_answer 0 0
    hint "cs text '$sym'          (the graph indexes declarations, not every spelling)" \
         "cs uses '$sym'          (a cross-repo reference is a string, not a symbol)"
    return $CS_EXIT_NO_HITS
  fi
  emit_capped "$out"
  report_answer "$(n_hits_in "$out")" "$(n_repos_in "$out")"
}

cmd_def() {
  [[ $# -ge 1 ]] || die "cs def <symbol> [repo]"
  local only="${2:-}"
  # --engine=tokensave asks for the graph deliberately; otherwise it is the
  # fallback for a machine with no universal-ctags, where cs def had no answer
  # at all rather than a weaker one.
  if [[ "${force_engine:-}" == tokensave ]]; then
    have_tokensave || die "--engine=tokensave requested but tokensave is not installed"
    def_via_tokensave "$1" "$only"
    return $?
  fi
  local ct
  if ! ct=$(ctags_bin); then
    if have_tokensave; then
      local _d
      for _d in $(real_dirs); do
        if tokensave_graph_at "$_d"; then def_via_tokensave "$1" "$only"; return $?; fi
      done
    fi
    die "universal-ctags not installed
  install it: brew install universal-ctags
  or build a tokensave graph, which cs def can read instead:
    cd <repo> && tokensave init"
  fi

  # The index was originally rebuilt on every query, on the grounds that it is
  # cheap and therefore never stale. That held at 0.07s on a five-file fixture
  # and does not hold at scale: measured 5.8s over 456k lines (scripts/
  # bench-scale), which puts a real ten-repo fleet well past the point where
  # anyone would keep using the command.
  #
  # So it is cached, keyed on the repos in view and the commit each is on, with
  # a short TTL as the backstop for uncommitted edits -- which refs cannot see
  # and which are exactly what you have while working a ticket. The staleness
  # window is bounded and stated rather than hidden; --refresh forces a rebuild.
  #
  # The TTL is SCOPED, because the two scopes this command answers for have
  # different keys, not different tastes in staleness.
  #
  #   ticket layered   uncommitted edits are the normal state, and a commit
  #                    hash cannot see one. 60s, as before.
  #   fleet only       the fingerprint is already a complete key for tracked
  #                    content: it holds every repo's HEAD, so it changes on
  #                    exactly the events that can invalidate the index.
  #
  # A flat 60s made the fingerprint decorative in the fleet case. Measured on a
  # 43-repo fleet: a cold `cs def` cost 42.1s and the same call six seconds
  # later cost 5.85s -- and since any interactive use is more than a minute
  # apart, nearly every `cs def` paid the 42s to rebuild an index the key had
  # already proved current.
  #
  # The residual gap in the fleet case is UNTRACKED files hand-dropped into a
  # mirror, which no fingerprint built from refs can see. --refresh is the
  # answer to that, and the answer line says so rather than implying the index
  # is unconditionally fresh.
  #
  # CS_TAGS_TTL still wins when it is set, in both scopes. It is the escape
  # hatch for a fleet root that is NOT a read-only mirror -- somewhere people
  # edit in place -- and setting it to 0 asks for the fingerprint alone.
  local fp tags age ttl cached="" no_cache=0
  if [[ -n "${CS_TAGS_TTL:-}" ]]; then
    ttl="$CS_TAGS_TTL"
  elif [[ -z "$view_tmp" ]]; then
    # No ticket workspace is layered, so nothing in view is a branch someone is
    # editing. -1 is "no time bound"; the fingerprint is the whole key.
    ttl=-1
  else
    ttl=60
  fi
  if fp=$(view_fingerprint); then
    tags="${TMPDIR:-/tmp}/cs-tags-${fp}.tags"
  else
    # Nothing here can hash, so there is no key that distinguishes this fleet
    # from another. Build a private index and throw it away rather than write to
    # a shared path that would answer the next fleet's question with this one's.
    no_cache=1
    tags="${TMPDIR:-/tmp}/cs-tags-nokey.$$.tags"
    warn "no md5/shasum/cksum on PATH — the symbol index cannot be cached safely, so it is rebuilt for this query"
  fi

  if [[ $no_cache -eq 0 && $refresh_index -eq 0 && -s "$tags" ]]; then
    age=$(( $(date +%s) - $(file_mtime "$tags") ))
    # A negative age is a clock that moved, not a fresh index, and is rebuilt
    # under every TTL rather than trusted under the unbounded one.
    if [[ $age -ge 0 ]] && { [[ $ttl -lt 0 ]] || [[ $age -lt $ttl ]]; }; then
      cached="cached $(format_age "$age") ago"
    fi
  fi

  # Built to a private path and moved into place, never written where a reader
  # can see it half-finished. The cache path is shared by construction -- it is
  # keyed on the fleet, so every concurrent `cs def` computes the SAME name --
  # and agents issue tool calls in parallel by default. Writing $tags directly
  # meant six simultaneous runs returned: three answers and three empty results,
  # each labelled a normal `structural via ctags` answer. A false negative
  # produced by nothing worse than being asked two questions at once.
  #
  # rename(2) is atomic within a filesystem, so a reader sees either the old
  # complete index or the new one. Whoever finishes last wins, and since every
  # writer is building the same content from the same fingerprint, that is fine.
  if [[ -z "$cached" ]]; then
    # The key includes each repo's commit, so every fleet refresh or branch
    # switch strands the previous index. On a large fleet these are tens of MB
    # each and nothing ever removed them. Swept on rebuild, which is the only
    # moment a new one is created; -mmin +1440 keeps today's other checkouts.
    find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'cs-tags-*.tags' -mmin +1440 -delete 2>/dev/null
    local tmp_tags="$tags.$$.building"
    run_timed "$ct" -R --links=yes --fields=+n ${CS_CTAGS_EXCLUDES[@]+"${CS_CTAGS_EXCLUDES[@]}"} -f "$tmp_tags" "$view"/*/ 2>/dev/null
    # A ctags run that fails PARTWAY leaves a non-empty index covering some of
    # the fleet, which the -s check below happily accepts -- so a symbol in an
    # unindexed repo comes back "not defined anywhere" with a normal structural
    # label. Total failure was already caught; partial failure was not.
    note_run_status $? ctags "building the fleet symbol index"
    if [[ ! -s "$tmp_tags" ]]; then
      rm -f "$tmp_tags"
      die "ctags produced no index under $root"
    fi
    mv -f "$tmp_tags" "$tags" 2>/dev/null || { rm -f "$tmp_tags"; die "could not install the symbol index at $tags"; }
    answer structural "ctags" "fleet-wide symbol index, rebuilt now"
  else
    # What the caller can and cannot conclude from a cache hit, which differs
    # by which key allowed it. Naming the wrong gap is worse than naming none:
    # under the fingerprint there is no time window to distrust, and under the
    # TTL there is.
    if [[ $ttl -lt 0 ]]; then
      answer structural "ctags" "fleet-wide symbol index, $cached — every repo is on the same commit as then, so only files added by hand and never committed are missing (--refresh)"
    else
      answer structural "ctags" "fleet-wide symbol index, $cached — uncommitted edits within ${ttl}s may be missing (--refresh)"
    fi
  fi
  # A concurrent --refresh can replace the file between the check above and the
  # read below; both are complete indexes, so re-checking is enough.
  if [[ ! -s "$tags" ]]; then die "the symbol index at $tags vanished or is empty"; fi
  # Per-process, because the result file was previously shared too: one run
  # deleted $tags.out while another was still reading it, which is the other
  # half of the same empty-answer bug.
  local out
  out=$(awk -F'\t' -v want="$1" '$1 == want {
      line = "?"; kind = "?";
      for (i = 4; i <= NF; i++) {
        if ($i ~ /^line:/) { line = substr($i, 6) }
        else if (length($i) <= 2) { kind = $i }
      }
      printf "%s:%s: [%s] %s\n", $2, line, kind, want
  }' "$tags" | normalize | sort -u | { if [[ -n "$only" ]]; then grep "^$only/" || true; else cat; fi; })
  if [[ -z "$out" ]]; then
    engines_ok_or_die def
    report_answer 0 0
    hint "cs text '$1'           (ctags misses symbols built dynamically)" \
         "cs refs $1 <repo> <file>  (for a precise, LSP-backed answer)"
    return $CS_EXIT_NO_HITS
  fi
  emit_capped "$out"
  # Two repos defining the same name is the failure mode this cannot resolve:
  # ctags matches spelling, so it cannot tell you which one your caller means.
  local nr; nr=$(n_repos_in "$out")
  [[ $nr -gt 1 ]] && warn "defined in $nr repos — same name, possibly unrelated types. Resolve with: cs def $1 \"\$(cs provides <coordinate>)\""
  report_answer "$(n_hits_in "$out")" "$nr"
}

# Which repo publishes a coordinate, and which repos depend on which. Answers
# the one question code search structurally cannot: choosing between two
# same-named symbols requires knowing which repo the caller actually depends
# on, and that lives in build manifests, not in code.
# The manifest readers all pipe through one python3 module, and none of them
# looked at whether it succeeded. A crash in deps.py made `cs provides` and
# `cs versions` report a confident zero, and made `cs deps` and `cs publishes`
# exit 0 with no output at all -- the worst of the set, because exit 0 is the
# code that means "the query ran and found something".
#
# deps.py and owners.py already draw the same distinction cs does -- 0 found
# something, 1 ran and found nothing, >=2 failed -- so only >=2 is an error
# here. Treating every non-zero as a failure turns a legitimate "no repo
# publishes this" into a refusal, which is the mirror image of the bug being
# fixed and just as wrong: it makes an honest negative undetectable.
manifest_ok_or_die() {  # <rc> <subcommand> <module> <what it was reading>
  [[ "${1:-0}" -le 1 ]] && return 0
  die "cs $2: $3 failed (exited $1), so nothing was read
  it was $4, and no manifest was parsed — this is not 'nothing is declared'
  check: cs repos   (are the repos in view the ones you expect?)"
}

# deps.py writes what it could NOT read to stderr: `! <what>` lines, each with
# indented continuation lines. They go to stderr for a human as always, and into
# the envelope as notes -- a repo missing from the answer because its manifest
# was not read looks exactly like a repo that declares nothing, and a machine
# caller never sees stderr.
relay_manifest_notes() {  # <stderr file>
  [[ -s "$1" ]] || return 0
  cat "$1" >&2
  local notes
  notes=$(awk '
    /^! / { if (cur != "") print cur; cur = substr($0, 3); sep = " "; next }
    /^    / && cur != "" { sub(/^ +/, ""); cur = cur sep $0; sep = ", "; next }
    END { if (cur != "") print cur }
  ' "$1")
  [[ -n "$notes" ]] || return 0
  if [[ -n "$CS_NOTES" ]]; then CS_NOTES="$CS_NOTES
$notes"; else CS_NOTES="$notes"; fi
}

cmd_provides() {
  [[ $# -ge 1 ]] || die "cs provides <coordinate>"
  require_python3 provides "reading the build manifests that declare it"
  answer declared "build manifests" "publish declarations"
  local out rc err_file
  err_file=$(cs_tmp cs-provides)
  out=$(python3 "$lib_dir/deps.py" "$view" provides "$1" 2>"$err_file"); rc=$?
  relay_manifest_notes "$err_file"; rm -f "$err_file"
  manifest_ok_or_die "$rc" provides deps.py "looking for what publishes '$1'"
  # A bare `printf '%s\n' ""` emits a blank line, which reads as an answer and
  # is what `cs def X "$(cs provides …)"` silently turns into "every repo".
  if [[ -z "$out" ]]; then
    report_answer 0 0
    hint "cs publishes           (what every repo declares that it publishes)" \
         "cs seam '$1'           (the coordinate may be referenced but not declared here)"
    return $CS_EXIT_NO_HITS
  fi
  emit_plain "$out"
  report_answer
}

# The outlier of the declared family: it neither validated its repo argument nor
# followed the zero-hit contract, so `cs deps <real-repo-with-no-edges>` and
# `cs deps <repo-that-does-not-exist>` were byte-identical -- exit 0, a single
# blank line, no count, no message. A typo in a repo name was answered as "no
# dependencies", which is a manufactured negative of exactly the kind the rest
# of this tool refuses to produce. `cs provides` is the same code path one
# function over and gets every part of this right.
cmd_deps() {
  require_python3 deps "reading the build manifests the graph is built from"
  local only="${1:-}"
  # `cs impls` proves the check is cheap and already written elsewhere.
  if [[ -n "$only" ]]; then
    if [[ ! -d "$view/$only" ]] || ! is_repo "$view/$only"; then
      die "no such repo: $only
  answering 'no dependencies' for a name that is not a repo would be a
  manufactured negative, so this refuses instead
  cs repos   lists the repositories actually in view"
    fi
  fi
  answer declared "build manifests" "dependency declarations"
  local out rc err_file
  err_file=$(cs_tmp cs-deps)
  out=$(python3 "$lib_dir/deps.py" "$view" deps "$only" 2>"$err_file"); rc=$?
  relay_manifest_notes "$err_file"; rm -f "$err_file"
  manifest_ok_or_die "$rc" deps deps.py "building the fleet dependency graph"
  if [[ -z "$out" ]]; then
    # An empty dependency graph is a substantive claim, not silence: a fleet can
    # genuinely have no intra-fleet edges while every repo publishes something.
    # Said with a count and a code, like every other subcommand.
    report_answer 0 0
    hint "cs publishes           (what each repo declares it publishes)" \
         "cs versions            (which coordinates the fleet shares at all)" \
         "cs provides <coord>    (whether a specific coordinate is published here)"
    return $CS_EXIT_NO_HITS
  fi
  emit_plain "$out"
  # Edges, and the repos they span: the row is `consumer -> producer (coord)`.
  report_answer "$(n_hits_in "$out")" \
                "$(printf '%s\n' "$out" | cut -f1,3 | tr '\t' '\n' | sort -u | grep -c '[^[:space:]]')"
}

cmd_publishes() {
  require_python3 publishes "reading the build manifests the graph is built from"
  answer declared "build manifests" "publish declarations"
  local out rc; out=$(python3 "$lib_dir/deps.py" "$view" publishes); rc=$?
  manifest_ok_or_die "$rc" publishes deps.py "reading what each repo publishes"
  emit_plain "$out"
  report_answer
}

# "Is the fleet agreed on a version of this?" -- `cs deps` deliberately drops
# versions, because "who depends on what" does not need them. This is the other
# question, and it is the one that finds a repo left behind by an upgrade: a
# shared contract library at two versions across a seam is a real bug shape,
# and it is invisible to every search engine here because the evidence is in
# manifests rather than in code.
cmd_versions() {
  require_python3 versions "reading the version each build manifest pins"
  answer declared "build manifests" "${1:+$1, }version declarations"
  local out rc err_file
  err_file=$(cs_tmp cs-versions)
  out=$(python3 "$lib_dir/deps.py" "$view" versions "${1:-}" 2>"$err_file"); rc=$?
  relay_manifest_notes "$err_file"; rm -f "$err_file"
  manifest_ok_or_die "$rc" versions deps.py "reading the version each manifest pins"
  if [[ -z "$out" ]]; then
    report_answer 0 0
    hint "cs deps               (the coordinate may be spelled differently in the manifest)" \
         "cs provides '${1:-<coordinate>}'   (confirm a fleet repo publishes it at all)" \
         "cs versions           (with no argument: every coordinate the fleet declares)"
    return $CS_EXIT_NO_HITS
  fi
  emit_plain "$out"
  # DRIFT is the finding; say so rather than leaving it in the table. A version
  # spread the caller did not notice is the same class of miss as a caller in a
  # repo they did not search.
  local drift
  drift=$(printf '%s\n' "$out" | grep -c '	DRIFT	' || true)
  [[ "$drift" -gt 0 ]] && warn "$drift coordinate(s) declared at more than one version — see DRIFT above"
  report_answer
}

# Who to ask about a result. Every other subcommand answers WHERE something is,
# and the next question is always who owns it -- which in a single repo is a
# `cat CODEOWNERS` away and across a fleet is not, because the file lives in a
# repo you have never opened.
cmd_owns() {
  require_python3 owns "parsing CODEOWNERS and matching its patterns"
  local mode="file" arg="${1:-}"
  if [[ -z "$arg" ]]; then
    mode="audit"
  elif [[ "$arg" != */* ]]; then
    # A bare name is a repo, a name with a slash is a path inside one.
    mode="repo"
  fi
  answer declared "CODEOWNERS" "$mode"
  # Captured separately, not with 2>&1. owners.py writes the GAPS to stderr on
  # purpose -- a repo with no CODEOWNERS is a finding, not an owner -- and
  # merging the streams put "no CODEOWNERS" on stdout as though it answered the
  # question. stdout is the result stream; that is a contract, not a preference.
  local out rc err_file
  err_file=$(cs_tmp cs-owns)
  out=$(python3 "$lib_dir/owners.py" "$view" "$mode" ${arg:+"$arg"} 2>"$err_file"); rc=$?
  if [[ -s "$err_file" ]]; then cat "$err_file" >&2; fi
  rm -f "$err_file"
  # The two halves used to share one branch and one exit code. owners.py failing
  # is a REFUSAL -- the CODEOWNERS files were never read, so no rule was ruled
  # out -- while owners.py succeeding with no rows is an honest "nothing names
  # this". Collapsing them is the same mistake as collapsing a missing fleet
  # root into "nothing found".
  # >=2 only. owners.py returns 1 for "ran, and no rule matched", which is a
  # real answer -- the last release treated it as a failure and refused, so
  # `cs owns` on a path no CODEOWNERS rule covers stopped being answerable.
  if [[ $rc -ge 2 ]]; then
    die "cs owns: could not read CODEOWNERS across the fleet (owners.py exited $rc)
  nothing was parsed, so this is not 'nobody owns it'
  check: cs repos (is the view what you expect?)"
  fi
  if [[ -z "$out" ]]; then
    report_answer 0 0
    hint "cs owns               (which repos declare ownership at all)" \
         "cs owns <repo>        (every rule in one repo)" \
         "cs repos              (the exact repo names in view)"
    return $CS_EXIT_NO_HITS
  fi
  emit_plain "$out"
  # Stated every time, because a CODEOWNERS answer is the one most likely to be
  # repeated to a person as fact. It says who the file names, which is not the
  # same as who will review the change or who understands the code.
  warn "CODEOWNERS is a declaration, not a fact about who knows this code — it can name a team that no longer exists, and it says nothing about repos with no file at all"
  report_answer
}

# The facade's own hazard: this falls back ast-grep -> semgrep, so an engine can
# break while every scored query still passes. The fallback is therefore
# announced rather than silent, and --engine= makes it fail instead.
cmd_calls() {
  [[ $# -ge 1 ]] || die "cs calls <pattern> [lang]"
  local pattern="$1" lang="${2:-}" out engine="${force_engine:-}"
  if [[ -z "$engine" ]]; then
    if have ast-grep; then engine=ast-grep
    elif have semgrep; then engine=semgrep; CS_DEGRADED="ast-grep absent, fell back to semgrep (different pattern dialect, different results)"
    else die "neither ast-grep nor semgrep installed"
    fi
  else
    have "$engine" || die "--engine=$engine requested but not installed"
  fi
  answer structural "$engine" "${lang:-all languages}"

  case "$engine" in
    ast-grep)
      local args=(--follow -p "$pattern")
      [[ -n "$lang" ]] && args+=(-l "$lang")
      # Scoped to the repositories in the view, by name, for the same reason the
      # text backends are (see view_repo_names): otherwise ast-grep walks the
      # whole view and a code match in a loose fleet-root file becomes a pathless
      # hit that cut -d/ -f1 miscounts as its own repo. semgrep below already
      # iterates real_dirs and needs nothing.
      local ag_names=() _agn
      while IFS= read -r _agn; do args+=("$_agn"); ag_names+=("$_agn"); done < <(view_repo_names)
      local ag_raw ag_rc ag_err
      ag_err=$(cs_tmp cs-engerr)
      if [[ ${#ag_names[@]} -eq 0 ]]; then
        ag_raw=""; ag_rc=0
      else
        ag_raw=$( (cd "$view" && run_timed ast-grep "${args[@]}") 2>"$ag_err" ); ag_rc=$?
      fi
      # ast-grep follows the grep convention, so an unparseable pattern or an
      # unknown language is >=2 and distinguishable from an honest no-match --
      # and, like ripgrep, it reports an unreadable file the same way, which is
      # a skipped file rather than a broken engine.
      note_search_result "$ag_rc" "$ag_err" ast-grep "matching '$pattern'${lang:+ in $lang}"
      rm -f "$ag_err"
      out=$(printf '%s\n' "$ag_raw" | normalize) ;;
    semgrep)
      # semgrep does not follow symlinks, so it is pointed at the real paths.
      local args=(-e "$pattern" --quiet --no-git-ignore)
      [[ -n "$lang" ]] && args+=(-l "$lang")
      # semgrep exits 0 whether or not it matched, so any non-zero is an error.
      # Recorded per repo inside the loop, because the loop's own status is only
      # that of the last repo and a failure on the first would vanish.
      local d
      out=$(while IFS= read -r d; do
              [[ -n "$d" ]] || continue
              (cd "$(dirname "$d")" && run_timed semgrep "${args[@]}" "$(basename "$d")" 2>/dev/null)
              note_run_status $? semgrep "matching '$pattern' in $(basename "$d")"
            done < <(real_dirs) | normalize) ;;
    *) die "unknown structural engine: $engine" ;;
  esac

  if [[ -z "$out" ]]; then
    engines_ok_or_die calls
    report_answer 0 0
    # A structural engine returns nothing both when there is no match and when
    # it cannot parse the language at all. Those are very different, and the
    # caller cannot tell them apart from an empty result.
    hint "cs text '$pattern'     (a structural engine returns nothing for a language it cannot parse — same as no match)" \
         "cs calls '$pattern' <lang>   (naming the language makes an unsupported one an error rather than silence)"
    return $CS_EXIT_NO_HITS
  fi
  emit_capped "$out"
  # ONE pattern is one shape, and the answer otherwise reads as complete. The
  # reported case: `cs calls '<Type>($$$ARGS)' python` returned 2 of 3 known
  # construction sites -- the third went through a classmethod factory -- and
  # nothing said a whole shape had never been looked at. This line is the cheap
  # half of cs constructs, and it is worth having on its own: it turns an
  # incomplete answer into an obviously incomplete one.
  #
  # Said only when the pattern looks like a CONSTRUCTION, because that is the
  # question with a known set of sibling shapes. A general pattern has no such
  # set, and a warning that fires on every query stops being read.
  case "$pattern" in
    *'($$$'*|*'( $$$'*)
      info ""
      info "this matched ONE shape: $pattern"
      info "  sibling shapes were NOT searched — a factory method, a builder chain, a"
      info "  copy/clone, or a deserializer constructs without matching this pattern"
      info "  ${C_BOLD}cs constructs <Type>${C_OFF} unions those shapes and says which it covered" ;;
  esac
  report_answer "$(n_hits_in "$out")" "$(n_repos_in "$out")"
}

# The second layer of the same guard as require_serena_toolchain, and the one
# that does not depend on knowing the language: never label `resolved` a
# zero-hit result the engine did not AFFIRMATIVELY produce.
#
# `answer resolved` used to be set before the call and survived every outcome --
# a server that errored, a call that timed out, a project that failed to load.
# All three arrived at the same `report_answer 0 0` as a genuine "no references
# exist", and only the genuine case is a negative result at all. The others are
# the absence of an answer, and the distinction is invisible from the empty
# string a single `out=$(… | …)` pipeline leaves behind.
#
# Called only when the formatted output is empty, so a partial-but-non-empty
# result still reaches the caller with its PARTIAL warning attached.
serena_answered_or_die() {  # <rc> <raw-file> <stderr-file> <subcommand> <symbol> <repo>
  local rc="$1" raw="$2" ef="$3" sub="$4" sym="$5" repo="$6" detail
  detail=$(head -3 "$ef" 2>/dev/null | tr '\n' ' ' | sed 's/ *$//')
  # Checked before the exit status, because a timeout is the more specific
  # diagnosis and run_timed reports it as a non-zero rc of its own.
  if timed_out; then
    if [[ -s "$ef" ]]; then cat "$ef" >&2; fi
    die "cs $sub: the language server hit the ${CS_TIMEOUT:-120}s timeout on '$sym' in $repo — PARTIAL, not an answer
  it did not finish, so there is nothing here to call a negative; a 'resolved'
  label on an unfinished run would be the strongest claim on the weakest evidence
  raise CS_TIMEOUT and rerun, or fall back to: cs def $sym $repo"
  fi
  # No server ran, so the naming advice below would send the caller after the
  # wrong problem. serena_call.py puts the reason first, with its fix when the
  # reason is a known one (#90).
  if [[ "$rc" -eq 6 ]]; then
    die "cs $sub: $(head -1 "$ef" 2>/dev/null | sed 's/^serena: //')
  '$sym' in $repo was not looked up, so this is NOT an answer — nothing was ruled out
  $(sed -n 2p "$ef" 2>/dev/null)
  weaker but available now: cs def $sym $repo, cs uses '$sym'"
  fi
  if [[ "$rc" -eq 5 ]]; then
    die "cs $sub: the language server refused the question for '$sym' in $repo
  ${detail:-no diagnostic was produced}
  nothing was looked up, so this is NOT an answer — nothing was ruled out
  name a member as Type.Member, Type/Member or its bare name, with the file that declares it
  find that file with: cs def ${sym##*[./]} $repo"
  fi
  if [[ "$rc" -ne 0 ]]; then
    die "cs $sub: the language server did not answer for '$sym' in $repo (serena exited $rc)
  ${detail:-no diagnostic was produced}
  nothing was analysed, so this is NOT 'resolved · 0 hit(s)' — nothing was ruled out
  check: cs doctor   (is this language's toolchain installed, findable, and the version the build asks for?)
  weaker but available now: cs def $sym $repo, cs uses '$sym'"
  fi
  if [[ ! -s "$raw" ]]; then
    die "cs $sub: the language server exited cleanly but returned no content for '$sym' in $repo
  an empty response is not an empty result set — the project may have failed to load
  check: cs doctor   (the toolchains this fleet's languages need, and the fix)
  weaker but available now: cs def $sym $repo, cs uses '$sym'"
  fi
  return 0
}

# The LSP-backed answers are the only ones that resolve an interface to its
# implementation, so they are worth the setup cost -- but only these.
# The graph route, taken only when the language server cannot run. Answers are
# `structural`, never `resolved`.
# The fourth argument is a REASON CODE, not a string to interpolate. It used to
# be documented as <missing-toolchain> and two of the three callers passed an
# English phrase into it, so the provenance line read "no explicitly requested
# here, so no language server" and the blind-spot warning claimed "cs refs ...
# needs explicitly requested" -- not merely ungrammatical, but FALSE about what
# cs refs actually requires, and a reader has no other way to learn the real
# prerequisite from that sentence.
#
# A malformed provenance label is the worst place for this project to be sloppy:
# labelling every answer with how it was obtained is the stated reason it
# exists. So the three routes get three sentences, and the toolchain is resolved
# HERE from the repo rather than passed in by a caller that may not know it.
impls_via_tokensave() {  # <symbol> <repo-name> <repo-dir> <toolchain-missing|forced|lsp-unresolved|lsp-not-started|lsp-off|build-copies>
  local sym="$1" repo="$2" dir="$3" reason="$4" out rc age tc lang note
  lang=$(symbol_language "$sym" "$dir") || lang=$(repo_language "$dir") || lang=""
  tc=""
  [[ -n "$lang" ]] && tc=$(language_toolchain "$lang" || true)
  local kt_want=""
  [[ "$lang" == kotlin ]] && kt_want=$(kotlin_jdk_unmet "$dir" || true)
  case "$reason" in
    forced)         note="graph requested explicitly" ;;
    lsp-unresolved) note="the language server did not resolve the symbol" ;;
    lsp-not-started) note="the language server did not start" ;;
    # The cause the warning above names, not "did not resolve": the server
    # never looked (#95). The answer line is the part an agent carries forward.
    lsp-off)        note="no $(lang_label "$lang") language server is enabled in the repo's Serena project" ;;
    build-copies)   note="the language server found the symbol only in build-output copies" ;;
    *) if [[ -n "$kt_want" ]]; then note="no JDK $kt_want for the build's jvmToolchain request here, so no language server"
       else note="no ${tc:-language toolchain} here, so no language server"; fi ;;
  esac
  # Through graph_note, so this route names WHICH index answered and how old it
  # is on the same terms as symbol mode. The age was already warned about on
  # stderr; putting it in the note is what gets it into the porcelain envelope,
  # which is the only channel a non-human caller reads.
  answer structural "tokensave (graph)" "$(graph_note "$repo" "$dir" "$note")"
  out=$(python3 "$lib_dir/tokensave_call.py" impls "$dir" "$repo" "$sym"); rc=$?
  case "$rc" in
    3) die "cs impls: '$sym' is not a type in $repo's graph
  the graph was never asked the question, so this is not 'nothing implements it'
  the graph may also predate the symbol — rebuild with: cd $(real_dir_of "$dir") && tokensave sync
  weaker but available now: cs def $sym $repo, cs uses '$sym'" ;;
    4) die "cs impls: the tokensave graph could not be queried for '$sym' in $repo
  nothing was read, so nothing was ruled out
  check: cs doctor   (graph coverage and age, and the fix)" ;;
  esac
  # A graph answers about the code as of its last sync, which makes staleness a
  # correctness problem rather than a tidiness one. Always stated.
  age=$(tokensave_graph_age_secs "$dir") && [[ -n "$age" ]] && \
    warn "answered from a tokensave graph last synced $(format_age "$age") ago — it cannot see changes made since (cd $(real_dir_of "$dir") && tokensave sync)"
  # Names the real prerequisite, or says nothing specific rather than something
  # untrue: the reader cannot learn what cs refs needs from anywhere else here.
  if [[ "$lang" == kotlin ]]; then
    warn "this is a GRAPH answer, not a language server: it cannot see reflection, DI registration, or generated code. cs refs is the only thing here that bridges a DI registration, and it needs a Kotlin language server that starts (docs/install.md, \"Kotlin language server\"), plus a JDK only when the build requests jvmToolchain(N), and then exactly N${kt_want:+ (this build requests $kt_want)}."
  elif [[ -n "$tc" ]]; then
    warn "this is a GRAPH answer, not a language server: it cannot see reflection, DI registration, or generated code. cs refs is the only thing here that bridges a DI registration, and it needs $tc."
  else
    warn "this is a GRAPH answer, not a language server: it cannot see reflection, DI registration, or generated code. cs refs is the only thing here that bridges a DI registration, and it needs a working language server for this repo's language."
  fi
  if [[ $rc -ne 0 || -z "$out" ]]; then
    report_answer 0 0
    hint "cs def $sym $repo       (where the symbol is declared)" \
         "cs calls '<pattern>'    (a shape the graph did not record)"
    return $CS_EXIT_NO_HITS
  fi
  emit_capped "$out"
  report_answer "$(n_hits_in "$out")" "$(n_repos_in "$out")"
}

cmd_impls() {
  [[ $# -ge 2 ]] || die "cs impls <symbol> <repo> [file]"
  require_python3 impls "driving the language server and formatting its answer"
  local repo_dir="$view/$2" file="${3:-}"
  [[ -d "$repo_dir" ]] || die "no such repo: $2"
  # An explicit --engine is an instruction, not a hint. It used to be read only
  # by cs def, so `cs impls X repo --engine=tokensave` was ACCEPTED and
  # DISCARDED -- and the refusal that followed looked exactly like the graph had
  # been asked and had nothing. That is worse than not offering the flag.
  case "${force_engine:-}" in
    tokensave)
      have_tokensave || die "--engine=tokensave requested but tokensave is not installed"
      tokensave_graph_at "$repo_dir" || die "--engine=tokensave requested but $2 has no graph
  $(graph_hint "$2" "$repo_dir")"
      impls_via_tokensave "$1" "$2" "$repo_dir" forced
      return $? ;;
    serena|lsp) ;;   # the default route below
    "") ;;
    *) die "cs impls has no engine named '$force_engine'
  it answers from: serena (language server) or tokensave (graph)
  a request for an engine that cannot serve this subcommand is dropped silently
  otherwise, which is indistinguishable from that engine finding nothing" ;;
  esac
  # Routing, in order of answer strength: a language server when it can run, a
  # graph when it cannot, and a refusal only when neither is available. The
  # toolchain question is asked about THIS SYMBOL's language, not the repo's
  # plurality one -- a mixed repo that is mostly JS with a large C# component
  # reported `javascript`, found node, and never reached the graph.
  local _missing_tc
  if _missing_tc=$(serena_missing_toolchain "$repo_dir" "$1"); then
    if have_tokensave && tokensave_graph_at "$repo_dir"; then
      impls_via_tokensave "$1" "$2" "$repo_dir" toolchain-missing
      return $?
    fi
  fi
  have uvx || die "serena needs uv installed"
  require_serena_toolchain impls "$1" "$2" "$repo_dir"
  serena_project_prepare "$repo_dir" "$2" "$1" "$file"

  # Serena identifies a symbol by name_path plus the file holding it, so the
  # symbol is looked up first rather than assuming a bare name is enough.
  #
  # Not a copy in build output (#95). JDTLS imports a Gradle build into bin/,
  # copying every .kt there, and the lookup took the first match -- the copy,
  # which no server owns. Its empty answer came back `resolved · 0 hit(s)` for
  # an interface with three implementations. A copy is a match git does not
  # track under bin/, build/, out/, target/ or obj/; a tracked file is source,
  # whatever its directory is called.
  local resolved lookup_err lookup_rc
  lookup_err=$(cs_tmp cs-serena-err)
  resolved=$(python3 "$lib_dir/serena_call.py" "$repo_dir" find_symbol \
             "{\"name_path\":\"$1\",\"include_body\":false}" 2>"$lookup_err" \
    | python3 -c '
import json, re, subprocess, sys
raw = sys.stdin.read().strip()
try:
    rows = json.loads(raw) if raw else []
except json.JSONDecodeError:
    rows = []
want, repo = sys.argv[1], sys.argv[2]
hits = [r for r in rows if r.get("kind") not in ("File",)
        and r.get("name_path", "").split("/")[-1] == want and r.get("relative_path")]
built = re.compile(r"(^|/)(bin|build|out|target|obj)/")
maybe = sorted({r["relative_path"] for r in hits if built.search(r["relative_path"])})
tracked = set()
if maybe:
    try:
        tracked = set(subprocess.run(["git", "-C", repo, "ls-files", "--"] + maybe,
                                     capture_output=True, text=True, timeout=30).stdout.split("\n"))
    except (OSError, subprocess.SubprocessError):
        tracked = set(maybe)          # cannot tell: treat none as a copy
copies = [p for p in maybe if p not in tracked]
pick = next((r for r in hits if r["relative_path"] not in copies), None)
if pick:
    print("pick\t" + pick["name_path"] + "\t" + pick["relative_path"] + "\t" + str(len(copies)))
elif copies:
    print("copies\t" + ", ".join(copies[:3]) + (" (+%d more)" % (len(copies) - 3) if len(copies) > 3 else ""))
' "$1" "$repo_dir")

  local name_path="" rel="" copies=""
  case "$resolved" in
    pick$'\t'*)
      name_path=$(printf '%s' "$resolved" | cut -f2)
      rel=$(printf '%s' "$resolved" | cut -f3)
      [[ "$(printf '%s' "$resolved" | cut -f4)" -gt 0 ]] 2>/dev/null && \
        info "asking about '$1' in $rel; skipped $(printf '%s' "$resolved" | cut -f4) build-output copy(ies) of it, which no language server owns" ;;
    copies$'\t'*) copies=$(printf '%s' "$resolved" | cut -f2) ;;
  esac
  [[ -n "$file" ]] && rel="$file"
  # A REFUSAL, not a zero-hit answer: find_implementations was never called, so
  # no implementation was ruled out. It reported the same exit code as a real
  # empty result set, which is the distinction this whole taxonomy turns on.
  #
  # But a language server that was pointed at the wrong language and found
  # nothing is not evidence either, and dying here with a usable graph sitting
  # untouched is a working engine never being asked. So the graph gets the
  # question before the refusal does.
  # The lookup's own failure, not "could not locate": a server that never
  # started has not looked, and its reason is the one thing worth reading (#90).
  local lookup_why="" lookup_log=""
  if grep -q '^serena: the language server did not start: ' "$lookup_err" 2>/dev/null; then
    lookup_why=$(head -1 "$lookup_err" | sed 's/^serena: //')
    lookup_log=$(sed -n 2p "$lookup_err")
  fi
  rm -f "$lookup_err"
  if [[ -z "$name_path" || -z "$rel" ]]; then
    if [[ -n "$lookup_why" ]] && have_tokensave && tokensave_graph_at "$repo_dir"; then
      warn "$lookup_why — falling back to the tokensave graph"
      impls_via_tokensave "$1" "$2" "$repo_dir" lsp-not-started
      return $?
    fi
    [[ -n "$lookup_why" ]] && die "cs impls: $lookup_why
  '$1' in $2 was not looked up, so this is NOT an answer — nothing was ruled out
  $lookup_log
  weaker but available now: cs def $1 $2, cs uses '$1'"
    # The cause, when it is that no server for the symbol's language ran (#95),
    # or that the only matches were build-output copies; spelling is neither.
    local why_not="" why_code="" off q_lang
    q_lang=$(question_language "$1" "$repo_dir" "$file" || true)
    if [[ -n "$q_lang" ]] && off=$(serena_project_lacks "$repo_dir" "$q_lang"); then
      why_code=lsp-off
      why_not=$(serena_lang_off impls "$1" "$2" "$repo_dir" "$q_lang" "$off")
    elif [[ -n "$copies" ]]; then
      why_code=build-copies
      why_not="cs impls: the language server found '$1' in $2 only in build output ($copies)
  git does not track those files, so they are copies no language server owns, and a copy's answer is empty — it was not asked, and nothing was ruled out
  fix: add the build directory (bin/ for JDTLS) to $2's .gitignore, or to ignored_paths: in $(real_dir_of "$repo_dir")/.serena/project.yml, then rerun"
    fi
    if [[ -n "$why_not" ]] && have_tokensave && tokensave_graph_at "$repo_dir"; then
      warn "$(printf '%s\n' "$why_not" | head -1 | sed 's/^cs impls: //') — falling back to the tokensave graph"
      if [[ "$why_code" == lsp-off ]]; then impls_via_tokensave "$1" "$2" "$repo_dir" lsp-off
      else impls_via_tokensave "$1" "$2" "$repo_dir" build-copies; fi
      return $?
    fi
    [[ -n "$why_not" ]] && die "$why_not
  weaker but available now: cs def $1 $2, cs uses '$1'"
    if have_tokensave && tokensave_graph_at "$repo_dir"; then
      warn "the language server could not locate '$1' in $2 — falling back to the tokensave graph"
      impls_via_tokensave "$1" "$2" "$repo_dir" lsp-unresolved
      return $?
    fi
    err "could not locate symbol '$1' in $2 — find_implementations was not run, so nothing was ruled out"
    hint "cs def $1 $2            (check the symbol exists and how it is spelled)"
    return $CS_EXIT_REFUSED
  fi

  # Run as two steps rather than one pipeline, because the pipeline collapsed
  # exactly the two outcomes that must never be confused: a server that produced
  # no answer, and a server that answered "none". Both left "$out" empty.
  #
  # Formatted and capped like every other subcommand. Raw Serena JSON was both
  # unscoreable and uncapped, so the one engine whose answers are strongest was
  # also the one whose output could flood a context window unannounced.
  local out raw err_file rc
  raw=$(cs_tmp cs-serena); err_file=$(cs_tmp cs-serena-err)
  run_timed python3 "$lib_dir/serena_call.py" "$repo_dir" find_implementations \
        "{\"name_path\":\"$name_path\",\"relative_path\":\"$rel\"}" \
        >"$raw" 2>"$err_file"; rc=$?
  out=$(python3 "$lib_dir/serena_fmt.py" "$2" < "$raw")
  # The server's notes (a re-ask, an import with warnings) are passed on; a
  # failure's message is not, because the refusal below quotes it, and an
  # agent reading stderr saw one event twice (#86).
  if [[ -s "$err_file" ]] && [[ "$rc" -eq 0 || -n "$out" ]]; then cat "$err_file" >&2; fi
  if [[ -z "$out" ]]; then
    # Dies unless the emptiness is an answer rather than the absence of one.
    serena_answered_or_die "$rc" "$raw" "$err_file" impls "$1" "$2"
    rm -f "$raw" "$err_file"
    answer resolved "serena (LSP)" "scoped to $2"
    report_answer 0 0
    hint "cs def $1              (confirm the symbol is spelled as the server sees it)" \
         "cs calls '<pattern>'   (an implementation the server could not load is invisible here)"
    return $CS_EXIT_NO_HITS
  fi
  rm -f "$raw" "$err_file"
  # Set only now, once the server has affirmatively produced something. The
  # label used to be assigned before the call and survived every failure.
  answer resolved "serena (LSP)" "scoped to $2"
  emit_capped "$out"
  report_answer "$(n_hits_in "$out")" "$(n_repos_in "$out")"
}

# ---- symbol mode -----------------------------------------------------------
# `cs uses` and `cs seam` ask about NAMES; these three ask about SYMBOLS. Both
# halves belong behind one interface because a real question crosses between
# them: "I am renaming this route — what breaks" starts as a seam question and
# ends as a symbol question, and handing the caller off to a different tool with
# a different scoping model halfway through IS the cost.
#
# What cs adds over calling the graph tool directly is not coverage -- the graph
# is good at this -- but three things it does not carry:
#
#   - the answer KIND. A graph answer is `structural`: it cannot see reflection,
#     DI registration, or generated code. Raw graph output says none of that,
#     and readers act on it as though it were `resolved`.
#   - STALENESS. A graph is the one engine here that can be confidently wrong
#     rather than blind, so its sync age is on every answer.
#   - REFUSAL DISCIPLINE. Two of the graph's own tools return an empty result
#     with exit 0 for a bare name (see tokensave_call.py) -- a manufactured
#     negative on the exact question people delete code over.
#
# Deliberately three subcommands and not ninety. The tool behind this exposes on
# the order of ninety operations -- dead code, coupling, complexity, blame, test
# mapping, call chains, inheritance depth. Fronting all of it would make cs a
# second, worse interface for something already good at it, and would cost the
# property that makes cs legible: subcommands shaped like questions, few enough
# to hold in your head. For anything deeper the honest move is the pointer in
# `cs which`, not another wrapper.
symbol_graph_query() {  # <callers|callees|impact> <symbol> <repo>
  local mode="$1" sym="$2" repo="$3"
  # A second statement, not more words on the line above: one `local` expands
  # every word BEFORE it assigns any of them, so `dir="$view/$repo"` there reads
  # a $repo that does not exist yet and dies under `set -u`.
  local dir="$view/$repo" fleet_dir="$root/$repo"
  require_python3 "$mode" "resolving the symbol to a graph node and formatting the answer"
  [[ -d "$dir" ]] || die "no such repo: $repo"
  have_tokensave || die "cs $mode needs tokensave, and it is not installed
  these three answer from a symbol graph and have no second engine: a language
  server answers about references (cs refs), not about a call graph
  install it, then: cd $(real_dir_of "$dir") && tokensave init
  weaker but available now: cs uses '$sym', cs def $sym $repo"
  # Same rule as cs impls: an --engine cs cannot honour is refused rather than
  # dropped, because a dropped request looks exactly like that engine answering
  # and finding nothing.
  case "${force_engine:-}" in
    ""|tokensave) ;;
    serena|lsp) die "cs $mode has no language-server route
  a language server resolves references, not a call graph — the nearest resolved
  answer is: cs refs $sym $repo $(refs_file "$sym" "$repo" "$dir")" ;;
    *) die "cs $mode has no engine named '$force_engine'
  it answers from: tokensave (graph), and nothing else" ;;
  esac

  # WHICH index answers, decided here rather than by whatever is on disk. The
  # layered view already points $view/<repo> at the right copy, so preferring it
  # is what keeps a ticket answer a ticket answer. The fleet copy is the
  # fallback, taken loudly: an answer that excludes your branch is still worth
  # having if you know that is what it is, and worthless if you do not.
  local graph_dir="" substituted=0
  if tokensave_graph_at "$dir"; then
    graph_dir="$dir"
  elif [[ "$CS_SCOPE" != "fleet" && -d "$fleet_dir" ]] && tokensave_graph_at "$fleet_dir"; then
    graph_dir="$fleet_dir"; substituted=1
  else
    die "cs $mode: $repo has no tokensave graph, so the question was never asked
  nothing was read there, and an empty answer would read as 'nothing calls this'
  $(graph_hint "$repo" "$dir")
  weaker but available now: cs uses '$sym', cs def $sym $repo"
  fi

  local extra gap_lang=""
  case "$mode" in
    callers) extra="direct callers" ;;
    callees) extra="direct callees" ;;
    impact)  extra="dependents, transitively, depth ≤ 3" ;;
  esac
  # In the provenance line, not only on stderr: it is the line an MCP caller
  # reads, and a zero here is otherwise indistinguishable from "unused".
  gap_lang=$(graph_accessor_gap "$(symbol_language "$sym" "$graph_dir" || repo_language "$graph_dir" || true)") \
    && extra="$extra; calls inside $gap_lang property accessors are not in the graph"
  answer structural "tokensave (graph)" "$(graph_note "$repo" "$graph_dir" "$extra")"

  local out rc
  out=$(python3 "$lib_dir/tokensave_call.py" "$mode" "$graph_dir" "$repo" "$sym"); rc=$?
  case "$rc" in
    3) die "cs $mode: '$sym' is not a node this graph can answer $mode for, in $repo
  the graph was never asked, so this is NOT 'nothing calls it' — the reason is
  on the line above
  the graph may also predate the symbol — rebuild with: cd $(real_dir_of "$graph_dir") && tokensave sync
  weaker but available now: cs def $sym $repo, cs uses '$sym'" ;;
    4) die "cs $mode: the tokensave graph could not be queried for '$sym' in $repo
  nothing was read, so nothing was ruled out
  check: cs doctor   (graph coverage and age, and the fix)" ;;
  esac

  graph_caveats "$repo" "$graph_dir" "$substituted"
  warn "this is a GRAPH answer, not a language server: it cannot see reflection, DI registration, or generated code. cs refs is the only thing here that bridges a DI registration."
  [[ -n "$gap_lang" ]] && warn "tokensave's $gap_lang graph has no edges out of property accessors (get/set/init) or into properties: a call made inside a getter or setter is missing from this answer (cs uses '$sym' --word finds it as text)"

  if [[ $rc -ne 0 || -z "$out" ]]; then
    # A zero from a graph with a known hole in it is not "nothing calls this".
    [[ -n "$gap_lang" ]] && CS_DEGRADED="${CS_DEGRADED:+$CS_DEGRADED; }a $mode zero in $gap_lang is not 'unused': calls made inside property accessors are not edges in tokensave's $gap_lang graph — check cs uses '$sym' --word"
    report_answer 0 0
    case "$mode" in
      callers) local rf; rf=$(refs_file "$sym" "$repo" "$dir")
               if [[ -n "$gap_lang" ]]; then
                 hint "cs uses '$sym' --word   (a call inside a $gap_lang property accessor is not in the graph; this finds it as text)" \
                      "cs refs $sym $repo $rf   (a language server sees accessor calls and DI registrations the graph cannot)"
               else hint "cs uses '$sym'          (a caller in another repo is a string, not an edge)" \
                    "cs refs $sym $repo $rf   (a language server sees a DI registration the graph cannot)"
               fi ;;
      callees) hint "cs def $sym $repo       (confirm the symbol is the one you mean)" \
                    "cs calls '<pattern>'    (a call shape the graph did not record)" ;;
      impact)  hint "cs callers $sym $repo   (impact walks dependents; start with the direct ones)" \
                    "cs uses '$sym'          (the cross-repo half, which no per-repo graph holds)" ;;
    esac
    return $CS_EXIT_NO_HITS
  fi
  emit_capped "$out"
  report_answer "$(n_hits_in "$out")" "$(n_repos_in "$out")"
}

cmd_callers() {
  [[ $# -ge 2 ]] || die "cs callers <symbol> <repo>"
  symbol_graph_query callers "$1" "$2"
}

cmd_callees() {
  [[ $# -ge 2 ]] || die "cs callees <symbol> <repo>"
  symbol_graph_query callees "$1" "$2"
}

cmd_impact() {
  [[ $# -ge 2 ]] || die "cs impact <symbol> <repo>"
  symbol_graph_query impact "$1" "$2"
}

# ---- cs fields -------------------------------------------------------------
# "If I change, remove, rename or re-default field X, who is affected?" -- the
# core question of an API-impact review, and the one shape the other verbs
# cannot express. cs uses / cs text / cs seam answer it TEXTUALLY: no read/write
# distinction, no enclosing symbol, and no way to separate the code that SETS a
# field from the code that reads it. cs callers / cs callees / cs impact answer
# structurally but are symbol-scoped, and a field is not a symbol they take.
#
# The write/read split is the whole value, because it is two different blast
# radii from one query:
#
#   - an additive change, or a changed DEFAULT, can only be observed by the
#     WRITE sites; it is unobservable anywhere the object is merely read
#   - a removal, rename or retype breaks the READ sites
#
# A text sweep collapses both into one list, which is why reviewing a
# default-value change with grep returns precisely the sites where the change
# is NOT observable.
#
# Unlike cs callers/callees/impact this is fleet-wide rather than per-repo: the
# question is "who is affected", and stopping at a repo boundary answers a
# smaller question than the one asked. Graphs are still per-repo, so the union
# is assembled here and the repos with no graph are NAMED -- a field read in an
# unindexed repo looks exactly like a field nobody reads.
# The summary half of the same question. For an impact review the first thing
# you need is not every site but HOW BIG and WHERE -- and at fleet scale the
# full listing cannot be produced at all: a common field name overflows
# tokensave's own 15000-character output even with reads limited to 1, so the
# listing route correctly refuses and the fleet-wide question is left with no
# answer. Counts have no such ceiling, because they are read from the JSON HEAD
# and survive the truncation that destroys the arrays.
#
# Deliberately NOT the union graph. A fleet-wide union graph answers promptly
# where the per-repo fan-out refuses, but it silently CAPS instead of refusing:
# write_count came back as 20 with limit 20 and 21 with limit 21, so it tracks
# the limit and nothing distinguishes "21 sites exist" from "21 of many were
# returned". The fan-out's honest refusal is better behaviour than that, and a
# summary built on a capped count would be a total nobody established.
# From tokensave 7.11 a `Type::field` qualifier is APPLIED: a site is kept
# only when its receiver resolves to the type. A zero from that is a fact about
# typing, not about who uses the field -- measured, a Python attribute that is
# only assigned (`self._x = ...`) has no declaration for the type to own, so
# DiscountEngine::_threshold answers zero in the fixture although DiscountEngine
# both writes and reads it. The generic "no site" refusal would send the reader
# to check a name that is fine.
fields_qualifier_unmatched_msg() {  # <Type::field> [--count]
  local field="$1" flag="${2:+ $2}"
  printf '%s' "cs fields$flag: tokensave applied the qualifier in '$field' and no site's receiver resolved to '${field%%::*}' in any graph — this is NOT 'nothing uses it'
  the narrowing keeps a site only when its receiver is typed as '${field%%::*}':
  an attribute that is only assigned (Python's self.${field##*::} = ...) has no
  declaration to match, and a receiver returned by a call cannot be typed, so a
  real type can answer with the same zero as a misspelt one
  ask the broad question deliberately with: cs fields '${field##*::}'$flag"
}

# The other half of the same narrowing: sites whose receiver could not be typed
# are counted by the engine and NOT listed, so a narrowed answer with any of
# them is a lower bound -- each repo's count is on the lines above.
fields_lower_bound_warn() {  # <Type::field> <repos>
  warn "PARTIAL: narrowed by receiver type, and in:$2 some sites' receivers could not be typed and are NOT included — a LOWER BOUND. Unnarrowed: cs fields '${1##*::}'"
}

fields_count_via_tokensave() {  # <field> [only-repo]
  local field="$1" only="${2:-}" d name rows="" rc n_graph=0 no_graph="" oldest="" age
  local refs_only="" qual_unmatched="" lower_bound=""
  for d in $(real_dirs); do
    name=$(basename "$d")
    [[ -n "$only" && "$name" != "$only" ]] && continue
    if ! tokensave_graph_at "$d"; then no_graph="$no_graph $name"; continue; fi
    n_graph=$((n_graph + 1))
    age=$(tokensave_graph_age_secs "$d") || age=""
    if [[ -n "$age" && ( -z "$oldest" || "$age" -gt "$oldest" ) ]]; then oldest="$age"; fi
    local one
    one=$(python3 "$lib_dir/tokensave_call.py" field-counts "$d" "$name" "$field"); rc=$?
    case "$rc" in
      3) die "cs fields --count: the qualifier in '$field' was parsed but not applied by tokensave, so the counts would be the bare name's
  ask the broad question deliberately with: cs fields '${field##*::}' --count" ;;
      4) die "cs fields --count: the tokensave graph for $name could not be queried
  nothing was read there, so nothing was ruled out
  check: cs doctor   (graph coverage and age, and the fix)" ;;
      5) # Counted, but as REFERENCES rather than sites: the engine truncated
         # its output, so the site arrays are incomplete and distinct file:line
         # cannot be derived. tokensave has no paging to page around it -- it
         # accepts an unknown --offset silently and ignores it. References still
         # bound the magnitude, and are labelled in the row so nobody compares
         # them against a listing's site count.
         CS_SOURCE_PARTIAL=1
         refs_only="$refs_only $name" ;;
      7) qual_unmatched="$qual_unmatched $name" ;;
      8) CS_SOURCE_PARTIAL=1; lower_bound="$lower_bound $name" ;;
    esac
    [[ -n "$one" ]] && rows="${rows:+$rows
}$one"
  done

  [[ $n_graph -gt 0 ]] || die "cs fields: no repo in view has a tokensave graph
  build one with: cd <repo> && tokensave init"

  answer structural "tokensave (graph)" "$n_graph repo graph(s), per-repo counts"
  [[ -n "$oldest" ]] && warn "answered from graph(s) last synced up to $(format_age "$oldest") ago — changes made since are invisible (tokensave sync)"
  [[ -n "$no_graph" ]] && warn "no tokensave graph, so NOT counted:$no_graph — a read or write in those repos is missing from these totals"

  # Same refusal as the listing route, for the same reason: tokensave returns
  # zero counts for a field that does not exist in the identical shape it
  # returns for one that is never touched, and no probe here separates them.
  [[ -z "$rows" && -n "$qual_unmatched" ]] && die "$(fields_qualifier_unmatched_msg "$field" --count)"
  if [[ -z "$rows" ]]; then
    die "cs fields --count: no read or write site for '$field' in $n_graph graph(s) — this is NOT 'nothing uses it'
  tokensave returns the same zero counts for a field that does not exist as for
  one that exists and is never touched, and nothing here can separate them
  confirm the name is real first: cs text '$field'"
  fi

  [[ -n "$lower_bound" ]] && fields_lower_bound_warn "$field" "$lower_bound"
  [[ -n "$refs_only" ]] && warn "PARTIAL: tokensave truncated its output for:$refs_only — those rows count REFERENCES, not sites, and are not comparable with a listing's site count (three references on one line are one place to edit)"

  emit_capped "$rows"
  # Parsed from the head of each row, anchored, rather than with a loose `.*`:
  # a row can carry a trailing `(refs: N write, M read)` and a greedy match
  # would be one rename away from summing the wrong numbers.
  local tw tr
  tw=$(printf '%s\n' "$rows" | awk -F'writes ' 'NF>1 {split($2, a, ","); s += a[1]} END {print s+0}')
  tr=$(printf '%s\n' "$rows" | awk -F'reads ' 'NF>1 {split($2, a, " "); s += a[1]} END {print s+0}')
  info ""
  # The unit is named. These are SITES -- distinct file:line, the same quantity
  # the listing mode reports -- because that is what a reviewer means by blast
  # radius. tokensave counts occurrences, which overstates it.
  info "${C_BOLD}total: writes $tw, reads $tr${C_OFF} site(s) across $(n_hits_in "$rows") repo(s) with a graph"
  [[ -n "$refs_only" ]] && info "  NOT all of that total is sites: the rows marked above count references, so this figure is an upper bound"
  info "  writes observe an added field or a changed default; reads break on a removal, rename or retype"
  info "  drill in with: cs fields '$field' <repo>"
  report_answer "$(n_hits_in "$rows")" "$(n_hits_in "$rows")"
}

fields_via_tokensave() {  # <field> [only-repo]
  local field="$1" only="${2:-}" d name out="" rc n_graph=0 no_graph="" oldest="" age
  local truncated_by_engine="" qual_unmatched="" lower_bound=""
  for d in $(real_dirs); do
    name=$(basename "$d")
    [[ -n "$only" && "$name" != "$only" ]] && continue
    if ! tokensave_graph_at "$d"; then no_graph="$no_graph $name"; continue; fi
    n_graph=$((n_graph + 1))
    age=$(tokensave_graph_age_secs "$d") || age=""
    if [[ -n "$age" && ( -z "$oldest" || "$age" -gt "$oldest" ) ]]; then oldest="$age"; fi
    local one
    one=$(python3 "$lib_dir/tokensave_call.py" fields "$d" "$name" "$field"); rc=$?
    case "$rc" in
      3) die "cs fields: the qualifier in '$field' was parsed but not applied by tokensave, so the query was NOT narrowed
  the sites it would have returned are the ones for the bare field name, which
  is the broad answer under a narrow heading -- refused rather than shown
  measured on tokensave 7.9.0: a real type and a fabricated one return the
  identical result, so the qualifier does not even spell-check (7.11 applies it)
  ask the broad question deliberately with: cs fields '${field##*::}'" ;;
      4) die "cs fields: the tokensave graph for $name could not be queried
  nothing was read there, so nothing was ruled out
  check: cs doctor   (graph coverage and age, and the fix)" ;;
      6) # Not a failure to answer -- a failure to LIST. The graph holds so many
         # sites for this field in $name that tokensave's own 15000-character
         # output overflows on the write list alone, so no complete listing can
         # be read. The blast-radius question still has an answer, and refusing
         # without naming it would leave the fleet-wide case with none at all.
         die "cs fields: the site list for '$field' in $name does not fit in tokensave's output, and a partial list would understate the blast radius
  the limit is output BYTES (15000 chars), not a number of sites — long
  snippets overflow it at a few dozen sites, so a small site count here is
  expected rather than surprising
  the COUNTS are unaffected -- they precede the sites in the graph's output and
  survive the cut that destroys the arrays:
    cs fields '$field' --count     per-repo writes and reads, fleet-wide
  narrowing to $name does NOT help: it is the repo that overflows" ;;
      5) # Sites came back, but the engine cut its own output and the reads
         # below are a sample of an unknown total. PARTIAL, and said so in the
         # envelope as well as on stderr -- a read total that reads as complete
         # would understate exactly the blast radius this verb is for.
         CS_SOURCE_PARTIAL=1
         truncated_by_engine="$truncated_by_engine $name" ;;
      7) qual_unmatched="$qual_unmatched $name" ;;
      8) CS_SOURCE_PARTIAL=1; lower_bound="$lower_bound $name" ;;
    esac
    [[ -n "$one" ]] && out="${out:+$out
}$one"
  done

  [[ $n_graph -gt 0 ]] || die "cs fields: no repo in view has a tokensave graph
  this question has no second engine -- a text search cannot tell a read from a
  write, which is the distinction the answer is for
  build one with: cd <repo> && tokensave init
  weaker but available now: cs uses '$field'"

  answer structural "tokensave (graph)" "$n_graph repo graph(s), read/write split"
  [[ -n "$oldest" ]] && warn "answered from graph(s) last synced up to $(format_age "$oldest") ago — changes made since are invisible (tokensave sync)"
  [[ -n "$no_graph" ]] && warn "no tokensave graph, so NOT searched:$no_graph — a read or write in those repos cannot be found this way"
  warn "this is a GRAPH answer, not a language server: it cannot see reflection, DI registration, serialization by name, or generated code — all of which touch fields without a site the graph records."
  # Named per repo, because the sampling happened per graph and the read counts
  # printed below are true for the other repos.
  [[ -n "$lower_bound" ]] && fields_lower_bound_warn "$field" "$lower_bound"
  # The write lists are complete because tokensave_call.py fetched them on
  # their own and CHECKED them against the graph's write total -- not because
  # --limit spares them, which stopped being true in tokensave 7.11 (#44).
  [[ -n "$truncated_by_engine" ]] && warn "PARTIAL: tokensave truncated its own output for:$truncated_by_engine — the reads from those repos are a SAMPLE (each repo's true read-reference total is on the lines above). The write lists are complete. Narrow with: cs fields '$field' <repo>"

  # An empty result REFUSES rather than reporting zero. tokensave's field_sites
  # returns write_count 0 / read_count 0 with exit 0 for a field that does not
  # exist, in exactly the shape it returns for a field that exists and is never
  # touched -- and there is no second probe that separates them:
  # find_exact_symbol reports count 0 for a real field too, because field nodes
  # are not in that index at all.
  #
  # So "nothing reads this field" here would be a negative nobody established,
  # about the question people delete a field on. The two commands that actually
  # disambiguate are named instead.
  [[ -z "$out" && -n "$qual_unmatched" ]] && die "$(fields_qualifier_unmatched_msg "$field")"
  if [[ -z "$out" ]]; then
    die "cs fields: no read or write site for '$field' in $n_graph graph(s) — this is NOT 'nothing uses it'
  tokensave returns the same empty answer for a field that does not exist as
  for one that exists and is never touched, and nothing here can separate them
  confirm the name is real first: cs text '$field'   (or: cs def '$field')
  if it is real and this is still empty, the field is genuinely untouched in
  the indexed repos -- but read the not-searched list above before concluding it"
  fi

  # Capped PER KIND, not per answer. Reads outnumber writes heavily (~7:1 in the
  # reported case), so a single cap over the combined stream would spend the
  # whole budget on reads and truncate the writes away -- and the writes are the
  # half that answers "who observes a changed default". Each kind gets an equal
  # share, and a kind that does not use its share donates the remainder to the
  # other, so a query with no writes still shows the full budget of reads.
  local writes reads n_w n_r cap half budget_w budget_r shown_w shown_r
  writes=$(printf '%s\n' "$out" | grep -F ': [write]' || true)
  reads=$(printf '%s\n' "$out" | grep -F ': [read]' || true)
  n_w=$(printf '%s' "$writes" | grep -c '[^[:space:]]' || true)
  n_r=$(printf '%s' "$reads" | grep -c '[^[:space:]]' || true)

  cap="${CS_MAX_RESULTS:-200}"
  if [[ "$cap" -le 0 ]]; then
    budget_w=$n_w; budget_r=$n_r
  else
    half=$(( cap / 2 ))
    budget_w=$half; budget_r=$(( cap - half ))
    if [[ "$n_w" -lt "$budget_w" ]]; then budget_r=$(( cap - n_w )); budget_w=$n_w; fi
    if [[ "$n_r" -lt "$budget_r" ]]; then budget_w=$(( cap - n_r )); budget_r=$n_r; fi
  fi

  local capped=""
  # awk rather than head, for the reason emit_capped uses it: head closes the
  # pipe at the cap and the builtin printf reports EPIPE on stderr.
  [[ "$n_w" -gt 0 ]] && capped=$(printf '%s\n' "$writes" | awk -v n="$budget_w" 'NR<=n')
  if [[ "$n_r" -gt 0 ]]; then
    local rpart; rpart=$(printf '%s\n' "$reads" | awk -v n="$budget_r" 'NR<=n')
    capped="${capped:+$capped
}$rpart"
  fi
  shown_w=$(( n_w < budget_w ? n_w : budget_w ))
  shown_r=$(( n_r < budget_r ? n_r : budget_r ))

  emit_plain "$capped"
  # Disclosed per kind, for the same reason the cap is per kind: one combined
  # "showing 200 of 900" would hide which half was cut.
  info ""
  # When the engine sampled the reads, n_r is a floor and not a total, and it
  # is spelled that way. "read sites: 30" beside a truncation warning would
  # still be read as thirty -- the number is what a reader takes away, not the
  # caveat three lines up.
  local r_total="$n_r"
  [[ -n "$truncated_by_engine" ]] && r_total="≥$n_r (true total unknown — engine sampled)"
  info "${C_BOLD}write sites: $n_w${C_OFF} (shown $shown_w) — these observe an added field or a changed default"
  info "${C_BOLD}read sites:  $r_total${C_OFF} (shown $shown_r) — these break on a removal, rename or retype"
  if [[ "$shown_w" -lt "$n_w" || "$shown_r" -lt "$n_r" ]]; then
    CS_TRUNCATED=$(( n_w + n_r ))
    info "raise the cap with CS_MAX_RESULTS, or narrow with: cs fields '$field' <repo>"
  fi
  report_answer "$(n_hits_in "$capped")" "$(n_repos_in "$capped")"
}

cmd_fields() {
  [[ $# -ge 1 ]] || die "cs fields <field|Type::field> [repo]
  every read and write site of a field, across every repo with a graph"
  local only="${2:-}"
  require_python3 fields "querying the graph and splitting reads from writes"
  have_tokensave || die "cs fields needs tokensave, and it is not installed
  no second engine answers this: a text search cannot tell a read from a write
  install it, then: cd <repo> && tokensave init
  weaker but available now: cs uses '$1'"
  case "${force_engine:-}" in
    ""|tokensave) ;;
    *) die "cs fields has no engine named '$force_engine'
  it answers from: tokensave (graph), and nothing else" ;;
  esac
  [[ -n "$only" && ! -d "$view/$only" ]] && die "no such repo: $only"
  if [[ $count_mode -eq 1 ]]; then
    fields_count_via_tokensave "$1" "$only"
  else
    fields_via_tokensave "$1" "$only"
  fi
}

# ---- cs constructs ---------------------------------------------------------
# "I am changing the DEFAULT of field X -- who is affected?" A default is only
# observable where the object is CONSTRUCTED, and specifically at the sites that
# OMIT the field and inherit it. Every site that passes a value is unaffected.
#
# cs calls answers this well for one shape and silently misses the rest. The
# reported case: `cs calls '<Type>($$$ARGS)' python` returned 2 of 3 known
# construction sites -- the third went through a classmethod factory -- and
# nothing in the answer indicated a whole construction shape had never been
# looked at. "7 hit(s)" reads as thorough. That is the silent under-selection
# class: the sensor answered the question it was asked, and the question was
# narrower than the caller's intent. Worse, writing enough patterns requires
# already knowing which idioms the codebase uses, and a caller who knew that
# would not need the search.
#
# So this verb OWNS the enumeration. The shapes it searches and the shapes it
# cannot are both part of the answer, every time -- the disclosure is the
# feature, not a footnote on it.
#
# Priority order matters: `new T(...)` also contains `T(...)`, so the more
# specific shape is tried first and a location already claimed is not re-listed
# under a weaker label.
CS_CONSTRUCT_SHAPES='ctor-new|new %s($$$ARGS)
ctor|%s($$$ARGS)
builder?|%s.builder($$$ARGS)
factory?|%s.$M($$$ARGS)'

# Named in every answer. These are constructions no pattern here can find, and
# a caller who does not know that will read the result as the complete set.
# Matches the engine returned for a shape whose pattern no longer carried the
# type name -- see ast_grep_matches.py. Tallied to a FILE because the search
# runs inside `$(...)`: a counter incremented there dies with the subshell, the
# same trap the comment on construct_shape_names records.
CS_CONSTRUCT_DROPPED=""

construct_blind_spots() {
  warn "shapes NOT searched, and a construction in any of them is missing from this answer:"
  warn "  cls(…) / self.__class__(…) inside the type's own module — a factory's own body"
  warn "  clone and copy: x.copy(…), x.model_copy(…), {...obj} — the receiver's type is not known to a pattern matcher"
  warn "  deserialization: json.loads → model, ORM row hydration — these construct without naming any field, so a default change is invisible at the call site"
  warn "  reflection, DI containers, and generated code"
}

constructs_via_ast_grep() {  # <type> [only-repo]
  local type="$1" only="${2:-}" shape pat out="" line loc
  local seen_f; seen_f=$(cs_tmp cs-constr-seen)
  local searched=""
  : > "$seen_f"

  while IFS='|' read -r shape pat; do
    [[ -n "$shape" ]] || continue
    # ONE argument, not two: every pattern carries a single %s, and printf
    # repeats its format for each extra argument -- two here rendered
    # `new T($$$ARGS)new T($$$ARGS)`, which matches nothing anywhere.
    # shellcheck disable=SC2059
    local rendered; rendered=$(printf "$pat" "$type")
    local raw rc err_f rc_f
    err_f=$(cs_tmp cs-engerr)
    rc_f=$(cs_tmp cs-engrc)
    # --json=stream, not the plain output, because the type-name guard inside
    # ast_grep_matches.py has to be applied per MATCH: a multi-line
    # construction carries the type name on its first line only, and a
    # line-wise test would discard the body of every real hit. The helper
    # re-emits `path:line:source-line`, so everything downstream is unchanged.
    #
    # ast-grep's own status is written to a file rather than read from
    # PIPESTATUS: this is an ASSIGNMENT whose right-hand side is a command
    # substitution, so PIPESTATUS afterwards describes the assignment, not the
    # pipeline inside it, and an engine failure would read as python's success.
    raw=$( (cd "$view" && run_timed ast-grep --follow -p "$rendered" --json=stream; printf '%s' "$?" >"$rc_f") 2>"$err_f" \
           | python3 "$lib_dir/ast_grep_matches.py" "$view" "$type" "$CS_CONSTRUCT_DROPPED" )
    rc=$(cat "$rc_f" 2>/dev/null); rm -f "$rc_f"; [[ -n "$rc" ]] || rc=2
    note_search_result "$rc" "$err_f" ast-grep "matching the $shape shape for '$type'"
    rm -f "$err_f"
    searched="$searched $shape"
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      # `repo/path:line`, split at the FIRST `:digits:` -- the same rule
      # json_results learned the hard way, since a matched line's TEXT can
      # carry `:NN:` and a path almost never does.
      loc=$(printf '%s' "$line" | sed -n 's/^\([^:]*:[0-9][0-9]*\):.*/\1/p')
      [[ -n "$loc" ]] || loc="$line"
      grep -qxF "$loc" "$seen_f" && continue
      printf '%s\n' "$loc" >> "$seen_f"
      out="${out:+$out
}$(printf '%s' "$line" | sed "s|^\([^:]*:[0-9][0-9]*\): *|\1: [$shape] |")"
    done < <(printf '%s\n' "$raw" | normalize)
  done <<EOF
$CS_CONSTRUCT_SHAPES
EOF
  rm -f "$seen_f"

  if [[ -n "$only" ]]; then
    out=$(printf '%s\n' "$out" | grep "^$only/" || true)
  fi
  printf '%s' "$out"
}

# Read from the shape table rather than reported back from the search function:
# that runs inside `$(...)`, and a variable set in a subshell never reaches the
# caller -- the same trap that left --source-only's exclusion out of the
# envelope. The list is static, so there is nothing to report back.
construct_shape_names() {
  printf '%s\n' "$CS_CONSTRUCT_SHAPES" | cut -d'|' -f1 | tr '\n' ' ' | sed 's/ $//'
}

# Said only when it fires, and never as PARTIAL: nothing was lost here. A drop
# means the ENGINE returned a match the pattern's own type argument had been
# parsed out of, and reporting the count keeps the guard from being a silent
# narrowing of the corpus -- the failure #13 records, arriving from the other
# side.
construct_overmatch_note() {  # <n-dropped> <type>
  [[ "${1:-0}" -gt 0 ]] || return 0
  info "${C_BOLD}$1 engine match(es) dropped${C_OFF} — they did not contain '$2', so the shape's own type argument had not been applied to them"
  info "  a pattern is re-parsed per language, and one that a grammar cannot express degenerates rather than erroring (markdown prose is the usual source)"
}

cmd_constructs() {
  [[ $# -ge 1 ]] || die "cs constructs <Type> [repo]
  every construction site of a type, across the shapes it can be built by"
  local type="$1" only="${2:-}" out
  have ast-grep || die "cs constructs needs ast-grep, and it is not installed
  semgrep is not a substitute here: this verb runs several patterns and unions
  them, and the two engines take different pattern dialects
  weaker but available now: cs uses '$type', cs calls '$type(\$\$\$ARGS)'"
  case "${force_engine:-}" in
    ""|ast-grep) ;;
    *) die "cs constructs has no engine named '$force_engine'
  it answers from: ast-grep, and nothing else" ;;
  esac
  [[ -n "$only" && ! -d "$view/$only" ]] && die "no such repo: $only"

  require_python3 constructs "holding each shape's pattern to its own type argument"

  answer structural "ast-grep" "construction shapes, unioned"
  CS_CONSTRUCT_DROPPED=$(cs_tmp cs-constr-dropped)
  out=$(constructs_via_ast_grep "$type" "$only")
  local n_dropped=0
  if [[ -s "$CS_CONSTRUCT_DROPPED" ]]; then
    n_dropped=$(awk '{ n += $1 } END { print n + 0 }' "$CS_CONSTRUCT_DROPPED")
  fi
  rm -f "$CS_CONSTRUCT_DROPPED"

  if [[ -z "$out" ]]; then
    engines_ok_or_die constructs
    report_answer 0 0
    # The disclosure matters MORE on an empty answer than on a full one: this is
    # exactly where "no construction sites" would be read as "nothing builds
    # this", and the unsearched shapes are the reason that reading is unsafe.
    construct_blind_spots
    construct_overmatch_note "$n_dropped" "$type"
    hint "cs uses '$type'         (a construction in an unsearched shape is still a mention)" \
         "cs def $type            (confirm the type exists and is spelled this way)"
    return $CS_EXIT_NO_HITS
  fi

  # --field turns "who constructs it" into "who inherits the default", which is
  # the question a default change is actually reviewed against. The test is
  # textual -- does the matched construction mention the field -- so it is a
  # heuristic marker on a structural hit, and is labelled as one rather than
  # silently upgraded to the answer.
  if [[ -n "$construct_field" ]]; then
    out=$(printf '%s\n' "$out" | awk -v f="$construct_field" '
      {
        body = $0
        sub(/^[^:]*:[0-9]+: /, "", body)
        mark = (index(body, f) > 0) ? "present" : "ABSENT"
        sub(/\] /, "] " mark " ", $0)
        print
      }')
  fi

  emit_capped "$out"
  info ""
  info "${C_BOLD}shapes searched:${C_OFF} $(construct_shape_names)"
  construct_overmatch_note "$n_dropped" "$type"
  if [[ -n "$construct_field" ]]; then
    local n_absent
    n_absent=$(printf '%s\n' "$out" | grep -c 'ABSENT' || true)
    info "${C_BOLD}$n_absent site(s) do not mention '$construct_field'${C_OFF} — those inherit its default and are what a default change is observable at"
    warn "present/ABSENT is a TEXTUAL test on the matched construction, not a resolved argument list: a field passed via **kwargs, a spread, or a variable holding the name reads as ABSENT"
  fi
  construct_blind_spots
  # `factory?` and `builder?` carry a question mark because a pattern matcher
  # cannot check the return type: `T.parse(x)` and `T.of(x)` match the same
  # shape, and only one of them constructs.
  warn "a hit labelled factory? or builder? matched the SHAPE of a construction; nothing here verifies the method returns a $type"
  report_answer "$(n_hits_in "$out")" "$(n_repos_in "$out")"
}

# ---- cs strictness ---------------------------------------------------------
# "If I add a field to this response, which consumers REJECT unknown fields and
# crash?" That is the expensive half of an API-impact review. Finding the
# consumers is well served (cs uses, cs fields); classifying each one's parser
# strictness was entirely manual -- open every consumer, find its
# deserialization site, work out whether the model forbids extras -- and it is
# the half where being wrong costs most. The incident behind this class of
# review is an "additive, non-breaking" field addition that crashed a consumer
# whose model was a plain dataclass splatted from a dict.
#
# It belongs here, and at the `declared` tier, for the same reason cs deps and
# cs owns do: strictness is declared in config and model metadata rather than
# inferred from control flow, and the raw signal is plentiful. What was missing
# is normalisation -- `extra="forbid"` and `extra='forbid'` are one setting in
# two quotings, and a caller grepping one silently misses the other. Same
# silent-under-selection class as the composition gap in cs uses.
cmd_strictness() {
  require_python3 strictness "reading model metadata and parser configuration"
  local mode="audit" arg="${1:-}"
  [[ -n "$arg" ]] && mode="repo"
  [[ -n "$arg" && ! -d "$view/$arg" ]] && die "no such repo: $arg"
  answer declared "parser config + model metadata" "$mode"

  # Captured separately rather than with 2>&1, for the reason cs owns does it:
  # strictness.py writes the UNKNOWN roll-up to stderr on purpose -- "we could
  # not tell" is a finding about the scan, not a posture a repo declared -- and
  # merging the streams would put it on stdout as though it were an answer.
  local out rc err_file
  err_file=$(cs_tmp cs-strict)
  out=$(python3 "$lib_dir/strictness.py" "$view" "$mode" ${arg:+"$arg"} 2>"$err_file"); rc=$?
  [[ "$rc" -eq 2 ]] && { cat "$err_file" >&2; rm -f "$err_file"; die "cs strictness: the scan did not run, so no repo's posture was determined
  nothing here is a verdict -- an absent answer is not a lenient one"; }
  if [[ -s "$err_file" ]]; then cat "$err_file" >&2; fi
  rm -f "$err_file"

  if [[ -z "$out" ]]; then
    report_answer 0 0
    hint "cs strictness           (the fleet-wide audit, if you asked about one repo)" \
         "cs uses 'JsonIgnoreProperties'   (the raw markers, unnormalised)"
    return $CS_EXIT_NO_HITS
  fi
  emit_capped "$out"

  # Every caveat here is about the same thing: a verdict is a summary, and the
  # decisions it feeds are per-consumer.
  warn "UNKNOWN is NOT lenient. It means no recognised parser configuration was found, and a repo whose posture is undetermined can still crash on an added field."
  warn "extra=allow is not simply lenient either: unknown fields are RETAINED on the model, so a consumer that persists the object verbatim (a JSONB column, say) stores them."
  if [[ "$mode" == "audit" ]]; then
    warn "a repo-level verdict is a ROLL-UP, not a per-consumer answer — for a MIXED repo the model list is what decides the review: cs strictness <repo>"
  fi
  warn "declared, not resolved: this reports what the config and model metadata SAY. A parser configured at runtime, a custom deserializer, or a framework default overridden in code is invisible here."
  report_answer "$(n_hits_in "$out")" "$(n_repos_in "$out")"
}

# ---- cs resilience ---------------------------------------------------------
# cs strictness answers "will this consumer REJECT an added field". There is a
# second question with the same shape, the same declared-tier evidence, and a
# different class of review behind it: WILL THIS CONSUMER EVEN READ THE BODY?
#
# Two findings it exists for. A producer shipped a partial-failure contract --
# a "here is what already succeeded" field designed for a caller that reads it
# on error -- and the consumer discarded the body and auto-retried; the field
# was worthless and that half was never in the diff. And a producer changed an
# ERROR shape, where the impact question is "who parses error responses", which
# the additive/strictness framing does not fire on at all.
#
# The evidence is plentiful and declared. Across a 43-repo fleet:
# raise_for_status 323 files, tenacity 219, @Retryable 10, Retryer 1. Those 323
# raise on a non-2xx WITHOUT reading the body, and none of them looks any
# different from an attentive consumer in a cs uses answer.
#
# A wrong answer here is QUIETER than a wrong strictness answer, which is the
# argument for having it: a rejected field crashes the consumer loudly, while a
# discarded field simply never arrives and nobody gets paged.
cmd_resilience() {
  require_python3 resilience "reading error handling and retry configuration"
  local mode="audit" arg="${1:-}"
  [[ -n "$arg" ]] && mode="repo"
  [[ -n "$arg" && ! -d "$view/$arg" ]] && die "no such repo: $arg"
  answer declared "error handlers + retry configuration" "$mode"

  # Captured separately rather than with 2>&1, for the reason cs strictness
  # does it: resilience.py writes the UNKNOWN roll-up and the infrastructure
  # caveat to stderr on purpose, and merging the streams would put them on
  # stdout as though they were verdicts.
  local out rc err_file
  err_file=$(cs_tmp cs-resil)
  out=$(python3 "$lib_dir/resilience.py" "$view" "$mode" ${arg:+"$arg"} 2>"$err_file"); rc=$?
  [[ "$rc" -eq 2 ]] && { cat "$err_file" >&2; rm -f "$err_file"; die "cs resilience: the scan did not run, so no repo's posture was determined
  nothing here is a verdict -- an absent answer is not an attentive one"; }
  if [[ -s "$err_file" ]]; then cat "$err_file" >&2; fi
  rm -f "$err_file"

  if [[ -z "$out" ]]; then
    report_answer 0 0
    hint "cs resilience           (the fleet-wide audit, if you asked about one repo)" \
         "cs uses 'raise_for_status'       (the raw markers, unnormalised)" \
         "cs strictness           (the other half: who REJECTS an added field)"
    return $CS_EXIT_NO_HITS
  fi
  emit_capped "$out"

  warn "UNKNOWN is NOT 'reads the error body'. It means no recognised error handling was found, and a consumer that never reads one looks exactly like a consumer this could not classify."
  warn "RETRIES, BODY DISCARDED is the verdict that turns a producer-side contract into a no-op: a partial-failure field added to an error body never reaches a caller that raises and retries."
  if [[ "$mode" == "audit" ]]; then
    warn "a repo-level verdict is a ROLL-UP, not a per-client answer — for a MIXED repo the site list is what decides the review: cs resilience <repo>"
  fi
  warn "declared, not resolved: this reports what the handlers and configuration SAY. Which client a given call actually goes through, and whether the caught exception is re-read further up, are not visible here."
  report_answer "$(n_hits_in "$out")" "$(n_repos_in "$out")"
}

# ---- cs gaps ---------------------------------------------------------------
# The one dishonest negative cs could not detect. Everything else here is about
# whether the SEARCH was sound; this is about whether the CORPUS was. A fleet
# holding 43 of an org's 365 repos makes `cs uses <route>` returning nothing
# mean "not in these 43", and a caller reading it as "nothing at this company
# calls it" is wrong in a way no provenance on the search itself can catch.
#
# It has bitten concretely: a repo holding a dedicated HTTP client for one of
# the fleet's own services was simply never cloned, and NO query shape could
# have found it -- the proof is set-theoretic, not search-dependent.
#
# This is the tool's own thesis one level up. cs refuses to manufacture a
# negative from a broken engine; a negative from an unrepresentative corpus is
# the same failure with a different cause.
have_forge() {
  have "${CS_FORGE_BIN:-gh}" || return 1
  # Installed is not the same as usable: an unauthenticated CLI fails per query,
  # and a per-query failure that reads as an empty result is the exact bug this
  # verb exists to prevent.
  "${CS_FORGE_BIN:-gh}" auth status >/dev/null 2>&1
}

cmd_gaps() {
  [[ $# -ge 1 ]] || die "cs gaps <query>
  what matches ORG-WIDE that the fleet cannot see"
  require_python3 gaps "querying the forge and classifying what it returns"
  local query="$1"
  have "${CS_FORGE_BIN:-gh}" || die "cs gaps needs a forge CLI (${CS_FORGE_BIN:-gh}), and it is not installed
  this is the one engine here that needs NETWORK, so it is opt-in and absent by
  default — cs engines reports it like any other
  without it a fleet-scoped negative cannot be escalated, and stays bounded by
  the fleet: see the note printed on any zero-hit fleet answer"
  have_forge || die "cs gaps: ${CS_FORGE_BIN:-gh} is installed but not authenticated, so no org-wide search ran
  an unauthenticated query fails per call, and a per-call failure that reads as
  an empty result is exactly the false zero this verb exists to prevent
  authenticate with: ${CS_FORGE_BIN:-gh} auth login"

  # textual, and labelled so: an org-wide match on a service name is strong for
  # "this repo talks to that service" and silent on what it does with it.
  answer textual "${CS_FORGE_BIN:-gh} (org-wide code search)" "unfiltered, classified after"

  local out rc err_file
  err_file=$(cs_tmp cs-gaps)
  out=$(python3 "$lib_dir/forge_gaps.py" "$view" "$query" ${CS_GAPS_LIMIT:+--limit="$CS_GAPS_LIMIT"} 2>"$err_file"); rc=$?
  [[ -s "$err_file" ]] && cat "$err_file" >&2
  rm -f "$err_file"

  case "$rc" in
    3) die "cs gaps: no organisation to search
  the owner is read from the fleet's own remotes; set CS_ORG to name one" ;;
    4) die "cs gaps: the org-wide search did not run, so NOTHING is ruled out
  this is a refusal, not 'no repos beyond the fleet' — org-wide code search is
  rate limited, and an error read as an empty result is the false zero this
  whole verb exists to prevent
  the reason is on the line above" ;;
  esac

  if [[ "$rc" -eq 1 || -z "$out" ]]; then
    report_answer 0 0
    warn "this bounds the negative only as far as the forge index reaches: a private repo the token cannot see, or one the index has not covered, is still outside it"
    return $CS_EXIT_NO_HITS
  fi

  emit_capped "$out"
  info ""
  info "${C_BOLD}a fleet-scoped negative for '$query' is bounded by the repo(s) above${C_OFF}"
  warn "application code and config only are DIFFERENT findings: a deployment manifest or README naming a service is not a caller, and cloning on a raw match would grow the fleet with the wrong half"
  warn "textual, not structural: this says a repo mentions the string, not that it calls, implements or deserializes anything"
  if [[ $suggest_clone -eq 1 ]]; then
    # Split on the classification forge_gaps.py already made, rather than
    # suggesting every row: the block above warns that a manifest naming a
    # service is not a caller, and a paste-ready list that includes the
    # CHANGELOGs contradicts that warning in the same answer.
    local code_rows cfg_rows
    code_rows=$(printf '%s\n' "$out" | grep -F '[application code' || true)
    cfg_rows=$(printf '%s\n' "$out" | grep -vF '[application code' || true)
    [[ $suggest_clone_all -eq 1 ]] && { code_rows="$out"; cfg_rows=""; }

    info ""
    if [[ -n "$code_rows" ]]; then
      info "${C_BOLD}to close the gap — registration is just a clone:${C_OFF}"
      printf '%s\n' "$code_rows" | sed -n 's/^\([^:]*\):.*/  git -C "$FLEET_ROOT" clone <forge-url>\/\1/p' >&2
    else
      info "${C_BOLD}no clone suggested:${C_OFF} every repo above matched only in config or docs"
      info "  that is still a bound on the negative — it is just not a caller to clone"
    fi
    if [[ -n "$cfg_rows" ]]; then
      info ""
      info "${C_BOLD}also matched, probably not worth cloning${C_OFF} — config or docs only, no application code:"
      printf '%s\n' "$cfg_rows" | sed -n 's/^\([^:]*\):.*/  \1/p' >&2
      info "  --suggest-clone=all emits clone commands for these too"
    fi
  fi
  report_answer "$(n_hits_in "$out")" "$(n_hits_in "$out")"
}

# ---- cs values -------------------------------------------------------------
# `cs fields` split a field into writes and reads, and that split was the whole
# value. A config key has the same two sides -- except they sit on opposite
# sides of a REPO BOUNDARY, and `cs uses <KEY>` returns them in one
# undifferentiated list.
#
# That shape hides the defect, because the interesting failure is not a missing
# reference. It is a VALUE MISMATCH across the seam: a cross-repo pair, both
# halves unusually well verified in isolation -- the producer proved its chart
# rendered identically, the consumer proved its values parsed identically --
# with the defect sitting exactly between them, because the producer gated on
# specific tokens and the consumer passed a group-level name that was never one
# of them. Neither side's tests could see it. Nothing in either diff could.
#
# The two sides live in DIFFERENT FILE KINDS, which is what makes the split
# cheap and what makes a single text sweep useless: measured on a 43-repo
# fleet, a Spring profile selector was in 10 manifests and 4 code files, a
# feature-flag prefix in 1 and 26, a log-level key in 15 and 58. The counts
# alone say nothing about whether the two agree.
cmd_values() {
  [[ $# -ge 1 ]] || die "cs values <KEY> [repo]
  which repos SET a config key, with what literals, and which repos READ it"
  require_python3 values "splitting set-sites from read-sites and reading the literals"
  local key="$1" only="${2:-}" hits out err_f rc
  [[ -n "$only" && ! -d "$view/$only" ]] && die "no such repo: $only"
  case "${force_engine:-}" in
    ""|rg|ripgrep|grep|posix) ;;
    *) die "cs values has no engine named '$force_engine'
  it is a text sweep classified afterwards, and answers from: $(text_engine)" ;;
  esac

  # `textual`, and the note says why it is not stronger. The set side is
  # manifest data and would pass for `declared`; the read side is a text match
  # over branching code and is not. Labelling the ANSWER by its weaker half is
  # the same rule cs applies everywhere else -- a mixed answer is worth what its
  # weakest evidence is worth.
  answer textual "$(text_engine)" "set/read split by file kind"
  hits=$(grep_fleet literal "$key" | normalize)
  [[ -n "$only" ]] && hits=$(printf '%s\n' "$hits" | grep "^$only/" || true)

  if [[ -z "$hits" ]]; then
    engines_ok_or_die values
    report_answer 0 0
    hint "cs uses '$key'          (the undifferentiated list, if the split found nothing)" \
         "cs seam '$key'          (which repos share it at all, comments included)"
    return $CS_EXIT_NO_HITS
  fi

  err_f=$(cs_tmp cs-values)
  # The script cuts each line's RAW text itself, so the [set]/[read] tag and
  # the literal it extracted are never what a long line loses.
  out=$(printf '%s\n' "$hits" | CS_MAX_LINE="$CS_MAX_LINE" \
        python3 "$lib_dir/config_values.py" "$view" "$key" 2>"$err_f"); rc=$?
  if [[ "$rc" -gt 1 ]]; then
    rm -f "$err_f"
    die "cs values: config_values.py exited $rc, so nothing was classified
  the hits were found and then not read -- this is a refusal, not an empty
  answer, and nothing here is ruled out
  weaker but available now: cs uses '$key'"
  fi
  if [[ -z "$out" ]]; then
    rm -f "$err_f"
    engines_ok_or_die values
    report_answer 0 0
    return $CS_EXIT_NO_HITS
  fi

  # Capped PER KIND, for the reason cs fields caps per kind: the two sides are
  # heavily unequal in either direction (10 set / 4 read for one key, 1 / 26 for
  # another), so one budget over the combined stream would spend itself on
  # whichever side happens to be larger and truncate the other away entirely.
  CS_PRECAPPED=1
  emit_two_kinds ': \[set\]' ': \[read\]' "$out"
  CS_PRECAPPED=""

  cat "$err_f" >&2
  rm -f "$err_f"
  warn "the two sides are told apart by FILE KIND, not by dataflow: a code file that SETS the key at runtime is counted as a read site here, and a manifest that only documents it is counted as a set site"
  warn "a set-site's literal is what the file SAYS. It is not what the process receives: an env var, a later overlay, or a values file merged on top can replace it, and none of that is visible to a text sweep."
  report_answer "$(n_hits_in "$out")" "$(n_repos_in "$out")"
}

cmd_refs() {
  [[ $# -ge 3 ]] || die "cs refs <symbol> <repo> <file-relative-to-repo>"
  have uvx || die "serena needs uv installed"
  require_python3 refs "driving the language server and formatting its answer"
  local repo_dir="$view/$2"
  [[ -d "$repo_dir" ]] || die "no such repo: $2"
  # Same rule as cs impls: an --engine cs refs cannot honour is rejected rather
  # than dropped. There is no alternative engine here -- a graph records no
  # references and cannot bridge a DI registration -- so anything but serena is
  # an error, and silence would look like that engine having found nothing.
  case "${force_engine:-}" in
    ""|serena|lsp) ;;
    *) die "cs refs has no engine named '$force_engine'
  only a language server resolves references, and it is the one thing here that
  bridges a DI registration — a tokensave graph does not record them
  for a graph-backed answer to a narrower question, use: cs impls $1 $2 --engine=tokensave" ;;
  esac
  # Before `answer resolved` is set, and before the server is started: uvx,
  # python3 and the repo directory all passing says nothing about whether this
  # language can be loaded at all.
  require_serena_toolchain refs "$1" "$2" "$repo_dir"
  # The file names the language for certain, so a repo whose Serena project
  # runs no server for it is refused before one is started (#95): the question
  # it was asked used to come back as advice on how to name the symbol.
  local q_lang off
  q_lang=$(question_language "$1" "$repo_dir" "$3" || true)
  if [[ -n "$q_lang" ]] && off=$(serena_project_lacks "$repo_dir" "$q_lang"); then
    die "$(serena_lang_off refs "$1" "$2" "$repo_dir" "$q_lang" "$off")
  weaker but available now: cs def ${1##*[./]} $2, cs uses '${1##*[./]}'"
  fi
  serena_project_prepare "$repo_dir" "$2" "$1" "$3"
  # `Patient.GetAccessionList` is how the call reads in C# or Java source, and
  # how an agent writes it; Serena separates a type and its member with `/` and
  # matches no symbol for the dotted form (#83). Asked in Serena's spelling,
  # and said so, since the name that was looked up is not the one typed.
  local name_path="$1"
  if [[ "$name_path" == *.* && "$name_path" != */* ]]; then
    name_path=$(printf '%s' "$name_path" | tr . /)
    info "asking the language server for '$name_path' (Type/Member), the spelling it matches, for '$1'"
  fi
  local out raw err_file rc
  raw=$(cs_tmp cs-serena); err_file=$(cs_tmp cs-serena-err)
  run_timed python3 "$lib_dir/serena_call.py" "$repo_dir" find_referencing_symbols \
        "{\"name_path\":\"$name_path\",\"relative_path\":\"$3\"}" \
        >"$raw" 2>"$err_file"; rc=$?
  out=$(python3 "$lib_dir/serena_fmt.py" "$2" < "$raw")
  # The server's notes (a re-ask, an import with warnings) are passed on; a
  # failure's message is not, because the refusal below quotes it, and an
  # agent reading stderr saw one event twice (#86).
  if [[ -s "$err_file" ]] && [[ "$rc" -eq 0 || -n "$out" ]]; then cat "$err_file" >&2; fi
  if [[ -z "$out" ]]; then
    serena_answered_or_die "$rc" "$raw" "$err_file" refs "$1" "$2"
    rm -f "$raw" "$err_file"
    answer resolved "serena (LSP)" "scoped to $2"
    report_answer 0 0
    hint "cs def $1 $2            (confirm the symbol and file are right)" \
         "cs uses '$1'           (a reference across a repo boundary is a string, not a symbol)"
    return $CS_EXIT_NO_HITS
  fi
  rm -f "$raw" "$err_file"
  answer resolved "serena (LSP)" "scoped to $2"
  emit_capped "$out"
  report_answer "$(n_hits_in "$out")" "$(n_repos_in "$out")"
}

# ---- history ---------------------------------------------------------------
# The question no search engine answers: not "where is this string" but "when
# did it get there, and what else changed with it". `git log -S` (the pickaxe)
# finds commits that changed the NUMBER of occurrences of a string, which is
# how you find the commit that introduced or removed a seam rather than the
# commits that merely touched the file.
#
# This is the cross-repo case done properly. When a consumer breaks because a
# producer changed, the producer's commit is in a different repo and is not
# reachable from the consumer's history at all -- so the search has to span the
# fleet, ordered by date, to put the two changes next to each other.
cmd_history() {
  [[ $# -ge 1 ]] || die "cs history <string> [repo]"
  local want="$1" only="${2:-}" rows=""

  # -S is the pickaxe: commits where the NUMBER of occurrences changed, which
  # isolates introduction and removal from the noise of commits that merely
  # touched the file. Its blind spot is a change in place -- rewriting the line
  # around the string leaves the count identical, so -S says nothing happened.
  # That is exactly the shape of a serializer or format change, so an empty -S
  # result escalates to -G (any diff hunk matching) rather than reporting none.
  _history_scan() {  # _history_scan <git-flag>
    local flag="$1" d name log out=""
    while IFS= read -r d; do
      [[ -n "$d" && -d "$d/.git" ]] || continue
      name=$(basename "$d")
      [[ -n "$only" && "$name" != "$only" ]] && continue
      # `|| continue` swallowed every git failure, so a repo git could not read
      # -- a corrupt object store, a missing binary, an unreadable ref -- was
      # indistinguishable from a repo with no matching commits. git exits 0
      # whether or not the pickaxe matched, so non-zero is always a real error.
      log=$(run_timed git -C "$d" log --all --no-merges "$flag$want" \
              --pretty=format:'%cs%x09%h%x09%an%x09%s' -- . 2>/dev/null)
      note_run_status $? git "reading history of $name"
      [[ -n "$log" ]] || continue
      out+=$(printf '%s\n' "$log" | sed "s|^|$name\t|")$'\n'
    done < <(real_dirs)
    printf '%s' "$out"
  }

  if [[ $touched_mode -eq 1 ]]; then
    answer historical "git log -G" "any diff hunk mentioning it"
    rows=$(_history_scan -G)
  else
    answer historical "git log -S" "occurrence count changed"
    rows=$(_history_scan -S)
    if [[ -z "$rows" ]]; then
      rows=$(_history_scan -G)
      [[ -n "$rows" ]] && {
        answer historical "git log -G" "no commit changed the count; showing commits that touched it"
        CS_DEGRADED="'$want' was never added or removed as a whole — every hit below modified a line already containing it"
      }
    fi
  fi

  if [[ -z "$rows" ]]; then
    engines_ok_or_die history
    info "no commit in the view added, removed, or modified a line containing '$want'"
    report_answer 0 0
    hint "cs seam '$want'        (confirm any repo contains it at all)" \
         "cs history '<shorter substring>'   (a reformat can hide the original spelling)"
    return $CS_EXIT_NO_HITS
  fi
  # Sorted by date across every repo, because the point is the interleaving:
  # a producer's change landing days before a consumer's incident is the signal.
  emit_plain "$(printf '%s' "$rows" | sort -t$'\t' -k2,2 \
    | awk -F'\t' '{ printf "%s  %-28s %-9s %-18s %s\n", $2, $1, $3, substr($4,1,18), $5 }')"
  report_answer "$(printf '%s' "$rows" | grep -c '')" \
                "$(printf '%s' "$rows" | cut -f1 | sort -u | grep -c '')"
}

# What is actually being searched, and whether each repo came from the ticket or
# the fleet. An agent that cannot see the view cannot judge a negative result.
cmd_repos() {
  local d name target kind n=0
  printf '%-32s %-8s %s\n' "REPO" "LAYER" "PATH"
  for d in "$view"/*; do
    [[ -e "$d" ]] || continue
    if [[ -L "$d" ]]; then target=$(readlink "$d"); else target="$d"; fi
    # When a ticket is layered the view holds only repos already, but an
    # unlayered view IS the fleet root, files and all.
    is_repo "$target" || continue
    name=$(basename "$d")
    if [[ -n "$ticket_root" && "$target" == "$ticket_root"/* ]]; then kind="ticket"; else kind="fleet"; fi
    printf '%-32s %-8s %s\n' "$name" "$kind" "$target"
    n=$((n + 1))
  done
  printf '\n%s repositor%s\n' "$n" "$([[ $n -eq 1 ]] && echo y || echo ies)"
  # Named, so a repo missing because it was never cloned is distinguishable
  # from one missing because cs did not consider it a repo at all.
  local skipped_entries
  skipped_entries=$(non_repo_entries | tr '\n' ' ' | sed 's/ $//')
  [[ -n "$skipped_entries" ]] && warn "not repositories, so not searched: $skipped_entries"
  return 0
}

# Which scopes exist to be searched -- the fleet, and every ticket workspace.
#
# `cs repos` answers "what am I searching right now", which presumes a right
# now: it reads $PWD to find the workspace. A caller that does not HAVE a
# meaningful working directory -- the MCP server in scripts/cs-mcp is the
# motivating one, but any daemon or CI job is the same -- cannot use that. It
# has to name a scope on every call, and so it first has to be able to find out
# which names are valid. Listing them is the difference between an explicit
# scope argument and a guess.
#
# Exempt from require_fleet, for the same reason `cs engines` is: reporting
# that the fleet root is empty or absent is half of what this command is for.
cmd_scopes() {
  local w n listed=0
  printf '%5s  %s\n' "REPOS" "SCOPE"
  if [[ -d "$root" ]]; then
    printf '%5s  %s\n' "$(count_fleet_repos)" "fleet   ($root)"
  else
    printf '%5s  %s\n' "-" "fleet   ($root does not exist)"
  fi
  # Workspaces by PATH, nested ones included, and nothing else: a grouping
  # folder (on-call/, _done/) holds workspaces rather than repos, and listing it
  # as a 0-repo scope invited a query that answered from main. The path is the
  # scope value; it is unambiguous across roots, where a folder name is not.
  #
  # A workspace with workspaces below it is MIXED: a grouping folder holding a
  # stray clone, most likely. Both are listed, and the outer one says so rather
  # than one reading being picked silently.
  local all c v inner mixed=0
  all=$(discover_workspaces | cut -f2)
  while IFS= read -r w; do
    [[ -n "$w" ]] || continue
    n=0
    for c in "$w"/*/; do [[ -d "$c" ]] && is_repo "${c%/}" && n=$((n + 1)); done
    inner=0
    while IFS= read -r v; do
      [[ "$v" == "$w"/* ]] && inner=$((inner + 1))
    done <<< "$all"
    if [[ $inner -gt 0 ]]; then
      printf '%5s  %s   (mixed: %s repo(s) and %s workspace(s) below — a stray clone?)\n' "$n" "$w" "$n" "$inner"
      mixed=$((mixed + 1))
    else
      printf '%5s  %s\n' "$n" "$w"
    fi
    listed=$((listed + 1))
  done <<< "$all"
  printf '\n'
  [[ $mixed -gt 0 ]] && warn "$mixed workspace(s) also hold workspaces: each is searchable as itself (its own repos only) and so is each workspace inside it — a repo directly in a grouping folder is usually a stray clone"
  local roots; roots=$(workspace_roots)
  if [[ -z "$roots" ]]; then
    warn "no workspace root exists: TICKETS_ROOT is ${TICKETS_ROOT:-unset}, WORKSPACE_ROOTS is ${WORKSPACE_ROOTS:-unset}"
  elif [[ $listed -eq 0 ]]; then
    info "no workspaces under $(printf '%s' "$roots" | tr '\n' ' ')— every scope is the fleet"
  else
    info "workspace roots: $(printf '%s' "$roots" | tr '\n' ' ')"
  fi
  info "search one with: cs --ticket=<path> <subcommand> …  (a bare folder name works when it is unique), or cs --fleet for the fleet alone"
  return 0
}

cmd_why() {
  if [[ $# -ge 1 ]]; then
    blind_spots "$1" || die "unknown answer kind: $1 (resolved, declared, structural, historical, heuristic, textual)"
    # The blind spots above are what the kind cannot see IN PRINCIPLE. Whether
    # you can get an answer of this kind AT ALL on this machine is a different
    # question with the same consequence, and it was only answerable by reading
    # `cs engines` and knowing the routing table by heart.
    local row state detail
    row=$(kind_status "$1")
    state="${row%%|*}"; detail="${row#*|}"
    [[ "$state" == ok ]] || state=$(printf '%s' "$state" | tr 'a-z' 'A-Z')
    printf '\nOn this machine: %s is %s — %s\n' "$1" "$state" "$detail"
    printf 'Backs: %s\n' "$(kind_subcommands "$1")"
    return 0
  fi
  cat <<'TABLE'
Every cs answer is labelled with the kind of evidence behind it. The kind is
what decides how much a NEGATIVE result is worth -- "cs uses found nothing" is
weak evidence of no callers; "cs refs found nothing" is strong.

KIND        WEIGHT  PRODUCED BY                    A NEGATIVE MEANS
----------- ------- ------------------------------ ----------------------------
resolved    highest serena (LSP)                   strong: no reference, in that repo
declared    high    build manifests                strong: not declared
structural  medium  ast-grep / semgrep / ctags     medium: no such shape
historical  high    git log -S                     strong, for tracked files
heuristic   low     text match, prose filtered     weak
textual     lowest  ripgrep / grep                 weak

Run `cs why <kind>` for what that kind specifically cannot see.

EXIT CODES -- a refusal and a zero-hit answer are opposite facts, so they are
different numbers. Branch on the code rather than reading the message:

  0   the query ran and found at least one hit
  1   REFUSAL -- the query did not run, or an engine failed part-way. Nothing
      was searched to completion, so nothing was ruled out. Fix the cause; do
      not fall back to grep.
  2   the query ran honestly and found nothing. Weigh it by the kind above.

A broken engine refuses rather than reporting 0 hits: ripgrep exiting 2, a
regex that does not compile, or a crashing helper all produce empty output that
is otherwise identical to an honest negative.

--porcelain (or CS_JSON=1) puts one JSON object on stdout carrying all of the
above -- kind, engine, hits, repos, degraded, partial, truncated, engine_errors
and the results themselves -- including on a refusal, which has no result
stream to attach anything to. stderr is unchanged either way.

TABLE
  # Which kinds are reachable here, not only what each cannot see. A kind whose
  # every backing engine is missing produces no answers at all, and that was
  # visible nowhere.
  print_kinds_table
}

fleet_only=0
show_why=0
quiet=0
word_match=0
# Opt-in, never the default: dropping data hits is a NARROWING, and a narrowing
# nobody asked for is how a real use goes missing. A route in an appsettings
# .json is a genuine seam, and --source-only would drop it -- which is fine when
# the caller asked for source, and not fine as a default.
source_only=0
# cs fields only. Refused rather than ignored on every other subcommand -- a
# dropped flag looks exactly like a flag that was honoured and changed nothing.
count_mode=0
# cs constructs only: which field to mark present/ABSENT on each site.
construct_field=""
# cs gaps only: print the clone commands that would close the gap. A SUGGESTION
# IS A DEFAULT, AND DEFAULTS GET FOLLOWED, so it defaults to the application-code
# half only -- the same half the verb's own warning says is the right one. The
# config-only repos are still printed, under their own heading, because "this
# matched but is probably not worth cloning" is a finding too; they are just not
# in the block a reader can paste. --suggest-clone=all restores the old
# behaviour for anyone who wants it.
#
# The asymmetry is why this is not tidiness: cloning too little leaves a blind
# spot that surfaces as a false negative, while cloning too much degrades every
# refresh and every graph sync for everyone, and is never revisited.
suggest_clone=0
suggest_clone_all=0
# Env as well as a flag: a caller wrapping cs in a script it does not control
# can set CS_JSON=1 once rather than threading a flag through every call site.
case "${CS_JSON:-0}" in 1|true|yes) porcelain=1 ;; esac
touched_mode=0
refresh_index=0
force_engine=""
CS_MAX_RESULTS="${CS_MAX_RESULTS:-200}"
args=()
for a in "$@"; do
  case "$a" in
    --fleet) fleet_only=1 ;;
    --ticket=*) ticket_id="${a#--ticket=}"
                [[ -n "$ticket_id" ]] || die "--ticket= needs a workspace id, e.g. --ticket=PROJ-123" ;;
    --why) show_why=1 ;;
    --quiet|-q) quiet=1 ;;
    --all) CS_MAX_RESULTS=0 ;;
    --touched) touched_mode=1 ;;
    --engine=*) force_engine="${a#--engine=}" ;;
    --refresh) refresh_index=1 ;;
    --porcelain|--json) porcelain=1 ;;
    --word|-w) word_match=1 ;;
    --source-only) source_only=1 ;;
    --full-lines) CS_MAX_LINE=0 ;;
    --count) count_mode=1 ;;
    --field=*) construct_field="${a#--field=}" ;;
    --suggest-clone) suggest_clone=1 ;;
    --suggest-clone=code) suggest_clone=1 ;;
    --suggest-clone=all) suggest_clone=1; suggest_clone_all=1 ;;
    --suggest-clone=*) die "--suggest-clone takes 'code' (the default) or 'all', not '${a#--suggest-clone=}'
  code: only the repos matched from application code
  all:  every matched repo, including the ones matched only in config or docs" ;;
    *) args+=("$a") ;;
  esac
done
# Recorded HERE, not inside apply_source_only: that runs inside `$(...)`, and a
# variable set in a subshell never reaches the envelope. The warning still
# printed from in there (stderr escapes a subshell; an assignment does not),
# which is exactly the shape of bug that leaves a narrowing visible to a human
# and invisible to a machine caller.
# Still refused rather than ignored everywhere else -- a dropped flag looks
# exactly like a flag that was honoured and changed nothing. The list grew from
# `fields` alone to the three text verbs: those return hits into a caller's
# context and are charged by the token, and a per-repo tally is how you find out
# where to look without paying for 200 hit bodies to learn it.
case "${args[0]:-}" in
  fields|text|seam|uses) ;;
  *) [[ $count_mode -eq 1 ]] && { printf 'cs: --count is not meaningful for cs %s\n  it answers on: fields (write/read site tallies), text, seam, uses (per-repo hit tallies)\n  every other subcommand returns a structured answer, not a per-repo count\n' "${args[0]:-<no subcommand>}" >&2; exit 1; } ;;
esac
[[ $source_only -eq 1 ]] && CS_EXCLUSION_NOTE="${CS_EXCLUSION_NOTE:+$CS_EXCLUSION_NOTE, }--source-only (data/doc extensions)"

# --engine names a text backend as well as a structural one; the text side is
# read from the environment so grep_fleet stays free of the flag plumbing.
case "$force_engine" in
  rg|ripgrep|grep|posix) export CS_TEXT_ENGINE="$force_engine"; force_engine="" ;;
esac
set -- "${args[@]:-}"

[[ $# -ge 1 && -n "${1:-}" ]] || usage 1
sub="$1"; shift
CS_SUB="$sub"; CS_QUERY="${1:-}"
# Everything that reads the fleet must have one; the four that only explain the
# tool must not require it, or the setup you are trying to diagnose blocks the
# diagnosis. `cs engines` is deliberately in the exempt list and prints the root
# it would have used.
case "$sub" in
  which|why|doctor|changes|-h|--help|help) ;;
  engines|scopes) [[ -d "$root" ]] || warn "fleet root does not exist yet: $root" ;;
  *) require_fleet ;;
esac
build_view
case "$sub" in engines|doctor|changes|which|why|repos|scopes|-h|--help|help) ;; *) announce_view ;; esac
case "$sub" in
  text)    cmd_text "$@" ;;
  seam)    cmd_seam "$@" ;;
  uses)    cmd_uses "$@" ;;
  def)     cmd_def "$@" ;;
  provides) cmd_provides "$@" ;;
  deps)    cmd_deps "$@" ;;
  publishes) cmd_publishes ;;
  versions) cmd_versions "$@" ;;
  owns)    cmd_owns "$@" ;;
  calls)   cmd_calls "$@" ;;
  impls)   cmd_impls "$@" ;;
  callers) cmd_callers "$@" ;;
  callees) cmd_callees "$@" ;;
  impact)  cmd_impact "$@" ;;
  fields)  cmd_fields "$@" ;;
  constructs) cmd_constructs "$@" ;;
  strictness) cmd_strictness "$@" ;;
  values)  cmd_values "$@" ;;
  resilience) cmd_resilience "$@" ;;
  gaps)    cmd_gaps "$@" ;;
  refs)    cmd_refs "$@" ;;
  history) cmd_history "$@" ;;
  repos)   cmd_repos ;;
  scopes)  cmd_scopes ;;
  which)   cmd_which ;;
  why)     cmd_why "$@" ;;
  engines) cmd_engines ;;
  doctor)  cmd_doctor ;;
  changes) cmd_changes "$@" ;;
  -h|--help|help) usage 0 ;;
  *) err "unknown subcommand: $sub"; usage 1 ;;
esac
