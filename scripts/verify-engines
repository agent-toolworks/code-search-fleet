#!/usr/bin/env bash
# Probe each search engine directly and compare against the last verified run.
#
# Why this exists separately from verify-search: the facade routes around a
# broken engine. `cs calls` falls back from ast-grep to semgrep, so ast-grep
# could break completely and the end-to-end run would still score 9/9. A facade
# hides exactly the regression you most want to see, so each engine is also
# tested on its own, on the specific capability the facade depends on it for.
#
# Probes are of two kinds:
#   capability      -- must keep working; losing it is a REGRESSION
#   known-limitation-- currently fails; if it starts passing that is an
#                      IMPROVEMENT and the routing should be reconsidered
#                      (tokensave's C# interface edges became a capability, #65;
#                      its C# property-accessor edges did too, #100)
#
# Versions are recorded in fixtures/verified-versions.tsv. A changed version is
# not itself a failure -- it is a prompt to look at the probe results.
#
# Usage: verify-engines [--update] [--quiet]
#   --update   record current versions and probe outcomes as the new baseline
set -uo pipefail

# The harness OWNS its fleet scope; it does not inherit one.
#
# This used to treat an exported FLEET_ROOT as "probe against this fleet". That
# reads as a feature and is not one: every probe here asserts FIXTURE-specific
# content -- the `inventory-api-dotnet` repo, the `Reserve` method, the
# `IsEnabled` literal -- so pointing it at a real fleet cannot succeed. And
# exporting FLEET_ROOT is not an unusual configuration, it is THE documented
# one, so essentially every real user got three engines reported as
# "REGRESSION since last verified run" for a break that did not exist.
#
# Worse, the tokensave probe `cd`s into a fixture repo that a real fleet does
# not contain, and reported `CONFIRMED — no C# interface implementation in
# either kind` from a tree it had never read. That reverses the #6 correction
# with a confident, specific, wrong finding about a third-party tool, which is
# worse than a harness that simply fails.
#
# A deliberate override is still available, but as a FLAG -- an argument is an
# act, an exported variable is ambient.
_fleet_override=""
source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"
# After sourcing, so neither the inherited environment nor the config file can
# reach `cs` or any probe through the ambient value.
unset FLEET_ROOT TICKETS_ROOT

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$here/.." && pwd)"
baseline="$repo_root/fixtures/verified-versions.tsv"

update=0
quiet=0
for a in "$@"; do
  case "$a" in
    --update) update=1 ;;
    --quiet) quiet=1 ;;
    --fleet=*) _fleet_override="${a#--fleet=}" ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown option: $a" ;;
  esac
done

have() { command -v "$1" >/dev/null 2>&1; }

owned=0
F="$_fleet_override"
if [[ -z "$F" || ! -d "$F" ]]; then
  [[ -n "$F" ]] && warn "--fleet $F does not exist; building a throwaway fixture fleet instead"
  F="$(mktemp -d)/fleet"; owned=1
  "$here/build-fixtures" "$F" >/dev/null 2>&1 || die "could not build fixtures"
fi
# Every probe below asserts fixture content, so a fleet without it can only
# produce nonsense. One clear message beats three engines reported as broken:
# a `cd` that fails must never be allowed to degrade into a capability verdict.
[[ -d "$F/inventory-api-dotnet" ]] || die \
"the fixture repo inventory-api-dotnet is not in $F
  every probe here asserts fixture-specific content (the Reserve method, the
  IsEnabled literal), so this fleet cannot be probed -- the results would be
  reported as engine failures rather than as the mismatch they are
  run without --fleet to build a throwaway fixture fleet"
# `cs` and the probes both read this; set from F rather than the other way round.
export FLEET_ROOT="$F"

declare -a ROWS=()

# record <engine> <version> <probe-kind> <outcome> <note>
#
# No field may be empty. The rows are split with `IFS=$'\t' read`, and tab is
# whitespace-IFS, so bash COLLAPSES a run of them -- an engine that failed
# before it could report a version emitted "semgrep\t\tcapability\tFAIL\t…",
# which read back shifted one column: outcome landed in `note`, matched no case
# in the report loop, and the failure was never counted. A genuinely broken
# engine therefore reported FAIL on screen and still exited 0.
record() {
  local e="$1" v="${2:-}" k="$3" o="$4" n="${5:-}"
  [[ -n "$v" ]] || v="?"
  [[ -n "$n" ]] || n="-"
  ROWS+=("$e	$v	$k	$o	$n")
}

prev_version() { [[ -f $baseline ]] && awk -F'\t' -v e="$1" '$1==e{print $2; exit}' "$baseline"; }
prev_outcome() { [[ -f $baseline ]] && awk -F'\t' -v e="$1" '$1==e{print $4; exit}' "$baseline"; }

version_of() {
  case "$1" in
    ripgrep)   rg --version 2>/dev/null | head -1 | awk '{print $2}' ;;
    # Was `"$($here/cs engines >/dev/null 2>&1; echo)"`, which discarded the
    # output it ran cs for, expanded to the empty string, and then tried to
    # EXECUTE that as a command. It survived because nothing calls this branch
    # -- probe_ctags reads the version itself -- but a dead branch that fails
    # the moment it is used is worse than no branch.
    ctags)     ctags_bin >/dev/null 2>&1 && "$(ctags_bin)" --version 2>&1 | head -1 | awk '{print $3}' | tr -d , ;;
    ast-grep)  ast-grep --version 2>/dev/null | awk '{print $2}' ;;
    semgrep)   semgrep --version 2>/dev/null | head -1 ;;
    tokensave) tokensave --version 2>/dev/null | awk '{print $2}' ;;
    # The pinned commit is part of the version: every build reports 2.0.0.dev0.
    serena)    python3 "$here/lib/serena_call.py" --version 2>/dev/null ;;
  esac
}

ctags_bin() {
  local c
  for c in /opt/homebrew/bin/ctags /usr/local/bin/ctags /usr/bin/ctags-universal "$(command -v ctags 2>/dev/null || true)"; do
    [[ -n "$c" && -x "$c" ]] || continue
    "$c" --version 2>&1 | grep -qi universal && { echo "$c"; return 0; }
  done
  return 1
}

# ---- probes -----------------------------------------------------------------
# Each asserts the one capability the facade relies on that engine for.

probe_ctags() {
  local ct; ct=$(ctags_bin) || { record ctags "-" capability MISSING "not installed"; return; }
  local ver; ver=$("$ct" --version 2>&1 | head -1 | awk '{print $3}' | tr -d ,)
  local tags; tags=$(mktemp)
  (cd "$F" && "$ct" -R --fields=+n -f "$tags" . 2>/dev/null)
  if grep -qP '^Reserve\t.*ReservationController\.cs' "$tags" 2>/dev/null \
     || grep -q '^Reserve	' "$tags" 2>/dev/null; then
    record ctags "$ver" capability PASS "fleet-wide symbol index"
  else
    record ctags "$ver" capability FAIL "did not index the Reserve method"
  fi
  rm -f "$tags"
}

probe_ast_grep() {
  have ast-grep || { record ast-grep "-" capability MISSING "not installed"; return; }
  local ver; ver=$(ast-grep --version 2>/dev/null | awk '{print $2}')
  local out; out=$(cd "$F" && ast-grep -p '$X.IsEnabled($KEY)' -l cs 2>/dev/null)
  if printf '%s' "$out" | grep -q 'ReservationController.cs'; then
    record ast-grep "$ver" capability PASS "literal in argument position"
  else
    record ast-grep "$ver" capability FAIL "missed the IsEnabled literal"
  fi
}

probe_semgrep() {
  have semgrep || { record semgrep "-" capability MISSING "not installed"; return; }
  local ver; ver=$(semgrep --version 2>/dev/null | head -1)
  local out; out=$(cd "$F" && semgrep -e '$X.IsEnabled("...")' -l csharp --quiet --no-git-ignore 2>/dev/null)
  if printf '%s' "$out" | grep -q 'ReservationController.cs'; then
    record semgrep "$ver" capability PASS "structural fallback for ast-grep"
  else
    record semgrep "$ver" capability FAIL "missed the IsEnabled literal"
  fi
}

probe_text() {
  local ver engine
  if [[ -x "$(command -v rg 2>/dev/null || true)" ]]; then
    engine=ripgrep; ver=$(rg --version | head -1 | awk '{print $2}')
  else
    engine=grep; ver=$(grep --version 2>/dev/null | head -1 | awk '{print $NF}')
  fi
  # Captured, not piped straight into `grep -q`: under `set -o pipefail` the
  # recursive grep is killed by SIGPIPE as soon as the second grep matches, and
  # the probe then reports FAIL for a capability that works. Same shape as the
  # bug that silently turned verify-search's timeout check into a SKIP.
  local hits
  hits=$( (cd "$F" && grep -rn --exclude-dir=.git -F 'orders.reserved.v1' . 2>/dev/null) || true )
  if printf '%s\n' "$hits" | grep -q EventPublisher; then
    record "$engine" "$ver" capability PASS "literal text across repos"
  else
    record "$engine" "$ver" capability FAIL "missed a known literal"
  fi
}

# Serena's C# probe needs a .NET SDK, not just uv. Without one the language
# server loads nothing and the probe reported FAIL — "REGRESSION since last
# verified run — lost C# find_implementations" — about a machine where the
# probe simply could not run. The script already knew: the `dotnet` row two
# lines below says so. It just was not consulted.
#
# Probed by RUNNING it, for the same reason cs does: macOS ships a /usr/bin/java
# stub that exists and then reports no runtime.
toolchain_runs() {
  command -v "$1" >/dev/null 2>&1 || return 1
  case "$1" in
    java) java -version >/dev/null 2>&1 ;;
    *)    "$1" --version </dev/null >/dev/null 2>&1 ;;
  esac
}

# uv is not an analyser, but every Serena answer goes through it, so its
# version is part of what a release was tested with (#100).
probe_uv() {
  have uvx || { record uv "-" capability MISSING "Serena cannot run — cs impls/refs refuse"; return; }
  record uv "$(uv --version 2>/dev/null | awk '{print $2}')" capability PASS "runs the pinned Serena (uvx)"
}

probe_serena() {
  have uvx || { record serena "-" capability MISSING "uv not installed"; return; }
  toolchain_runs dotnet || {
    record serena "-" capability SKIP "no .NET SDK here; the C# probe cannot run (see the dotnet row)"
    return
  }
  local ver; ver=$(version_of serena)
  local out
  out=$(python3 "$here/lib/serena_call.py" "$F/inventory-api-dotnet" find_implementations \
        '{"name_path":"Acme.Inventory.Domain/IInventoryStore","relative_path":"src/Domain/IInventoryStore.cs"}' 2>/dev/null)
  if printf '%s' "$out" | grep -q 'SqlInventoryStore'; then
    record serena "${ver:-unknown}" capability PASS "C# interface to implementation"
  else
    record serena "${ver:-unknown}" capability FAIL "lost C# find_implementations"
  fi
}

# Java is the one language whose server needs nothing from the machine: Eclipse
# JDTLS ships a JRE and imports Gradle with it, so cs does not gate Java on a
# system `java` (#65). That is a claim about Serena's packaging, not a law, so it
# is probed: this runs whether or not a JDK is installed, and a release that
# stops bundling the runtime turns it into a REGRESSION rather than into empty
# Java answers.
probe_serena_java() {
  have uvx || { record serena-java "-" capability MISSING "uv not installed"; return; }
  local ver; ver=$(version_of serena)
  local out
  out=$(python3 "$here/lib/serena_call.py" "$F/pricing-lib-java" find_implementations \
        '{"name_path":"DiscountRule","relative_path":"src/main/java/com/acme/pricing/DiscountRule.java"}' 2>/dev/null)
  if printf '%s' "$out" | grep -q 'BulkDiscountRule'; then
    record serena-java "${ver:-unknown}" capability PASS "Java interface to implementation, with or without a system JDK"
  else
    record serena-java "${ver:-unknown}" capability FAIL "lost Java find_implementations — cs no longer gates Java on a JDK, so check the bundled JRE"
  fi
}

# Two more claims cs's gate rests on (#72), probed for the same reason as Java's:
# each is a fact about a third party's packaging, and a release can change it.
#
# A Kotlin build that requests NO Gradle toolchain -- pinned only by
# sourceCompatibility / jvmTarget -- imports on the Kotlin server's own runtime,
# so cs lets it through without a JDK. The fleet is built with
# `build-fixtures --no-toolchain` (#103), which commits that edit in both the
# service and the Java build it includes; JAVA_HOME is unset.
probe_serena_kotlin_floor() {
  have uvx || { record serena-kt "-" capability MISSING "uv not installed"; return; }
  local ver tmp out why
  ver=$(version_of serena)
  tmp=$(mktemp -d)
  "$here/build-fixtures" "$tmp/fleet" --no-toolchain >/dev/null 2>&1 || {
    rm -rf "$tmp"; record serena-kt "${ver:-unknown}" capability FAIL "build-fixtures --no-toolchain failed — the probe cannot run"; return; }
  out=$(env -u JAVA_HOME python3 "$here/lib/serena_call.py" "$tmp/fleet/checkout-service-kotlin" find_implementations \
        '{"name_path":"CheckoutResult","relative_path":"src/main/kotlin/com/acme/checkout/CheckoutService.kt"}' 2>"$tmp/err")
  why=$(sed -n 's/^serena: the language server did not start: //p' "$tmp/err" | head -1)
  rm -rf "$tmp"
  if printf '%s' "$out" | grep -q 'CheckoutResult/Accepted'; then
    record serena-kt "${ver:-unknown}" capability PASS "Kotlin with no Gradle toolchain request, on the server's own runtime (no JAVA_HOME)"
  elif [[ -n "$why" ]]; then
    # Not the claim this probe tests: no Kotlin server ran at all (#90).
    record serena-kt "${ver:-unknown}" capability FAIL "the Kotlin server did not start: ${why%%;*}"
  else
    record serena-kt "${ver:-unknown}" capability FAIL "a Kotlin build with no toolchain request did not resolve without JAVA_HOME — cs lets those through, so check the server's bundled runtime"
  fi
}

# Legacy .NET Framework projects load with the .NET SDK on macOS and Linux too,
# minus their reference assemblies; cs used to call that impossible. Two
# non-SDK-style projects, the second implementing the first's interface through
# a ProjectReference, because the cross-project edge is what a real solution has.
probe_serena_csharp_framework() {
  have uvx || { record serena-netfx "-" capability MISSING "uv not installed"; return; }
  toolchain_runs dotnet || { record serena-netfx "-" capability SKIP "no .NET SDK here (see the dotnet row)"; return; }
  local ver tmp out p
  ver=$(version_of serena)
  tmp=$(mktemp -d)
  mkdir -p "$tmp/sln/Lims" "$tmp/sln/Web"
  for p in Lims Web; do
    {
      printf '<?xml version="1.0" encoding="utf-8"?>\n<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">\n'
      printf '  <PropertyGroup><OutputType>Library</OutputType><AssemblyName>%s</AssemblyName><TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion></PropertyGroup>\n' "$p"
      printf '  <ItemGroup><Reference Include="System" /><Compile Include="*.cs" /></ItemGroup>\n'
      [[ $p == Web ]] && printf '  <ItemGroup><ProjectReference Include="..\\Lims\\Lims.csproj" /></ItemGroup>\n'
      printf '  <Import Project="$(MSBuildToolsPath)\\Microsoft.CSharp.targets" />\n</Project>\n'
    } > "$tmp/sln/$p/$p.csproj"
  done
  printf 'namespace Lims { public interface IStore { string Get(int id); } }\n' > "$tmp/sln/Lims/IStore.cs"
  printf 'namespace Lims { public class SqlStore : IStore { public string Get(int id) { return ""; } } }\n' > "$tmp/sln/Lims/SqlStore.cs"
  printf 'namespace Web { public class AuditedStore : Lims.IStore { public string Get(int id) { return ""; } } }\n' > "$tmp/sln/Web/AuditedStore.cs"
  git -C "$tmp/sln" init -q 2>/dev/null
  out=$(python3 "$here/lib/serena_call.py" "$tmp/sln" find_implementations \
        '{"name_path":"Lims/IStore","relative_path":"Lims/IStore.cs"}' 2>/dev/null)
  rm -rf "$tmp"
  if printf '%s' "$out" | grep -q 'SqlStore' && printf '%s' "$out" | grep -q 'AuditedStore'; then
    record serena-netfx "${ver:-unknown}" capability PASS ".NET Framework projects load with the .NET SDK, across a ProjectReference"
  else
    record serena-netfx "${ver:-unknown}" capability FAIL "legacy .NET Framework projects did not resolve — cs tells Framework repos the SDK works, so re-check"
  fi
}

# Serena is a DRIVER for a language server, and a language server needs its
# language's toolchain. `probe_serena` above only exercises C#, so on a machine
# with a .NET SDK and no JDK it reports PASS while `cs impls` on every Kotlin
# repo in the fleet is unable to run -- a gap that was visible only after a
# query came back empty, and only to someone who knew why. (Kotlin's server
# bundles a runtime to run, but its Gradle import needs a JDK at the project's
# toolchain version; without one it answers `[]`.)
#
# Probed by RUNNING each toolchain, not by `command -v`: "on PATH but fails to
# run" is a real state and is indistinguishable from a working one until a
# query returns nothing. MISSING rather than FAIL, because an absent SDK is a
# fact about the machine, not a regression in an engine.
probe_toolchains() {
  local tc ver langs
  for tc in dotnet java node; do
    case "$tc" in
      dotnet) langs="C#" ;;
      java)   langs="Kotlin builds that request a Gradle toolchain" ;;
      node)   langs="TypeScript/JavaScript" ;;
    esac
    if ! command -v "$tc" >/dev/null 2>&1; then
      record "$tc" "-" capability MISSING "Serena cannot analyse $langs — cs impls/refs refuse there"
      continue
    fi
    case "$tc" in
      java) ver=$(java -version 2>&1 | head -1 | awk -F'"' '{print $2}') ;;
      *)    ver=$("$tc" --version </dev/null 2>/dev/null | head -1) ;;
    esac
    if [[ -n "$ver" ]]; then
      record "$tc" "$ver" capability PASS "Serena can analyse $langs"
    else
      record "$tc" "?" capability MISSING "on PATH but did not run — Serena cannot analyse $langs"
    fi
  done
}

# tokensave was first probed on a LIMITATION -- "its C# graph has no
# `implements` edges", the reason it lost the routing -- so that a release
# fixing it would report IMPROVED. The limitation turned out to be a misreading
# (below, and BASELINE.md at 7.9.0), the routing WAS revisited, and `cs impls`
# now falls back to the graph wherever a language server cannot run. That made
# it a capability cs relies on, and a known-limitation probe of a capability
# gets both directions wrong: it prints IMPROVED on every run, which teaches
# people to skip the line, and a release that LOST the edges would report
# CONFIRMED, in green. So it is a capability: losing it is a REGRESSION (#65).
#
# Probing ONE edge kind was the original flaw. C# has a single syntax for both relations
# -- `class Foo : BaseFoo, IFoo` -- so an extractor cannot separate them without
# resolving each name in the base list, and tokensave resolves some while
# defaulting the rest to `extends`. Counting only `implements` therefore reports
# "the relation is absent" about a graph that has it, which is a different and
# much more consequential claim than "it is filed elsewhere":
#
#   absent            -> the graph cannot answer interface questions in C#
#   filed as extends  -> it can, by querying both kinds and filtering targets
#
# The target id carries its own kind (`interface:<hash>` / `class:<hash>`),
# which is a far better discriminator than the `I[A-Z]*` naming convention --
# it is what the extractor actually decided, not a guess from the name.
probe_tokensave() {
  have tokensave || { record tokensave "-" capability MISSING "not installed"; return; }
  local ver; ver=$(tokensave --version 2>/dev/null | awk '{print $2}')
  local dir="$F/inventory-api-dotnet"
  [[ -d "$dir/.tokensave" ]] || (cd "$dir" && tokensave init </dev/null >/dev/null 2>&1)

  local n_impl n_ext
  n_impl=$(cd "$dir" && tokensave tool rank --edge-kind implements 2>/dev/null \
           | awk -F: '/result_count/{gsub(/[ ,]/,"",$2); print $2}')
  n_ext=$(cd "$dir" && tokensave tool rank --edge-kind extends 2>/dev/null \
          | awk -F: '/result_count/{gsub(/[ ,]/,"",$2); print $2}')
  # Unparseable counts are a FAIL, not a zero. A count that is not a number
  # used to abort this function in the -gt test below, so the row vanished and
  # the summary called tokensave "not installed here" on a machine that has it.
  if ! [[ "$n_impl" =~ ^[0-9]+$ && "$n_ext" =~ ^[0-9]+$ ]]; then
    record tokensave "$ver" capability FAIL \
      "could not read edge counts from 'tokensave tool rank' (got '${n_impl}' / '${n_ext}') — its output format may have changed"
    return
  fi

  # How many `extends` edges actually point at an interface. Needs the graph
  # itself; the rank tool reports counts but not targets.
  local db n_iface="?"
  db="$dir/.tokensave/tokensave.db"
  if have sqlite3 && [[ -f "$db" ]]; then
    n_iface=$(sqlite3 "$db" "
      SELECT COUNT(*) FROM edges e JOIN nodes s ON s.id = e.source
      WHERE s.file_path LIKE '%.cs' AND e.kind = 'extends'
        AND e.target LIKE 'interface:%';" 2>/dev/null)
    n_iface=${n_iface:-?}
  fi

  local captured=$((n_impl + ${n_iface//[!0-9]/0}))
  if [[ "$n_impl" -gt 0 || "${n_iface//[!0-9]/0}" -gt 0 ]]; then
    record tokensave "$ver" capability PASS \
      "C# interface impls in the graph ($captured: $n_impl implements + $n_iface extends→interface, of $n_ext extends) — cs impls queries both kinds"
  else
    record tokensave "$ver" capability FAIL \
      "no C# interface implementation in either kind ($n_ext extends, none targeting an interface) — cs impls' graph fallback cannot answer"
  fi
}

# Calls made inside a property accessor (#79). tokensave emitted no edges out of
# C# or Kotlin accessors, so a method called only from a getter had no callers in
# the graph. C# gained them in 7.15.0 (tokensave #637), the oldest tokensave cs
# supports (#100), so for C# it is a capability: cs no longer names the gap on
# C# answers, and losing the edges is a REGRESSION. Kotlin still lacks them: a
# known limitation, CONFIRMED while the gap holds and IMPROVED the day a release
# emits the edge, which is when graph_accessor_gap in cs should drop Kotlin.
# Each language has two calls -- one from a getter (the one tested) and one
# from a method (the control, which must be found, or the probe proves nothing).
probe_tokensave_accessors() {
  have tokensave || {
    record ts-getters-cs "-" capability MISSING "not installed"
    record ts-getters-kt "-" known-limitation SKIP "not installed"
    return
  }
  local ver tmp lang gap ctl found=() control_missing=()
  ver=$(tokensave --version 2>/dev/null | awk '{print $2}')
  tmp=$(mktemp -d)
  mkdir -p "$tmp/cs" "$tmp/kt"
  printf 'namespace L { public class P { public static int Gap(int i) { return i; } public static int Ctl(int i) { return i; } }\n public class R { public int A { get { return P.Gap(1); } } public int B() { return P.Ctl(1); } } }\n' > "$tmp/cs/P.cs"
  printf 'object P {\n    fun gap(i: Int): Int = i\n    fun ctl(i: Int): Int = i\n}\nclass R {\n    val a: Int\n        get() = P.gap(1)\n    fun b(): Int = P.ctl(1)\n}\n' > "$tmp/kt/P.kt"
  for lang in cs kt; do
    (cd "$tmp/$lang" && git init -q && git add -A && git -c user.email=t@t -c user.name=t commit -qm p \
       && tokensave init </dev/null >/dev/null 2>&1)
    case "$lang" in cs) gap=Gap; ctl=Ctl ;; kt) gap=gap; ctl=ctl ;; esac
    # Edges only: since #107 cs callers also lists calls tokensave left unbound,
    # and an unbound row is not the edge this probe is about.
    [[ -n "$(python3 "$here/lib/tokensave_call.py" callers "$tmp/$lang" "$lang" "$ctl" 2>/dev/null | grep -v '(unbound call: ')" ]] || control_missing+=("$lang")
    [[ -n "$(python3 "$here/lib/tokensave_call.py" callers "$tmp/$lang" "$lang" "$gap" 2>/dev/null | grep -v '(unbound call: ')" ]] && found+=("$lang")
  done
  rm -rf "$tmp"
  local nocontrol=" ${control_missing[*]:-} " has=" ${found[*]:-} "
  if [[ "$nocontrol" == *" cs "* ]]; then
    record ts-getters-cs "$ver" capability FAIL "the control call (from a C# method) was not found — the probe cannot tell anything"
  elif [[ "$has" == *" cs "* ]]; then
    record ts-getters-cs "$ver" capability PASS "calls inside C# property accessors are graph edges"
  else
    record ts-getters-cs "$ver" capability FAIL "no edge out of a C# property accessor — cs no longer names that gap, so C# answers miss those callers"
  fi
  if [[ "$nocontrol" == *" kt "* ]]; then
    record ts-getters-kt "$ver" known-limitation FAIL "the control call (from a Kotlin method) was not found — the probe cannot tell anything"
  elif [[ "$has" == *" kt "* ]]; then
    record ts-getters-kt "$ver" known-limitation IMPROVED "a call inside a Kotlin property accessor IS an edge now — drop Kotlin from graph_accessor_gap in cs"
  else
    record ts-getters-kt "$ver" known-limitation CONFIRMED "no edges out of Kotlin property accessors — cs names it on Kotlin graph answers"
  fi
}

info "probing engines against $F"   # unconditional: the cheap self-check that
                                   # catches a scope leak immediately
probe_text
probe_ctags
probe_ast_grep
probe_semgrep
probe_tokensave
probe_tokensave_accessors
probe_uv
probe_serena
probe_serena_java
probe_serena_kotlin_floor
probe_serena_csharp_framework
probe_toolchains

# ---- report -----------------------------------------------------------------
printf '\n%-12s %-14s %-16s %-10s %s\n' ENGINE VERSION KIND OUTCOME NOTE
regressions=0; changes=0; improvements=0; skips=0; absent_here=0
skip_why=()

for row in "${ROWS[@]}"; do
  IFS=$'\t' read -r engine version kind outcome note <<< "$row"
  local_prev_v=$(prev_version "$engine")
  local_prev_o=$(prev_outcome "$engine")
  flag=""
  if [[ -n "$local_prev_v" && "$local_prev_v" != "$version" ]]; then
    flag=" ${C_YELLOW}(was $local_prev_v)${C_OFF}"; changes=$((changes + 1))
  fi
  case "$outcome" in
    PASS|CONFIRMED) colour="$C_GREEN" ;;
    IMPROVED)       colour="$C_YELLOW"; improvements=$((improvements + 1)) ;;
    FAIL)           colour="$C_RED"; regressions=$((regressions + 1)) ;;
    SKIP)           colour="$C_YELLOW"; skips=$((skips + 1)); skip_why+=("$engine: $note") ;;
    MISSING)        colour="$C_YELLOW"; [[ -n "$local_prev_v" && "$local_prev_v" != "-" ]] && absent_here=$((absent_here + 1)) ;;
    *)              colour="$C_YELLOW" ;;
  esac
  # Reserved for a probe whose OUTCOME moved PASS -> FAIL with its prerequisite
  # still satisfied. A probe that can no longer run has not regressed, and
  # saying it has is the wrong claim rather than merely an unhelpful one.
  if [[ "$local_prev_o" == "PASS" && "$outcome" == "FAIL" ]]; then
    note="REGRESSION since last verified run — $note"
  fi
  printf '%-12s %-14s %-16s %s%-10s%s %s%s\n' \
    "$engine" "$version" "$kind" "$colour" "$outcome" "$C_OFF" "$note" "$flag"
done

info ""
# "changed since the last verified run" silently means "compared to whichever
# machine last ran --update". A baseline carrying dotnet 10.0.400 on a machine
# that never had dotnet is not a change over time, it is a different computer —
# and calling it a change sends a reader hunting for a code difference that does
# not exist. Presence deltas are separated from genuine version movement.
[[ $changes -gt 0 ]] && warn "$changes engine version(s) differ from the recorded baseline (which may have been recorded on another machine — not necessarily a change over time)"
# Reported separately rather than as "of those": an engine absent here has no
# version to differ, so it is not counted among the version deltas above.
[[ $absent_here -gt 0 ]] && warn "$absent_here engine(s) in the baseline are not installed here — absent, not changed"
[[ $improvements -gt 0 ]] && warn "$improvements known limitation(s) no longer apply — revisit the routing in skills/code-search/SKILL.md"
if [[ $skips -gt 0 ]]; then
  warn "$skips probe(s) SKIPPED — a skip is not a pass:"
  for s in "${skip_why[@]:-}"; do [[ -n "$s" ]] && info "    $s"; done
fi
# Exit 1 is reserved for a probe that RAN and produced a wrong answer. An
# absent optional engine and an unmet prerequisite are facts about the machine.
if [[ $regressions -gt 0 ]]; then
  err "$regressions engine(s) failed their capability probe"
else
  if [[ $skips -gt 0 ]]; then
    ok "all capability probes that could run passed ($skips skipped)"
  else
    ok "all capability probes passed"
  fi
fi

if [[ $update -eq 1 ]]; then
  {
    printf '# engine\tversion\tkind\toutcome\tnote\n'
    printf '# verified %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    for row in "${ROWS[@]}"; do printf '%s\n' "$row"; done
  } > "$baseline"
  ok "baseline written to ${baseline#$repo_root/}"
fi

[[ $owned -eq 1 ]] && rm -rf "$(dirname "$F")"
[[ $regressions -eq 0 ]]
